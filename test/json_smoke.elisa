# JSON smoke: parse a JSON-RPC-shaped document and navigate it (object field lookup,
# string compare, nested array indexing). Anchors the Json module.
# Frontend runtime comes from the adjacent compiler checkout (same mechanism as
# src/diagnostics.elisa); override the checkout location via ELISA_COMPILER_ROOT
# when invoking the compiler, keeping this relative include as the default.
include "../../Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../src/json.elisa"


def json_probe(source: u8&, source_len: usize, id_out: mutable u64&, method_ok_out: mutable u8&, arr_count_out: mutable u64&, arr1_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        src: sview = sview(source, 0, source_len.i64())
        id_out[0] <- 0
        method_ok_out[0] <- 0
        arr_count_out[0] <- 0
        arr1_out[0] <- 0
        match Json::parse(src):
            Json::ParseOutcome.Parsed(root):
                if Json::get(root, "id") is idv:
                    match Json::as_i64_result(idv):
                        Json::I64ParseOutcome.Valid(value):
                            id_out[0] <- value.u64()
                        Json::I64ParseOutcome.Invalid:
                            pass
                if Json::get(root, "method") is mv:
                    match Json::as_str_result(mv):
                        Json::StringParseOutcome.Valid(method):
                            if string_view_eq(method, "initialize") == 1:
                                method_ok_out[0] <- 1
                        Json::StringParseOutcome.Null | Json::StringParseOutcome.WrongType:
                            pass
                if Json::get(root, "params") is pv:
                    if Json::get(pv, "a") is av:
                        match av:
                            Json::Value.Arr(items):
                                arr_count_out[0] <- items.count.u64()
                                if items.count >= 2:
                                    match Json::as_i64_result(items[1]):
                                        Json::I64ParseOutcome.Valid(value):
                                            arr1_out[0] <- value.u64()
                                        Json::I64ParseOutcome.Invalid:
                                            pass
                            _:
                                pass
            Json::ParseOutcome.Rejected(_):
                pass


export fn json_probe_export(source: u8&, source_len: usize, id_out: mutable u64&, method_ok_out: mutable u8&, arr_count_out: mutable u64&, arr1_out: mutable u64&) -> void = json_probe
