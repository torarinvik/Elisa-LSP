{
  "spec_baseline": "LSP 3.17",
  "server": "elisa-lsp",
  "transport": {
    "framing": "buffered Content-Length framing (case-insensitive header, strict digit value, overflow-checked)",
    "bounds": {
      "max_header_bytes": 16384,
      "max_header_lines": 64,
      "max_body_bytes": 16777216
    },
    "failure": "malformed/conflicting/missing/zero/truncated/oversized frames are controlled nonzero exits with no output frame; clean EOF is exit 0",
    "test": "test/transport_test.sh"
  },
  "methods": {
    "initialize": {
      "implemented": true,
      "test": "test/handshake_test.sh",
      "module": "src/main.elisa:main"
    },
    "initialized": {
      "implemented": false,
      "note": "accepted silently (no-op); P02 state machine pending"
    },
    "shutdown": {
      "implemented": true,
      "test": "test/handshake_test.sh",
      "module": "src/main.elisa:main"
    },
    "exit": {
      "implemented": true,
      "test": "test/handshake_test.sh",
      "module": "src/main.elisa:main"
    },
    "textDocument/didOpen": {
      "implemented": true,
      "test": "test/diagnostics_test.sh",
      "module": "src/main.elisa:check_and_publish"
    },
    "textDocument/didChange": {
      "implemented": true,
      "test": "test/sync_test.sh",
      "module": "src/main.elisa:check_and_publish",
      "note": "full-sync only (all change entries validated in order, last wins); incremental sync not advertised"
    },
    "textDocument/didClose": {
      "implemented": true,
      "test": "test/multi_document_test.sh",
      "module": "src/main.elisa:handle_did_close"
    },
    "textDocument/semanticTokens/full": {
      "implemented": true,
      "test": "test/semtokens_test.sh",
      "module": "src/semtokens.elisa:handle_semantic_tokens"
    },
    "textDocument/hover": {
      "implemented": true,
      "test": "test/hover_test.sh",
      "module": "src/main.elisa:handle_hover",
      "note": "loop-header specialization only; general hover pending (F01)"
    },
    "textDocument/publishDiagnostics": {
      "implemented": true,
      "kind": "server-to-client notification",
      "test": "test/diagnostics_test.sh",
      "module": "src/diagnostics.elisa:publish_diagnostics"
    },
    "textDocument/didSave": {
      "implemented": false,
      "note": "not handled"
    },
    "textDocument/willSave": {
      "implemented": false,
      "note": "not handled"
    },
    "textDocument/documentSymbol": {
      "implemented": true,
      "test": "test/document_symbols_test.sh",
      "module": "src/features/document_symbols.elisa:handle_document_symbols",
      "note": "flat SymbolInformation by default; hierarchical DocumentSymbol when supported; line-range outline (declaration end lines + enum variants pending A02); symbolKind.valueSet respected"
    },
    "textDocument/definition": {
      "implemented": false,
      "planned": "F03"
    },
    "textDocument/references": {
      "implemented": false,
      "planned": "F04"
    },
    "textDocument/completion": {
      "implemented": false,
      "planned": "F05"
    },
    "textDocument/signatureHelp": {
      "implemented": false,
      "planned": "F06"
    },
    "textDocument/rename": {
      "implemented": false,
      "planned": "F07"
    },
    "textDocument/prepareRename": {
      "implemented": false,
      "planned": "F07"
    },
    "workspace/symbol": {
      "implemented": false,
      "planned": "F08"
    },
    "workspace/executeCommand": {
      "implemented": false,
      "note": "no commands advertised"
    },
    "$/cancelRequest": {
      "implemented": true,
      "test": "test/cancel_test.sh",
      "module": "src/main.elisa:main",
      "note": "bounded typed-id set; pipelined cancellation completes with RequestCancelled -32800"
    },
    "window/workDoneProgress/create": {
      "implemented": false,
      "planned": "Q03"
    },
    "textDocument/foldingRange": {
      "implemented": true,
      "test": "test/folding_test.sh",
      "module": "src/features/folding.elisa:handle_folding_range",
      "note": "indentation regions + comment runs + doc blocks; line-only; rangeLimit honored"
    }
  },
  "capabilities_advertised": {
    "textDocumentSync": 1,
    "semanticTokensProvider": {
      "legend": "src/semtokens.elisa:semtok_legend_json (48 custom types)",
      "full": true
    },
    "hoverProvider": {
      "markdown": "default",
      "plaintext": "when contentFormat lacks markdown",
      "test": "test/capabilities_test.sh"
    },
    "positionEncoding": {
      "negotiated": "utf-8 only when the client offers it first; otherwise UTF-16 (default, field omitted)",
      "test": "test/capabilities_test.sh"
    },
    "documentSymbolProvider": {
      "shapes": "flat SymbolInformation; hierarchical when hierarchicalDocumentSymbolSupport",
      "valueSet": "honored via per-category fallbacks",
      "test": "test/document_symbols_test.sh"
    },
    "publishDiagnostics": {
      "relatedInformation": "emitted when the client advertises support and the compiler carries a secondary span",
      "test": "test/related_info_test.sh"
    },
    "foldingRangeProvider": {
      "shape": "line-only FoldingRange",
      "rangeLimit": "honored",
      "test": "test/folding_test.sh"
    }
  },
  "legend": {
    "source": "src/semtokens.elisa",
    "count": 48,
    "manifest": "docs/semantic-token-schema.json",
    "note": "custom names; standard fallback pending (H01)"
  },
  "frontend_adapter": {
    "module": "src/frontend_adapter.elisa",
    "contract_version": 1,
    "test": "test/frontend_contract_test.sh",
    "note": "only module touching Semantic::SymbolTable storage layout; ref_kind roles named OCC_PARAM/OCC_LOCAL"
  },
  "json_validation": {
    "strict_gate": "src/json.elisa:is_valid",
    "on_failure": "ParseError -32700 with id null",
    "nesting_limit": 256,
    "test": "test/json_strict_test.sh"
  }
}