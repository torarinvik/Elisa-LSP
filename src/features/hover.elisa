# General hover (F01 v1), backed by a retained analysis summary (A03).
#
# At analysis time `build_hover_index` serializes the compiler's file symbols,
# param/local occurrences, and exact resolver-produced definition edges into a
# compact analysis stream stored in the document's flat storage. Providers later
# scan that stream (not the live SymbolTable, whose sviews would dangle after
# storage compaction) and resolve
# the identifier under the cursor:
#   1. a param/local occurrence at the exact byte span wins (H02 precedence) —
#      `(parameter) name: DeclaredType` / `(local) name: DeclaredType` when the
#      compiler retained an explicit annotation;
#   2. otherwise a file-level declaration matched by name — its category plus
#      the declared return type when the frontend carries one.
# Unknown identifiers or no document summary yield empty (the caller then falls
# back to the loop-header hover). Display-only: name matching is not used as
# proof for any editing operation.
#
# Record stream: each record starts with REC (0x1e); the first byte is `s`
# (symbol: name, category, line, return-type, name-byte-offset, declaration-ID),
# `v` (enum variant: owner and name), `o` (occurrence: byte start/end,
# name, ref-kind, binding owner/serial), `d` (definition source/target ranges),
# or `t` (declared binding type: BindingId, exact source span, and hex-encoded
# annotation). Fields are FS-separated (0x1f); source-derived type text is hex
# encoded so arbitrary bytes cannot corrupt the record stream.

const HOVER_REC: u8 = 30
const HOVER_FS: u8 = 31
const HOVER_TYPE_BINDING: u8 = 116
const HOVER_TYPE_SOURCE_LIMIT: usize = 2048
const HOVER_TYPE_TOTAL_LIMIT: usize = 65536


def hover_symbol_category(kind: i64) -> sview:
    return "fn" if kind == SYMBOL_KIND_FUNCTION or kind == SYMBOL_KIND_EXTERN
    return "struct" if kind == SYMBOL_KIND_STRUCT
    return "enum" if kind == SYMBOL_KIND_ENUM
    return "alias" if kind == SYMBOL_KIND_ALIAS
    return "const" if kind == SYMBOL_KIND_CONST
    return "module" if kind == SYMBOL_KIND_MODULE
    return "import" if kind == SYMBOL_KIND_IMPORT
    return "law" if kind == SYMBOL_KIND_LAW
    return ""


def hover_push(out: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
    out.extend([b for b in text])


def hover_push_range(body: mutable darray[u8]&, line0: i64, scol: i64, ecol: i64) -> void can[Memory.Allocate, Abort.Panic]:
    body.push_str("{\"start\":{\"line\":")
    body.push_int(line0)
    body.push_str(",\"character\":")
    body.push_int(scol)
    body.push_str("},\"end\":{\"line\":")
    body.push_int(line0)
    body.push_str(",\"character\":")
    body.push_int(ecol)
    body.push_str("}}")


def hover_definition_position(src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, offset: u32, utf8: bool, line_out: mutable i64&, char_out: mutable i64&) -> bool can[Abort.Panic]:
    off: usize = offset.usize()
    false return if off > src_len or span_count == 0
    position: (line: i64, character: i64) = Positions::byte_offset_to_position_span_indexed(src, src_len, line_starts, span_start, span_count, off, utf8)
    line0: i64 = position.line
    start: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, line0)
    byte_col: i64 = (off - start).i64()
    false return if byte_col > Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, line0)
    line_out <- line0
    char_out <- position.character
    return true


def hover_definition_span_matches(src: u8&, src_len: usize, start: u32, finish: u32, name: sview) -> bool:
    a: usize = start.usize()
    b: usize = finish.usize()
    false return if b <= a or b > src_len or b - a != name.len.usize()
    return string_views_eq(Positions::source_view_span(src, src_len, a, b - a), name) != 0


def hover_push_hex_source(out: mutable darray[u8]&, src: u8&, start: usize, count: usize) -> void can[Memory.Allocate, Abort.Panic]:
    digits: sview = "0123456789abcdef"
    i: mutable usize = 0
    while i < count:
        byte: u8 = src[start + i]
        out.push(sview_at(digits, (byte >> 4).usize()))
        out.push(sview_at(digits, (byte & 15).usize()))
        i <- i + 1


def hover_token_index_at(tokens: darray[Lexer::Token], offset: u32, index_out: mutable usize&) -> bool:
    lo: mutable usize = 0
    hi: mutable usize = tokens.count
    while lo < hi:
        mid: usize = lo + (hi - lo) / 2
        if tokens[mid].start < offset:
            lo <- mid + 1
        else:
            hi <- mid
    return false if lo >= tokens.count or tokens[lo].start != offset
    index_out <- lo
    return true


def hover_type_delimiter_open(kind: Lexer::TokenKind) -> bool:
    return kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket or kind == Lexer::TokenKind.LBrace


def hover_type_delimiter_close(kind: Lexer::TokenKind) -> bool:
    return kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket or kind == Lexer::TokenKind.RBrace


def hover_type_binder_index(tokens: darray[Lexer::Token], binder_pos: Ast::Pos, src_len: usize, index_out: mutable usize&) -> bool:
    if binder_pos.end_offset > binder_pos.offset and binder_pos.end_offset.usize() <= src_len:
        exact_index: mutable usize = 0
        if hover_token_index_at(tokens, binder_pos.offset, exact_index):
            exact: Lexer::Token = tokens[exact_index]
            exact_end: usize = exact.start.usize() + exact.length.usize()
            has_colon: bool = exact_index + 1 < tokens.count and tokens[exact_index + 1].kind == Lexer::TokenKind.Colon
            if exact.kind == Lexer::TokenKind.Ident and exact_end == binder_pos.end_offset.usize() and has_colon:
                index_out <- exact_index
                return true
    # Some current compiler recovery rows retain a declaration line but not its
    # exact binder token. Recover only one `Ident:` candidate on that line;
    # multiple candidates remain unresolved. The emitted type record is still
    # keyed by the compiler's exact BindingId, never by this token's spelling.
    line: u32 = binder_pos.line
    return false if line == 0
    matches: mutable usize = 0
    candidate_index: mutable usize = 0
    i: mutable usize = 0
    while i < tokens.count:
        token: Lexer::Token = tokens[i]
        if token.line == line and token.kind == Lexer::TokenKind.Ident and i + 1 < tokens.count and tokens[i + 1].kind == Lexer::TokenKind.Colon:
            matches <- matches + 1
            candidate_index <- i
        i <- i + 1
    return false if matches != 1
    index_out <- candidate_index
    return true


# The compiler's current AST position for composite `Index`/`IndexN` types can
# describe only the subscript punctuation. Starting from the compiler's exact
# binder span, use the lexer token contract to recover the complete annotation
# up to its top-level parameter/default/declaration delimiter. Unknown or
# malformed token shapes produce no type record rather than partial text.
def hover_declared_type_source_span(tokens: darray[Lexer::Token], src: u8&, src_len: usize, binder_pos: Ast::Pos, annotation_pos: Ast::Pos, start_out: mutable usize&, end_out: mutable usize&) -> bool:
    return false if binder_pos.line == 0
    return false if annotation_pos.end_offset <= annotation_pos.offset or annotation_pos.end_offset.usize() > src_len
    binder_index: mutable usize = 0
    return false if not hover_type_binder_index(tokens, binder_pos, src_len, binder_index)
    binder: Lexer::Token = tokens[binder_index]
    return false if binder.kind != Lexer::TokenKind.Ident
    return false if not hover_definition_span_matches(src, src_len, binder.start, binder.start + binder.length, Lexer::text_or_empty(binder, src))
    colon_index: usize = binder_index + 1
    return false if colon_index >= tokens.count or tokens[colon_index].kind != Lexer::TokenKind.Colon
    depth: mutable i64 = 0
    cursor: mutable usize = colon_index + 1
    source_start: mutable usize = 0
    source_end: mutable usize = 0
    while cursor < tokens.count:
        token: Lexer::Token = tokens[cursor]
        if depth == 0 and (token.kind == Lexer::TokenKind.Comma or token.kind == Lexer::TokenKind.Assign or token.kind == Lexer::TokenKind.RParen or token.kind == Lexer::TokenKind.Newline or token.kind == Lexer::TokenKind.Semicolon):
            break
        if hover_type_delimiter_open(token.kind):
            depth <- depth + 1
        elif hover_type_delimiter_close(token.kind):
            return false if depth == 0
            depth <- depth - 1
        token_start: usize = token.start.usize()
        token_end: usize = token_start + token.length.usize()
        return false if token_end > src_len
        source_start <- token_start if source_end == 0
        source_end <- token_end
        cursor <- cursor + 1
    return false if depth != 0 or source_end <= source_start
    start_out <- source_start
    end_out <- source_end
    return true


def build_hover_index(table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], tokens: darray[Lexer::Token], src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        body: mutable darray[u8] = []
        i: mutable usize = 0
        declared_type_count: usize = binding_declared_type_count(table)
        retained_type_source_bytes: mutable usize = 0
        while i < symbol_count(table):
            source_line: u32 = symbol_source_line(table, i)
            if source_line > 0 and symbol_name(table, i).len > 0:
                cat: sview = hover_symbol_category(symbol_category(table, i))
                if cat.len > 0:
                    body.push(HOVER_REC)
                    body.push(115)
                    body.push(HOVER_FS)
                    hover_push(body, symbol_name(table, i))
                    body.push(HOVER_FS)
                    hover_push(body, cat)
                    body.push(HOVER_FS)
                    push_int(body, source_line.i64())
                    body.push(HOVER_FS)
                    hover_push(body, symbol_return_type(table, i))
                    body.push(HOVER_FS)
                    push_int(body, symbol_name_position(table, i).offset.i64())
                    body.push(HOVER_FS)
                    push_int(body, symbol_declaration_id(table, i))
            i <- i + 1
        i <- 0
        while i < enum_variant_count(table):
            owner: sview = enum_variant_owner(table, i)
            name: sview = enum_variant_name(table, i)
            body.push(HOVER_REC)
            body.push(118)
            body.push(HOVER_FS)
            hover_push(body, owner)
            body.push(HOVER_FS)
            hover_push(body, name)
            i <- i + 1
        i <- 0
        while i < occurrence_count(table):
            occurrence_pos: Ast::Pos = occurrence_position(occurrence_positions, i)
            if occurrence_pos.end_offset > occurrence_pos.offset:
                start_line: mutable i64 = 0
                start_char: mutable i64 = 0
                end_line: mutable i64 = 0
                end_char: mutable i64 = 0
                positions_valid: mutable bool = hover_definition_position(src, src_len, line_starts, span_start, span_count, occurrence_pos.offset, utf8, start_line, start_char)
                positions_valid <- hover_definition_position(src, src_len, line_starts, span_start, span_count, occurrence_pos.end_offset, utf8, end_line, end_char) if positions_valid
                if positions_valid:
                    body.push(HOVER_REC)
                    body.push(111)
                    body.push(HOVER_FS)
                    push_int(body, occurrence_pos.offset.i64())
                    body.push(HOVER_FS)
                    push_int(body, occurrence_pos.end_offset.i64())
                    body.push(HOVER_FS)
                    hover_push(body, occurrence_name(table, i))
                    body.push(HOVER_FS)
                    push_int(body, occurrence_kind_index(table, i))
                    body.push(HOVER_FS)
                    push_int(body, occurrence_binding_owner(table, i).i64())
                    body.push(HOVER_FS)
                    push_int(body, occurrence_binding_serial(table, i).i64())
                    body.push(HOVER_FS)
                    push_int(body, start_line)
                    body.push(HOVER_FS)
                    push_int(body, start_char)
                    body.push(HOVER_FS)
                    push_int(body, end_line)
                    body.push(HOVER_FS)
                    push_int(body, end_char)
            i <- i + 1
        i <- 0
        while i < definition_reference_count(table):
            source_pos: Ast::Pos = definition_reference_position(table, i)
            target_pos: Ast::Pos = definition_reference_target_position(table, i)
            target_name: sview = definition_reference_target_name(table, i)
            if hover_definition_span_matches(src, src_len, source_pos.offset, source_pos.end_offset, target_name) and hover_definition_span_matches(src, src_len, target_pos.offset, target_pos.end_offset, target_name):
                source_start_line: mutable i64 = 0
                source_start_char: mutable i64 = 0
                source_end_line: mutable i64 = 0
                source_end_char: mutable i64 = 0
                target_start_line: mutable i64 = 0
                target_start_char: mutable i64 = 0
                target_end_line: mutable i64 = 0
                target_end_char: mutable i64 = 0
                positions_valid: mutable bool = hover_definition_position(src, src_len, line_starts, span_start, span_count, source_pos.offset, utf8, source_start_line, source_start_char)
                positions_valid <- hover_definition_position(src, src_len, line_starts, span_start, span_count, source_pos.end_offset, utf8, source_end_line, source_end_char) if positions_valid
                positions_valid <- hover_definition_position(src, src_len, line_starts, span_start, span_count, target_pos.offset, utf8, target_start_line, target_start_char) if positions_valid
                positions_valid <- hover_definition_position(src, src_len, line_starts, span_start, span_count, target_pos.end_offset, utf8, target_end_line, target_end_char) if positions_valid
                if positions_valid:
                    body.push(HOVER_REC)
                    body.push(100)
                    body.push(HOVER_FS)
                    push_int(body, source_start_line)
                    body.push(HOVER_FS)
                    push_int(body, source_start_char)
                    body.push(HOVER_FS)
                    push_int(body, source_end_line)
                    body.push(HOVER_FS)
                    push_int(body, source_end_char)
                    body.push(HOVER_FS)
                    push_int(body, target_start_line)
                    body.push(HOVER_FS)
                    push_int(body, target_start_char)
                    body.push(HOVER_FS)
                    push_int(body, target_end_line)
                    body.push(HOVER_FS)
                    push_int(body, target_end_char)
            i <- i + 1
        i <- 0
        while i < declared_type_count:
            annotation_pos: Ast::Pos = binding_declared_type_position(table, i)
            binder_pos: Ast::Pos = binding_declared_type_declaration_position(table, i)
            type_start: mutable usize = 0
            type_end: mutable usize = 0
            if hover_declared_type_source_span(tokens, src, src_len, binder_pos, annotation_pos, type_start, type_end):
                type_bytes: usize = type_end - type_start
                if type_bytes <= HOVER_TYPE_SOURCE_LIMIT and retained_type_source_bytes <= HOVER_TYPE_TOTAL_LIMIT - type_bytes:
                    body.push(HOVER_REC)
                    body.push(HOVER_TYPE_BINDING)
                    body.push(HOVER_FS)
                    push_int(body, binding_declared_type_owner(table, i).i64())
                    body.push(HOVER_FS)
                    push_int(body, binding_declared_type_serial(table, i).i64())
                    body.push(HOVER_FS)
                    push_int(body, type_start.i64())
                    body.push(HOVER_FS)
                    push_int(body, type_end.i64())
                    body.push(HOVER_FS)
                    hover_push_hex_source(body, src, type_start, type_bytes)
                    retained_type_source_bytes <- retained_type_source_bytes + type_bytes
            i <- i + 1
        return body


# [start,end) bounds of field `index` within a record; false past the last.
def hover_field(blob: sview, rec_start: usize, rec_end: usize, index: i64, out: mutable sview&) -> bool:
    f: mutable i64 = 0
    i: mutable usize = rec_start
    fstart: mutable usize = rec_start
    while i <= rec_end:
        if i == rec_end or sview_at(blob, i) == HOVER_FS:
            if f == index:
                out <- string_view_slice(blob, fstart.i64(), i.i64())
                return true
            f <- f + 1
            fstart <- i + 1
        i <- i + 1
    return false


def hover_parse_i64(text: sview) -> i64:
    n: mutable i64 = 0
    neg: mutable bool = false
    i: mutable usize = 0
    if text.len > 0 and sview_at(text, 0) == 45:
        neg <- true
        i <- 1
    while i < text.len.usize():
        d: u8 = sview_at(text, i)
        n <- n * 10 + (d.i64() - 48) if d >= 48 and d <= 57
        i <- i + 1
    return (0 - n) if neg else n


# ref_kind of an occurrence matching the exact half-open byte span and name, or -1.
def hover_occ_kind(blob: sview, start: i64, finish: i64, name: sview, owner_out: mutable i64&, serial_out: mutable i64&) -> i64:
    rec_start: mutable usize = 0
    i: mutable usize = 0
    n: usize = blob.len.usize()
    while i <= n:
        if i == n or sview_at(blob, i) == HOVER_REC:
            if i > rec_start and sview_at(blob, rec_start) == 111:
                fs: mutable sview = sview("", 0, 0)
                fe: mutable sview = sview("", 0, 0)
                fn: mutable sview = sview("", 0, 0)
                fk: mutable sview = sview("", 0, 0)
                fo: mutable sview = sview("", 0, 0)
                fb: mutable sview = sview("", 0, 0)
                if hover_field(blob, rec_start, i, 1, fs) and hover_field(blob, rec_start, i, 2, fe) and hover_field(blob, rec_start, i, 3, fn) and hover_field(blob, rec_start, i, 4, fk) and hover_field(blob, rec_start, i, 5, fo) and hover_field(blob, rec_start, i, 6, fb):
                    if hover_parse_i64(fs) == start and hover_parse_i64(fe) == finish and string_views_eq(fn, name) != 0:
                        owner_out <- hover_parse_i64(fo)
                        serial_out <- hover_parse_i64(fb)
                        return hover_parse_i64(fk)
            rec_start <- i + 1
        i <- i + 1
    return -1


# Resolve an explicit annotation by the exact resolver identity. Repeated rows
# for one binding are treated as invalid cache data instead of selected by name.
def hover_binding_type_hex(blob: sview, owner: i64, serial: i64, out: mutable sview&) -> bool:
    rec_start: mutable usize = 0
    i: mutable usize = 0
    n: usize = blob.len.usize()
    matches: mutable usize = 0
    found: mutable sview = sview("", 0, 0)
    while i <= n:
        if i == n or sview_at(blob, i) == HOVER_REC:
            if i > rec_start and sview_at(blob, rec_start) == HOVER_TYPE_BINDING:
                fo: mutable sview = sview("", 0, 0)
                fb: mutable sview = sview("", 0, 0)
                ft: mutable sview = sview("", 0, 0)
                if hover_field(blob, rec_start, i, 1, fo) and hover_field(blob, rec_start, i, 2, fb) and hover_field(blob, rec_start, i, 5, ft):
                    if hover_parse_i64(fo) == owner and hover_parse_i64(fb) == serial:
                        matches <- matches + 1
                        found <- ft
            rec_start <- i + 1
        i <- i + 1
    return false if matches != 1 or found.len == 0
    out <- found
    return true


# Resolve one spelling in a single pass over the retained record stream.
# Results: 0 = unknown, 1 = unique declaration, 2 = unique enum variant,
# 3 = overloaded, repeated, or cross-category ambiguous.
def hover_name_info(blob: sview, name: sview, cat_out: mutable sview&, ret_out: mutable sview&, owner_out: mutable sview&, declaration_id_out: mutable i64&) -> i64:
    rec_start: mutable usize = 0
    i: mutable usize = 0
    n: usize = blob.len.usize()
    symbol_matches: mutable i64 = 0
    variant_matches: mutable i64 = 0
    found_category: mutable sview = sview("", 0, 0)
    found_return: mutable sview = sview("", 0, 0)
    found_owner: mutable sview = sview("", 0, 0)
    found_declaration_id: mutable i64 = -1
    while i <= n:
        if i == n or sview_at(blob, i) == HOVER_REC:
            if i > rec_start and sview_at(blob, rec_start) == 115:
                fn: mutable sview = sview("", 0, 0)
                fc: mutable sview = sview("", 0, 0)
                fr: mutable sview = sview("", 0, 0)
                declaration_id_text: mutable sview = sview("", 0, 0)
                if hover_field(blob, rec_start, i, 1, fn) and hover_field(blob, rec_start, i, 2, fc) and hover_field(blob, rec_start, i, 4, fr) and hover_field(blob, rec_start, i, 6, declaration_id_text):
                    if string_views_eq(fn, name) != 0:
                        symbol_matches <- symbol_matches + 1
                        found_category <- fc
                        found_return <- fr
                        found_declaration_id <- hover_parse_i64(declaration_id_text)
                        return 3 if symbol_matches > 1
            elif i > rec_start and sview_at(blob, rec_start) == 118:
                owner: mutable sview = sview("", 0, 0)
                variant: mutable sview = sview("", 0, 0)
                if hover_field(blob, rec_start, i, 1, owner) and hover_field(blob, rec_start, i, 2, variant):
                    if string_views_eq(variant, name) != 0:
                        variant_matches <- variant_matches + 1
                        found_owner <- owner
                        return 3 if variant_matches > 1
            rec_start <- i + 1
        i <- i + 1
    return 3 if symbol_matches > 0 and variant_matches > 0
    if variant_matches == 1:
        owner_out <- found_owner
        return 2
    if symbol_matches == 1:
        cat_out <- found_category
        ret_out <- found_return
        declaration_id_out <- found_declaration_id
        return 1
    return 0


def hover_decode_signature_hex(encoded: sview, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if encoded.len == 0 or encoded.len.usize() % 2 != 0 or encoded.len > 4096
    decoded: mutable darray[u8] = []
    index: mutable usize = 0
    while index < encoded.len.usize():
        high: u8 = sview_at(encoded, index)
        low: u8 = sview_at(encoded, index + 1)
        high_value: mutable i64 = -1
        low_value: mutable i64 = -1
        if high >= 48 and high <= 57:
            high_value <- high.i64() - 48
        elif high >= 97 and high <= 102:
            high_value <- high.i64() - 87
        if low >= 48 and low <= 57:
            low_value <- low.i64() - 48
        elif low >= 97 and low <= 102:
            low_value <- low.i64() - 87
        return false if high_value < 0 or low_value < 0
        decoded.push(((high_value << 4) | low_value).u8())
        index <- index + 2
    return false if decoded.count == 0
    out.extend([byte for byte in decoded])
    return true


def hover_append_signature(value: mutable darray[u8]&, signature: darray[u8], markdown: bool) -> void can[Memory.Allocate, Abort.Panic]:
    if markdown:
        longest_ticks: mutable usize = 0
        run: mutable usize = 0
        for byte in signature:
            if byte == 96:
                run <- run + 1
                longest_ticks <- run if run > longest_ticks
            else:
                run <- 0
        fence: usize = 3 if longest_ticks < 3 else longest_ticks + 1
        for _ in 0..<fence:
            value.push(96)
        push_str(value, "elisa\n")
        value.extend([byte for byte in signature])
        push_str(value, "\n")
        for _ in 0..<fence:
            value.push(96)
    else:
        value.extend([byte for byte in signature])


def hover_is_ident_byte(b: u8) -> bool:
    if b >= 48 and b <= 57:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 97 and b <= 122:
        return true
    return b == 95 or b >= 128


# The identifier at the cursor. Boundary policy: if the byte at the cursor is
# not an identifier byte, the token immediately to its left is selected (so a
# cursor at a token's end still hovers it); if neither side is an identifier,
# returns false. `scol`/`ecol` are negotiated-unit columns of the span.
def hover_ident_at(src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, line0: i64, char_units: i64, utf8: bool, name_out: mutable sview&, scol_out: mutable i64&, ecol_out: mutable i64&, byte_start_out: mutable i64&, byte_end_out: mutable i64&) -> bool can[Abort.Panic]:
    lstart: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, line0)
    llen: i64 = Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, line0)
    bcol: i64 = Positions::char_to_byte_col_span_indexed(src, src_len, line_starts, span_start, span_count, line0, char_units, utf8)
    s: mutable i64 = bcol
    if s >= llen or not hover_is_ident_byte(src[lstart + s.usize()]):
        if s > 0 and hover_is_ident_byte(src[lstart + (s - 1).usize()]):
            s <- s - 1
        else:
            return false
    e: mutable i64 = s
    while e < llen and hover_is_ident_byte(src[lstart + e.usize()]):
        e <- e + 1
    st: mutable i64 = s
    while st > 0 and hover_is_ident_byte(src[lstart + (st - 1).usize()]):
        st <- st - 1
    name_out <- string_view_slice(Positions::source_view_span(src, src_len, 0, src_len), (lstart.i64() + st), (lstart.i64() + e))
    scol_out <- Positions::byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, line0, st, utf8)
    ecol_out <- Positions::byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, line0, e, utf8)
    byte_start_out <- (lstart + st.usize()).i64()
    byte_end_out <- (lstart + e.usize()).i64()
    return true


def hover_label_from(cat: sview, name: sview, ret: sview) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[u8] = []
        if string_view_eq(cat, "fn") == 1:
            push_str(out, "def ")
            hover_push(out, name)
            if ret.len > 0:
                push_str(out, " -> ")
                hover_push(out, ret)
        elif string_view_eq(cat, "struct") == 1:
            push_str(out, "struct ")
            hover_push(out, name)
        elif string_view_eq(cat, "enum") == 1:
            push_str(out, "enum ")
            hover_push(out, name)
        elif string_view_eq(cat, "alias") == 1:
            push_str(out, "alias ")
            hover_push(out, name)
        elif string_view_eq(cat, "const") == 1:
            push_str(out, "const ")
            hover_push(out, name)
        elif string_view_eq(cat, "module") == 1:
            push_str(out, "module ")
            hover_push(out, name)
        elif string_view_eq(cat, "law") == 1:
            push_str(out, "law ")
            hover_push(out, name)
        return out


# Returns the full hover result body, or empty when nothing resolves.
def general_hover_body(document: DocumentSnapshotView, storage: darray[u8]&, source_start: usize, document_line_starts: darray[usize]&, span_start: usize, span_count: usize, hover_start: usize, signature_start: usize, line_no: i64, char_no: i64, markdown: bool, utf8: bool) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        if document.caches.hover_len == 0 or line_no < 0 or char_no < 0:
            return []
        src: u8& = &storage[source_start]
        src_len: usize = document.source.text_len - 1
        name: mutable sview = sview("", 0, 0)
        scol: mutable i64 = 0
        ecol: mutable i64 = 0
        byte_start: mutable i64 = 0
        byte_end: mutable i64 = 0
        if not hover_ident_at(src, src_len, document_line_starts, span_start, span_count, line_no, char_no, utf8, name, scol, ecol, byte_start, byte_end):
            return []
        if hover_start > storage.count:
            return []
        if document.caches.hover_len > storage.count - hover_start:
            return []
        blob: sview = bytes_view_range_ref(storage, hover_start, document.caches.hover_len)
        signature_blob: mutable sview = sview("", 0, 0)
        if document.caches.signature_len > 0:
            if signature_start > storage.count or document.caches.signature_len > storage.count - signature_start:
                return []
            signature_blob <- bytes_view_range_ref(storage, signature_start, document.caches.signature_len)
        value: mutable darray[u8] = []
        binding_owner: mutable i64 = -1
        binding_serial: mutable i64 = -1
        occ: i64 = hover_occ_kind(blob, byte_start, byte_end, name, binding_owner, binding_serial)
        if occ == OCC_PARAM:
            push_str(value, "(parameter) ")
            hover_push(value, name)
            type_hex: mutable sview = sview("", 0, 0)
            declared_type: mutable darray[u8] = []
            if hover_binding_type_hex(blob, binding_owner, binding_serial, type_hex) and hover_decode_signature_hex(type_hex, declared_type):
                push_str(value, ": ")
                value.extend([byte for byte in declared_type])
        elif occ == OCC_LOCAL:
            push_str(value, "(local) ")
            hover_push(value, name)
            type_hex: mutable sview = sview("", 0, 0)
            declared_type: mutable darray[u8] = []
            if hover_binding_type_hex(blob, binding_owner, binding_serial, type_hex) and hover_decode_signature_hex(type_hex, declared_type):
                push_str(value, ": ")
                value.extend([byte for byte in declared_type])
        else:
            cat: mutable sview = sview("", 0, 0)
            ret: mutable sview = sview("", 0, 0)
            owner: mutable sview = sview("", 0, 0)
            declaration_id: mutable i64 = -1
            info_kind: i64 = hover_name_info(blob, name, cat, ret, owner, declaration_id)
            if info_kind == 3:
                return []
            if info_kind == 2:
                push_str(value, "enum ")
                hover_push(value, owner)
                push_str(value, ".")
                hover_push(value, name)
            elif info_kind == 1:
                signature_hex: mutable sview = sview("", 0, 0)
                signature_bytes: mutable darray[u8] = []
                has_signature: bool = string_view_eq(cat, "fn") == 1 and signature_source_hex_for_row(signature_blob, declaration_id, signature_hex) and hover_decode_signature_hex(signature_hex, signature_bytes)
                if has_signature:
                    hover_append_signature(value, signature_bytes, markdown)
                else:
                    value <- hover_label_from(cat, name, ret)
        if value.count == 0:
            return []
        body: mutable darray[u8] = []
        push_str(body, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"") if markdown
        push_str(body, "{\"contents\":{\"kind\":\"plaintext\",\"value\":\"") if not markdown
        json_escape_utf8(body, bytes_view_range_ref(value, 0, value.count))
        push_str(body, "\"},\"range\":")
        hover_push_range(body, line_no, scol, ecol)
        push_str(body, "}")
        return body
