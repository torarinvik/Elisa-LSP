# Selection ranges (E04 v2): nested word -> line -> enclosing block(s) ->
# document, for every requested position, with a strict containment invariant.
#
# Derivation is purely syntactic (indentation), so it needs no symbol identity:
# - innermost: the identifier/word under the cursor (a cursor at a token's end
#   selects that token);
# - then the full line;
# - then each enclosing indentation block, innermost first (a block header is
#   the nearest preceding less-indented line; blank lines are transparent);
# - outermost: the whole document.
# `parent` links child -> parent per LSP; ranges use 0-based lines and
# negotiated-unit characters (UTF-16 by default) via the shared Positions layer.

def sel_is_word_byte(b: u8) -> bool:
    if b >= 48 and b <= 57:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 97 and b <= 122:
        return true
    return b == 95 or b >= 128


def sel_push_range(body: mutable darray[u8]&, sline: i64, scol: i64, eline: i64, ecol: i64) -> void can[Memory.Allocate, Abort.Panic]:
    body.push_str("{\"start\":{\"line\":")
    body.push_int(sline)
    body.push_str(",\"character\":")
    body.push_int(scol)
    body.push_str("},\"end\":{\"line\":")
    body.push_int(eline)
    body.push_str(",\"character\":")
    body.push_int(ecol)
    # Close the end object AND the enclosing range object.
    body.push_str("}}")


# Word span at the cursor as 0-based byte columns; false in whitespace.
def sel_word_span(src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, line0: i64, char_units: i64, utf8: bool, sbyte_out: mutable i64&, ebyte_out: mutable i64&) -> bool can[Abort.Panic]:
    lstart: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, line0)
    llen: i64 = Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, line0)
    bcol: i64 = Positions::char_to_byte_col_span_indexed(src, src_len, line_starts, span_start, span_count, line0, char_units, utf8)
    s: mutable i64 = bcol
    if s >= llen or not sel_is_word_byte(src[lstart + s.usize()]):
        if s > 0 and sel_is_word_byte(src[lstart + (s - 1).usize()]):
            s <- s - 1
        else:
            return false
    e: mutable i64 = s
    while e < llen and sel_is_word_byte(src[lstart + e.usize()]):
        e <- e + 1
    st: mutable i64 = s
    while st > 0 and sel_is_word_byte(src[lstart + (st - 1).usize()]):
        st <- st - 1
    sbyte_out <- st
    ebyte_out <- e
    return true


# Last line of the block opened at `header` (inclusive): the last more-indented
# line before an equal-or-less-indented line.
def sel_block_end(indent: darray[i64]&, nlines: i64, header: i64) -> i64:
    hi: i64 = indent[header.usize()]
    end: mutable i64 = header
    j: mutable i64 = header + 1
    while j < nlines:
        ij: i64 = indent[j.usize()]
        if ij >= 0:
            break if ij <= hi
            end <- j
        j <- j + 1
    return end


def sel_range_at(body: mutable darray[u8]&, r_s: darray[i64]&, r_sc: darray[i64]&, r_e: darray[i64]&, r_ec: darray[i64]&, k: usize) -> void can[Memory.Allocate, Abort.Panic]:
    sel_push_range(body, r_s[k], r_sc[k], r_e[k], r_ec[k])


def sel_emit_position(out: mutable darray[u8]&, src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, indent: darray[i64]&, nlines: i64, last_line: i64, line0: i64, char_units: i64, utf8: bool) -> void can[Memory.Allocate, Abort.Panic]:
    # Collect ranges innermost -> outermost, then build the LSP chain from the
    # outside in: each object's `range` is a level and its `parent` is larger.
    r_s: mutable darray[i64] = []
    r_sc: mutable darray[i64] = []
    r_e: mutable darray[i64] = []
    r_ec: mutable darray[i64] = []
    sbyte: mutable i64 = 0
    ebyte: mutable i64 = 0
    wfound: bool = sel_word_span(src, src_len, line_starts, span_start, span_count, line0, char_units, utf8, sbyte, ebyte)
    if wfound:
        r_s.push(line0)
        r_sc.push(Positions::byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, line0, sbyte, utf8))
        r_e.push(line0)
        r_ec.push(Positions::byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, line0, ebyte, utf8))
    else:
        r_s.push(line0)
        r_sc.push(0)
        r_e.push(line0)
        r_ec.push(0)
    # Line.
    r_s.push(line0)
    r_sc.push(0)
    r_e.push(line0)
    r_ec.push(Positions::line_unit_length_span_indexed(src, src_len, line_starts, span_start, span_count, line0, utf8))
    # Enclosing blocks, innermost first.
    threshold: mutable i64 = indent[line0.usize()]
    j: mutable i64 = line0 - 1
    while j >= 0:
        ij: i64 = indent[j.usize()]
        if ij >= 0 and ij < threshold:
            bend: i64 = sel_block_end(indent, nlines, j)
            r_s.push(j)
            r_sc.push(0)
            r_e.push(bend)
            r_ec.push(Positions::line_unit_length_span_indexed(src, src_len, line_starts, span_start, span_count, bend, utf8))
            threshold <- ij
        j <- j - 1
    # Document.
    r_s.push(0)
    r_sc.push(0)
    r_e.push(last_line)
    r_ec.push(Positions::line_unit_length_span_indexed(src, src_len, line_starts, span_start, span_count, last_line, utf8))
    # Build from the outermost inward: start at the document, wrap each smaller
    # range as a new object whose parent is the accumulated one.
    obj: mutable darray[u8] = []
    last: usize = r_s.count - 1
    obj.push_str("{\"range\":")
    sel_range_at(obj, r_s, r_sc, r_e, r_ec, last)
    obj.push_str("}")
    k: mutable i64 = last.i64() - 1
    while k >= 0:
        wrap: mutable darray[u8] = []
        wrap.push_str("{\"range\":")
        sel_range_at(wrap, r_s, r_sc, r_e, r_ec, k.usize())
        wrap.push_str(",\"parent\":")
        wrap.extend([b for b in obj])
        wrap.push_str("}")
        obj.truncate(0)
        obj.extend([b for b in wrap])
        k <- k - 1
    out.extend([b for b in obj])


def build_selection_body_indexed(src: u8&, src_len: usize, utf8: bool, positions: darray[Json::Value], line_starts: darray[usize]&, span_start: usize, span_count: usize) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        nlines: i64 = span_count.i64()
        last_line: i64 = nlines - 1
        # Every result must correspond to the position at the same array
        # index and contain that position. LSP specifies clamping for a
        # character beyond a valid line, but a line beyond the document has
        # no such fallback; return null for the request rather than fabricate
        # a range at EOF that does not contain the requested position.
        i: mutable usize = 0
        while i < positions.count:
            line_v: mutable i64 = -1
            if Json::get(positions[i], "line") is lv:
                line_v <- Json::as_lsp_uinteger_or_invalid(lv)
            if line_v < 0 or line_v >= nlines:
                empty_result: mutable darray[u8] = []
                empty_result.push_str("null")
                return empty_result
            i <- i + 1
        # Per-line indentation (-1 = blank); computed once for all positions.
        indent: mutable darray[i64] = []
        line: mutable i64 = 0
        while line < nlines:
            start: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, line)
            cend: usize = start + Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, line).usize()
            k: mutable usize = start
            ind: mutable i64 = 0
            while k < cend and (src[k] == 32 or src[k] == 9):
                ind <- ind + 1
                k <- k + 1
            indent.push(-1 if k >= cend else ind)
            line <- line + 1
        body: mutable darray[u8] = []
        body.push_str("[")
        i <- 0
        while i < positions.count:
            body.push_str(",") if i > 0
            line_v: mutable i64 = -1
            char_v: mutable i64 = 0
            if Json::get(positions[i], "line") is lv:
                line_v <- Json::as_lsp_uinteger_or_invalid(lv)
            if Json::get(positions[i], "character") is cv:
                char_v <- Json::as_lsp_uinteger_or_invalid(cv)
            char_v <- 0 if char_v < 0
            sel_emit_position(body, src, src_len, line_starts, span_start, span_count, indent, nlines, last_line, line_v, char_v, utf8)
            i <- i + 1
        body.push_str("]")
        return body


def handle_selection_range(root: Json::Value, snapshot: DocumentSnapshotView, document_storage: darray[u8]&, document_line_starts: darray[usize]&, result_body: mutable darray[u8]&, utf8: bool) -> ProviderOutcome can[Memory.Allocate, Abort.Panic]:
    if not snapshot.valid:
        return ProviderOutcome.NoMatchEmptyArray
    document: DocumentSnapshotView = snapshot
    source_start: mutable usize = document.source.text_start
    if source_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len == 0 or document.source.text_len > document_storage.count - source_start:
        return ProviderOutcome.InvalidRetainedCache
    if document.caches.line_index_count > 0:
        if document.caches.line_index_start > document_line_starts.count:
            return ProviderOutcome.InvalidRetainedCache
        if document.caches.line_index_count > document_line_starts.count - document.caches.line_index_start:
            return ProviderOutcome.InvalidRetainedCache
    src: u8& = &document_storage[source_start]
    empty: darray[Json::Value] = []
    positions: mutable darray[Json::Value] = empty
    if Json::get(root, "params") is params:
        if Json::get(params, "positions") is pv:
            match pv:
                Json::Value.Arr(items):
                    positions <- items
                _:
                    pass
    src_len: usize = document.source.text_len - 1
    result: mutable darray[u8] = []
    if document.caches.line_index_count > 0:
        result <- build_selection_body_indexed(src, src_len, utf8, positions, document_line_starts, document.caches.line_index_start, document.caches.line_index_count)
    else:
        fallback_starts: darray[usize] = Positions::build_line_starts(src, src_len)
        lsp_line_index_fallback_build_calls <- lsp_line_index_fallback_build_calls + 1
        result <- build_selection_body_indexed(src, src_len, utf8, positions, &fallback_starts, 0, fallback_starts.count)
    result_body.extend(result)
    return ProviderOutcome.Result
