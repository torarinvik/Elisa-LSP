# Semantic tokens (lexical layer): full-file token classification served from
# the REAL frontend lexer — the same single source of truth as diagnostics.
#
# Token types follow docs/highlight-taxonomy.md: the legend order below is the
# wire index and MUST stay in lockstep with the client palette (the JetBrains
# plugin maps these names to the OKLCH-derived colors in the same doc).
# This layer classifies what the token stream alone can know ([L] leaves);
# the [S] leaves (binding kinds, user types, def/use from the symbol table)
# arrive in a later pass and will override these client-side.

# Legend index constants (wire protocol — order is meaning).
const ST_TYPE_INT_SIGNED: i64 = 0
const ST_TYPE_INT_UNSIGNED: i64 = 1
const ST_TYPE_FLOAT: i64 = 2
const ST_TYPE_SCALAR: i64 = 3
const ST_TYPE_STRING: i64 = 4
const ST_TYPE_CONTAINER: i64 = 5
const ST_TYPE_USER: i64 = 6
const ST_TYPE_VOID: i64 = 7
const ST_LIT_INT: i64 = 8
const ST_LIT_FLOAT: i64 = 9
const ST_LIT_CHAR: i64 = 10
const ST_LIT_STRING: i64 = 11
const ST_LIT_VALUE: i64 = 12
const ST_FN_DEF: i64 = 13
const ST_FN_USE: i64 = 14
const ST_FN_LAMBDA: i64 = 15
const ST_BIND_PARAM: i64 = 16
const ST_BIND_LOCAL: i64 = 17
const ST_BIND_FIELD: i64 = 18
const ST_BIND_GLOBAL: i64 = 19
const ST_BIND_DISCARD: i64 = 20
const ST_EFFECT_GRANT: i64 = 21
const ST_EFFECT_NAME: i64 = 22
const ST_EFFECT_UNSAFE: i64 = 23
const ST_EFFECT_ERROR: i64 = 24
const ST_MEM_REGION: i64 = 25
const ST_MEM_QUALIFIER: i64 = 26
const ST_FLOW_BRANCH: i64 = 27
const ST_FLOW_ERROR: i64 = 28
const ST_FLOW_CONCURRENT: i64 = 29
const ST_DECL_SKELETON: i64 = 30
const ST_CONTRACT_CLAUSE: i64 = 31
const ST_CONTRACT_QUANTIFIER: i64 = 32
const ST_CONTRACT_GHOST: i64 = 33
const ST_OP_MUTATION: i64 = 34
const ST_OP_LAMBDA: i64 = 35
const ST_OP_RANGE: i64 = 36
const ST_META_DECORATOR: i64 = 37
const ST_META_DIRECTIVE: i64 = 38
const ST_META_MODULE: i64 = 39
# Filling out the "universe": operators, punctuation, and comments so that
# every visible token carries a color and color distance mirrors semantic
# distance (docs/highlight-taxonomy.md §10/§11). Appended to keep existing
# wire indices stable.
const ST_COMMENT: i64 = 40
const ST_PUNCTUATION: i64 = 41
const ST_OP_ARITHMETIC: i64 = 42
const ST_OP_COMPARISON: i64 = 43
const ST_OP_LOGICAL: i64 = 44
const ST_OP_BITWISE: i64 = 45
const ST_OP_ASSIGN: i64 = 46
# Enum variants are appended so existing semantic-token wire indices remain stable.
const ST_ENUM_VARIANT: i64 = 47

# Standard semantic-token modifiers are a second, independent legend. The
# cached analysis uses this canonical bit order; a session profile remaps the
# bits to the subset/order negotiated from the client's capability list.
# Keep the values explicit because the source language does not have a
# portable compile-time bit-shift expression in every supported compiler.
const ST_MOD_DECLARATION: i64 = 1
const ST_MOD_DEFINITION: i64 = 2
const ST_MOD_READONLY: i64 = 4
const ST_MOD_MODIFICATION: i64 = 8
const ST_MODIFIER_MASK: i64 = 15
const SEMTOK_MODIFIER_COUNT: i64 = 4

# The legend, embedded in the initialize capabilities. Names mirror the
# taxonomy leaves; the client palette keys off these exact strings.
def semtok_legend_json() -> cstr:
    return "[\"elisa.type.int.signed\",\"elisa.type.int.unsigned\",\"elisa.type.float\",\"elisa.type.scalar\",\"elisa.type.string\",\"elisa.type.container\",\"elisa.type.user\",\"elisa.type.void\",\"elisa.lit.int\",\"elisa.lit.float\",\"elisa.lit.char\",\"elisa.lit.string\",\"elisa.lit.value\",\"elisa.fn.def\",\"elisa.fn.use\",\"elisa.fn.lambda\",\"elisa.bind.param\",\"elisa.bind.local\",\"elisa.bind.field\",\"elisa.bind.global\",\"elisa.bind.discard\",\"elisa.effect.grant\",\"elisa.effect.name\",\"elisa.effect.unsafe\",\"elisa.effect.error\",\"elisa.mem.region\",\"elisa.mem.qualifier\",\"elisa.flow.branch\",\"elisa.flow.error\",\"elisa.flow.concurrent\",\"elisa.decl.skeleton\",\"elisa.contract.clause\",\"elisa.contract.quantifier\",\"elisa.contract.ghost\",\"elisa.op.mutation\",\"elisa.op.lambda\",\"elisa.op.range\",\"elisa.meta.decorator\",\"elisa.meta.directive\",\"elisa.meta.module\",\"elisa.comment\",\"elisa.punctuation\",\"elisa.op.arithmetic\",\"elisa.op.comparison\",\"elisa.op.logical\",\"elisa.op.bitwise\",\"elisa.op.assign\",\"elisa.enum.variant\"]"


# The cache always stores these stable custom indices. A session profile maps
# each cached index either to a position in its advertised legend or to -1
# when the client's partial standard-token set cannot represent that category.
struct SemTokProfile:
    legend_json: mutable darray[u8]
    type_map: mutable darray[i64]
    custom: mutable bool
    # JSON legend and stable-index -> negotiated-index map for modifiers.
    # `modifier_map[i] == -1` means that the client did not advertise the
    # canonical modifier at index i, so that bit is dropped at the wire edge.
    modifier_json: mutable darray[u8]
    modifier_map: mutable darray[i64]


const SEMTOK_CUSTOM_TYPE_COUNT: i64 = 48
const SEMTOK_STANDARD_FALLBACK_COUNT: i64 = 15
const SEMTOK_MAX_CLIENT_TOKEN_TYPES: i64 = 256
const SEMTOK_MAX_CLIENT_TOKEN_MODIFIERS: i64 = 256


def semtok_modifier_bit(index: i64) -> i64:
    return when index:
        0 -> ST_MOD_DECLARATION
        1 -> ST_MOD_DEFINITION
        2 -> ST_MOD_READONLY
        3 -> ST_MOD_MODIFICATION
        _ -> 0


def semtok_modifier_name(index: i64) -> cstr:
    return when index:
        0 -> "declaration"
        1 -> "definition"
        2 -> "readonly"
        3 -> "modification"
        _ -> ""


# Re-encode the canonical cache bitset into the negotiated legend's bitset.
# Unknown cache bits are intentionally ignored; the worker validator rejects
# them before a cache can be published, and this mask keeps the protocol edge
# defensive if an old cache is encountered during an upgrade.
def semtok_remap_modifier_bits(modifiers: i64, modifier_map: darray[i64]) -> i64:
    mapped: mutable i64 = 0
    for index in 0..<SEMTOK_MODIFIER_COUNT:
        source_bit: i64 = semtok_modifier_bit(index)
        if source_bit != 0 and (modifiers & source_bit) != 0 and index < modifier_map.count.i64():
            target_index: i64 = modifier_map[index.usize()]
            target_bit: i64 = semtok_modifier_bit(target_index)
            mapped <- mapped | target_bit if target_bit != 0
    return mapped


def semtok_modifier_map_is_identity(modifier_map: darray[i64]) -> bool:
    return false if modifier_map.count.i64() != SEMTOK_MODIFIER_COUNT
    for index in 0..<SEMTOK_MODIFIER_COUNT:
        return false if modifier_map[index.usize()] != index
    return true


def semtok_custom_type_name(index: i64) -> cstr:
    return when index:
        0 -> "elisa.type.int.signed"
        1 -> "elisa.type.int.unsigned"
        2 -> "elisa.type.float"
        3 -> "elisa.type.scalar"
        4 -> "elisa.type.string"
        5 -> "elisa.type.container"
        6 -> "elisa.type.user"
        7 -> "elisa.type.void"
        8 -> "elisa.lit.int"
        9 -> "elisa.lit.float"
        10 -> "elisa.lit.char"
        11 -> "elisa.lit.string"
        12 -> "elisa.lit.value"
        13 -> "elisa.fn.def"
        14 -> "elisa.fn.use"
        15 -> "elisa.fn.lambda"
        16 -> "elisa.bind.param"
        17 -> "elisa.bind.local"
        18 -> "elisa.bind.field"
        19 -> "elisa.bind.global"
        20 -> "elisa.bind.discard"
        21 -> "elisa.effect.grant"
        22 -> "elisa.effect.name"
        23 -> "elisa.effect.unsafe"
        24 -> "elisa.effect.error"
        25 -> "elisa.mem.region"
        26 -> "elisa.mem.qualifier"
        27 -> "elisa.flow.branch"
        28 -> "elisa.flow.error"
        29 -> "elisa.flow.concurrent"
        30 -> "elisa.decl.skeleton"
        31 -> "elisa.contract.clause"
        32 -> "elisa.contract.quantifier"
        33 -> "elisa.contract.ghost"
        34 -> "elisa.op.mutation"
        35 -> "elisa.op.lambda"
        36 -> "elisa.op.range"
        37 -> "elisa.meta.decorator"
        38 -> "elisa.meta.directive"
        39 -> "elisa.meta.module"
        40 -> "elisa.comment"
        41 -> "elisa.punctuation"
        42 -> "elisa.op.arithmetic"
        43 -> "elisa.op.comparison"
        44 -> "elisa.op.logical"
        45 -> "elisa.op.bitwise"
        46 -> "elisa.op.assign"
        47 -> "elisa.enum.variant"
        _ -> ""


# Standard fallback order follows the first occurrence of each mapped category
# in docs/semantic-token-schema.json. The mapping itself is kept in
# semtok_fallback_category below and checked against that manifest in tests.
def semtok_standard_type_name(category: i64) -> cstr:
    return when category:
        0 -> "type"
        1 -> "number"
        2 -> "string"
        3 -> "keyword"
        4 -> "function"
        5 -> "parameter"
        6 -> "variable"
        7 -> "property"
        8 -> "macro"
        9 -> "modifier"
        10 -> "comment"
        11 -> "operator"
        12 -> "decorator"
        13 -> "namespace"
        14 -> "enumMember"
        _ -> ""


# Values mirror docs/semantic-token-schema.json's standard_fallback mapping.
def semtok_fallback_category(index: i64) -> i64:
    return when index:
        0..=7 -> 0
        8..=9 -> 1
        10..=11 -> 2
        12 -> 3
        13..=14 -> 4
        15 -> 3
        16 -> 5
        17 -> 6
        18 -> 7
        19..=20 -> 6
        21 -> 3
        22 -> 0
        23 -> 8
        24..=25 -> 3
        26 -> 9
        27..=30 -> 3
        31 -> 10
        32 -> 3
        33 -> 10
        34..=36 -> 11
        37 -> 12
        38 -> 8
        39 -> 13
        40 -> 10
        41..=46 -> 11
        47 -> 14
        _ -> -1


def semtok_default_profile() -> SemTokProfile can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        legend: mutable darray[u8] = []
        push_str(legend, semtok_legend_json())
        mapping: mutable darray[i64] = []
        for index in 0..<SEMTOK_CUSTOM_TYPE_COUNT:
            mapping.push(index)
        # Modifier negotiation is filled in by semtok_profile_with_modifiers;
        # an empty map is the safe default for clients that omit the semantic
        # token capability or its tokenModifiers list.
        modifier_json: mutable darray[u8] = []
        push_str(modifier_json, "[]")
        modifier_map: mutable darray[i64] = []
        for index in 0..<SEMTOK_MODIFIER_COUNT:
            modifier_map.push(-1)
        return SemTokProfile{legend_json: legend, type_map: mapping, custom: true, modifier_json: modifier_json, modifier_map: modifier_map}


# Build the modifier legend in canonical order from the client's advertised
# list. LSP clients may list supported modifiers in any order; the server
# chooses one stable order and remaps cached canonical bits to it. If the
# semantic-token capability is absent, no modifiers are emitted, preserving
# compatibility with legacy clients that only know the original 5-field data
# shape.
def semtok_profile_with_modifiers(profile: SemTokProfile, root: Json::Value) -> SemTokProfile can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        modifier_json: mutable darray[u8] = []
        push_str(modifier_json, "[")
        modifier_map: mutable darray[i64] = []
        for index in 0..<SEMTOK_MODIFIER_COUNT:
            modifier_map.push(-1)
        semantic_present: mutable bool = false
        offered: mutable darray[i64] = []
        for index in 0..<SEMTOK_MODIFIER_COUNT:
            offered.push(0)
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "semanticTokens") is semantic:
                        semantic_present <- true
                        if Json::get(semantic, "tokenModifiers") is token_modifiers:
                            match token_modifiers:
                                Json::Value.Arr(items):
                                    for item in items:
                                        for index in 0..<SEMTOK_MODIFIER_COUNT:
                                            offered[index.usize()] <- 1 if json_string_is(item, semtok_modifier_name(index))
                                _:
                                    pass
        emitted: mutable i64 = 0
        if semantic_present:
            for index in 0..<SEMTOK_MODIFIER_COUNT:
                if offered[index.usize()] == 1:
                    modifier_json.push(44) if emitted > 0
                    modifier_json.push(34)
                    push_str(modifier_json, semtok_modifier_name(index))
                    modifier_json.push(34)
                    modifier_map[index.usize()] <- emitted
                    emitted <- emitted + 1
        modifier_json.push(93)
        return SemTokProfile{legend_json: profile.legend_json, type_map: profile.type_map, custom: profile.custom, modifier_json: modifier_json, modifier_map: modifier_map}


def semtok_has_full_custom_list(items: darray[Json::Value]) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        for expected in 0..<SEMTOK_CUSTOM_TYPE_COUNT:
            found: mutable bool = false
            for item in items:
                found <- true if json_string_is(item, semtok_custom_type_name(expected))
            return false if not found
        return true


# Negotiate one legend for the whole session. Missing textDocument.semanticTokens
# preserves the established custom legend for old clients. An explicitly
# complete custom list also opts into that stable ABI. Every other capability
# receives the supported standard subset from the schema fallback table.
def semtok_negotiate_profile(root: Json::Value) -> SemTokProfile can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "semanticTokens") is semantic:
                        if Json::get(semantic, "tokenTypes") is token_types:
                            match token_types:
                                Json::Value.Arr(items):
                                    return semtok_profile_with_modifiers(semtok_default_profile(), root) if semtok_has_full_custom_list(items)
                                    supported: mutable darray[i64] = []
                                    standard_indices: mutable darray[i64] = []
                                    for category in 0..<SEMTOK_STANDARD_FALLBACK_COUNT:
                                        found: mutable bool = false
                                        for item in items:
                                            found <- true if json_string_is(item, semtok_standard_type_name(category))
                                        supported.push(1 if found else 0)
                                        standard_indices.push(-1)
                                    legend: mutable darray[u8] = []
                                    push_str(legend, "[")
                                    legend_count: mutable i64 = 0
                                    for category in 0..<SEMTOK_STANDARD_FALLBACK_COUNT:
                                        if supported[category.usize()] == 1:
                                            legend.push(44) if legend_count > 0
                                            legend.push(34)
                                            push_str(legend, semtok_standard_type_name(category))
                                            legend.push(34)
                                            standard_indices[category.usize()] <- legend_count
                                            legend_count <- legend_count + 1
                                    push_str(legend, "]")
                                    mapping: mutable darray[i64] = []
                                    for index in 0..<SEMTOK_CUSTOM_TYPE_COUNT:
                                        category: i64 = semtok_fallback_category(index)
                                        mapped: mutable i64 = -1
                                        if category >= 0 and category < standard_indices.count.i64():
                                            mapped <- standard_indices[category.usize()]
                                        mapping.push(mapped)
                                    return semtok_profile_with_modifiers(SemTokProfile{legend_json: legend, type_map: mapping, custom: false, modifier_json: [], modifier_map: []}, root)
                                _:
                                    pass
        return semtok_profile_with_modifiers(semtok_default_profile(), root)


# Detect whether an identifier-shaped `fn(` token begins actual lambda syntax.
# `fn` is also a legal value name, so the following body marker is significant.
def semtok_lambda_intro(tokens: darray[Lexer::Token], index: usize, src: u8&) -> bool:
    # `fn` is also a legal identifier. Treat it as the lambda introducer only
    # when the balanced parameter list is followed by a lambda body marker.
    # Optional return types are skipped with delimiter depth so nested function
    # types and generic annotations do not look like the body boundary.
    return false if index >= tokens.count or tokens[index].kind != Lexer::TokenKind.Ident
    return false if index + 1 >= tokens.count or tokens[index + 1].kind != Lexer::TokenKind.LParen
    return false if tokens[index].length != 2 or src[tokens[index].start.usize()] != 102 or src[tokens[index].start.usize() + 1] != 110
    depth: mutable i64 = 0
    close_index: mutable usize = 0
    found_close: mutable bool = false
    i: mutable usize = index + 1
    while i < tokens.count:
        kind: Lexer::TokenKind = tokens[i].kind
        if kind == Lexer::TokenKind.LParen:
            depth <- depth + 1
        elif kind == Lexer::TokenKind.RParen:
            depth <- depth - 1
            if depth == 0:
                close_index <- i + 1
                found_close <- true
                break
        elif depth == 1 and (kind == Lexer::TokenKind.Newline or kind == Lexer::TokenKind.Eof):
            return false
        i <- i + 1
    return false if not found_close or close_index >= tokens.count
    after_parameters: Lexer::TokenKind = tokens[close_index].kind
    return true if after_parameters == Lexer::TokenKind.FatArrow or after_parameters == Lexer::TokenKind.Colon
    return false if after_parameters != Lexer::TokenKind.Arrow
    delimiter_depth: mutable i64 = 0
    tail_kind: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
    i <- close_index + 1
    while i < tokens.count:
        tail_kind <- tokens[i].kind
        if delimiter_depth == 0 and (tail_kind == Lexer::TokenKind.FatArrow or tail_kind == Lexer::TokenKind.Colon):
            return true
        if delimiter_depth == 0 and (tail_kind == Lexer::TokenKind.Newline or tail_kind == Lexer::TokenKind.Eof):
            return false
        if tail_kind == Lexer::TokenKind.LParen or tail_kind == Lexer::TokenKind.LBracket or tail_kind == Lexer::TokenKind.LBrace:
            delimiter_depth <- delimiter_depth + 1
        elif tail_kind == Lexer::TokenKind.RParen or tail_kind == Lexer::TokenKind.RBracket or tail_kind == Lexer::TokenKind.RBrace:
            delimiter_depth <- delimiter_depth - 1 if delimiter_depth > 0
        i <- i + 1
    return false


# Classify a contextual identifier by its text ([L] approximation: text match
# without scope info — a local named `can` will tint violet; acceptable for
# the lexical layer, corrected later by the [S] pass).
def semtok_ident_class(text: sview) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        # A pure text -> token-class dispatch (docs/125 §6b: a classifier reads as a `when`).
        return when text:
            "int" | "i8" | "i16" | "i32" | "i64" | "isize" -> ST_TYPE_INT_SIGNED
            "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> ST_TYPE_INT_UNSIGNED
            "f32" | "f64" -> ST_TYPE_FLOAT
            "bool" | "char" -> ST_TYPE_SCALAR
            "cstr" | "dstr" | "sview" -> ST_TYPE_STRING
            "darray" | "dict" | "set" | "view" | "array" | "id" -> ST_TYPE_CONTAINER
            "void" -> ST_TYPE_VOID
            "Arena" | "Self" -> ST_TYPE_USER
            "can" | "uses" -> ST_EFFECT_GRANT
            "trusted" | "Unsafe" -> ST_EFFECT_UNSAFE
            "raises" -> ST_EFFECT_ERROR
            "region" | "destroy" | "perm" | "owner" -> ST_MEM_REGION
            "move" -> ST_MEM_QUALIFIER
            "for" | "defer" | "guard" | "do" | "get" | "rebind" -> ST_FLOW_BRANCH
            "parallel" | "nursery" | "pool" | "submit" | "await" | "wait" | "lock" | "spawn_daemon" -> ST_FLOW_CONCURRENT
            "module" | "extend" | "using" | "include" | "public" | "private" -> ST_DECL_SKELETON
            "type" | "alias" | "law" | "permission" | "effect" | "protocol" | "impl" -> ST_DECL_SKELETON
            "affine" | "linear" | "layout" | "common" | "of" | "at" -> ST_DECL_SKELETON
            "requires" | "ensure" | "ensures" | "invariant" | "decreases" | "changes" | "preserves" | "fulfills" -> ST_CONTRACT_CLAUSE
            "forall" | "exists" | "where" -> ST_CONTRACT_QUANTIFIER
            "ghost" | "lemma" -> ST_CONTRACT_GHOST
            "fn" | "λ" | "Λ" | "ƛ" -> ST_FN_LAMBDA
            "generate" | "emit" -> ST_META_DIRECTIVE
            "_" -> ST_BIND_DISCARD
            _ -> -1


# [S] layer: map a name to the token type implied by its top-level declaration
# (Struct/Enum/Alias→type.user, Func/Extern→fn.use, Const→global, Module→module,
# Law→decl). -1 = no match. Declaration lookup goes through the frontend adapter.
def symbol_ttype_index(table: Semantic::SymbolTable&, idx: i64) -> i64:
    return -1 if idx < 0 or idx.usize() >= symbol_count(table)
    k: i64 = symbol_category(table, idx.usize())
    return ST_FN_USE if k == SYMBOL_KIND_FUNCTION or k == SYMBOL_KIND_EXTERN
    return ST_TYPE_USER if k == SYMBOL_KIND_STRUCT or k == SYMBOL_KIND_ENUM or k == SYMBOL_KIND_ALIAS
    return ST_BIND_GLOBAL if k == SYMBOL_KIND_CONST
    return ST_META_MODULE if k == SYMBOL_KIND_MODULE or k == SYMBOL_KIND_IMPORT
    return ST_DECL_SKELETON if k == SYMBOL_KIND_LAW
    return -1


def symbol_ttype(table: Semantic::SymbolTable&, name_heads: dict[u64, i64]&, sym_next: darray[i64]&, name: sview) -> i64:
    idx: i64 = symbol_index_of_indexed(table, name_heads, sym_next, name)
    return symbol_ttype_index(table, idx)


# Resolve a param/local occurrence through the adapter's exact source-span index.
def occurrence_ttype(table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], position_heads: dict[i64, i64]&, ref_next: darray[i64]&, token: Lexer::Token, name: sview, allow_fstring_scope_fallback: bool, src: u8&, src_len: usize) -> i64:
    occ: i64 = occurrence_kind_indexed(table, occurrence_positions, position_heads, ref_next, token.start, name)
    return frontend_fstring_occurrence_kind(table, occurrence_positions, src, src_len, token.start, name) if occ == OCC_UNKNOWN and allow_fstring_scope_fallback
    if occ == OCC_PARAM:
        return 1
    if occ == OCC_LOCAL:
        return 2
    return -1


def semtok_expression_can_end(kind: Lexer::TokenKind) -> bool:
    match kind:
        Lexer::TokenKind.Ident | Lexer::TokenKind.IntLit | Lexer::TokenKind.HexLit | Lexer::TokenKind.FloatLit | Lexer::TokenKind.StringLit | Lexer::TokenKind.CharLit | Lexer::TokenKind.FString:
            return true
        Lexer::TokenKind.True | Lexer::TokenKind.False | Lexer::TokenKind.Null | Lexer::TokenKind.Zeroed | Lexer::TokenKind.RParen | Lexer::TokenKind.RBracket | Lexer::TokenKind.RBrace:
            return true
        _:
            return false


def semtok_expression_can_start(kind: Lexer::TokenKind) -> bool:
    match kind:
        Lexer::TokenKind.Ident | Lexer::TokenKind.IntLit | Lexer::TokenKind.HexLit | Lexer::TokenKind.FloatLit | Lexer::TokenKind.StringLit | Lexer::TokenKind.CharLit | Lexer::TokenKind.FString:
            return true
        Lexer::TokenKind.True | Lexer::TokenKind.False | Lexer::TokenKind.Null | Lexer::TokenKind.Zeroed | Lexer::TokenKind.New | Lexer::TokenKind.LParen | Lexer::TokenKind.LBrace:
            return true
        Lexer::TokenKind.Sizeof | Lexer::TokenKind.Alignof | Lexer::TokenKind.Offsetof | Lexer::TokenKind.Panic | Lexer::TokenKind.Raise | Lexer::TokenKind.Not | Lexer::TokenKind.Bang | Lexer::TokenKind.Tilde | Lexer::TokenKind.Minus | Lexer::TokenKind.Plus | Lexer::TokenKind.Ampersand:
            return true
        _:
            return false


# `&` is address-of in prefix position, a reference-type suffix when no value
# follows, and infix bitwise-and when the compiler's value-start rule sees a
# right operand. Consecutive ampersands are examined as one run, just like the
# parser's postfix_amp_run. The array-suffix case depends on parser type context
# that is not retained in tokens, so decline to classify that ambiguous shape.
def semtok_ampersand_ttype(tokens: darray[Lexer::Token], index: usize, src: u8&) -> i64:
    return -1 if index >= tokens.count or tokens[index].kind != Lexer::TokenKind.Ampersand
    return ST_MEM_QUALIFIER if index == 0 or not semtok_expression_can_end(tokens[index - 1].kind)
    run_end: mutable usize = index + 1
    while run_end < tokens.count and tokens[run_end].kind == Lexer::TokenKind.Ampersand:
        run_end <- run_end + 1
    next_kind: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
    next_text: mutable sview = sview("", 0, 0)
    if run_end < tokens.count:
        next_kind <- tokens[run_end].kind
        next_text <- Lexer::text_or_empty(tokens[run_end], src) if next_kind == Lexer::TokenKind.Ident
    return -1 if next_kind == Lexer::TokenKind.LBracket
    return ST_MEM_QUALIFIER if next_text == "can" or next_text == "where"
    return ST_OP_BITWISE if semtok_expression_can_start(next_kind)
    return ST_MEM_QUALIFIER


# Classify one token; -1 = no token emitted (IDE default styling). `prev`/`next`
# are the neighboring token kinds; `table` is the real symbol table so bare
# references take their declared kind ([S] layer) rather than a lexical guess.
def semtok_classify(tok: Lexer::Token, src: u8&, src_len: usize, prev: Lexer::TokenKind, next: Lexer::TokenKind, ampersand_ttype: i64, lambda_form: bool, in_effect: bool, table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], allow_fstring_scope_fallback: bool, qualified_owner: sview, qualified_owner_start: u32, shorthand_member: bool, name_heads: dict[u64, i64]&, sym_next: darray[i64]&, position_heads: dict[i64, i64]&, ref_next: darray[i64]&, resolved_reference_heads: dict[i64, i64]&, resolved_reference_next: darray[i64]&, enum_name_heads: dict[u64, i64]&, enum_name_next: darray[i64]&, enum_owner_heads: dict[u64, i64]&, enum_owner_next: darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        kind: Lexer::TokenKind = tok.kind
        match kind:
            Lexer::TokenKind.Ident:
                # `def NAME` — function definition name (reliable lexically).
                ST_FN_DEF return if prev == Lexer::TokenKind.Def
                text: sview = Lexer::text_or_empty(tok, src)
                # Decorator name right after `@` (the At token colors too).
                ST_META_DECORATOR return if prev == Lexer::TokenKind.At
                # Inside a bracketed effect row, `.` separates the qualifier
                # from the permission name. Treat that suffix as effect metadata,
                # not as an ordinary value-field selector.
                ST_EFFECT_NAME return if in_effect and prev == Lexer::TokenKind.Dot
                # A qualified enum member is a variant selector only when its
                # receiver is not shadowed by a resolved parameter/local binding.
                # An exact owner-token occurrence suppresses enum interpretation when
                # a local binding shadows a type with the same spelling.
                if prev == Lexer::TokenKind.Dot and enum_variant_for_owner_indexed(table, enum_owner_heads, enum_owner_next, qualified_owner, text):
                    owner_occurrence: i64 = occurrence_kind_indexed(table, occurrence_positions, position_heads, ref_next, qualified_owner_start, qualified_owner)
                    ST_ENUM_VARIANT return if owner_occurrence == OCC_UNKNOWN
                if shorthand_member:
                    # Leading-dot cases have no owner token. Resolve their
                    # spelling only when registry metadata names one owner in
                    # one module and no ordinary declaration collides. Exact
                    # bindings/resolver edges still win; ambiguous cases stay
                    # uncolored until the frontend supplies variant targets.
                    shorthand_occ: i64 = occurrence_ttype(table, occurrence_positions, position_heads, ref_next, tok, text, allow_fstring_scope_fallback, src, src_len)
                    ST_BIND_PARAM return if shorthand_occ == 1
                    ST_BIND_LOCAL return if shorthand_occ == 2
                    shorthand_target: i64 = definition_reference_target_index_at(table, resolved_reference_heads, resolved_reference_next, tok.start, tok.length, text)
                    shorthand_ttype: i64 = symbol_ttype_index(table, shorthand_target)
                    shorthand_ttype return if shorthand_ttype >= 0
                    shorthand_resolution: i64 = enum_variant_name_resolution_indexed(table, enum_name_heads, enum_name_next, name_heads, sym_next, text)
                    ST_ENUM_VARIANT return if shorthand_resolution == 1
                    return -1 if shorthand_resolution == 2
                # Member access is always a field or method — decided before the
                # symbol table, so a `.field` sharing a top-level name isn't mistaken
                # for that declaration.
                ST_FN_USE return if prev == Lexer::TokenKind.Dot and next == Lexer::TokenKind.LParen
                ST_BIND_FIELD return if prev == Lexer::TokenKind.Dot
                # `can` is an Ident token even when it is the effect-grant clause
                # immediately following a function's parameter list. A parameter
                # with the same spelling on that line is present in the compiler's
                # (line,name)-keyed occurrence log, but this exact signature shape
                # is syntax, not a parameter reference.
                ST_EFFECT_GRANT return if text == "can" and prev == Lexer::TokenKind.RParen and (next == Lexer::TokenKind.LBracket or next == Lexer::TokenKind.Ident)
                # H02 precedence: a RESOLVED param/local binding is authoritative
                # and must beat keyword/type/effect spelling. A binding legally
                # named `can`, `move`, or `type` is a binding, not its keyword
                # meaning. Consulted before the text classifier and the symbol
                # table, so shadowing a top-level name also wins.
                occ: i64 = occurrence_ttype(table, occurrence_positions, position_heads, ref_next, tok, text, allow_fstring_scope_fallback, src, src_len)
                ST_BIND_PARAM return if occ == 1
                ST_BIND_LOCAL return if occ == 2
                # Exact compiler resolver edges beat every spelling-based rule,
                # including contextual keywords such as a function named `get`.
                resolved_target: i64 = definition_reference_target_index_at(table, resolved_reference_heads, resolved_reference_next, tok.start, tok.length, text)
                resolved_ttype: i64 = symbol_ttype_index(table, resolved_target)
                resolved_ttype return if resolved_ttype >= 0
                by_text: i64 = semtok_ident_class(text)
                if next == Lexer::TokenKind.LParen:
                    # `fn(x) => ...` and `fn(x): ...` are lambda syntax even
                    # though the lexer keeps `fn` as Ident so ordinary `fn(x)`
                    # calls remain legal.
                    return by_text if by_text == ST_FN_LAMBDA and lambda_form
                    # Keep a same-named real declaration or registered variant
                    # ahead of the unresolved-call fallback. The exact resolver
                    # edge above remains authoritative when it exists.
                    by_symbol_call: i64 = symbol_ttype(table, name_heads, sym_next, text)
                    by_symbol_call return if by_symbol_call >= 0
                    ST_ENUM_VARIANT return if enum_variant_anywhere_indexed(table, enum_name_heads, enum_name_next, text)
                    # An unresolved call is still an expression-call shape, even
                    # when its contextual spelling also names a syntax category.
                    return ST_FN_USE
                # Known keyword/type/effect text wins next, so e.g. `Unsafe` keeps
                # its red-shifted effect color even inside an effect list.
                by_text return if by_text >= 0
                # Inside a `can[...]`/`trusted …` list every remaining identifier
                # names an effect (Memory.Allocate, Console, …) — tint the family.
                ST_EFFECT_NAME return if in_effect
                # [S] layer: a bare reference matching a real top-level declaration
                # takes that declaration's kind (so `Point(...)` is a type, a bare
                # function value is fn.use, a const is a global, …).
                by_symbol: i64 = symbol_ttype(table, name_heads, sym_next, text)
                by_symbol return if by_symbol >= 0
                # Bare variants (including bare match arms) are registry-resolved,
                # not guessed from case.
                ST_ENUM_VARIANT return if enum_variant_anywhere_indexed(table, enum_name_heads, enum_name_next, text)
                # PascalCase → a user-type reference (Point, Self, …). Lexical guess
                # for names with no top-level declaration in this file.
                first: u8 = src[tok.start.usize()]
                ST_TYPE_USER return if first >= 65 and first <= 90
                # Otherwise it is a value binding (param / local / field name). The
                # default so no identifier stays uncolored.
                return ST_BIND_LOCAL
            Lexer::TokenKind.IntLit | Lexer::TokenKind.HexLit:
                return ST_LIT_INT
            Lexer::TokenKind.FloatLit:
                return ST_LIT_FLOAT
            Lexer::TokenKind.CharLit:
                return ST_LIT_CHAR
            Lexer::TokenKind.StringLit:
                return ST_LIT_STRING
            # An f-string as a whole is a string literal. The main loop instead emits
            # fine-grained spans (chunks vs `{EXPR}`); this is the whole-token fallback.
            Lexer::TokenKind.FString:
                return ST_LIT_STRING
            Lexer::TokenKind.True | Lexer::TokenKind.False | Lexer::TokenKind.Null | Lexer::TokenKind.Zeroed:
                return ST_LIT_VALUE
            Lexer::TokenKind.If | Lexer::TokenKind.Elif | Lexer::TokenKind.Else | Lexer::TokenKind.While | Lexer::TokenKind.Break | Lexer::TokenKind.Continue | Lexer::TokenKind.Return | Lexer::TokenKind.Pass | Lexer::TokenKind.Match:
                return ST_FLOW_BRANCH
            Lexer::TokenKind.Try | Lexer::TokenKind.Catch | Lexer::TokenKind.Raise | Lexer::TokenKind.Panic | Lexer::TokenKind.Error:
                return ST_FLOW_ERROR
            Lexer::TokenKind.Def | Lexer::TokenKind.Struct | Lexer::TokenKind.Enum | Lexer::TokenKind.Const | Lexer::TokenKind.Global | Lexer::TokenKind.Extern | Lexer::TokenKind.Export | Lexer::TokenKind.Packed | Lexer::TokenKind.Repr | Lexer::TokenKind.Aligned | Lexer::TokenKind.Is | Lexer::TokenKind.With | Lexer::TokenKind.As | Lexer::TokenKind.To:
                return ST_DECL_SKELETON
            Lexer::TokenKind.Sizeof | Lexer::TokenKind.Alignof | Lexer::TokenKind.Offsetof:
                return ST_DECL_SKELETON
            Lexer::TokenKind.In:
                return ST_FLOW_BRANCH
            Lexer::TokenKind.Static:
                return ST_META_DIRECTIVE
            Lexer::TokenKind.Region | Lexer::TokenKind.New:
                return ST_MEM_REGION
            # Borrow sigil `&` lives in the memory family alongside heap/stack/tail.
            Lexer::TokenKind.Heap | Lexer::TokenKind.Stack | Lexer::TokenKind.Tail:
                return ST_MEM_QUALIFIER
            Lexer::TokenKind.Ampersand:
                return ampersand_ttype
            # Mutation: `<-`, `mutable`, and the compound assignments (they write).
            Lexer::TokenKind.Mutable | Lexer::TokenKind.LArrow | Lexer::TokenKind.PlusEq | Lexer::TokenKind.MinusEq | Lexer::TokenKind.StarEq | Lexer::TokenKind.SlashEq | Lexer::TokenKind.PercentEq | Lexer::TokenKind.CaretEq | Lexer::TokenKind.PipeEq | Lexer::TokenKind.AmpEq | Lexer::TokenKind.LShiftEq | Lexer::TokenKind.RShiftEq | Lexer::TokenKind.QAssign:
                return ST_OP_MUTATION
            # `=` binds (defines) — a distinct hue from mutation.
            Lexer::TokenKind.Assign:
                return ST_OP_ASSIGN
            Lexer::TokenKind.FatArrow:
                return ST_OP_LAMBDA
            Lexer::TokenKind.Range | Lexer::TokenKind.RangeLt | Lexer::TokenKind.RangeGt | Lexer::TokenKind.RangeLe:
                return ST_OP_RANGE
            Lexer::TokenKind.Plus | Lexer::TokenKind.Minus | Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent:
                return ST_OP_ARITHMETIC
            Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq:
                return ST_OP_COMPARISON
            Lexer::TokenKind.And | Lexer::TokenKind.Or | Lexer::TokenKind.Not:
                return ST_OP_LOGICAL
            Lexer::TokenKind.Pipe | Lexer::TokenKind.Caret | Lexer::TokenKind.LShift | Lexer::TokenKind.RShift | Lexer::TokenKind.Tilde:
                return ST_OP_BITWISE
            Lexer::TokenKind.At:
                return ST_META_DECORATOR
            # Structural glue — brackets, delimiters, arrows, sigils — gets a calm
            # low-salience tint so the content still carries the eye (taxonomy §10).
            Lexer::TokenKind.Colon | Lexer::TokenKind.Scope | Lexer::TokenKind.Arrow | Lexer::TokenKind.Dot | Lexer::TokenKind.Comma | Lexer::TokenKind.Semicolon | Lexer::TokenKind.LParen | Lexer::TokenKind.RParen | Lexer::TokenKind.LBracket | Lexer::TokenKind.RBracket | Lexer::TokenKind.LBrace | Lexer::TokenKind.RBrace | Lexer::TokenKind.Hash | Lexer::TokenKind.Question | Lexer::TokenKind.Bang | Lexer::TokenKind.Ellipsis | Lexer::TokenKind.PipeGt:
                return ST_PUNCTUATION
            _:
                return -1


# Display width of a token for highlighting. Most tokens report their exact
# lexeme width in `tok.length`, but string/char literals are special: the lexer
# records `column` at the opening delimiter while `length` counts the CONTENT
# only (both quotes excluded, since the parser wants the string value). Coloring
# `length` chars from the opening quote would leave the last content char and the
# closing quote uncolored. So for string/char literals we extend the width to the
# full lexeme: +1 for the opening delimiter (column already sits on it) and +1
# more when the closing delimiter is present (absent only for an unterminated
# literal at EOF / end of line).
def semtok_display_start(tok: Lexer::Token) -> usize:
    start: usize = tok.start.usize()
    if tok.kind == Lexer::TokenKind.StringLit or tok.kind == Lexer::TokenKind.CharLit:
        return start - 1 if start > 0
    return start


def semtok_display_length(tok: Lexer::Token, src: u8&, src_len: usize) -> i64:
    base: mutable i64 = tok.length.i64()
    kind: Lexer::TokenKind = tok.kind
    if kind == Lexer::TokenKind.StringLit or kind == Lexer::TokenKind.CharLit:
        close: mutable u8 = 34            # '"'
        close <- 39 if kind == Lexer::TokenKind.CharLit                   # '\''
        end_idx: usize = tok.start.usize() + tok.length.usize()
        base <- base + 1
        base <- base + 1 if end_idx < src_len and src[end_idx] == close
    # An f-string's `column` sits on the `f`, but `length` counts the RAW interior
    # only (both `f"` prefix and closing quote excluded). Extend to the full
    # lexeme: +2 for `f"`, +1 more for the closing quote when present.
    if kind == Lexer::TokenKind.FString:
        end_idx: usize = tok.start.usize() + tok.length.usize()
        base <- base + 2
        base <- base + 1 if end_idx < src_len and src[end_idx] == 34
    return base


# One classified span, in absolute 0-based coordinates (pre delta-encoding).
# U02: `col`/`length` are BYTE offsets into the source snapshot (the shared
# internal system); conversion to UTF-16 happens once at the protocol boundary
# in `semtok_data_body_with_table` via `module Positions`.
struct SemTok:
    line: i64
    col: i64
    length: i64
    ttype: i64
    modifiers: i64 = 0


# Declaration names are the only tokens for which a lexical declaration marker
# is reliable across all currently supported declaration forms. Concrete
# definitions receive `definition`; an `extern` name is a declaration without
# a body and therefore receives `declaration` only. Contextual declaration
# words are checked by text because the lexer intentionally keeps them as
# identifiers for parser compatibility.
def semtok_declaration_modifiers(tokens: darray[Lexer::Token], index: usize, src: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return 0 if index >= tokens.count or tokens[index].kind != Lexer::TokenKind.Ident or index == 0
        previous: Lexer::Token = tokens[index - 1]
        return ST_MOD_DEFINITION if previous.kind == Lexer::TokenKind.Def or previous.kind == Lexer::TokenKind.Struct or previous.kind == Lexer::TokenKind.Enum or previous.kind == Lexer::TokenKind.Const or previous.kind == Lexer::TokenKind.Global
        return ST_MOD_DECLARATION if previous.kind == Lexer::TokenKind.Extern
        if previous.kind == Lexer::TokenKind.Ident:
            previous_text: sview = Lexer::text_or_empty(previous, src)
            return ST_MOD_DEFINITION if previous_text == "type" or previous_text == "alias" or previous_text == "law" or previous_text == "module" or previous_text == "extend" or previous_text == "effect" or previous_text == "protocol" or previous_text == "permission"
        return 0


# Readonly is exposed only for names the compiler explicitly records as
# immutable constants. Parameter/local mutability is not retained in the
# current frontend's occurrence log, so guessing it from syntax would produce
# false positives. A resolved local/parameter shadows a same-spelled const and
# suppresses the modifier.
def semtok_readonly_modifier(table: Semantic::SymbolTable&, immutable_const_heads: dict[u64, i64]&, immutable_const_next: darray[i64]&, immutable_const_mask: u64, tok: Lexer::Token, src: u8&, occurrence_kind: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return 0 if tok.kind != Lexer::TokenKind.Ident or occurrence_kind != OCC_UNKNOWN
        name: sview = Lexer::text_or_empty(tok, src)
        return ST_MOD_READONLY if immutable_const_named_indexed(table, immutable_const_heads, immutable_const_next, immutable_const_mask, name)
        return 0


# `modification` is emitted for direct assignment targets only. The token
# immediately preceding a mutation operator is the exact written place for
# identifiers and fields; index expressions have no single safe identifier to
# annotate and are intentionally left unmodified until the frontend exposes a
# resolved write span.
def semtok_modification_modifier(tokens: darray[Lexer::Token], index: usize, src: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return 0 if index >= tokens.count or tokens[index].kind != Lexer::TokenKind.Ident
        if index + 1 < tokens.count:
            next_kind: Lexer::TokenKind = tokens[index + 1].kind
            return ST_MOD_MODIFICATION if next_kind == Lexer::TokenKind.LArrow or next_kind == Lexer::TokenKind.PlusEq or next_kind == Lexer::TokenKind.MinusEq or next_kind == Lexer::TokenKind.StarEq or next_kind == Lexer::TokenKind.SlashEq or next_kind == Lexer::TokenKind.PercentEq or next_kind == Lexer::TokenKind.CaretEq or next_kind == Lexer::TokenKind.PipeEq or next_kind == Lexer::TokenKind.AmpEq or next_kind == Lexer::TokenKind.LShiftEq or next_kind == Lexer::TokenKind.RShiftEq or next_kind == Lexer::TokenKind.QAssign
        if index > 0 and tokens[index - 1].kind == Lexer::TokenKind.Ident:
            previous_text: sview = Lexer::text_or_empty(tokens[index - 1], src)
            return ST_MOD_MODIFICATION if previous_text == "rebind"
        return 0


# Emit fine-grained spans for one f-string token: literal chunks (including the
# `f"` prefix, closing quote, and `{{`/`}}`/`\` escapes) as string literals, and
# each `{EXPR}` interpolation as punctuation braces around the sub-lexed
# expression tokens — classified like any other code, so an interpolated
# `{d.name}` colours its identifiers, operators, and nested literals. Mirrors the
# parser's scan (parser_expr.elisa `fstring_expr`) so the highlighted spans match
# what actually parses. Single-line; columns are byte-based (as elsewhere here).
def semtok_fstring_spans_at(entries: mutable darray[SemTok]&, tok: Lexer::Token, src: u8&, src_len: usize, table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], name_heads: dict[u64, i64]&, sym_next: darray[i64]&, position_heads: dict[i64, i64]&, ref_next: darray[i64]&, resolved_reference_heads: dict[i64, i64]&, resolved_reference_next: darray[i64]&, enum_name_heads: dict[u64, i64]&, enum_name_next: darray[i64]&, enum_owner_heads: dict[u64, i64]&, enum_owner_next: darray[i64]&, line: i64, base_col: i64, depth: i64) -> void can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        lo: usize = tok.start.usize()            # first interior byte (after `f"`)
        hi: usize = lo + tok.length.usize()      # closing-quote byte offset
        # Malformed or adversarial input must not make semantic-token expansion
        # recurse without bound. At the limit, retain one valid string span.
        if depth >= 16:
            fallback_len: i64 = semtok_display_length(tok, src, src_len)
            entries.push(SemTok{line: line, col: base_col, length: fallback_len, ttype: ST_LIT_STRING}) if fallback_len > 0
            return
        seg_start: mutable i64 = base_col        # current string run starts at the `f`
        i: mutable usize = lo
        while i < hi:
            ch: char = src[i].char()
            # Literal `{{` / `}}` and `\x` escapes stay inside the string run.
            if ch == '{' and i + 1 < hi and src[i + 1].char() == '{':
                i <- i + 2
                continue
            if ch == '}' and i + 1 < hi and src[i + 1].char() == '}':
                i <- i + 2
                continue
            if ch == '\\':
                i <- i + 2
                continue
            if ch == '{':
                open_col: i64 = base_col + 2 + (i - lo).i64()
                # Flush the pending literal chunk [seg_start, open_col).
                entries.push(SemTok{line: line, col: seg_start, length: open_col - seg_start, ttype: ST_LIT_STRING}) if open_col > seg_start
                # Find the matching `}` (string-aware, mirrors the lexer/parser scan).
                j: mutable usize = i + 1
                brace_depth: mutable usize = 1
                while j < hi and brace_depth > 0:
                    cj: char = src[j].char()
                    match cj:
                        '{':
                            brace_depth <- brace_depth + 1
                        '}':
                            brace_depth <- brace_depth - 1
                            break if brace_depth == 0
                        '"':
                            j <- j + 1
                            while j < hi and src[j].char() != '"':
                                j <- j + 1 if src[j].char() == '\\'
                                j <- j + 1
                        '\'':
                            j <- j + 1
                            while j < hi and src[j].char() != '\'':
                                j <- j + 1 if src[j].char() == '\\'
                                j <- j + 1
                        _:
                            pass
                    j <- j + 1
                # Opening `{` punctuation.
                entries.push(SemTok{line: line, col: open_col, length: 1, ttype: ST_PUNCTUATION})
                # Sub-lex the embedded expression. Its tokens carry ABSOLUTE
                # `.start` offsets into `src` (so text/classification are exact),
                # but `.line`/`.column` are stale — the span lexer jumps `position`
                # without re-tracking them. Derive the source column from `.start`
                # (the interpolation shares the f-string's single line). Quoted
                # literals store `.start` after their opening delimiter, while
                # their display span begins at that delimiter.
                if j > i + 1:
                    subtoks: darray[Lexer::Token] = Lexer::frontend_tokenize_span("", src, i + 1, j)
                    s: mutable usize = 0
                    while s < subtoks.count:
                        st: Lexer::Token = subtoks[s]
                        sp: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
                        sp <- subtoks[s - 1].kind if s > 0
                        sn: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
                        sn <- subtoks[s + 1].kind if s + 1 < subtoks.count
                        qualified_owner: mutable sview = sview("", 0, 0)
                        qualified_owner_start: mutable u32 = 0
                        shorthand_member: mutable bool = false
                        if sp == Lexer::TokenKind.Dot:
                            if s >= 2 and subtoks[s - 2].kind == Lexer::TokenKind.Ident:
                                qualified_owner <- Lexer::text_or_empty(subtoks[s - 2], src)
                                qualified_owner_start <- subtoks[s - 2].start
                            else:
                                shorthand_member <- true
                        if st.kind == Lexer::TokenKind.FString:
                            # A nested f-string token starts at its raw interior,
                            # two bytes after its `f"` prefix. Re-enter the same
                            # expander with the prefix column so its literal and
                            # interpolation spans remain absolute and non-overlapping.
                            nested_col: i64 = base_col + (st.start.usize() - lo).i64()
                            semtok_fstring_spans_at(entries, st, src, src_len, table, occurrence_positions, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next, line, nested_col, depth + 1)
                        else:
                            stt: i64 = semtok_classify(st, src, src_len, sp, sn, semtok_ampersand_ttype(subtoks, s, src), semtok_lambda_intro(subtoks, s, src), false, table, occurrence_positions, true, qualified_owner, qualified_owner_start, shorthand_member, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next)
                            sln: i64 = semtok_display_length(st, src, src_len)
                            if stt >= 0 and sln > 0:
                                display_start: usize = semtok_display_start(st)
                                sub_col: i64 = base_col + 2 + (display_start - lo).i64()
                                entries.push(SemTok{line: line, col: sub_col, length: sln, ttype: stt})
                        s <- s + 1
                if j < hi:
                    # Closing `}` punctuation; the next string run follows it.
                    close_col: i64 = base_col + 2 + (j - lo).i64()
                    entries.push(SemTok{line: line, col: close_col, length: 1, ttype: ST_PUNCTUATION})
                    seg_start <- close_col + 1
                    i <- j + 1
                else:
                    # Unterminated interpolation (ran to end of interior).
                    seg_start <- base_col + 2 + (hi - lo).i64()
                    i <- hi
                continue
            i <- i + 1
        # Trailing literal chunk, including the closing quote when present.
        end_col: mutable i64 = base_col + 2 + (hi - lo).i64()
        end_col <- end_col + 1 if hi < src_len and src[hi].char() == '"'
        entries.push(SemTok{line: line, col: seg_start, length: end_col - seg_start, ttype: ST_LIT_STRING}) if end_col > seg_start


# Top-level entry derives coordinates from the parser's main token stream.
# Recursive calls use the containing interpolation's line and absolute byte
# column because span-lexer token line/column tracking intentionally stays stale.
def semtok_fstring_spans(entries: mutable darray[SemTok]&, tok: Lexer::Token, src: u8&, src_len: usize, table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], name_heads: dict[u64, i64]&, sym_next: darray[i64]&, position_heads: dict[i64, i64]&, ref_next: darray[i64]&, resolved_reference_heads: dict[i64, i64]&, resolved_reference_next: darray[i64]&, enum_name_heads: dict[u64, i64]&, enum_name_next: darray[i64]&, enum_owner_heads: dict[u64, i64]&, enum_owner_next: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        semtok_fstring_spans_at(entries, tok, src, src_len, table, occurrence_positions, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next, tok.line.i64() - 1, tok.column.i64() - 1, 0)


# Classify the main token stream into absolute-position entries, tracking the
# `can[…]` / `trusted …` effect-list context so effect names colour correctly.
def semtok_main_entries(src: u8&, src_len: usize, tokens: darray[Lexer::Token], table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], name_heads: dict[u64, i64]&, sym_next: darray[i64]&, position_heads: dict[i64, i64]&, ref_next: darray[i64]&, resolved_reference_heads: dict[i64, i64]&, resolved_reference_next: darray[i64]&, enum_name_heads: dict[u64, i64]&, enum_name_next: darray[i64]&, enum_owner_heads: dict[u64, i64]&, enum_owner_next: darray[i64]&, immutable_const_heads: dict[u64, i64]&, immutable_const_next: darray[i64]&, immutable_const_mask: u64) -> darray[SemTok]:
    can Memory.Allocate, Abort.Panic:
        entries: mutable darray[SemTok] = []
        # Effect-list context: bracketed (closes on the matching `]`) or block
        # (`can X, Y:`, closes on `:` / newline).
        bracket_depth: mutable i64 = 0
        effect_depth: mutable i64 = -1
        block_effect: mutable bool = false
        grant_pending: mutable bool = false
        i: mutable usize = 0
        while i < tokens.count:
            tok: Lexer::Token = tokens[i]
            prev_kind: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
            prev_kind <- tokens[i - 1].kind if i > 0
            next_kind: mutable Lexer::TokenKind = Lexer::TokenKind.Eof
            next_kind <- tokens[i + 1].kind if i + 1 < tokens.count
            in_effect: mutable bool = effect_depth >= 0 or block_effect
            in_effect <- true if grant_pending and tok.kind != Lexer::TokenKind.LBracket            # first effect ident of a block form
            if tok.kind == Lexer::TokenKind.FString:
                # F-strings expand into multiple spans (literal chunks + coloured
                # `{EXPR}` interpolations) rather than one whole-token span.
                semtok_fstring_spans(entries, tok, src, src_len, table, occurrence_positions, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next)
            else:
                qualified_owner: mutable sview = sview("", 0, 0)
                qualified_owner_start: mutable u32 = 0
                shorthand_member: mutable bool = false
                if prev_kind == Lexer::TokenKind.Dot:
                    if i >= 2 and tokens[i - 2].kind == Lexer::TokenKind.Ident:
                        qualified_owner <- Lexer::text_or_empty(tokens[i - 2], src)
                        qualified_owner_start <- tokens[i - 2].start
                    else:
                        shorthand_member <- true
                ttype: i64 = semtok_classify(tok, src, src_len, prev_kind, next_kind, semtok_ampersand_ttype(tokens, i, src), semtok_lambda_intro(tokens, i, src), in_effect, table, occurrence_positions, false, qualified_owner, qualified_owner_start, shorthand_member, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next)
                emit_len: i64 = semtok_display_length(tok, src, src_len)
                occurrence_kind: mutable i64 = OCC_UNKNOWN
                if tok.kind == Lexer::TokenKind.Ident:
                    occurrence_kind <- occurrence_ttype(table, occurrence_positions, position_heads, ref_next, tok, Lexer::text_or_empty(tok, src), false, src, src_len)
                modifiers: i64 = semtok_declaration_modifiers(tokens, i, src) | semtok_readonly_modifier(table, immutable_const_heads, immutable_const_next, immutable_const_mask, tok, src, occurrence_kind) | semtok_modification_modifier(tokens, i, src)
                entries.push(SemTok{line: tok.line.i64() - 1, col: tok.column.i64() - 1, length: emit_len, ttype: ttype, modifiers: modifiers}) if ttype >= 0 and emit_len > 0
            # Advance the effect-list state machine for the NEXT token.
            k: Lexer::TokenKind = tok.kind
            match k:
                Lexer::TokenKind.LBracket:
                    effect_depth <- bracket_depth if grant_pending and effect_depth < 0
                    bracket_depth <- bracket_depth + 1
                Lexer::TokenKind.RBracket:
                    bracket_depth <- bracket_depth - 1
                    effect_depth <- -1 if effect_depth >= 0 and bracket_depth == effect_depth
                _:
                    pass
            block_effect <- false if block_effect and (k == Lexer::TokenKind.Colon or k == Lexer::TokenKind.Newline)
            block_effect <- true if grant_pending and k != Lexer::TokenKind.LBracket and k != Lexer::TokenKind.Colon and k != Lexer::TokenKind.Newline
            new_grant: mutable bool = false
            if k == Lexer::TokenKind.Ident:
                gt: sview = Lexer::text_or_empty(tok, src)
                new_grant <- true if gt == "can" or gt == "uses" or gt == "trusted"
            grant_pending <- new_grant
            i <- i + 1
        return entries


# Comment spans (harvested from the lexer's side channel) as entries. Comments
# report `column` at the `#`/`"""` with `length` = full span, so no adjustment.
def semtok_comment_entries(comments: darray[Lexer::Token]) -> darray[SemTok]:
    can Memory.Allocate, Abort.Panic:
        entries: mutable darray[SemTok] = []
        j: mutable usize = 0
        while j < comments.count:
            ctok: Lexer::Token = comments[j]
            entries.push(SemTok{line: ctok.line.i64() - 1, col: ctok.column.i64() - 1, length: ctok.length.i64(), ttype: ST_COMMENT}) if ctok.length > 0
            j <- j + 1
        return entries


# H03: split any span that crosses a line into valid per-line spans. The LSP
# semantic-token format has no multiline tokens — a token's `length` applies to
# its start line only — so a multiline comment/string emitted as one entry is
# invalid (and hides every intermediate line). Pieces preserve order, never
# overlap, and exclude a CRLF's CR. Line-bounded entries pass through unchanged.
def semtok_append_normalized(out: mutable darray[SemTok]&, e: SemTok, src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize) -> void can[Memory.Allocate, Abort.Panic]:
    return if e.length <= 0
    llen: i64 = Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, e.line)
    # Positions excludes the CR byte in CRLF's visible line width. A frontend
    # token that begins at that byte must not be emitted as an end-of-line span.
    return if e.col >= llen
    if e.col + e.length <= llen:
        out.push(e)
        return
    start: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, e.line) + e.col.usize()
    return if start > src_len
    end: mutable usize = start + e.length.usize()
    end <- src_len if end > src_len
    line: mutable i64 = e.line
    seg: mutable usize = start
    col: mutable i64 = e.col
    i: mutable usize = start
    while i < end:
        if src[i] == 10:
            seg_end: mutable usize = i
            if seg_end > seg and src[seg_end - 1] == 13:
                seg_end <- seg_end - 1
            out.push(SemTok{line: line, col: col, length: (seg_end - seg).i64(), ttype: e.ttype, modifiers: e.modifiers}) if seg_end > seg
            line <- line + 1
            col <- 0
            seg <- i + 1
        i <- i + 1
    fin: mutable usize = end
    fin <- fin - 1 if fin > seg and fin <= src_len and src[fin - 1] == 13 and fin < src_len and src[fin] == 10
    out.push(SemTok{line: line, col: col, length: (fin - seg).i64(), ttype: e.ttype, modifiers: e.modifiers}) if fin > seg


def semtok_normalize(list: darray[SemTok], src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize) -> darray[SemTok]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[SemTok] = []
        i: mutable usize = 0
        while i < list.count:
            semtok_append_normalized(out, list[i], src, src_len, line_starts, span_start, span_count)
            i <- i + 1
        return out


# (line, byte-col) — a linear merge, no sort — before delta-encoding. Starts
# and lengths convert from bytes to UTF-16 code units here, at the protocol
# boundary, through the shared `Positions` module (U02); the merge order is
# unaffected because the conversion is monotonic within a line. The caller
# passes the already-computed table so diagnostics and highlighting share one
# frontend pass per source update.
def semtok_data_body_with_table(src: u8&, src_len: usize, tokens: darray[Lexer::Token], comments: darray[Lexer::Token], table: Semantic::SymbolTable&, occurrence_positions: darray[Ast::Pos], line_starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        # H04: build name/line indexes once per analysis so classification is
        # O(1) average instead of a full scan per identifier.
        name_heads: mutable dict[u64, i64] = {}
        sym_next: mutable darray[i64] = []
        resolved_reference_heads: mutable dict[i64, i64] = {}
        resolved_reference_next: mutable darray[i64] = []
        position_heads: mutable dict[i64, i64] = {}
        ref_next: mutable darray[i64] = []
        enum_name_heads: mutable dict[u64, i64] = {}
        enum_name_next: mutable darray[i64] = []
        enum_owner_heads: mutable dict[u64, i64] = {}
        enum_owner_next: mutable darray[i64] = []
        immutable_const_heads: mutable dict[u64, i64] = {}
        immutable_const_next: mutable darray[i64] = []
        immutable_const_mask: mutable u64 = 0
        lsp_adapter_symbol_index_build_calls <- lsp_adapter_symbol_index_build_calls + 1
        symbol_index_build(table, name_heads, sym_next, resolved_reference_heads, resolved_reference_next)
        lsp_adapter_occurrence_index_build_calls <- lsp_adapter_occurrence_index_build_calls + 1
        occurrence_index_build(table, occurrence_positions, position_heads, ref_next)
        enum_variant_index_build(table, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next)
        immutable_const_index_build(table, immutable_const_heads, immutable_const_next, immutable_const_mask)
        entries: darray[SemTok] = semtok_normalize(semtok_main_entries(src, src_len, tokens, table, occurrence_positions, name_heads, sym_next, position_heads, ref_next, resolved_reference_heads, resolved_reference_next, enum_name_heads, enum_name_next, enum_owner_heads, enum_owner_next, immutable_const_heads, immutable_const_next, immutable_const_mask), src, src_len, line_starts, span_start, span_count)
        comment_entries: darray[SemTok] = semtok_normalize(semtok_comment_entries(comments), src, src_len, line_starts, span_start, span_count)
        body: mutable darray[u8] = []
        push_str(body, "{\"data\":[")
        prev_line: mutable i64 = 0
        prev_col: mutable i64 = 0
        first: mutable bool = true
        a: mutable usize = 0
        b: mutable usize = 0
        while a < entries.count or b < comment_entries.count:
            take_a: mutable bool = true
            take_a <- false if a >= entries.count
            if b < comment_entries.count and a < entries.count:
                ea: SemTok = entries[a]
                cb: SemTok = comment_entries[b]
                take_a <- false if cb.line < ea.line or (cb.line == ea.line and cb.col < ea.col)
            e: mutable SemTok = zeroed
            if take_a:
                e <- entries[a]
                a <- a + 1
            else:
                e <- comment_entries[b]
                b <- b + 1
            lstart: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, src_len, e.line)
            llen: i64 = Positions::line_byte_length_span_indexed(src, src_len, line_starts, span_start, span_count, e.line)
            bcol: i64 = 0 if e.col < 0 else (llen if e.col > llen else e.col)
            ucol: i64 = bcol if utf8 else Positions::utf16_units_for_bytes(src, lstart, bcol.usize())
            ulen: i64 = Positions::span_unit_length(src, src_len, lstart + bcol.usize(), e.length.usize(), utf8)
            dl: i64 = e.line - prev_line
            dc: mutable i64 = ucol
            dc <- ucol - prev_col if dl == 0
            body.push(44) if not first
            push_int(body, dl)
            body.push(44)
            push_int(body, dc)
            body.push(44)
            push_int(body, ulen)
            body.push(44)
            push_int(body, e.ttype)
            # Canonical cache modifier bits stay independent from the
            # negotiated client profile. The worker validates this mask before
            # publication; remapping happens only when serving a request.
            body.push(44)
            push_int(body, e.modifiers & ST_MODIFIER_MASK)
            first <- false
            prev_line <- e.line
            prev_col <- ucol
        push_str(body, "]}")
        return body


# Handle `textDocument/semanticTokens/full`: emit the cached LSP delta-encoded
# data array. Unknown/uncached uri -> empty data.
# LspDocument is declared in documents.elisa; included source shares one module
# scope, so this handler can select the requested snapshot by URI.
def handle_semantic_tokens(root: Json::Value, snapshot: DocumentSnapshotView, document_storage: darray[u8]&, profile: SemTokProfile, result_body: mutable darray[u8]&, retained_start_out: mutable usize&, retained_len_out: mutable usize&) -> ProviderOutcome can[Memory.Allocate, Abort.Panic]:
    if not snapshot.valid or snapshot.lifecycle.analysis_state != DocumentAnalysisState.Ready:
        return ProviderOutcome.NoMatchSemanticTokens
    document: DocumentSnapshotView = snapshot
    if document.source.text_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len == 0 or document.source.text_len > document_storage.count - document.source.text_start:
        return ProviderOutcome.InvalidRetainedCache
    semantic_start: mutable usize = document.caches.semantic_start
    if semantic_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.caches.semantic_len == 0 or document.caches.semantic_len > document_storage.count - semantic_start:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len <= 1:
        return ProviderOutcome.NoMatchSemanticTokens
    if profile.custom and semtok_modifier_map_is_identity(profile.modifier_map):
        retained_start_out <- semantic_start
        retained_len_out <- document.caches.semantic_len
        return ProviderOutcome.Result
    cached: sview = bytes_view_range_ref(document_storage, semantic_start, document.caches.semantic_len)
    result: darray[u8] = semtok_remap_full(cached, profile.type_map, profile.modifier_map)
    # The generated container belongs to this function's auto region. Copy its
    # scalar payload into the caller-owned response buffer without storing the
    # local container descriptor beyond that lifetime.
    result_body.extend([byte for byte in result])
    return ProviderOutcome.Result


# `send_result` variant whose result payload is an owned buffer.
def send_result_body(id_raw: darray[u8], result: darray[u8]) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"result\":")
    body.extend(result)
    push_str(body, "}")
    send_message(body)


# The cached semantic result already lives in the session storage. Build the
# response directly from that range to avoid an intermediate result-buffer copy
# on the frequent semantic-token request path.
def send_result_storage(id_raw: darray[u8], storage: darray[u8]&, start: usize, length: usize) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"result\":")
    for i in 0..<length:
        body.push(storage[start + i])
    push_str(body, "}")
    send_message(body)


# ---- H05: semanticTokens/range ------------------------------------------------
#
# The cached full result is a delta-encoded `{"data":[...]}` array in document
# coordinates. A range request decodes it, keeps entries intersecting the
# requested range, and re-encodes with the SAME document-zero baseline (per LSP,
# the first token is relative to line/character zero, not the range start), so
# the filtered array is a valid prefix-compatible subset of the full one.
# Modifier bits are decoded and remapped alongside token types. The cached
# stream uses canonical modifier positions; the response uses the negotiated
# client legend positions.

def semtok_parse_int(data: sview, pos: mutable usize&) -> i64:
    n: mutable i64 = 0
    neg: mutable bool = false
    if pos[0] < data.len.usize() and sview_at(data, pos[0]) == 45:
        neg <- true
        pos[0] <- pos[0] + 1
    while pos[0] < data.len.usize():
        d: u8 = sview_at(data, pos[0])
        break if d < 48 or d > 57
        n <- n * 10 + (d.i64() - 48)
        pos[0] <- pos[0] + 1
    return (0 - n) if neg else n


# Translate a cached full result from stable Elisa indices to the session's
# negotiated legend. Unsupported fallback categories are omitted. Delta
# positions are re-encoded against the previously emitted token so skipped
# tokens cannot corrupt subsequent coordinates.
def semtok_remap_full(cached: sview, type_map: darray[i64], modifier_map: darray[i64]) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        lb: mutable i64 = -1
        rb: mutable i64 = -1
        j: mutable usize = 0
        while j < cached.len.usize():
            c: u8 = sview_at(cached, j)
            lb <- j.i64() if c == 91 and lb < 0
            rb <- j.i64() if c == 93
            j <- j + 1
        body: mutable darray[u8] = []
        push_str(body, "{\"data\":[")
        if lb < 0 or rb <= lb:
            push_str(body, "]}")
            return body
        data: sview = string_view_slice(cached, lb + 1, rb)
        pos: mutable usize = 0
        cur_line: mutable i64 = 0
        cur_col: mutable i64 = 0
        prev_line: mutable i64 = 0
        prev_col: mutable i64 = 0
        first: mutable bool = true
        while pos < data.len.usize():
            dl: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            dc: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            ln: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            tt: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            mods: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            cur_line <- cur_line + dl
            if dl == 0:
                cur_col <- cur_col + dc
            else:
                cur_col <- dc
            mapped_type: mutable i64 = -1
            if tt >= 0 and tt < type_map.count.i64():
                mapped_type <- type_map[tt.usize()]
            if mapped_type >= 0:
                odl: i64 = cur_line - prev_line
                odc: mutable i64 = cur_col
                odc <- cur_col - prev_col if odl == 0
                body.push(44) if not first
                push_int(body, odl)
                body.push(44)
                push_int(body, odc)
                body.push(44)
                push_int(body, ln)
                body.push(44)
                push_int(body, mapped_type)
                body.push(44)
                push_int(body, semtok_remap_modifier_bits(mods, modifier_map))
                first <- false
                prev_line <- cur_line
                prev_col <- cur_col
        push_str(body, "]}")
        return body


def semtok_filter_range(cached: sview, sline: i64, schar: i64, eline: i64, echar: i64, type_map: darray[i64], modifier_map: darray[i64]) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        # Locate `[` .. `]` of the data array.
        lb: mutable i64 = -1
        rb: mutable i64 = -1
        j: mutable usize = 0
        while j < cached.len.usize():
            c: u8 = sview_at(cached, j)
            lb <- j.i64() if c == 91 and lb < 0
            rb <- j.i64() if c == 93
            j <- j + 1
        body: mutable darray[u8] = []
        push_str(body, "{\"data\":[")
        if lb < 0 or rb <= lb:
            push_str(body, "]}")
            return body
        data: sview = string_view_slice(cached, lb + 1, rb)
        pos: mutable usize = 0
        cur_line: mutable i64 = 0
        cur_col: mutable i64 = 0
        # Baseline for the filtered output (document zero), independent of the
        # requested range start.
        prev_line: mutable i64 = 0
        prev_col: mutable i64 = 0
        first: mutable bool = true
        while pos < data.len.usize():
            dl: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            dc: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            ln: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            tt: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            mods: i64 = semtok_parse_int(data, pos)
            pos <- pos + 1 if pos < data.len.usize() and sview_at(data, pos) == 44
            cur_line <- cur_line + dl
            if dl == 0:
                cur_col <- cur_col + dc
            else:
                cur_col <- dc
            mapped_type: mutable i64 = -1
            if tt >= 0 and tt < type_map.count.i64():
                mapped_type <- type_map[tt.usize()]
            # Intersect [cur_col, cur_col+ln) on cur_line with the range.
            if mapped_type >= 0 and cur_line >= sline and cur_line <= eline:
                starts_before_end: bool = cur_line < eline or cur_col < echar
                ends_after_start: bool = cur_line > sline or cur_col + ln > schar
                if starts_before_end and ends_after_start:
                    odl: i64 = cur_line - prev_line
                    odc: mutable i64 = cur_col
                    odc <- cur_col - prev_col if odl == 0
                    body.push(44) if not first
                    push_int(body, odl)
                    body.push(44)
                    push_int(body, odc)
                    body.push(44)
                    push_int(body, ln)
                    body.push(44)
                    push_int(body, mapped_type)
                    body.push(44)
                    push_int(body, semtok_remap_modifier_bits(mods, modifier_map))
                    first <- false
                    prev_line <- cur_line
                    prev_col <- cur_col
        push_str(body, "]}")
        return body


def handle_semantic_tokens_range(root: Json::Value, snapshot: DocumentSnapshotView, document_storage: darray[u8]&, profile: SemTokProfile, result_body: mutable darray[u8]&) -> ProviderOutcome can[Memory.Allocate, Abort.Panic]:
    if not snapshot.valid or snapshot.lifecycle.analysis_state != DocumentAnalysisState.Ready:
        return ProviderOutcome.NoMatchSemanticTokens
    document: DocumentSnapshotView = snapshot
    if document.source.text_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len == 0 or document.source.text_len > document_storage.count - document.source.text_start:
        return ProviderOutcome.InvalidRetainedCache
    semantic_start: mutable usize = document.caches.semantic_start
    if semantic_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.caches.semantic_len == 0 or document.caches.semantic_len > document_storage.count - semantic_start:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len <= 1:
        return ProviderOutcome.NoMatchSemanticTokens
    sline: mutable i64 = 0
    schar: mutable i64 = 0
    eline: mutable i64 = 0
    echar: mutable i64 = 0
    if Json::get(root, "params") is params:
        if Json::get(params, "range") is rng:
            if Json::get(rng, "start") is s:
                if Json::get(s, "line") is v:
                    sline <- Json::as_lsp_uinteger_or_invalid(v)
                if Json::get(s, "character") is v:
                    schar <- Json::as_lsp_uinteger_or_invalid(v)
            if Json::get(rng, "end") is e:
                if Json::get(e, "line") is v:
                    eline <- Json::as_lsp_uinteger_or_invalid(v)
                if Json::get(e, "character") is v:
                    echar <- Json::as_lsp_uinteger_or_invalid(v)
    sline <- 0 if sline < 0
    schar <- 0 if schar < 0
    eline <- 0 if eline < 0
    echar <- 0 if echar < 0
    if eline < sline or (eline == sline and echar < schar):
        eline <- sline
        echar <- schar
    cached: sview = bytes_view_range_ref(document_storage, semantic_start, document.caches.semantic_len)
    result: darray[u8] = semtok_filter_range(cached, sline, schar, eline, echar, profile.type_map, profile.modifier_map)
    # Keep the auto-region result local and copy only its byte values outward.
    result_body.extend([byte for byte in result])
    return ProviderOutcome.Result
