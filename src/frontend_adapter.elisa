# Frontend adapter (A01): the ONLY module that reaches into the compiler's
# `Semantic::SymbolTable` storage layout. Everything else — diagnostics,
# semantic tokens, document symbols, and future providers — goes through these
# named accessors, so a frontend upgrade that renames a field, changes a
# parallel-array shape, or renumbers `ref_kind` fails here (or in
# `test/frontend_contract.sh`) with a localized error instead of silently
# changing behavior across the server.
#
# Contract version: bump `frontend_contract_version` whenever the assumptions
# below about the frontend surface change. The contract fixture compiles and
# exercises these accessors against the pinned frontend; a mismatch is a
# contract break, not a feature regression.
#
# Explicitly NOT in this module: token-type/presentation mapping (semtokens),
# diagnostic wording/severity (the frontend keeps `diagnostic_message` /
# `diagnostic_severity` authoritative), JSON framing, and range conversion.

# Occurrence roles, decoded from the frontend's `ref_kind` scalar. The frontend
# documents these as 1 = parameter and 2 = local; naming them here keeps that
# numeric encoding out of every provider.
const OCC_UNKNOWN: i64 = -1
const OCC_PARAM: i64 = 1
const OCC_LOCAL: i64 = 2

# The frontend contract revision this adapter is written against.
def frontend_contract_version() -> i64:
    return 1


# FNV-1a over a name; the symbol-index bucket key. Self-contained so the
# adapter (and its contract fixture) does not depend on other LSP modules.
def adapter_name_hash(name: sview) -> u64:
    hash: mutable u64 = 14695981039346656037
    i: mutable usize = 0
    while i < name.len.usize():
        hash <- (hash ^ sview_at(name, i).u64()) * 1099511628211
        i <- i + 1
    return hash


# Iterate the file's declaration symbols without exposing the storage field.
def symbol_count(table: Semantic::SymbolTable&) -> usize:
    return table.symbols.count


def symbol_at(table: Semantic::SymbolTable&, index: usize) -> Semantic::Symbol:
    return table.symbols[index]


# Index of the first declaration whose name matches exactly, or -1. A scan is
# correct at per-file scale; an index arrives with A02.
def symbol_index_of(table: Semantic::SymbolTable&, name: sview) -> i64:
    i: mutable usize = 0
    while i < table.symbols.count:
        return i.i64() if string_views_eq(table.symbols[i].name, name) != 0
        i <- i + 1
    return -1


# A parameter/local occurrence on `line` with `name`, decoded to OCC_*. The
# frontend logs these in parallel arrays; any renumbering surfaces here.
def occurrence_kind_at(table: Semantic::SymbolTable&, line: u32, name: sview) -> i64:
    i: mutable usize = 0
    while i < table.ref_line.count:
        if table.ref_line[i] == line and string_views_eq(table.ref_name[i], name) != 0:
            return table.ref_kind[i].i64()
        i <- i + 1
    return OCC_UNKNOWN


# H04 occurrence index: hash-chain the frontend's occurrence log by source line
# so a lookup touches only the entries on that line instead of every entry in
# the file. Built once per analysis; the linear `occurrence_kind_at` remains the
# reference implementation (and the contract fixture's oracle).
def occurrence_index_build(table: Semantic::SymbolTable&, line_heads: mutable dict[i64, i64]&, ref_next: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        i: mutable usize = 0
        while i < table.ref_line.count:
            ref_next.push(-1)
            i <- i + 1
        i <- 0
        while i < table.ref_line.count:
            key: i64 = table.ref_line[i].i64()
            previous: mutable i64 = -1
            previous <- head if line_heads.get(key) is head
            ref_next[i] <- previous
            line_heads <- line_heads.put(key, i.i64())
            i <- i + 1


def occurrence_kind_indexed(table: Semantic::SymbolTable&, line_heads: dict[i64, i64]&, ref_next: darray[i64]&, line: u32, name: sview) -> i64:
    if line_heads.get(line.i64()) is head:
        current: mutable i64 = head
        while current >= 0:
            index: usize = current.usize()
            return table.ref_kind[index].i64() if string_views_eq(table.ref_name[index], name) != 0
            current <- ref_next[index]
    return OCC_UNKNOWN


# H04 symbol index: hash-chain file symbols by name. `symbol_index_of`'s linear
# scan is the reference; this makes a repeated unknown/type lookup O(1) average.
def symbol_index_build(table: Semantic::SymbolTable&, name_heads: mutable dict[u64, i64]&, sym_next: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        i: mutable usize = 0
        while i < table.symbols.count:
            sym_next.push(-1)
            i <- i + 1
        i <- 0
        while i < table.symbols.count:
            key: u64 = adapter_name_hash(table.symbols[i].name)
            previous: mutable i64 = -1
            previous <- head if name_heads.get(key) is head
            sym_next[i] <- previous
            name_heads <- name_heads.put(key, i.i64())
            i <- i + 1


def symbol_index_of_indexed(table: Semantic::SymbolTable&, name_heads: dict[u64, i64]&, sym_next: darray[i64]&, name: sview) -> i64:
    if name_heads.get(adapter_name_hash(name)) is head:
        current: mutable i64 = head
        while current >= 0:
            index: usize = current.usize()
            return current if string_views_eq(table.symbols[index].name, name) != 0
            current <- sym_next[index]
    return -1


# Enum variants live in parallel registries, not ordinary Symbol rows.
def enum_variant_for_owner(table: Semantic::SymbolTable&, owner: sview, name: sview) -> bool:
    i: mutable usize = 0
    while i < table.enum_variant_owner.count:
        return true if string_views_eq(table.enum_variant_owner[i], owner) != 0 and string_views_eq(table.enum_variant_name[i], name) != 0
        i <- i + 1
    return false


def enum_variant_anywhere(table: Semantic::SymbolTable&, name: sview) -> bool:
    i: mutable usize = 0
    while i < table.enum_variant_name.count:
        return true if string_views_eq(table.enum_variant_name[i], name) != 0
        i <- i + 1
    return false


# The frontend's located findings. Wording/severity stay frontend-owned.
def diagnostic_count(table: Semantic::SymbolTable&) -> usize:
    return table.diagnostics.count


def diagnostic_at(table: Semantic::SymbolTable&, index: usize) -> Semantic::Diagnostic:
    return table.diagnostics[index]


# Occurrence-log entries, exposed for A03 serialization (a retained analysis
# summary). The raw `ref_kind` stays encoded behind OCC_*.
def occurrence_count(table: Semantic::SymbolTable&) -> usize:
    return table.ref_line.count


def occurrence_line(table: Semantic::SymbolTable&, index: usize) -> u32:
    return table.ref_line[index]


def occurrence_name(table: Semantic::SymbolTable&, index: usize) -> sview:
    return table.ref_name[index]


def occurrence_kind_index(table: Semantic::SymbolTable&, index: usize) -> i64:
    return table.ref_kind[index].i64()
