# Live diagnostics via the stage1 self-hosted frontend (`module Semantic`).
#
# Runs the real lex -> parse -> check pipeline over a document's text and turns the
# resulting `Semantic::SymbolTable.diagnostics` into an LSP `publishDiagnostics`
# notification body. Enabled end-to-end by the stage0 region-poly-in-module fix
# (Elisa-core 65aa624e) plus the `Json` module (src/json.elisa).
#
# The diagnostic stream is entirely the frontend's: `Semantic::check` folds the parser's
# syntax findings (`Ast::File.errors`) in alongside the checker's semantic findings, and
# per-diagnostic wording + severity come from `Semantic::diagnostic_message` /
# `diagnostic_severity`. The LSP re-derives none of that — it only frames the JSON and
# maps source positions.
#
# FIXED (Elisa-core 742c2b4b): >=1 diagnostic used to abort with "assert failed" in
# elisacore_std/arena.elisa. Root cause was a stage0 backend bug — a caller's local darray
# routed to its own parallel arena had its backing split when passed to a forwarded-param
# grower (resolveRegionArenaArgs ignored darrayStackTag), so a later realloc straddled two
# arenas. The >=1-diagnostic path is now covered by test/diagnostics_test.sh.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "diagnostic_codes.elisa"
include "positions.elisa"

extern elisa_lsp_monotonic_millis() -> i64 can[Console]
extern elisa_lsp_timing_enabled() -> int can[Console]

# push_str/push_int/push_sview come from the frontend's `module Bytes` (inlined in
# semantic.elisa), pulled in via the include above; `using` makes them callable here.
using Bytes
# Source coordinates come from `module Positions` (src/positions.elisa): line
# offsets, UTF-16 conversion, and clamping. Unqualified here; other files in
# the unit call them as `Positions::...`.
using Positions

# Private lifetime counters used by `$/elisa/stats`. These are deliberately
# incremented next to the frontend calls below so the reported values count
# real frontend work, not LSP notifications or cache misses.
global mutable lsp_frontend_tokenize_calls: i64 = 0
global mutable lsp_frontend_parse_calls: i64 = 0
global mutable lsp_frontend_check_calls: i64 = 0

# The compiler's combined lexer result keeps the main parser stream and its
# comment side channel under one source-pass lifetime. The LSP wrapper keeps
# the compiler-owned type behind this small boundary so providers do not reach
# into compiler implementation details.
struct LspFrontendTokenBatch:
    tokens: darray[Lexer::Token]
    comments: darray[Lexer::Token]

# Q04 opt-in stage observations. These are the current message/job values;
# they are reset at each frame boundary. Child-worker values are returned in
# the trusted internal packet and installed in the parent before the message
# finishes. Zero means either a sub-millisecond stage or disabled timing, so
# the status probe also reports whether collection is enabled.
global mutable lsp_timing_enabled: bool = false
global mutable lsp_timing_decode_ms: i64 = 0
global mutable lsp_timing_edit_ms: i64 = 0
global mutable lsp_timing_line_index_ms: i64 = 0
global mutable lsp_timing_lex_ms: i64 = 0
global mutable lsp_timing_parse_ms: i64 = 0
global mutable lsp_timing_check_ms: i64 = 0
global mutable lsp_timing_index_ms: i64 = 0
global mutable lsp_timing_provider_ms: i64 = 0
global mutable lsp_timing_serialization_ms: i64 = 0
global mutable lsp_timing_queue_wait_ms: i64 = 0
global mutable lsp_timing_transport_ms: i64 = 0
global mutable lsp_timing_last_decode_ms: i64 = 0
global mutable lsp_timing_last_edit_ms: i64 = 0
global mutable lsp_timing_last_line_index_ms: i64 = 0
global mutable lsp_timing_last_lex_ms: i64 = 0
global mutable lsp_timing_last_parse_ms: i64 = 0
global mutable lsp_timing_last_check_ms: i64 = 0
global mutable lsp_timing_last_index_ms: i64 = 0
global mutable lsp_timing_last_provider_ms: i64 = 0
global mutable lsp_timing_last_serialization_ms: i64 = 0
global mutable lsp_timing_last_queue_wait_ms: i64 = 0
global mutable lsp_timing_last_transport_ms: i64 = 0


def lsp_timing_start() -> i64 can[Console]:
    return -1 if not lsp_timing_enabled
    return elisa_lsp_monotonic_millis() can Console


def lsp_timing_elapsed(started_ms: i64) -> i64 can[Console]:
    return 0 if not lsp_timing_enabled or started_ms < 0
    finished_ms: i64 = elisa_lsp_monotonic_millis() can Console
    return finished_ms - started_ms if finished_ms >= started_ms else 0


def lsp_timing_record(target: mutable i64&, started_ms: i64) -> void can[Console]:
    target <- lsp_timing_elapsed(started_ms) if lsp_timing_enabled


def lsp_timing_add(target: mutable i64&, started_ms: i64) -> void can[Console]:
    target <- target + lsp_timing_elapsed(started_ms) if lsp_timing_enabled


def lsp_timing_reset() -> void:
    lsp_timing_decode_ms <- 0
    lsp_timing_edit_ms <- 0
    lsp_timing_line_index_ms <- 0
    lsp_timing_lex_ms <- 0
    lsp_timing_parse_ms <- 0
    lsp_timing_check_ms <- 0
    lsp_timing_index_ms <- 0
    lsp_timing_provider_ms <- 0
    lsp_timing_serialization_ms <- 0
    lsp_timing_queue_wait_ms <- 0
    lsp_timing_transport_ms <- 0


def lsp_timing_commit() -> void:
    lsp_timing_last_decode_ms <- lsp_timing_decode_ms
    lsp_timing_last_edit_ms <- lsp_timing_edit_ms
    lsp_timing_last_line_index_ms <- lsp_timing_line_index_ms
    lsp_timing_last_lex_ms <- lsp_timing_lex_ms
    lsp_timing_last_parse_ms <- lsp_timing_parse_ms
    lsp_timing_last_check_ms <- lsp_timing_check_ms
    lsp_timing_last_index_ms <- lsp_timing_index_ms
    lsp_timing_last_provider_ms <- lsp_timing_provider_ms
    lsp_timing_last_serialization_ms <- lsp_timing_serialization_ms
    lsp_timing_last_queue_wait_ms <- lsp_timing_queue_wait_ms
    lsp_timing_last_transport_ms <- lsp_timing_transport_ms


# Count full-source tokenization at its only LSP entry point so semantic-token
# construction can reuse the same stream and the counter reflects real calls.
def tokenize_frontend_source(src: u8&, len: usize) -> LspFrontendTokenBatch:
    can Memory.Allocate, Abort.Panic, Console:
        timing_started_ms: i64 = lsp_timing_start() can Console
        lsp_frontend_tokenize_calls <- lsp_frontend_tokenize_calls + 1
        # The LSP owns a physical, in-memory snapshot.  Feed the compiler a
        # stable display name while using its expanded-unit lexer entry point:
        # this keeps `#line N path` directives from replacing physical buffer
        # lines or making a compiler display path look like the source URI.
        # The display name is intentionally not persisted or used for LSP
        # identity; every provider maps the returned source offsets back to the
        # document snapshot and echoes the client's URI spelling separately.
        frontend: Lexer::FrontendTokenBatch = Lexer::frontend_tokenize_expanded_unit_with_comments("<elisa-lsp>", src, len)
        lsp_timing_record(lsp_timing_lex_ms, timing_started_ms) can Console
        return LspFrontendTokenBatch{tokens: frontend.tokens, comments: frontend.comments}


# Render one diagnostic as an LSP `Diagnostic` JSON object. The message text and severity
# come straight from the frontend (`Semantic::diagnostic_message` / `diagnostic_severity`) —
# the LSP does NOT re-derive per-kind wording or severity, so the two stay in sync as the
# frontend gains new `DiagnosticKind`s. The LSP only owns the JSON framing and the
# source-position mapping.
#
# G01: exact ranges from `Diagnostic.pos` (1-based byte columns) converted to
# UTF-16 code units via `module Positions` (src/positions.elisa) and clamped
# inside the source snapshot. When the frontend has no span (`pos.end_column == 0`), fall back to
# the bounded line extent instead of inventing positions. Never emits 999.
# Multiline spans map each end on its own line; inverted ends collapse to start.
#
# Builds and returns its own buffer; the caller appends it with `body.extend(...)`. (An
# earlier arena-growth bug forced an element-wise copy here — a stack-tagged darray grown
# through a by-reference helper had its backing split across the base and its parallel
# stack. Fixed in Elisa-core: resolveRegionArenaArgs now peels the `&` a `mutable darray&`
# argument is wrapped in, so the helper grows into the darray's own stack.)
def diagnostic_json(d: Semantic::Diagnostic, src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool, related: bool, uri: sview) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        nlines: i64 = span_count.i64()
        last: i64 = nlines - 1
        # Prefer the frontend span; otherwise the report line.
        raw_line: i64 = d.pos.line.i64() if d.pos.line > 0 else d.line.i64()
        line1: i64 = 1 if raw_line < 1 else raw_line
        sline0: mutable i64 = line1 - 1
        sline0 <- last if sline0 > last
        eline0: mutable i64 = sline0
        schar: mutable i64 = 0
        echar: mutable i64 = line_unit_length_span_indexed(src, src_len, line_starts, span_start, span_count, sline0, utf8)
        if d.pos.end_column > 0 and d.pos.line > 0:
            el1: i64 = d.pos.end_line.i64() if d.pos.end_line >= d.pos.line else d.pos.line.i64()
            eline0 <- el1 - 1
            eline0 <- last if eline0 > last
            eline0 <- 0 if eline0 < 0
            scol_byte: i64 = d.pos.column.i64() - 1 if d.pos.column > 0 else 0
            ecol_byte: i64 = d.pos.end_column.i64() - 1
            schar <- byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, sline0, scol_byte, utf8)
            echar <- byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, eline0, ecol_byte, utf8)
            if eline0 == sline0 and echar < schar:
                echar <- schar
            if eline0 < sline0:
                eline0 <- sline0
                echar <- schar
            # Prefer the frontend's absolute half-open byte offsets when both
            # endpoints are in this physical snapshot and they agree with its
            # line/column fields. The agreement check protects against stale,
            # defaulted, or remapped offsets; those findings keep the bounded
            # line/column conversion above.
            offsets_in_snapshot: bool = frontend_offsets_valid(d.pos, src_len)
            if offsets_in_snapshot:
                physical_start: (line: i64, character: i64) = byte_offset_to_position_span_indexed(src, src_len, line_starts, span_start, span_count, d.pos.offset.usize(), utf8)
                physical_end: (line: i64, character: i64) = byte_offset_to_position_span_indexed(src, src_len, line_starts, span_start, span_count, d.pos.end_offset.usize(), utf8)
                if physical_start.line == sline0 and physical_start.character == schar and physical_end.line == eline0 and physical_end.character == echar:
                    sline0 <- physical_start.line
                    schar <- physical_start.character
                    eline0 <- physical_end.line
                    echar <- physical_end.character
        buffer: mutable darray[u8] = []
        buffer.push_str("{\"range\":{\"start\":{\"line\":")
        buffer.push_int(sline0)
        buffer.push_str(",\"character\":")
        buffer.push_int(schar)
        buffer.push_str("},\"end\":{\"line\":")
        buffer.push_int(eline0)
        buffer.push_str(",\"character\":")
        buffer.push_int(echar)
        buffer.push_str("}},\"severity\":")
        buffer.push_int(Semantic::diagnostic_severity(d).i64())
        # G01/G03: stable machine-readable identity is independent of the
        # compiler's user-facing wording.  The generated adapter maps every
        # supported DiagnosticKind to an explicit ELISA-* code and fails the
        # build when the compiler adds or renames a kind without a review.
        buffer.push_str(",\"code\":\"")
        json_escape_utf8(buffer, diagnostic_code(d.kind))
        buffer.push_str("\"")
        buffer.push_str(",\"source\":\"elisa\",\"message\":\"")
        msg_bytes: darray[u8] = Semantic::diagnostic_message(d)
        if msg_bytes.count > 0:
            json_escape_utf8(buffer, bytes_view_range_ref(msg_bytes, 0, msg_bytes.count))
        buffer.push_str("\"")
        # G03: expose the compiler's structured secondary location as LSP
        # `relatedInformation` (a duplicate declaration points at the original).
        # Only when the client advertises support and the frontend actually
        # carried a secondary line; otherwise the diagnostic is unchanged.
        if related and d.secondary_line > 0:
            srel0: mutable i64 = d.secondary_line.i64() - 1
            srel0 <- last if srel0 > last
            srel0 <- 0 if srel0 < 0
            rel_s: mutable i64 = 0
            rel_e: mutable i64 = line_unit_length_span_indexed(src, src_len, line_starts, span_start, span_count, srel0, utf8)
            if d.secondary_end_column > 0:
                rscol: i64 = d.secondary_column.i64() - 1 if d.secondary_column > 0 else 0
                recol: i64 = d.secondary_end_column.i64() - 1
                rel_s <- byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, srel0, rscol, utf8)
                rel_e <- byte_col_to_units_span_indexed(src, src_len, line_starts, span_start, span_count, srel0, recol, utf8)
                rel_e <- rel_s if rel_e < rel_s
            buffer.push_str(",\"relatedInformation\":[{\"location\":{\"uri\":\"")
            json_escape_utf8(buffer, uri)
            buffer.push_str("\",\"range\":{\"start\":{\"line\":")
            buffer.push_int(srel0)
            buffer.push_str(",\"character\":")
            buffer.push_int(rel_s)
            buffer.push_str("},\"end\":{\"line\":")
            buffer.push_int(srel0)
            buffer.push_str(",\"character\":")
            buffer.push_int(rel_e)
            buffer.push_str("}}},\"message\":\"first declared here\"}]")
        buffer.push_str("}")
        return buffer


# `{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":<uri>,"diagnostics":[...]}}`
#
# G02 versioned publication: the body carries the client's document `version`
# (when known) so the client can drop stale pushes; exact-duplicate findings
# are deduplicated; output is capped at MAX_DIAGNOSTICS with a visible hint
# entry rather than silent truncation. Returns the complete notification body;
# the caller (which owns the document lifecycle) decides eligibility and
# identical-repeat suppression before sending.
const MAX_DIAGNOSTICS: i64 = 200

def build_publish_body(uri: sview, table: Semantic::SymbolTable, src: u8&, src_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, version: i64, utf8: bool, related: bool) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        body: mutable darray[u8] = []
        body.push_str("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
        json_escape_utf8(body, uri)
        body.push_str("\",\"version\":")
        json_push_i64(body, version)
        body.push_str(",\"diagnostics\":[")
        # Render entries into a flat span buffer with per-entry bounds so exact
        # duplicates (same range, severity, wording) collapse. Scalar index
        # arrays only — no nested containers, per the region discipline.
        spans: mutable darray[u8] = []
        starts: mutable darray[usize] = []
        lens: mutable darray[usize] = []
        rendered: mutable i64 = 0
        truncated: mutable bool = false
        i: mutable usize = 0
        while i < diagnostic_count(table):
            entry: darray[u8] = diagnostic_json(diagnostic_at(table, i), src, src_len, line_starts, span_start, span_count, utf8, related, uri)
            dup: mutable bool = false
            k: mutable usize = 0
            while k < starts.count:
                st: usize = starts[k]
                ln: usize = lens[k]
                if ln == entry.count:
                    same: mutable bool = true
                    j: mutable usize = 0
                    while j < ln:
                        if spans[st + j] != entry[j]:
                            same <- false
                            break
                        j <- j + 1
                    dup <- true if same
                    break if dup
                k <- k + 1
            if not dup:
                if rendered >= MAX_DIAGNOSTICS:
                    # We only claim truncation after finding a distinct item
                    # beyond the emitted set. Frontend duplicates are removed
                    # before the cap and do not inflate an omitted count.
                    truncated <- true
                    break
                starts.push(spans.count)
                lens.push(entry.count)
                spans.extend([b for b in entry])
                rendered <- rendered + 1
            i <- i + 1
        q: mutable usize = 0
        while q < starts.count:
            body.push_str(",") if q > 0
            st: usize = starts[q]
            ln: usize = lens[q]
            j: mutable usize = 0
            while j < ln:
                body.push(spans[st + j])
                j <- j + 1
            q <- q + 1
        if truncated:
            body.push_str(",") if starts.count > 0
            body.push_str("{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":4,\"code\":\"ELISA-LSP-DiagnosticsTruncated\",\"source\":\"elisa-lsp\",\"message\":\"additional distinct diagnostics omitted (showing first ")
            body.push_int(rendered)
            body.push_str(")\"}")
        body.push_str("]}}")
        return body
