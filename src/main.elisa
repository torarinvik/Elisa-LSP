# Elisa Language Server — transport + initialize handshake + live diagnostics.
#
# Speaks LSP over stdio (JSON-RPC with Content-Length framing). Requests are parsed with
# the `Json` module (module Json, src/json.elisa). `textDocument/didOpen` and `didChange`
# run the real stage1 frontend (`Semantic::check`, src/diagnostics.elisa) and publish
# findings back as `textDocument/publishDiagnostics`.
# Runtime is pulled in transitively via diagnostics.elisa -> Elisa-compiler's parser,
# which carries its own copy of elisacore_std (a second copy would duplicate-declare).
include "diagnostics.elisa"
include "features/signature_help.elisa"
include "frontend_adapter.elisa"
include "json_writer.elisa"
include "json.elisa"
include "semtokens.elisa"
include "features/document_symbols.elisa"
include "features/hover.elisa"
include "features/completion.elisa"
include "features/definition.elisa"
include "features/references.elisa"
include "features/rename.elisa"
include "features/document_highlight.elisa"
include "features/folding.elisa"
include "features/selection.elisa"
include "uri.elisa"
include "documents.elisa"

# Byte-buffer builders (push_str/push_int/push_sview) come from the frontend's `module Bytes`
# (inlined in Elisa-compiler semantic.elisa), pulled in transitively via diagnostics.elisa.
# `using` makes them callable unqualified and as UFCS methods.
using Bytes

def ascii_lower(c: u8) -> u8:
    return (c.i64() + 32).u8() if c >= 65 and c <= 90 else c

extern elisa_lsp_read_retry(fd: int, buf: void&, count: usize) -> isize can[Console]
extern elisa_lsp_write_retry(fd: int, buf: void&, count: usize) -> isize can[Console]
extern elisa_lsp_write_all(fd: int, buf: void&, count: usize, timeout_millis: i64) -> isize can[Console]
extern elisa_lsp_output_begin(fd: int, timeout_millis: i64) -> int can[Console]
extern elisa_lsp_output_end(fd: int) -> int can[Console]
extern elisa_lsp_install_termination_handlers() -> int can[Console]
extern elisa_lsp_pending_termination_signal() -> int can[Console]
extern elisa_lsp_restore_termination_handlers() -> int can[Console]
extern elisa_lsp_max_header_bytes() -> i64 can[Console]
extern elisa_lsp_max_header_lines() -> i64 can[Console]
extern elisa_lsp_max_body_bytes() -> i64 can[Console]
extern elisa_lsp_max_open_source_bytes() -> i64 can[Console]
extern elisa_lsp_max_open_documents() -> i64 can[Console]
extern elisa_lsp_max_open_uri_bytes() -> i64 can[Console]
extern elisa_lsp_max_derived_cache_bytes() -> i64 can[Console]
extern elisa_lsp_write_timeout_millis() -> i64 can[Console]
extern elisa_lsp_analysis_worker_begin(timeout_millis: i64) -> int can[Console]
extern elisa_lsp_analysis_worker_write(buf: void&, count: usize) -> isize can[Console]
extern elisa_lsp_analysis_worker_child_exit(status: int) -> void can[Console]
extern elisa_lsp_analysis_worker_read_available(buf: void&, count: usize) -> isize can[Console]
extern elisa_lsp_analysis_worker_try_finish() -> int can[Console]
extern elisa_lsp_analysis_worker_abort() -> void can[Console]
extern elisa_lsp_analysis_worker_wait_event(timeout_millis: int) -> int can[Console]
extern elisa_lsp_analysis_timeout_millis() -> i64 can[Console]
extern elisa_lsp_validate_provider_ranges() -> int can[Console]
extern elisa_lsp_log_level() -> i64 can[Console]
extern elisa_lsp_log_max_bytes() -> i64 can[Console]


# One LSP process handles one connection and one initialize handshake. Keep
# lifecycle phases explicit so protocol gates cannot drift between handlers.
enum LspMessageStep:
    Next
    WaitInput
    Stop(status: i64)


enum LspFramePhase:
    Header
    Body


# Persistent transport state. Header and body bytes survive event-loop turns,
# so a split frame is parsed once as bytes arrive instead of rescanning a
# growing prefix or blocking until the complete body has been read.
struct LspFrameDecoder:
    phase: mutable LspFramePhase
    active: mutable bool
    header_line: mutable darray[u8]
    body: mutable darray[u8]
    header_bytes: mutable i64
    header_lines: mutable i64
    content_length: mutable i64
    body_remaining: mutable i64
    content_type_seen: mutable bool
    content_encoding_seen: mutable bool


# Parent-side identity and partial packet state for one foreground analysis.
# Pending document snapshots live in DocumentLifecycle and coalesce by job id;
# this record is only the bounded in-flight worker.
struct LspAnalysisWorkerRuntime:
    packet: mutable darray[u8]
    slot: mutable usize
    source_len: mutable usize
    job_id: mutable i64
    generation: mutable i64
    version: mutable i64
    uri_hash: mutable i64
    source_hash: mutable i64
    active: mutable bool
    eof_seen: mutable bool
    utf8: mutable bool
    symbols_hier: mutable bool
    related: mutable bool


struct LspPendingAnalysisRequest:
    body_start: mutable usize
    body_len: mutable usize
    key_start: mutable usize
    key_len: mutable usize
    response_id_start: mutable usize
    response_id_len: mutable usize
    slot: mutable usize
    job_id: mutable i64
    generation: mutable i64
    version: mutable i64
    priority: mutable i64
    queued_at_ms: mutable i64
    ready: mutable bool


struct LspPendingAnalysisQueue:
    requests: mutable darray[LspPendingAnalysisRequest]
    storage: mutable darray[u8]
    body_bytes: mutable usize


# The response boundary uses one validator for every range-bearing provider.
# Semantic-token payloads have their compact delta shape checked separately;
# all other provider payloads are walked recursively so nested locations,
# selection ranges, and folding line/character pairs receive the same source
# snapshot and negotiated-unit checks.
enum ProviderRangeKind:
    Standard
    SemanticTokens
    DocumentSymbols
    # SelectionRange responses preserve the order of the requested positions;
    # their result array is intentionally not source-ordered.
    SelectionRanges


enum LspLifecycleState:
    Uninitialized
    Initializing
    Running
    Initialized
    ShutdownRequested
    Exited


# Scalar session settings live behind one mutable record so one-message
# processing can inspect and update them without exposing scalar reference
# wrappers to the message dispatch code.
struct LspSessionState:
    lifecycle: mutable LspLifecycleState
    pos_utf8: mutable bool
    hover_markdown: mutable bool
    rename_document_changes: mutable bool
    completion_kind_limited: mutable bool
    completion_snippet_support: mutable bool
    completion_insert_replace_support: mutable bool
    completion_commit_characters_support: mutable bool
    completion_label_details_support: mutable bool
    definition_link_support: mutable bool
    symbols_hier: mutable bool
    diag_related: mutable bool
    fold_limit: mutable i64
    # The analysis deadline starts from the process environment and may be
    # overridden by validated initialize-time or didChangeConfiguration
    # settings for this one connection. Keep it in the session record so a
    # future multi-session embedding cannot accidentally share configuration.
    analysis_timeout_ms: mutable i64


const MAX_WORKSPACE_ROOTS: i64 = 32

# P03 configuration bounds. These deliberately match the POSIX worker's
# environment contract so initialize-time settings cannot create a value that
# the worker rejects later (or that silently disables the deadline).
const MIN_ANALYSIS_TIMEOUT_MS: i64 = 100
const MAX_ANALYSIS_TIMEOUT_MS: i64 = 300000

# ---- stdio byte transport ---------------------------------------------------------
#
# T01: buffered, bounded input framing. One reusable read buffer holds bytes
# read ahead of the current cursor, so a single `read` may deliver several
# messages, part of a message, or a multibyte UTF-8 sequence that the cursor
# must not split. Frames are read only from this buffer; consumed prefixes are
# reclaimed on refill. Limits are conservative and documented; a violation is
# a controlled session failure (main returns nonzero) rather than an unbounded
# allocation or a silent mis-frame.
const TRANSPORT_CHUNK: usize = 8192
global mutable lsp_transport_output_failed: bool = false
global mutable lsp_transport_input_failed: bool = false
global mutable lsp_transport_input_eof: bool = false
global mutable lsp_transport_write_timeout_ms: i64 = 15000
global mutable lsp_frontend_validation_failure_logs: i64 = 0
global mutable lsp_analysis_worker_failure_logs: i64 = 0
global mutable lsp_analysis_job_sequence: i64 = 0
global mutable lsp_analysis_timeout_ms: i64 = 30000
global mutable lsp_max_open_source_bytes: i64 = 268435456
global mutable lsp_max_open_documents: i64 = 1024
global mutable lsp_max_open_uri_bytes: i64 = 8388608
global mutable lsp_max_derived_cache_bytes: i64 = 67108864
global mutable lsp_document_admission_rejection_logs: i64 = 0
global mutable lsp_line_index_build_calls: i64 = 0
global mutable lsp_line_index_fallback_build_calls: i64 = 0
global mutable lsp_validate_provider_ranges: bool = false
global mutable lsp_provider_range_failure_logs: i64 = 0
global mutable lsp_cache_access_clock: i64 = 0
global mutable lsp_cache_eviction_count: i64 = 0

# R05 observability. Informational/debug lines are opt-in and every stderr
# write shares one process-wide byte budget. These globals are session-local in
# practice because one server process handles one stdio connection.
const LSP_LOG_OFF: i64 = 0
const LSP_LOG_ERROR: i64 = 1
const LSP_LOG_WARN: i64 = 2
const LSP_LOG_INFO: i64 = 3
const LSP_LOG_DEBUG: i64 = 4
const LSP_CACHE_NONE: i64 = 0
const LSP_CACHE_MISS: i64 = 1
const LSP_CACHE_HIT: i64 = 2
const LSP_CACHE_INVALID: i64 = 3
const LSP_CACHE_FAILED: i64 = 4
const LSP_CACHE_UPDATED: i64 = 5
const LSP_CACHE_SUPPRESSED: i64 = 6
global mutable lsp_log_level: i64 = LSP_LOG_WARN
global mutable lsp_log_max_bytes: i64 = 65536
global mutable lsp_log_bytes_written: i64 = 0
global mutable lsp_last_cache_outcome: i64 = LSP_CACHE_NONE
global mutable lsp_last_document_generation: i64 = -1
global mutable lsp_last_analysis_status: i64 = 0

# Keep retained line starts within an 8 MiB logical budget on arm64. The
# backing darray can reserve somewhat more while growing, but the active entry
# count is capped here and reported separately from its capacity.
const MAX_RETAINED_LINE_INDEX_ENTRIES: usize = 1048576


# Restore the process signal state on every orderly server exit. POSIX signal
# handlers only record the first termination signal; this converts it to the
# conventional 128 + signal status after restoring the caller's dispositions.
def transport_finish(status: i64) -> i64 can[Console]:
    # Any exit path owns cleanup of the single active child and its pipe.
    elisa_lsp_analysis_worker_abort() can Console
    signal_number: mutable int = elisa_lsp_pending_termination_signal() can Console
    restored: int = elisa_lsp_restore_termination_handlers() can Console
    if signal_number == 0:
        signal_number <- elisa_lsp_pending_termination_signal() can Console
    return 1 if restored != 0
    return 128 + signal_number.i64() if signal_number != 0
    return status


# Ensure at least one unconsumed byte is available. False only at clean EOF
# with nothing buffered.
def transport_fill(buf: mutable darray[u8]&, pos: mutable usize&) -> bool can[Console, Memory.Allocate, Abort.Panic]:
    true return if pos[0] < buf.count
    # Cursor reached the end: the whole buffer is consumed; reclaim it.
    buf.truncate(0)
    pos[0] <- 0
    start: usize = buf.count
    i: mutable usize = 0
    while i < TRANSPORT_CHUNK:
        buf.push(0)
        i <- i + 1
    got: isize = elisa_lsp_read_retry(0, (&buf[start]).cast[void&], TRANSPORT_CHUNK) can Console
    if got <= 0:
        lsp_transport_input_failed <- true if got < 0
        lsp_transport_input_eof <- true if got == 0
        buf.truncate(start)
        return false
    buf.truncate(start + got.usize())
    return true


# Header field names use the HTTP token grammar. LSP headers themselves are
# ASCII; values may contain horizontal tab and visible ASCII only.
def header_token_byte(c: u8) -> bool:
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 33 or c == 35 or c == 36 or c == 37 or c == 38 or c == 39 or c == 42 or c == 43 or c == 45 or c == 46 or c == 94 or c == 95 or c == 96 or c == 124 or c == 126


# Return the colon position, or -1 for a malformed header name / missing colon.
def header_colon(line: darray[u8]) -> i64:
    i: mutable usize = 0
    while i < line.count:
        c: u8 = line[i]
        return i.i64() if c == 58
        return -1 if not header_token_byte(c)
        i <- i + 1
    return -1


def header_line_valid(line: darray[u8]) -> bool:
    colon: i64 = header_colon(line)
    return false if colon <= 0
    i: mutable usize = colon.usize() + 1
    while i < line.count:
        c: u8 = line[i]
        return false if c != 9 and (c < 32 or c > 126)
        i <- i + 1
    return true


def header_name_is(line: darray[u8], name: sview) -> bool:
    colon: i64 = header_colon(line)
    return false if colon != name.len
    i: mutable usize = 0
    while i < colon.usize():
        return false if ascii_lower(line[i]) != ascii_lower(sview_at(name, i))
        i <- i + 1
    return true


def header_token_at(line: darray[u8], start: usize, token: sview) -> bool:
    return false if line.count < start or line.count - start < token.len.usize()
    i: mutable usize = 0
    while i < token.len.usize():
        return false if ascii_lower(line[start + i]) != ascii_lower(sview_at(token, i))
        i <- i + 1
    return true


def skip_header_ows(line: darray[u8], pos: mutable usize&) -> void:
    while pos[0] < line.count and (line[pos[0]] == 32 or line[pos[0]] == 9):
        pos[0] <- pos[0] + 1


# Content-Type is optional and defaults to JSON-RPC UTF-8. For compatibility,
# both the current "utf-8" spelling and historical "utf8" spelling are
# accepted. Unknown parameters or charsets are rejected rather than decoding
# the body with an encoding the server does not implement.
def content_type_valid(line: darray[u8]) -> bool:
    colon: i64 = header_colon(line)
    pos: mutable usize = colon.usize() + 1
    skip_header_ows(line, pos)
    media: sview = sview("application/vscode-jsonrpc", 0, -1)
    media_start: usize = pos
    while pos < line.count and line[pos] != 59:
        pos <- pos + 1
    media_end: mutable usize = pos
    while media_end > media_start and (line[media_end - 1] == 32 or line[media_end - 1] == 9):
        media_end <- media_end - 1
    return false if media_end - media_start != media.len.usize()
    i: mutable usize = 0
    while i < media.len.usize():
        return false if ascii_lower(line[media_start + i]) != ascii_lower(sview_at(media, i))
        i <- i + 1
    return true if pos == line.count
    pos <- pos + 1
    skip_header_ows(line, pos)
    charset: sview = sview("charset", 0, -1)
    return false if not header_token_at(line, pos, charset)
    pos <- pos + charset.len.usize()
    skip_header_ows(line, pos)
    return false if pos >= line.count or line[pos] != 61
    pos <- pos + 1
    skip_header_ows(line, pos)
    quoted: bool = pos < line.count and line[pos] == 34
    pos <- pos + 1 if quoted
    value_start: usize = pos
    while pos < line.count and (header_token_byte(line[pos]) or line[pos] == 45):
        pos <- pos + 1
    value_len: usize = pos - value_start
    valid_charset: mutable bool = value_len == 5 and header_token_at(line, value_start, "utf-8")
    valid_charset <- (value_len == 4 and header_token_at(line, value_start, "utf8")) or valid_charset
    return false if not valid_charset
    return false if quoted and (pos >= line.count or line[pos] != 34)
    pos <- pos + 1 if quoted
    skip_header_ows(line, pos)
    return pos == line.count


# Content-Encoding is not used for LSP bodies. Explicit identity is harmless;
# compressed or otherwise transformed bodies are unsupported.
def content_encoding_valid(line: darray[u8]) -> bool:
    colon: i64 = header_colon(line)
    pos: mutable usize = colon.usize() + 1
    skip_header_ows(line, pos)
    encoding: sview = sview("identity", 0, -1)
    return false if line.count - pos != encoding.len.usize()
    return header_token_at(line, pos, encoding)


# Parse a `Content-Length:` header line strictly.
#   >= 0  the length
#   -1    not a Content-Length header (ignored)
#   -2    malformed Content-Length (non-digit, empty, or i64 overflow) — fatal
# Header names are case-insensitive; the value admits surrounding spaces but no
# other characters, so `Content-Length: 5x` and `Content-Length:` are rejected
# instead of silently parsing as 5 and 0.
def content_length_of(line: darray[u8]) -> i64 can[Memory.Allocate, Abort.Panic]:
    -1 return if not header_name_is(line, "content-length")
    colon: i64 = header_colon(line)
    i: mutable usize = colon.usize() + 1
    skip_header_ows(line, i)
    end: mutable usize = line.count
    while end > i and (line[end - 1] == 32 or line[end - 1] == 9):
        end <- end - 1
    -2 return if i >= end
    n: mutable i64 = 0
    limit: i64 = 922337203685477580
    while i < end:
        ch: u8 = line[i]
        -2 return if ch < 48 or ch > 57
        d: i64 = ch.i64() - 48
        -2 return if n > limit or (n == limit and d > 7)
        n <- n * 10 + d
        i <- i + 1
    return n


# Reset all per-frame parser state while keeping bounded darray capacity for
# reuse by the next frame.
def frame_decoder_reset(decoder: mutable LspFrameDecoder&) -> void:
    decoder.phase <- LspFramePhase.Header
    decoder.active <- false
    decoder.header_line.truncate(0)
    decoder.body.truncate(0)
    decoder.header_bytes <- 0
    decoder.header_lines <- 0
    decoder.content_length <- -1
    decoder.body_remaining <- 0
    decoder.content_type_seen <- false
    decoder.content_encoding_seen <- false


# Consume only bytes already present in `buf`. Results are 0 for clean EOF,
# 1 for a complete frame, 2 when more input is needed, and negative for
# malformed or truncated framing. Header and body progress remains in
# `decoder` across event-loop turns.
def frame_decoder_step(body: mutable darray[u8]&, decoder: mutable LspFrameDecoder&, buf: mutable darray[u8]&, pos: mutable usize&, max_header_bytes: i64, max_header_lines: i64, max_body_bytes: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    decoder.active <- true
    while true:
        if decoder.phase == LspFramePhase.Header:
            while pos[0] < buf.count and decoder.phase == LspFramePhase.Header:
                b: u8 = buf[pos[0]]
                pos[0] <- pos[0] + 1
                decoder.header_bytes <- decoder.header_bytes + 1
                return -1 if decoder.header_bytes > max_header_bytes
                if b == 10:
                    return -1 if decoder.header_line.count == 0 or decoder.header_line[decoder.header_line.count - 1] != 13
                    decoder.header_line.truncate(decoder.header_line.count - 1)
                    decoder.header_lines <- decoder.header_lines + 1
                    return -1 if decoder.header_lines > max_header_lines
                    if decoder.header_line.count == 0:
                        return -1 if decoder.content_length < 0 or decoder.content_length > max_body_bytes
                        decoder.body_remaining <- decoder.content_length
                        decoder.phase <- LspFramePhase.Body
                        if decoder.body_remaining == 0:
                            body.truncate(0)
                            frame_decoder_reset(decoder)
                            return 1
                    else:
                        return -1 if not header_line_valid(decoder.header_line)
                        cl: i64 = content_length_of(decoder.header_line)
                        return -1 if cl == -2
                        if cl >= 0:
                            return -1 if decoder.content_length >= 0 and decoder.content_length != cl
                            decoder.content_length <- cl
                        if header_name_is(decoder.header_line, "content-type"):
                            return -1 if decoder.content_type_seen or not content_type_valid(decoder.header_line)
                            decoder.content_type_seen <- true
                        if header_name_is(decoder.header_line, "content-encoding"):
                            return -1 if decoder.content_encoding_seen or not content_encoding_valid(decoder.header_line)
                            decoder.content_encoding_seen <- true
                    decoder.header_line.truncate(0)
                else:
                    decoder.header_line.push(b)
            if decoder.phase == LspFramePhase.Header:
                return -2 if lsp_transport_input_eof and (decoder.header_bytes > 0 or decoder.header_line.count > 0 or decoder.header_lines > 0)
                return 0 if lsp_transport_input_eof
                return 2
        available: i64 = (buf.count - pos[0]).i64()
        if available > 0:
            take: i64 = available if available < decoder.body_remaining else decoder.body_remaining
            i: mutable usize = 0
            while i < take.usize():
                decoder.body.push(buf[pos[0] + i])
                i <- i + 1
            pos[0] <- pos[0] + take.usize()
            decoder.body_remaining <- decoder.body_remaining - take
        if decoder.body_remaining == 0:
            body.truncate(0)
            copy_index: mutable usize = 0
            while copy_index < decoder.body.count:
                body.push(decoder.body[copy_index])
                copy_index <- copy_index + 1
            frame_decoder_reset(decoder)
            return 1
        return -3 if lsp_transport_input_eof
        return 2
    return -1


# ---- request inspection (Json module) ----------------------------------------------

# The decoded message `method` as a view into caller-owned scratch storage.
def request_method(root: Json::Value, out: mutable darray[u8]&) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out.truncate(0)
        if Json::get(root, "method") is m:
            match m:
                Json::Value.Str(_):
                    Json::decode_into(m, out)
                    return bytes_view_range_ref(out, 0, out.count) if out.count > 0
                _:
                    pass
        return sview("", 0, 0)


# Whether the message's method equals `name`.
def method_is(root: Json::Value, name: cstr?) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        decoded: mutable darray[u8] = []
        return string_view_eq(request_method(root, decoded), name) == 1


# Compare a JSON string after expanding JSON escapes.
def json_string_is(value: Json::Value, expected: cstr?) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                view: sview = bytes_view_range_ref(decoded, 0, decoded.count) if decoded.count > 0 else sview("", 0, 0)
                return string_view_eq(view, expected) == 1
            _:
                return false


# Required string fields such as TextDocumentItem.languageId must contain at
# least one decoded byte. Inspect decoded content so an escaped empty string is
# treated consistently with its unescaped spelling.
def json_string_nonempty(value: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                return decoded.count > 0
            _:
                return false


# JSON-RPC notifications omit `id`; this separate predicate also catches
# present-but-invalid IDs, which must be rejected as InvalidRequest.
def request_id_present(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return Json::count_key(root, "id") > 0


# An LSP request ID is a string or an integer number. Fractional, null, and
# other JSON values are invalid; emit a null response ID for those envelopes.
def request_id_valid(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "id") is idv:
            match idv:
                Json::Value.Num(_):
                    match Json::as_lsp_integer_result(idv):
                        Json::I64ParseOutcome.Valid(_):
                            return true
                        Json::I64ParseOutcome.Invalid:
                            return false
                Json::Value.Str(_):
                    return true
                _:
                    return false
        return true


def envelope_has_critical_duplicates(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return true if Json::count_key(root, "jsonrpc") > 1
        return true if Json::count_key(root, "method") > 1
        return true if Json::count_key(root, "id") > 1
        return true if Json::count_key(root, "params") > 1
        return false


def json_string_values_equal(left: Json::Value, right: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match left:
            Json::Value.Str(_):
                match right:
                    Json::Value.Str(_):
                        left_bytes: mutable darray[u8] = []
                        right_bytes: mutable darray[u8] = []
                        Json::decode_into(left, left_bytes)
                        Json::decode_into(right, right_bytes)
                        left_view: sview = bytes_view_range_ref(left_bytes, 0, left_bytes.count) if left_bytes.count > 0 else sview("", 0, 0)
                        right_view: sview = bytes_view_range_ref(right_bytes, 0, right_bytes.count) if right_bytes.count > 0 else sview("", 0, 0)
                        return string_views_eq(left_view, right_view) != 0
                    _:
                        return false
            _:
                return false


def root_is_object(root: Json::Value) -> bool:
    match root:
        Json::Value.Obj(_):
            return true
        _:
            return false


def is_unmatched_response(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(root, "method") > 0
        return Json::count_key(root, "result") > 0 or Json::count_key(root, "error") > 0


def params_shape_valid(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            match params:
                Json::Value.Obj(_) | Json::Value.Arr(_):
                    return true
                _:
                    return false
        return true


def nonnegative_json_integer(value: Json::Value) -> bool:
    match Json::as_lsp_uinteger_result(value):
        Json::I64ParseOutcome.Valid(_):
            return true
        Json::I64ParseOutcome.Invalid:
            return false


def lsp_position_valid(position: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(position)
        return false if Json::count_key(position, "line") != 1 or Json::count_key(position, "character") != 1
        if Json::get(position, "line") is line and Json::get(position, "character") is character:
            return nonnegative_json_integer(line) and nonnegative_json_integer(character)
        return false


def signature_help_context_valid(context: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(context) or Json::count_key(context, "triggerKind") != 1 or Json::count_key(context, "isRetrigger") != 1
        trigger_kind: mutable i64 = -1
        if Json::get(context, "triggerKind") is trigger_value:
            match Json::as_lsp_uinteger_result(trigger_value):
                Json::I64ParseOutcome.Valid(kind):
                    trigger_kind <- kind
                    return false if kind < 1 or kind > 3
                Json::I64ParseOutcome.Invalid:
                    return false
        else:
            return false
        if Json::get(context, "isRetrigger") is retrigger:
            match retrigger:
                Json::Value.Bool(_):
                    pass
                _:
                    return false
        else:
            return false
        if trigger_kind == 2:
            return false if Json::count_key(context, "triggerCharacter") != 1
            if Json::get(context, "triggerCharacter") is character:
                match character:
                    Json::Value.Str(_):
                        decoded_character: mutable darray[u8] = []
                        Json::decode_into(character, decoded_character)
                        return false if decoded_character.count == 0
                    _:
                        return false
            else:
                return false
        else:
            return false if Json::count_key(context, "triggerCharacter") != 0
        if Json::count_key(context, "activeSignatureHelp") > 0:
            return false if Json::count_key(context, "activeSignatureHelp") != 1
            if Json::get(context, "activeSignatureHelp") is active:
                return false if not root_is_object(active)
        return true


def completion_context_valid(context: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(context)
        return false if Json::count_key(context, "triggerKind") != 1 or Json::count_key(context, "triggerCharacter") > 1
        trigger_kind: mutable i64 = -1
        if Json::get(context, "triggerKind") is trigger_value:
            match Json::as_lsp_uinteger_result(trigger_value):
                Json::I64ParseOutcome.Valid(kind):
                    trigger_kind <- kind
                    return false if kind < 1 or kind > 3
                Json::I64ParseOutcome.Invalid:
                    return false
        else:
            return false
        if trigger_kind == 2:
            return false if Json::count_key(context, "triggerCharacter") != 1
            if Json::get(context, "triggerCharacter") is character:
                match character:
                    Json::Value.Str(_):
                        decoded_character: mutable darray[u8] = []
                        Json::decode_into(character, decoded_character)
                        return false if decoded_character.count == 0
                        first_scalar: usize = Positions::utf8_scalar_length(&decoded_character[0], 0, decoded_character.count, 0)
                        return first_scalar == decoded_character.count
                    _:
                        return false
            return false
        return Json::count_key(context, "triggerCharacter") == 0


def lsp_range_valid(range: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(range)
        return false if Json::count_key(range, "start") != 1 or Json::count_key(range, "end") != 1
        if Json::get(range, "start") is start and Json::get(range, "end") is finish:
            return false if not lsp_position_valid(start) or not lsp_position_valid(finish)
            if Json::get(start, "line") is start_line_value and Json::get(start, "character") is start_char_value and Json::get(finish, "line") is end_line_value and Json::get(finish, "character") is end_char_value:
                start_line: i64 = Json::as_lsp_uinteger_or_invalid(start_line_value)
                start_char: i64 = Json::as_lsp_uinteger_or_invalid(start_char_value)
                end_line: i64 = Json::as_lsp_uinteger_or_invalid(end_line_value)
                end_char: i64 = Json::as_lsp_uinteger_or_invalid(end_char_value)
                return start_line < end_line or (start_line == end_line and start_char <= end_char)
        return false


def text_document_uri_valid(params: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(params, "textDocument") != 1
        if Json::get(params, "textDocument") is td:
            if root_is_object(td) and Json::count_key(td, "uri") == 1 and Json::get(td, "uri") is uri:
                match uri:
                    Json::Value.Str(_):
                        return true
                    _:
                        return false
        return false


def decoded_string_nonempty(value: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                return decoded.count > 0
            _:
                return false


# Validate every workspace root consumed by collect_roots. Ambiguous escaped
# duplicate keys or malformed array entries must fail initialize before roots
# or lifecycle state are changed.
def initialize_workspace_folders_valid(params: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(params, "workspaceFolders") > 1 or Json::count_key(params, "rootUri") > 1
        if Json::get(params, "workspaceFolders") is folders:
            match folders:
                Json::Value.Null:
                    pass
                Json::Value.Arr(items):
                    return false if items.count.i64() > MAX_WORKSPACE_ROOTS
                    for folder in items:
                        return false if not root_is_object(folder)
                        return false if Json::count_key(folder, "uri") != 1 or Json::count_key(folder, "name") != 1
                        if Json::get(folder, "uri") is uri and Json::get(folder, "name") is name:
                            return false if not decoded_string_nonempty(uri)
                            match name:
                                Json::Value.Str(_):
                                    pass
                                _:
                                    return false
                        else:
                            return false
                _:
                    return false
        if Json::get(params, "rootUri") is root_uri:
            match root_uri:
                Json::Value.Null:
                    pass
                Json::Value.Str(_):
                    return false if not decoded_string_nonempty(root_uri)
                _:
                    return false
        return true


# P03: the standard `initializationOptions` and
# `workspace/didChangeConfiguration.settings` fields are intentionally open
# extension points. Elisa consumes one namespaced object only:
# `{\"elisa\": {\"analysisTimeoutMs\": integer}}`. Unknown options remain
# client-owned and are ignored, while a malformed value for a recognized key
# is rejected before initialize state or settings are changed.
def analysis_timeout_setting_valid(value: Json::Value) -> bool:
    match Json::as_lsp_integer_result(value):
        Json::I64ParseOutcome.Valid(timeout_ms):
            return timeout_ms >= MIN_ANALYSIS_TIMEOUT_MS and timeout_ms <= MAX_ANALYSIS_TIMEOUT_MS
        Json::I64ParseOutcome.Invalid:
            return false


def elisa_configuration_scope_valid(scope: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match scope:
            Json::Value.Null:
                return true
            Json::Value.Obj(_):
                return false if Json::count_key(scope, "analysisTimeoutMs") > 1
                if Json::get(scope, "analysisTimeoutMs") is timeout_value:
                    return analysis_timeout_setting_valid(timeout_value)
                return true
            _:
                return false


def configuration_extension_valid(container: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match container:
            Json::Value.Obj(_):
                return false if Json::count_key(container, "elisa") > 1
                if Json::get(container, "elisa") is elisa:
                    return elisa_configuration_scope_valid(elisa)
                return true
            # `initializationOptions` and `settings` are `any` in the LSP
            # model. A client may use a scalar/array for another extension;
            # it carries no Elisa settings and is therefore valid to ignore.
            _:
                return true


def initialize_options_valid(params: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(params, "initializationOptions") > 1
        if Json::get(params, "initializationOptions") is options:
            return configuration_extension_valid(options)
        return true


def configuration_settings_valid(params: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(params, "settings") != 1
        if Json::get(params, "settings") is settings:
            return configuration_extension_valid(settings)
        return false


def configured_analysis_timeout_scope(scope: Json::Value, current: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match scope:
            Json::Value.Obj(_):
                if Json::get(scope, "analysisTimeoutMs") is timeout_value:
                    match Json::as_lsp_integer_result(timeout_value):
                        Json::I64ParseOutcome.Valid(timeout_ms):
                            return timeout_ms if timeout_ms >= MIN_ANALYSIS_TIMEOUT_MS and timeout_ms <= MAX_ANALYSIS_TIMEOUT_MS
                        Json::I64ParseOutcome.Invalid:
                            pass
                return current
            _:
                return current


def configured_analysis_timeout(container: Json::Value, current: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match container:
            Json::Value.Obj(_):
                # Only the namespaced object is server-owned. A same-named
                # member at the top level belongs to another extension and is
                # deliberately ignored.
                if Json::get(container, "elisa") is elisa:
                    return configured_analysis_timeout_scope(elisa, current)
                return current
            _:
                return current


def initialize_analysis_timeout(root: Json::Value, current: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "initializationOptions") is options:
                return configured_analysis_timeout(options, current)
        return current


def apply_configuration_notification(root: Json::Value, state: mutable LspSessionState&) -> void can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "settings") is settings:
                updated: i64 = configured_analysis_timeout(settings, state.analysis_timeout_ms)
                if updated != state.analysis_timeout_ms:
                    state.analysis_timeout_ms <- updated
                    # The current server has one synchronous session. Keep the
                    # worker entry point on the same validated value; the
                    # state field is the source of truth for future sessions.
                    lsp_analysis_timeout_ms <- updated


def initialize_consumed_keys_unique(params: Json::Value, caps: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if Json::count_key(params, "workspaceFolders") > 1 or Json::count_key(params, "rootUri") > 1
        return false if not initialize_options_valid(params)
        return false if Json::count_key(caps, "general") > 1 or Json::count_key(caps, "textDocument") > 1 or Json::count_key(caps, "workspace") > 1
        if Json::get(caps, "general") is general:
            return false if not root_is_object(general) or Json::count_key(general, "positionEncodings") > 1
        if Json::get(caps, "workspace") is workspace:
            return false if not root_is_object(workspace) or Json::count_key(workspace, "workspaceEdit") > 1
            if Json::get(workspace, "workspaceEdit") is workspace_edit:
                return false if not root_is_object(workspace_edit) or Json::count_key(workspace_edit, "documentChanges") > 1
                if Json::get(workspace_edit, "documentChanges") is document_changes:
                    match document_changes:
                        Json::Value.Bool(_):
                            pass
                        _:
                            return false
        if Json::get(caps, "textDocument") is td:
            return false if not root_is_object(td)
            return false if Json::count_key(td, "hover") > 1 or Json::count_key(td, "documentSymbol") > 1 or Json::count_key(td, "completion") > 1
            return false if Json::count_key(td, "publishDiagnostics") > 1 or Json::count_key(td, "foldingRange") > 1
            return false if Json::count_key(td, "semanticTokens") > 1
            if Json::get(td, "semanticTokens") is semantic:
                return false if not root_is_object(semantic) or Json::count_key(semantic, "tokenTypes") != 1 or Json::count_key(semantic, "tokenModifiers") > 1
                if Json::get(semantic, "tokenTypes") is token_types:
                    match token_types:
                        Json::Value.Arr(items):
                            return false if items.count.i64() > SEMTOK_MAX_CLIENT_TOKEN_TYPES
                            for i in 0..<items.count:
                                current: Json::Value = items[i]
                                match current:
                                    Json::Value.Str(_):
                                        decoded: mutable darray[u8] = []
                                        Json::decode_into(current, decoded)
                                        return false if decoded.count == 0 or decoded.count.i64() > 128
                                    _:
                                        return false
                                for previous in 0..<i:
                                    return false if json_string_values_equal(current, items[previous])
                        _:
                            return false
                if Json::get(semantic, "tokenModifiers") is token_modifiers:
                    match token_modifiers:
                        Json::Value.Arr(items):
                            return false if items.count.i64() > SEMTOK_MAX_CLIENT_TOKEN_MODIFIERS
                            for i in 0..<items.count:
                                current: Json::Value = items[i]
                                match current:
                                    Json::Value.Str(_):
                                        decoded: mutable darray[u8] = []
                                        Json::decode_into(current, decoded)
                                        return false if decoded.count == 0 or decoded.count.i64() > 128
                                    _:
                                        return false
                                for previous in 0..<i:
                                    return false if json_string_values_equal(current, items[previous])
                        _:
                            return false
            if Json::get(td, "hover") is hover:
                return false if not root_is_object(hover) or Json::count_key(hover, "contentFormat") > 1
            return false if Json::count_key(td, "definition") > 1
            if Json::get(td, "definition") is definition:
                return false if not root_is_object(definition) or Json::count_key(definition, "linkSupport") > 1
                if Json::get(definition, "linkSupport") is link_support:
                    match link_support:
                        Json::Value.Bool(_):
                            pass
                        _:
                            return false
            if Json::get(td, "documentSymbol") is ds:
                return false if not root_is_object(ds) or Json::count_key(ds, "hierarchicalDocumentSymbolSupport") > 1 or Json::count_key(ds, "symbolKind") > 1
                if Json::get(ds, "symbolKind") is sk:
                    return false if not root_is_object(sk) or Json::count_key(sk, "valueSet") > 1
            if Json::get(td, "publishDiagnostics") is pd:
                return false if not root_is_object(pd) or Json::count_key(pd, "relatedInformation") > 1
            if Json::get(td, "foldingRange") is fr:
                return false if not root_is_object(fr) or Json::count_key(fr, "rangeLimit") > 1
            if Json::get(td, "completion") is completion:
                return false if not root_is_object(completion) or Json::count_key(completion, "completionItemKind") > 1
                return false if Json::count_key(completion, "completionItem") > 1
                if Json::get(completion, "completionItem") is completion_item:
                    return false if not root_is_object(completion_item) or Json::count_key(completion_item, "snippetSupport") > 1 or Json::count_key(completion_item, "insertReplaceSupport") > 1 or Json::count_key(completion_item, "commitCharactersSupport") > 1 or Json::count_key(completion_item, "labelDetailsSupport") > 1
                    if Json::get(completion_item, "snippetSupport") is snippet_support:
                        match snippet_support:
                            Json::Value.Bool(_):
                                pass
                            _:
                                return false
                    if Json::get(completion_item, "insertReplaceSupport") is insert_replace_support:
                        match insert_replace_support:
                            Json::Value.Bool(_):
                                pass
                            _:
                                return false
                    if Json::get(completion_item, "commitCharactersSupport") is commit_characters_support:
                        match commit_characters_support:
                            Json::Value.Bool(_):
                                pass
                            _:
                                return false
                    if Json::get(completion_item, "labelDetailsSupport") is label_details_support:
                        match label_details_support:
                            Json::Value.Bool(_):
                                pass
                            _:
                                return false
                if Json::get(completion, "completionItemKind") is item_kind:
                    return false if not root_is_object(item_kind) or Json::count_key(item_kind, "valueSet") > 1
                    if Json::get(item_kind, "valueSet") is value_set:
                        match value_set:
                            Json::Value.Arr(items):
                                return false if items.count.i64() > 25
                                for i in 0..<items.count:
                                    item: Json::Value = items[i]
                                    match item:
                                        Json::Value.Num(_):
                                            return false if not Json::is_int_num(item)
                                            kind: i64 = Json::as_lsp_uinteger_or_invalid(item)
                                            return false if kind < 1 or kind > 25
                                        _:
                                            return false
                                    for previous in 0..<i:
                                        return false if Json::as_lsp_uinteger_or_invalid(item) == Json::as_lsp_uinteger_or_invalid(items[previous])
                            _:
                                return false
        return true


def initialize_params_valid(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params and root_is_object(params):
            return false if not initialize_workspace_folders_valid(params)
            # InitializeParams.capabilities is required by LSP. An empty object
            # is the valid minimal profile for clients with no optional support.
            return false if Json::count_key(params, "capabilities") != 1
            if Json::get(params, "capabilities") is caps:
                return root_is_object(caps) and initialize_consumed_keys_unique(params, caps)
        return false


def document_change_params_valid(root: Json::Value, is_open: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params and root_is_object(params):
            if Json::get(params, "textDocument") is td and root_is_object(td):
                return false if not text_document_uri_valid(params)
                return false if Json::count_key(td, "version") != 1
                if Json::get(td, "version") is version:
                    match Json::as_lsp_integer_result(version):
                        Json::I64ParseOutcome.Valid(_):
                            pass
                        Json::I64ParseOutcome.Invalid:
                            return false
                else:
                    return false
                if is_open:
                    return false if Json::count_key(td, "languageId") != 1 or Json::count_key(td, "text") != 1
                    if Json::get(td, "languageId") is language_id:
                        return false if not json_string_nonempty(language_id)
                    else:
                        return false
                    if Json::get(td, "text") is txt:
                        match txt:
                            Json::Value.Str(_):
                                return true
                            _:
                                return false
                    return false
                return false if Json::count_key(params, "contentChanges") != 1
                if Json::get(params, "contentChanges") is changes:
                    match changes:
                        Json::Value.Arr(items):
                            return false if items.count == 0
                            for entry in items:
                                return false if not root_is_object(entry)
                                return false if Json::count_key(entry, "text") != 1
                                return false if Json::count_key(entry, "range") > 1 or Json::count_key(entry, "rangeLength") > 1
                                # rangeLength is deprecated compatibility metadata for a ranged
                                # event. It cannot stand in for range and has no meaning on a
                                # whole-document replacement.
                                return false if Json::count_key(entry, "rangeLength") == 1 and Json::count_key(entry, "range") != 1
                                if Json::get(entry, "text") is txt:
                                    match txt:
                                        Json::Value.Str(_):
                                            pass
                                        _:
                                            return false
                                else:
                                    return false
                                if Json::get(entry, "range") is range:
                                    return false if not lsp_range_valid(range)
                                if Json::get(entry, "rangeLength") is length:
                                    return false if not nonnegative_json_integer(length)
                            return true
                        _:
                            return false
        return false


def method_params_valid(root: Json::Value, method: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match method:
            "initialize":
                return initialize_params_valid(root)
            "shutdown":
                if Json::get(root, "params") is params:
                    return root_is_object(params)
                return true
            "textDocument/semanticTokens/full" | "textDocument/documentSymbol" | "textDocument/foldingRange":
                if Json::get(root, "params") is params:
                    return root_is_object(params) and text_document_uri_valid(params)
                return false
            "textDocument/semanticTokens/range":
                if Json::get(root, "params") is params:
                    if root_is_object(params) and text_document_uri_valid(params):
                        return false if Json::count_key(params, "range") != 1
                        if Json::get(params, "range") is range:
                            return lsp_range_valid(range)
                return false
            "textDocument/hover" | "textDocument/definition" | "textDocument/documentHighlight":
                if Json::get(root, "params") is params:
                    if root_is_object(params) and text_document_uri_valid(params):
                        return false if Json::count_key(params, "position") != 1
                        if Json::get(params, "position") is position:
                            return lsp_position_valid(position)
                return false
            "textDocument/prepareRename":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "textDocument") != 1 or Json::count_key(params, "position") != 1
                    return false if not text_document_uri_valid(params)
                    if Json::get(params, "position") is position:
                        return lsp_position_valid(position)
                return false
            "textDocument/rename":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "textDocument") != 1 or Json::count_key(params, "position") != 1 or Json::count_key(params, "newName") != 1
                    return false if not text_document_uri_valid(params)
                    if Json::get(params, "position") is position:
                        return false if not lsp_position_valid(position)
                    else:
                        return false
                    if Json::get(params, "newName") is new_name:
                        match new_name:
                            Json::Value.Str(_):
                                return true
                            _:
                                return false
                return false
            "textDocument/signatureHelp":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "textDocument") != 1 or Json::count_key(params, "position") != 1
                    return false if not text_document_uri_valid(params)
                    return false if Json::count_key(params, "position") != 1
                    if Json::get(params, "position") is position:
                        return false if not lsp_position_valid(position)
                    else:
                        return false
                    if Json::count_key(params, "context") > 0:
                        return false if Json::count_key(params, "context") != 1
                        if Json::get(params, "context") is context:
                            return signature_help_context_valid(context)
                    return true
                return false
            "textDocument/completion":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "textDocument") != 1 or Json::count_key(params, "position") != 1
                    return false if not text_document_uri_valid(params)
                    if Json::get(params, "position") is position:
                        return false if not lsp_position_valid(position)
                    else:
                        return false
                    if Json::count_key(params, "context") > 0:
                        return false if Json::count_key(params, "context") != 1
                        if Json::get(params, "context") is context:
                            return completion_context_valid(context)
                    return true
                return false
            "completionItem/resolve":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "item") != 1
                    if Json::get(params, "item") is item:
                        return root_is_object(item)
                return false
            "textDocument/references":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "textDocument") != 1 or Json::count_key(params, "position") != 1 or Json::count_key(params, "context") != 1
                    return false if not text_document_uri_valid(params)
                    if Json::get(params, "position") is position:
                        return false if not lsp_position_valid(position)
                    if Json::get(params, "context") is context and root_is_object(context):
                        return false if Json::count_key(context, "includeDeclaration") != 1
                        if Json::get(context, "includeDeclaration") is include:
                            match include:
                                Json::Value.Bool(_):
                                    return true
                                _:
                                    return false
                return false
            "textDocument/selectionRange":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if not text_document_uri_valid(params)
                    return false if Json::count_key(params, "positions") != 1
                    if Json::get(params, "positions") is positions:
                        match positions:
                            Json::Value.Arr(items):
                                for position in items:
                                    return false if not lsp_position_valid(position)
                                return true
                            _:
                                return false
                return false
            "textDocument/didOpen":
                return document_change_params_valid(root, true)
            "textDocument/didChange":
                return document_change_params_valid(root, false)
            "textDocument/didClose":
                if Json::get(root, "params") is params:
                    return root_is_object(params) and text_document_uri_valid(params)
                return false
            "initialized" | "exit":
                if Json::get(root, "params") is params:
                    return root_is_object(params)
                return true
            "workspace/didChangeConfiguration":
                if Json::get(root, "params") is params:
                    return root_is_object(params) and configuration_settings_valid(params)
                return false
            "$/cancelRequest":
                if Json::get(root, "params") is params and root_is_object(params):
                    return false if Json::count_key(params, "id") != 1
                    if Json::get(params, "id") is cancel_id:
                        match cancel_id:
                            Json::Value.Str(_):
                                return true
                            Json::Value.Num(_):
                                match Json::as_lsp_integer_result(cancel_id):
                                    Json::I64ParseOutcome.Valid(_):
                                        return true
                                    Json::I64ParseOutcome.Invalid:
                                        return false
                            _:
                                return false
                return false
            "$/elisa/stats":
                if Json::get(root, "params") is params:
                    match params:
                        Json::Value.Obj(_) | Json::Value.Arr(_):
                            return true
                        _:
                            return false
                return true
            "$/elisa/status":
                if Json::get(root, "params") is params:
                    match params:
                        Json::Value.Obj(_) | Json::Value.Arr(_):
                            return true
                        _:
                            return false
                return true
            "$/elisa/workspace":
                if Json::get(root, "params") is params:
                    return false if not root_is_object(params)
                    if Json::count_key(params, "textDocument") == 1 and Json::get(params, "textDocument") is td:
                        if root_is_object(td) and Json::count_key(td, "uri") == 1 and Json::get(td, "uri") is uri:
                            match uri:
                                Json::Value.Str(_):
                                    return true
                                _:
                                    pass
                        return false
                return true
            _:
                return true


def known_request_method(method: sview) -> bool:
    match method:
        "initialize" | "shutdown" | "textDocument/semanticTokens/full" | "textDocument/semanticTokens/range" | "textDocument/hover" | "textDocument/completion" | "completionItem/resolve" | "textDocument/signatureHelp" | "textDocument/definition" | "textDocument/references" | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/documentHighlight" | "textDocument/documentSymbol" | "textDocument/foldingRange" | "textDocument/selectionRange" | "$/elisa/stats" | "$/elisa/status" | "$/elisa/workspace":
            return true
        _:
            return false


def known_notification_method(method: sview) -> bool:
    match method:
        "initialized" | "exit" | "textDocument/didOpen" | "textDocument/didChange" | "textDocument/didClose" | "workspace/didChangeConfiguration" | "$/cancelRequest":
            return true
        _:
            return false


# The JSON-RPC ID token for verbatim echo into the response. String contents
# remain escaped in their original JSON representation.
# Defaults to `null` when absent (notifications have no id).
def extract_id(root: Json::Value) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    if Json::get(root, "id") is idv:
        match idv:
            Json::Value.Num(text):
                match Json::as_lsp_integer_result(idv):
                    Json::I64ParseOutcome.Valid(_):
                        push_sview(out, text)
                    Json::I64ParseOutcome.Invalid:
                        push_str(out, "null")
            Json::Value.Str(text):
                out.push(34)
                push_sview(out, text)
                out.push(34)
            _:
                push_str(out, "null")
    else:
        push_str(out, "null")
    return out


# Whether the message carries a valid LSP request ID. Invalid present IDs are
# caught by the envelope validator before dispatch.
def request_has_id(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return request_id_present(root) and request_id_valid(root)


def envelope_error_id(root: Json::Value) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    if Json::count_key(root, "id") != 1:
        push_str(out, "null")
    else:
        out <- extract_id(root)
    return out


# ---- diagnostics: textDocument/didOpen + didChange ---------------------------------

# Decode `params.textDocument.uri` into `out`, returning a view of the decoded
# bytes. URI equality and diagnostics must use the same value the client sent;
# retaining the raw JSON string would make escaped quotes/backslashes part of the
# URI and could also emit malformed diagnostic JSON.
def request_uri(root: Json::Value, out: mutable darray[u8]&) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out.truncate(0)
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "uri") is u:
                    Json::decode_into(u, out)
                    return bytes_view_range_ref(out, 0, out.count) if out.count > 0
        return sview("", 0, 0)


# The document's full text as a Json Str value: `params.textDocument.text`
# (didOpen) or `params.contentChanges[0].text` (didChange, full-document sync).
# Null if malformed. Returned as the VALUE (not a span) so the caller can decode
# the JSON string escapes — real clients escape every newline of the document.
def request_text_value(root: Json::Value) -> Json::Value? can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "text") is t:
                    return t
            if Json::get(params, "contentChanges") is changes:
                match changes:
                    Json::Value.Arr(items):
                        t return if items.count > 0 and Json::get(items[0], "text") is t
                    _:
                        pass
        return null


# Client version for didOpen/didChange (`params.textDocument.version`). The
# tagged state keeps valid negative versions distinct from absence and failure.
def request_version_state(root: Json::Value) -> DocumentVersionState can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "version") is v:
                    match Json::as_lsp_integer_result(v):
                        Json::I64ParseOutcome.Valid(value):
                            return DocumentVersionState.Present(value)
                        Json::I64ParseOutcome.Invalid:
                            return DocumentVersionState.Invalid
        return DocumentVersionState.Invalid


# Defensive hover-line accessor (J02). Normal requests pass
# `method_params_valid` first, which returns InvalidParams for absent, fractional,
# overflowing, or wrong-typed positions. Keep -1 as a fail-closed fallback if
# this helper is ever reached with malformed input.
def request_hover_line(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "position") is pos:
                if Json::get(pos, "line") is ln:
                    return Json::as_lsp_uinteger_or_invalid(ln)
        return -1


# Strict hover character (J02), in negotiated units; -1 when absent/invalid.
def request_hover_char(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "position") is pos:
                if Json::get(pos, "character") is ch:
                    v: i64 = Json::as_lsp_uinteger_or_invalid(ch)
                    return v if v >= 0 else -1
        return -1


# D02 full-sync collection: decode the notification's full replacement text
# into `out` (byte-exact, CRLF/trailing-newline preserving). didOpen reads
# `params.textDocument.text`; didChange validates EVERY `contentChanges` entry
# in order and uses the last. Any ranged entry (`range`/`rangeLength`), missing
# text, non-string text, or empty change list rejects the whole notification
# (returns false, `out` untouched) — the server advertises full sync only, so a
# fragment must never be mistaken for the whole document. Byte copies (not
# container stores) keep the region checker satisfied.
def collect_full_text(root: Json::Value, is_open: bool, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if is_open:
            if Json::get(root, "params") is params:
                if Json::get(params, "textDocument") is td:
                    if Json::get(td, "text") is t:
                        match t:
                            Json::Value.Str(st):
                                tmp: mutable darray[u8] = []
                                Json::decode_into(t, tmp)
                                out.truncate(0)
                                out.extend([b for b in tmp])
                                return true
                            _:
                                return false
            return false
        if Json::get(root, "params") is params:
            if Json::get(params, "contentChanges") is changes:
                match changes:
                    Json::Value.Arr(items):
                        return false if items.count == 0
                        i: mutable usize = 0
                        while i < items.count:
                            entry: Json::Value = items[i]
                            if Json::get(entry, "range") is rg:
                                return false
                            if Json::get(entry, "rangeLength") is rl:
                                return false
                            if Json::get(entry, "text") is tt:
                                match tt:
                                    Json::Value.Str(st):
                                        pass
                                    _:
                                        return false
                            else:
                                return false
                            i <- i + 1
                        last: Json::Value = items[items.count - 1]
                        if Json::get(last, "text") is lt:
                            tmp: mutable darray[u8] = []
                            Json::decode_into(lt, tmp)
                            out.truncate(0)
                            out.extend([b for b in tmp])
                            return true
                        return false
                    _:
                        return false
        return false


# Structured URI parsing and lexical lookup-key conversion live in `module
# Uri`; document output continues to use the original decoded spelling.
def uri_canonical(decoded: u8&, decoded_len: usize, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    Uri::canonical_key(decoded, decoded_len, out)


# Canonical lookup identity for a request: JSON-decode into `spell_buf` (kept
# for responses), derive bytes into `canon_buf`, and return a view of the
# canonical form — empty when the request carries no usable URI.
def request_document_snapshot(root: Json::Value, documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&) -> DocumentSnapshotView can[Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return document_empty_snapshot_view() if uri.len == 0
    return document_snapshot_for_uri(documents, storage, heads, uri)


def request_identity(root: Json::Value, spell_buf: mutable darray[u8]&, canon_buf: mutable darray[u8]&) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        request_uri(root, spell_buf)
        return sview("", 0, 0) if spell_buf.count == 0
        canon_buf.truncate(0)
        uri_canonical(&spell_buf[0], spell_buf.count, canon_buf)
        return bytes_view_range_ref(canon_buf, 0, canon_buf.count) if canon_buf.count > 0
        return sview("", 0, 0)


# Providers that read normalized compiler results cannot truthfully report an
# empty result when the accepted document snapshot was rejected by the
# frontend-table contract validator. Keep missing documents and source-only
# methods on their normal paths; hover is excluded because it has a deliberate
# lexical fallback while semantic data is unavailable.
def method_requires_analysis_snapshot(method: sview) -> bool:
    match method:
        "textDocument/semanticTokens/full" | "textDocument/semanticTokens/range" | "textDocument/completion" | "textDocument/signatureHelp" | "textDocument/definition" | "textDocument/references" | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/documentHighlight" | "textDocument/documentSymbol":
            return true
        _:
            return false


# Hover keeps a lexical fallback when analysis has failed or the document is
# unavailable, but a Pending accepted snapshot must wait for its semantic
# index instead of returning an early, incomplete answer.
def method_waits_for_analysis_snapshot(method: sview) -> bool:
    match method:
        "textDocument/hover":
            return true
        _:
            return method_requires_analysis_snapshot(method)


# A queued cursor lookup is user-blocking work. Tokens, symbols, and other
# document-wide requests still outrank unrequested snapshots, while retaining
# FIFO job order among requests with the same priority.
def analysis_request_priority(method: sview) -> i64:
    match method:
        "textDocument/hover" | "textDocument/completion" | "textDocument/signatureHelp" | "textDocument/definition" | "textDocument/references" | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/documentHighlight":
            return 0
        _:
            return 1


def request_has_failed_analysis_snapshot(root: Json::Value, method: sview, documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not method_requires_analysis_snapshot(method)
        spell_bytes: mutable darray[u8] = []
        canon_bytes: mutable darray[u8] = []
        uri: sview = request_identity(root, spell_bytes, canon_bytes)
        return false if uri.len <= 0
        found: i64 = document_index(documents, storage, heads, uri)
        return false if found < 0
        document: LspDocument = documents[found.usize()]
        return document.lifecycle.open and document.lifecycle.analysis_state == DocumentAnalysisState.Failed


# D02 incremental change application. An LSP range is converted against the
# text produced by the PRECEDING change in the same notification, so a change
# list is applied to a working copy iteration by iteration and committed only if
# every entry is well-formed. A ranged entry is rejected (whole notification
# discarded) when its range is inverted or out of bounds, or when an optional
# deprecated rangeLength disagrees with the removed span in negotiated units.
# Entries without a `range` are full replacements (the old full-sync behaviour
# still works); rangeLength without a range is malformed.
def range_change_offsets(src: u8&, src_len: usize, range: Json::Value, utf8: bool, sbyte_out: mutable usize&, ebyte_out: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    sl: mutable i64 = -1
    sc: mutable i64 = -1
    el: mutable i64 = -1
    ec: mutable i64 = -1
    if Json::get(range, "start") is s:
        if Json::get(s, "line") is v:
            sl <- Json::as_lsp_uinteger_or_invalid(v)
        if Json::get(s, "character") is v:
            sc <- Json::as_lsp_uinteger_or_invalid(v)
    if Json::get(range, "end") is e:
        if Json::get(e, "line") is v:
            el <- Json::as_lsp_uinteger_or_invalid(v)
        if Json::get(e, "character") is v:
            ec <- Json::as_lsp_uinteger_or_invalid(v)
    return false if sl < 0 or sc < 0 or el < 0 or ec < 0
    nlines: i64 = Positions::line_count(src, src_len)
    last: i64 = nlines - 1
    # Position.character beyond a valid line clamps to its end, but an edit
    # endpoint inside a code point or surrogate pair is rejected. A line
    # beyond the document has no such fallback and cannot alias EOF.
    return false if sl > last or el > last
    scol: mutable i64 = 0
    ecol: mutable i64 = 0
    return false if not Positions::edit_char_to_byte_col(src, src_len, sl, sc, utf8, scol)
    return false if not Positions::edit_char_to_byte_col(src, src_len, el, ec, utf8, ecol)
    sbyte: usize = Positions::line_start_offset(src, src_len, sl) + scol.usize()
    ebyte: usize = Positions::line_start_offset(src, src_len, el) + ecol.usize()
    return false if sbyte > ebyte or ebyte > src_len
    sbyte_out <- sbyte
    ebyte_out <- ebyte
    return true


def apply_content_changes(current: sview, content_changes: darray[Json::Value], utf8: bool, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    working: mutable darray[u8] = []
    i: mutable usize = 0
    while i < current.len.usize():
        working.push(sview_at(current, i))
        i <- i + 1
    sentinel: mutable darray[u8] = [0]
    i <- 0
    while i < content_changes.count:
        entry: Json::Value = content_changes[i]
        txt: mutable darray[u8] = []
        if Json::get(entry, "text") is tv:
            match tv:
                Json::Value.Str(_):
                    Json::decode_into(tv, txt)
                _:
                    return false
        else:
            return false
        if Json::get(entry, "range") is rg:
            base: u8& = &working[0] if working.count > 0 else &sentinel[0]
            sbyte: mutable usize = 0
            ebyte: mutable usize = 0
            if not range_change_offsets(base, working.count, rg, utf8, sbyte, ebyte):
                return false
            if Json::get(entry, "rangeLength") is reported_length:
                reported: i64 = Json::as_lsp_uinteger_or_invalid(reported_length)
                return false if reported < 0
                actual: i64 = Positions::span_unit_length(base, working.count, sbyte, ebyte - sbyte, utf8)
                return false if reported != actual
            nxt: mutable darray[u8] = []
            j: mutable usize = 0
            while j < sbyte:
                nxt.push(working[j])
                j <- j + 1
            nxt.extend([b for b in txt])
            j <- ebyte
            while j < working.count:
                nxt.push(working[j])
                j <- j + 1
            working.truncate(0)
            working.extend([b for b in nxt])
        else:
            return false if Json::count_key(entry, "rangeLength") != 0
            working.truncate(0)
            working.extend([b for b in txt])
        i <- i + 1
    out.truncate(0)
    out.extend([b for b in working])
    return true


# A04: one analysis packet is bounded independently of the incoming LSP frame.
# The child streams the payload while the parent drains it, so results larger
# than a pipe buffer cannot deadlock the event loop.
const MAX_ANALYSIS_PACKET_BYTES: usize = 67108864
const ANALYSIS_WORKER_READ_CHUNK: usize = 8192
const ANALYSIS_WORKER_HEADER_BYTES: usize = 1024
const ANALYSIS_WORKER_HEADER_FIELDS: usize = 23
const MAX_PENDING_ANALYSIS_REQUESTS: usize = 128
const MAX_PENDING_ANALYSIS_REQUEST_BYTES: usize = 4194304
const MAX_PENDING_ANALYSIS_STORAGE_BYTES: usize = 13631488
const LSP_ERROR_REQUEST_CANCELLED: i64 = -32800
const LSP_ERROR_CONTENT_MODIFIED: i64 = -32801
const LSP_ERROR_SERVER_BUSY: i64 = -32000


def analysis_source_fingerprint(src: u8&, len: usize) -> u64:
    hash: mutable u64 = 14695981039346656037
    i: mutable usize = 0
    while i < len:
        hash <- (hash ^ src[i].u64()) * 1099511628211
        i <- i + 1
    return hash


def analysis_worker_write_bytes(bytes: darray[u8]&) -> bool can[Console]:
    return true if bytes.count == 0
    written: isize = elisa_lsp_analysis_worker_write((&bytes[0]).cast[void&], bytes.count) can Console
    return written == bytes.count.isize()


# Child-to-parent packet: fixed ASCII metadata line followed by five opaque
# byte spans (semantic tokens, symbols, hover, signature, diagnostics). The
# numeric fields include per-job counter deltas because forked globals are
# copy-on-write and would otherwise disappear from $/elisa/stats. The final
# four fields carry opt-in lex/parse/check/index stage durations; zero is the
# disabled/sub-millisecond representation and remains valid at the trust
# boundary.
def analysis_worker_send_packet(job_id: i64, generation: i64, version: i64, source_len: i64, uri_hash: i64, source_hash: i64, status: i64, semantic: darray[u8]&, symbols: darray[u8]&, hover: darray[u8]&, signature: darray[u8]&, diagnostics: darray[u8]&, tokenize_delta: i64, parse_delta: i64, check_delta: i64, query_delta: i64, symbol_index_delta: i64, occurrence_index_delta: i64, line_index_fallback_delta: i64, lex_ms: i64, parse_ms: i64, check_ms: i64, index_ms: i64) -> bool can[Console, Memory.Allocate, Abort.Panic]:
    payload_bytes: mutable usize = 0
    if semantic.count > MAX_ANALYSIS_PACKET_BYTES:
        return false
    if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - semantic.count:
        return false
    payload_bytes <- payload_bytes + semantic.count
    if symbols.count > MAX_ANALYSIS_PACKET_BYTES:
        return false
    if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - symbols.count:
        return false
    payload_bytes <- payload_bytes + symbols.count
    if hover.count > MAX_ANALYSIS_PACKET_BYTES:
        return false
    if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - hover.count:
        return false
    payload_bytes <- payload_bytes + hover.count
    if signature.count > MAX_ANALYSIS_PACKET_BYTES:
        return false
    if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - signature.count:
        return false
    payload_bytes <- payload_bytes + signature.count
    if diagnostics.count > MAX_ANALYSIS_PACKET_BYTES:
        return false
    if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - diagnostics.count:
        return false
    payload_bytes <- payload_bytes + diagnostics.count
    header: mutable darray[u8] = []
    header.push_str("ELISA-LSP-WORKER\t3\t")
    json_push_i64(header, job_id)
    header.push(9)
    json_push_i64(header, generation)
    header.push(9)
    json_push_i64(header, version)
    header.push(9)
    json_push_i64(header, source_len)
    header.push(9)
    json_push_i64(header, uri_hash)
    header.push(9)
    json_push_i64(header, source_hash)
    header.push(9)
    json_push_i64(header, status)
    header.push(9)
    json_push_i64(header, semantic.count.i64())
    header.push(9)
    json_push_i64(header, symbols.count.i64())
    header.push(9)
    json_push_i64(header, hover.count.i64())
    header.push(9)
    json_push_i64(header, signature.count.i64())
    header.push(9)
    json_push_i64(header, diagnostics.count.i64())
    header.push(9)
    json_push_i64(header, tokenize_delta)
    header.push(9)
    json_push_i64(header, parse_delta)
    header.push(9)
    json_push_i64(header, check_delta)
    header.push(9)
    json_push_i64(header, query_delta)
    header.push(9)
    json_push_i64(header, symbol_index_delta)
    header.push(9)
    json_push_i64(header, occurrence_index_delta)
    header.push(9)
    json_push_i64(header, line_index_fallback_delta)
    header.push(9)
    json_push_i64(header, lex_ms)
    header.push(9)
    json_push_i64(header, parse_ms)
    header.push(9)
    json_push_i64(header, check_ms)
    header.push(9)
    json_push_i64(header, index_ms)
    header.push(10)
    return false if header.count > MAX_ANALYSIS_PACKET_BYTES or payload_bytes > MAX_ANALYSIS_PACKET_BYTES - header.count
    return false if not analysis_worker_write_bytes(header)
    return false if not analysis_worker_write_bytes(semantic)
    return false if not analysis_worker_write_bytes(symbols)
    return false if not analysis_worker_write_bytes(hover)
    return false if not analysis_worker_write_bytes(signature)
    return false if not analysis_worker_write_bytes(diagnostics)
    return true


def analysis_worker_parse_integer(packet: darray[u8]&, start: usize, end: usize, value_out: mutable i64&) -> bool:
    pos: mutable usize = start
    return false if pos >= end
    negative: mutable bool = false
    if packet[pos] == 45:
        negative <- true
        pos <- pos + 1
    return false if pos >= end
    return false if negative and packet[pos] == 48
    return false if end - pos > 1 and packet[pos] == 48
    limit: mutable i64 = -9223372036854775807
    limit <- limit - 1 if negative
    mult_min: i64 = limit / 10
    value: mutable i64 = 0
    while pos < end:
        c: u8 = packet[pos]
        return false if c < 48 or c > 57
        digit: i64 = c.i64() - 48
        return false if value < mult_min
        value <- value * 10
        return false if value < limit + digit
        value <- value - digit
        pos <- pos + 1
    value_out[0] <- value if negative else -value
    return true


def analysis_worker_parse_header(packet: darray[u8]&, fields: mutable darray[i64]&, payload_start: mutable usize&) -> bool:
    return false if packet.count == 0 or packet.count > MAX_ANALYSIS_PACKET_BYTES
    prefix: sview = sview("ELISA-LSP-WORKER\t3\t", 0, 19)
    return false if packet.count < prefix.len.usize()
    i: mutable usize = 0
    while i < prefix.len.usize():
        return false if packet[i] != sview_at(prefix, i)
        i <- i + 1
    newline: mutable usize = i
    while newline < packet.count and newline < ANALYSIS_WORKER_HEADER_BYTES:
        break if packet[newline] == 10
        newline <- newline + 1
    return false if newline >= packet.count or newline >= ANALYSIS_WORKER_HEADER_BYTES
    field_start: mutable usize = i
    pos: mutable usize = i
    while pos <= newline:
        if pos == newline or packet[pos] == 9:
            parsed: mutable i64 = 0
            return false if fields.count >= ANALYSIS_WORKER_HEADER_FIELDS
            return false if not analysis_worker_parse_integer(packet, field_start, pos, parsed)
            fields.push(parsed)
            break if pos == newline
            field_start <- pos + 1
        pos <- pos + 1
    return false if fields.count != ANALYSIS_WORKER_HEADER_FIELDS
    payload_start[0] <- newline + 1
    return true


# Worker packets are an internal trust boundary too: lengths and identity alone
# do not prove that a payload can safely be returned to an LSP client. The
# semantic-token builder emits one canonical compact JSON shape, so validate
# that stream directly (without allocating a large generic JSON value tree).
def analysis_worker_payload_uinteger(packet: darray[u8]&, end: usize, pos: mutable usize&, value_out: mutable i64&) -> bool:
    return false if pos[0] >= end
    start: usize = pos[0]
    first: u8 = packet[pos[0]]
    return false if first < 48 or first > 57
    return false if first == 48 and pos[0] + 1 < end and packet[pos[0] + 1] >= 48 and packet[pos[0] + 1] <= 57
    value: mutable i64 = 0
    while pos[0] < end and packet[pos[0]] >= 48 and packet[pos[0]] <= 57:
        digit: i64 = packet[pos[0]].i64() - 48
        return false if value > (2147483647 - digit) / 10
        value <- value * 10 + digit
        pos[0] <- pos[0] + 1
    return false if pos[0] == start
    value_out[0] <- value
    return true


def analysis_worker_source_position_valid(line: i64, character: i64, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Abort.Panic]:
    return false if line < 0 or line.usize() >= span_count or character < 0
    units: i64 = Positions::line_unit_length_span_indexed(src, src_len, starts, span_start, span_count, line, utf8)
    return character <= units


def analysis_worker_json_string_is(value: Json::Value, expected: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                view: sview = bytes_view_range_ref(decoded, 0, decoded.count) if decoded.count > 0 else sview("", 0, 0)
                return string_views_eq(view, expected) != 0
            _:
                return false


def analysis_worker_json_string_nonempty(value: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                return decoded.count > 0
            _:
                return false


def analysis_worker_json_string_starts_with(value: Json::Value, prefix: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Str(_):
                decoded: mutable darray[u8] = []
                Json::decode_into(value, decoded)
                return false if decoded.count < prefix.len.usize()
                for i in 0..<prefix.len.usize():
                    return false if decoded[i] != sview_at(prefix, i)
                return true
            _:
                return false


def analysis_worker_json_object_size(value: Json::Value, expected: usize) -> bool:
    match value:
        Json::Value.Obj(fields):
            return fields.count == expected
        _:
            return false


def analysis_worker_json_position(value: Json::Value, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool, line_out: mutable i64&, character_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(value)
        return false if Json::count_key(value, "line") != 1 or Json::count_key(value, "character") != 1
        if Json::get(value, "line") is line_value and Json::get(value, "character") is character_value:
            line: i64 = Json::as_lsp_uinteger_or_invalid(line_value)
            character: i64 = Json::as_lsp_uinteger_or_invalid(character_value)
            return false if not analysis_worker_source_position_valid(line, character, src, src_len, starts, span_start, span_count, utf8)
            line_out <- line
            character_out <- character
            return true
        return false


def analysis_worker_json_range(value: Json::Value, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool, start_line_out: mutable i64&, start_char_out: mutable i64&, end_line_out: mutable i64&, end_char_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(value) or Json::count_key(value, "start") != 1 or Json::count_key(value, "end") != 1
        if Json::get(value, "start") is start_value and Json::get(value, "end") is end_value:
            start_line: mutable i64 = 0
            start_char: mutable i64 = 0
            end_line: mutable i64 = 0
            end_char: mutable i64 = 0
            return false if not analysis_worker_json_position(start_value, src, src_len, starts, span_start, span_count, utf8, start_line, start_char)
            return false if not analysis_worker_json_position(end_value, src, src_len, starts, span_start, span_count, utf8, end_line, end_char)
            return false if start_line > end_line or (start_line == end_line and start_char > end_char)
            start_line_out <- start_line
            start_char_out <- start_char
            end_line_out <- end_line
            end_char_out <- end_char
            return true
        return false


def analysis_worker_semantic_payload_valid(packet: darray[u8]&, start: usize, count: usize, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool, strict_boundaries: bool) -> bool can[Abort.Panic]:
    return false if count < 11 or start > packet.count or count > packet.count - start
    # Exact encoder contract: {"data":[<canonical uinteger list>]}
    return false if packet[start] != 123 or packet[start + 1] != 34 or packet[start + 2] != 100 or packet[start + 3] != 97 or packet[start + 4] != 116 or packet[start + 5] != 97 or packet[start + 6] != 34 or packet[start + 7] != 58 or packet[start + 8] != 91
    payload_end: usize = start + count - 2
    return false if packet[payload_end] != 93 or packet[payload_end + 1] != 125
    pos: mutable usize = start + 9
    return true if pos == payload_end
    field_index: mutable i64 = 0
    delta_line: mutable i64 = 0
    delta_char: mutable i64 = 0
    token_length: mutable i64 = 0
    token_type: mutable i64 = 0
    modifiers: mutable i64 = 0
    current_line: mutable i64 = 0
    current_char: mutable i64 = 0
    while pos < payload_end:
        value: mutable i64 = 0
        return false if not analysis_worker_payload_uinteger(packet, payload_end, pos, value)
        if field_index == 0:
            delta_line <- value
        elif field_index == 1:
            delta_char <- value
        elif field_index == 2:
            token_length <- value
        elif field_index == 3:
            token_type <- value
        else:
            modifiers <- value
            current_line <- current_line + delta_line
            current_char <- delta_char if delta_line > 0 else current_char + delta_char
            return false if token_length <= 0 or token_type >= SEMTOK_CUSTOM_TYPE_COUNT or modifiers < 0 or modifiers > ST_MODIFIER_MASK
            return false if not analysis_worker_source_position_valid(current_line, current_char, src, src_len, starts, span_start, span_count, utf8)
            line_units: i64 = Positions::line_unit_length_span_indexed(src, src_len, starts, span_start, span_count, current_line, utf8)
            return false if token_length > line_units - current_char
            token_end: i64 = current_char + token_length
            return false if token_end < current_char or not analysis_worker_source_position_valid(current_line, token_end, src, src_len, starts, span_start, span_count, utf8)
            if strict_boundaries:
                start_byte: i64 = Positions::char_to_byte_col_span_indexed(src, src_len, starts, span_start, span_count, current_line, current_char, utf8)
                end_byte: i64 = Positions::char_to_byte_col_span_indexed(src, src_len, starts, span_start, span_count, current_line, token_end, utf8)
                return false if Positions::byte_col_to_units_span_indexed(src, src_len, starts, span_start, span_count, current_line, start_byte, utf8) != current_char
                return false if Positions::byte_col_to_units_span_indexed(src, src_len, starts, span_start, span_count, current_line, end_byte, utf8) != token_end
        field_index <- (field_index + 1) % 5
        if pos < payload_end:
            return false if packet[pos] != 44
            pos <- pos + 1
            return false if pos >= payload_end
    return field_index == 0


def analysis_worker_symbol_item_valid(item: Json::Value, hierarchical: bool, uri: sview, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        expected_fields: usize = 5 if hierarchical else 3
        return false if not analysis_worker_json_object_size(item, expected_fields)
        return false if Json::count_key(item, "name") != 1 or Json::count_key(item, "kind") != 1
        return false if hierarchical and (Json::count_key(item, "range") != 1 or Json::count_key(item, "selectionRange") != 1 or Json::count_key(item, "children") != 1)
        return false if not hierarchical and Json::count_key(item, "location") != 1
        if Json::get(item, "name") is name and Json::get(item, "kind") is kind_value:
            return false if not analysis_worker_json_string_nonempty(name)
            kind: i64 = Json::as_lsp_uinteger_or_invalid(kind_value)
            return false if kind < 1 or kind > 26
        else:
            return false
        range_value: mutable Json::Value = Json::Value.Null
        selection_value: mutable Json::Value = Json::Value.Null
        if hierarchical:
            if Json::get(item, "range") is range:
                range_value <- range
            else:
                return false
            if Json::get(item, "selectionRange") is selection:
                selection_value <- selection
            else:
                return false
        else:
            if Json::get(item, "location") is location:
                return false if not analysis_worker_json_object_size(location, 2)
                return false if Json::count_key(location, "uri") != 1 or Json::count_key(location, "range") != 1
                if Json::get(location, "uri") is location_uri and Json::get(location, "range") is range:
                    return false if not analysis_worker_json_string_is(location_uri, uri)
                    range_value <- range
                else:
                    return false
            else:
                return false
        rs_line: mutable i64 = 0
        rs_char: mutable i64 = 0
        re_line: mutable i64 = 0
        re_char: mutable i64 = 0
        return false if not analysis_worker_json_range(range_value, src, src_len, starts, span_start, span_count, utf8, rs_line, rs_char, re_line, re_char)
        # Symbol ranges begin at the declaration line's start. Their end may
        # be a later line when the source indentation block contains children.
        return false if rs_char != 0
        if hierarchical:
            ss_line: mutable i64 = 0
            ss_char: mutable i64 = 0
            se_line: mutable i64 = 0
            se_char: mutable i64 = 0
            return false if not analysis_worker_json_range(selection_value, src, src_len, starts, span_start, span_count, utf8, ss_line, ss_char, se_line, se_char)
            return false if ss_line < rs_line or se_line > re_line
            return false if ss_line == rs_line and ss_char < rs_char
            return false if se_line == re_line and se_char > re_char
            if Json::get(item, "children") is children:
                match children:
                    Json::Value.Arr(items):
                        previous_line: mutable i64 = -1
                        previous_character: mutable i64 = -1
                        for child in items:
                            return false if not analysis_worker_symbol_item_valid(child, true, uri, src, src_len, starts, span_start, span_count, utf8)
                            if Json::get(child, "range") is child_range:
                                child_start_line: mutable i64 = 0
                                child_start_character: mutable i64 = 0
                                child_end_line: mutable i64 = 0
                                child_end_character: mutable i64 = 0
                                return false if not analysis_worker_json_range(child_range, src, src_len, starts, span_start, span_count, utf8, child_start_line, child_start_character, child_end_line, child_end_character)
                                return false if child_start_line < rs_line or child_end_line > re_line
                                return false if child_start_line == rs_line and child_start_character < rs_char
                                return false if child_end_line == re_line and child_end_character > re_char
                                return false if previous_line > child_start_line or (previous_line == child_start_line and previous_character > child_start_character)
                                previous_line <- child_start_line
                                previous_character <- child_start_character
                            else:
                                return false
                    _:
                        return false
            else:
                return false
        return true


def analysis_worker_symbols_payload_valid(packet: darray[u8]&, start: usize, count: usize, hierarchical: bool, uri: sview, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if start > packet.count or count > packet.count - start
        payload: sview = bytes_view_range_ref(packet, start, count) if count > 0 else sview("", 0, 0)
        match Json::parse(payload):
            Json::ParseOutcome.Parsed(root):
                match root:
                    Json::Value.Arr(items):
                        for item in items:
                            return false if not analysis_worker_symbol_item_valid(item, hierarchical, uri, src, src_len, starts, span_start, span_count, utf8)
                        return true
                    _:
                        return false
            Json::ParseOutcome.Rejected(_):
                return false


def analysis_worker_diagnostic_item_valid(item: Json::Value, uri: sview, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(item)
        fields: usize = 5 if Json::count_key(item, "relatedInformation") == 0 else 6
        return false if not analysis_worker_json_object_size(item, fields)
        return false if Json::count_key(item, "range") != 1 or Json::count_key(item, "severity") != 1 or Json::count_key(item, "code") != 1 or Json::count_key(item, "source") != 1 or Json::count_key(item, "message") != 1
        range_start_line: mutable i64 = 0
        range_start_char: mutable i64 = 0
        range_end_line: mutable i64 = 0
        range_end_char: mutable i64 = 0
        if Json::get(item, "range") is range:
            return false if not analysis_worker_json_range(range, src, src_len, starts, span_start, span_count, utf8, range_start_line, range_start_char, range_end_line, range_end_char)
        else:
            return false
        if Json::get(item, "severity") is severity_value:
            severity: i64 = Json::as_lsp_uinteger_or_invalid(severity_value)
            return false if severity < 1 or severity > 4
        else:
            return false
        if Json::get(item, "code") is code_value:
            return false if not analysis_worker_json_string_starts_with(code_value, sview("ELISA-", 0, 6))
        else:
            return false
        if Json::get(item, "source") is source_value:
            return false if not (analysis_worker_json_string_is(source_value, sview("elisa", 0, 5)) or analysis_worker_json_string_is(source_value, sview("elisa-lsp", 0, 9)))
        else:
            return false
        if Json::get(item, "message") is message_value:
            match message_value:
                Json::Value.Str(_):
                    pass
                _:
                    return false
        else:
            return false
        if Json::get(item, "relatedInformation") is related:
            match related:
                Json::Value.Arr(entries):
                    return false if entries.count != 1
                    if Json::get(entries[0], "location") is location and Json::get(entries[0], "message") is related_message:
                        return false if not analysis_worker_json_object_size(entries[0], 2)
                        return false if not analysis_worker_json_string_is(related_message, sview("first declared here", 0, 19))
                        return false if not analysis_worker_json_object_size(location, 2)
                        return false if Json::count_key(location, "uri") != 1 or Json::count_key(location, "range") != 1
                        if Json::get(location, "uri") is related_uri and Json::get(location, "range") is related_range:
                            return false if not analysis_worker_json_string_is(related_uri, uri)
                            sl: mutable i64 = 0
                            sc: mutable i64 = 0
                            el: mutable i64 = 0
                            ec: mutable i64 = 0
                            return false if not analysis_worker_json_range(related_range, src, src_len, starts, span_start, span_count, utf8, sl, sc, el, ec)
                        else:
                            return false
                    else:
                        return false
                _:
                    return false
        return true


def analysis_worker_diagnostics_payload_valid(packet: darray[u8]&, start: usize, count: usize, uri: sview, version: i64, src: u8&, src_len: usize, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if start > packet.count or count > packet.count - start
        payload: sview = bytes_view_range_ref(packet, start, count) if count > 0 else sview("", 0, 0)
        match Json::parse(payload):
            Json::ParseOutcome.Parsed(root):
                return false if not analysis_worker_json_object_size(root, 3)
                return false if Json::count_key(root, "jsonrpc") != 1 or Json::count_key(root, "method") != 1 or Json::count_key(root, "params") != 1
                if Json::get(root, "jsonrpc") is rpc and Json::get(root, "method") is method and Json::get(root, "params") is params:
                    return false if not analysis_worker_json_string_is(rpc, sview("2.0", 0, 3)) or not analysis_worker_json_string_is(method, sview("textDocument/publishDiagnostics", 0, 31))
                    return false if not analysis_worker_json_object_size(params, 3)
                    return false if Json::count_key(params, "uri") != 1 or Json::count_key(params, "version") != 1 or Json::count_key(params, "diagnostics") != 1
                    if Json::get(params, "uri") is published_uri and Json::get(params, "version") is published_version and Json::get(params, "diagnostics") is diagnostics:
                        return false if not analysis_worker_json_string_is(published_uri, uri)
                        parsed_version: mutable i64 = -1
                        match Json::as_lsp_integer_result(published_version):
                            Json::I64ParseOutcome.Valid(value):
                                parsed_version <- value
                            Json::I64ParseOutcome.Invalid:
                                return false
                        return false if parsed_version != version
                        match diagnostics:
                            Json::Value.Arr(items):
                                return false if items.count > 201
                                for item in items:
                                    return false if not analysis_worker_diagnostic_item_valid(item, uri, src, src_len, starts, span_start, span_count, utf8)
                                return true
                            _:
                                return false
                    else:
                        return false
                else:
                    return false
            Json::ParseOutcome.Rejected(_):
                return false


def analysis_worker_ascii_uinteger(text: sview, value_out: mutable i64&) -> bool:
    return false if text.len <= 0
    first: u8 = sview_at(text, 0)
    return false if first < 48 or first > 57
    return false if first == 48 and text.len > 1
    value: mutable i64 = 0
    i: mutable usize = 0
    while i < text.len.usize():
        digit_byte: u8 = sview_at(text, i)
        return false if digit_byte < 48 or digit_byte > 57
        digit: i64 = digit_byte.i64() - 48
        return false if value > (2147483647 - digit) / 10
        value <- value * 10 + digit
        i <- i + 1
    value_out[0] <- value
    return true


def analysis_worker_record_field_count(blob: sview, record_start: usize, record_end: usize) -> i64:
    return -1 if record_start >= record_end
    fields: mutable i64 = 1
    i: mutable usize = record_start + 1
    while i < record_end:
        fields <- fields + 1 if sview_at(blob, i) == 31
        i <- i + 1
    return fields


def analysis_worker_occurrence_span_matches(start_offset: i64, end_offset: i64, name: sview, src: u8&, src_len: usize) -> bool:
    return false if start_offset < 0 or end_offset <= start_offset or end_offset.usize() > src_len
    return false if end_offset - start_offset != name.len.i64() or name.len == 0
    start: usize = start_offset.usize()
    i: mutable usize = 0
    while i < name.len.usize():
        return false if src[start + i] != sview_at(name, i)
        i <- i + 1
    return true


def analysis_worker_hex_digit(byte: u8) -> i64:
    if byte >= 48 and byte <= 57:
        return byte.i64() - 48
    if byte >= 97 and byte <= 102:
        return byte.i64() - 87
    return -1


def analysis_worker_hex_source_matches(encoded: sview, start_offset: i64, end_offset: i64, src: u8&, src_len: usize) -> bool:
    return false if start_offset < 0 or end_offset <= start_offset or end_offset.usize() > src_len
    source_count: usize = (end_offset - start_offset).usize()
    return false if source_count > 2048 or encoded.len.usize() != source_count * 2
    source_start: usize = start_offset.usize()
    index: mutable usize = 0
    while index < source_count:
        high: i64 = analysis_worker_hex_digit(sview_at(encoded, index * 2))
        low: i64 = analysis_worker_hex_digit(sview_at(encoded, index * 2 + 1))
        return false if high < 0 or low < 0
        return false if ((high << 4) | low).u8() != src[source_start + index]
        index <- index + 1
    return true


def analysis_worker_private_record_stream(blob: sview, hover_stream: bool, src_len: usize, src: u8&, starts: darray[usize]&, span_start: usize, span_count: usize, utf8: bool) -> bool can[Abort.Panic]:
    rec: u8 = 30
    separator: u8 = 31
    cursor: mutable usize = 0
    n: usize = blob.len.usize()
    call_count: mutable i64 = 0
    largest_event_call: mutable i64 = -1
    while cursor < n:
        return false if sview_at(blob, cursor) != rec
        record_start: usize = cursor + 1
        return false if record_start + 1 >= n or sview_at(blob, record_start + 1) != separator
        record_end: mutable usize = record_start
        while record_end < n and sview_at(blob, record_end) != rec:
            record_end <- record_end + 1
        tag: u8 = sview_at(blob, record_start)
        field_count: i64 = analysis_worker_record_field_count(blob, record_start, record_end)
        if hover_stream:
            if tag == 115: # symbol: tag, name, category, 1-based line, return type, name byte offset, declaration ID
                return false if field_count != 7
                name: mutable sview = sview("", 0, 0)
                category: mutable sview = sview("", 0, 0)
                line_field: mutable sview = sview("", 0, 0)
                offset_field: mutable sview = sview("", 0, 0)
                declaration_id_field: mutable sview = sview("", 0, 0)
                if not hover_field(blob, record_start, record_end, 1, name) or not hover_field(blob, record_start, record_end, 2, category) or not hover_field(blob, record_start, record_end, 3, line_field) or not hover_field(blob, record_start, record_end, 5, offset_field) or not hover_field(blob, record_start, record_end, 6, declaration_id_field):
                    return false
                return false if name.len == 0
                return false if category.len != 0 and string_view_eq(category, "fn") != 1 and string_view_eq(category, "struct") != 1 and string_view_eq(category, "enum") != 1 and string_view_eq(category, "alias") != 1 and string_view_eq(category, "const") != 1 and string_view_eq(category, "module") != 1 and string_view_eq(category, "import") != 1 and string_view_eq(category, "law") != 1
                source_line: mutable i64 = -1
                return false if not analysis_worker_ascii_uinteger(line_field, source_line) or source_line < 1
                return false if not analysis_worker_source_position_valid(source_line - 1, 0, src, src_len, starts, span_start, span_count, utf8)
                symbol_offset: mutable i64 = -1
                declaration_id: mutable i64 = -1
                return false if not analysis_worker_ascii_uinteger(offset_field, symbol_offset) or symbol_offset.usize() > src_len
                return false if not analysis_worker_ascii_uinteger(declaration_id_field, declaration_id)
            elif tag == 118: # enum variant: owner and variant name
                return false if field_count != 3
                owner: mutable sview = sview("", 0, 0)
                name: mutable sview = sview("", 0, 0)
                return false if not hover_field(blob, record_start, record_end, 1, owner) or not hover_field(blob, record_start, record_end, 2, name)
                return false if owner.len == 0 or name.len == 0
            elif tag == 111: # occurrence: tag, byte start/end, name, role, binding owner/serial, exact LSP range
                return false if field_count != 11
                start_field: mutable sview = sview("", 0, 0)
                end_field: mutable sview = sview("", 0, 0)
                name: mutable sview = sview("", 0, 0)
                kind_field: mutable sview = sview("", 0, 0)
                owner_field: mutable sview = sview("", 0, 0)
                serial_field: mutable sview = sview("", 0, 0)
                start_line_field: mutable sview = sview("", 0, 0)
                start_char_field: mutable sview = sview("", 0, 0)
                end_line_field: mutable sview = sview("", 0, 0)
                end_char_field: mutable sview = sview("", 0, 0)
                return false if not hover_field(blob, record_start, record_end, 1, start_field) or not hover_field(blob, record_start, record_end, 2, end_field) or not hover_field(blob, record_start, record_end, 3, name) or not hover_field(blob, record_start, record_end, 4, kind_field) or not hover_field(blob, record_start, record_end, 5, owner_field) or not hover_field(blob, record_start, record_end, 6, serial_field) or not hover_field(blob, record_start, record_end, 7, start_line_field) or not hover_field(blob, record_start, record_end, 8, start_char_field) or not hover_field(blob, record_start, record_end, 9, end_line_field) or not hover_field(blob, record_start, record_end, 10, end_char_field)
                start_offset: mutable i64 = -1
                end_offset: mutable i64 = -1
                kind: mutable i64 = -1
                owner: mutable i64 = -1
                serial: mutable i64 = -1
                start_line: mutable i64 = -1
                start_char: mutable i64 = -1
                end_line: mutable i64 = -1
                end_char: mutable i64 = -1
                return false if not analysis_worker_ascii_uinteger(start_field, start_offset) or not analysis_worker_ascii_uinteger(end_field, end_offset)
                return false if not analysis_worker_ascii_uinteger(kind_field, kind) or (kind != OCC_PARAM and kind != OCC_LOCAL)
                return false if not analysis_worker_ascii_uinteger(owner_field, owner) or owner > 4294967295
                return false if not analysis_worker_ascii_uinteger(serial_field, serial)
                return false if not analysis_worker_ascii_uinteger(start_line_field, start_line) or not analysis_worker_ascii_uinteger(start_char_field, start_char) or not analysis_worker_ascii_uinteger(end_line_field, end_line) or not analysis_worker_ascii_uinteger(end_char_field, end_char)
                return false if not analysis_worker_occurrence_span_matches(start_offset, end_offset, name, src, src_len)
                return false if not analysis_worker_source_position_valid(start_line, start_char, src, src_len, starts, span_start, span_count, utf8) or not analysis_worker_source_position_valid(end_line, end_char, src, src_len, starts, span_start, span_count, utf8)
                return false if start_line > end_line or (start_line == end_line and start_char >= end_char)
            elif tag == 116: # declared binding type: identity, exact source span, hex source text
                return false if field_count != 6
                owner_field: mutable sview = sview("", 0, 0)
                serial_field: mutable sview = sview("", 0, 0)
                start_field: mutable sview = sview("", 0, 0)
                end_field: mutable sview = sview("", 0, 0)
                type_hex: mutable sview = sview("", 0, 0)
                return false if not hover_field(blob, record_start, record_end, 1, owner_field) or not hover_field(blob, record_start, record_end, 2, serial_field) or not hover_field(blob, record_start, record_end, 3, start_field) or not hover_field(blob, record_start, record_end, 4, end_field) or not hover_field(blob, record_start, record_end, 5, type_hex)
                owner: mutable i64 = -1
                serial: mutable i64 = -1
                type_start: mutable i64 = -1
                type_end: mutable i64 = -1
                return false if not analysis_worker_ascii_uinteger(owner_field, owner) or not analysis_worker_ascii_uinteger(serial_field, serial)
                return false if not analysis_worker_ascii_uinteger(start_field, type_start) or not analysis_worker_ascii_uinteger(end_field, type_end)
                return false if not analysis_worker_hex_source_matches(type_hex, type_start, type_end, src, src_len)
            elif tag == 100: # definition edge: tag plus four source and four target coordinates
                return false if field_count != 9
                values: mutable darray[i64] = []
                for field_index in 1..=8:
                    value_field: mutable sview = sview("", 0, 0)
                    parsed: mutable i64 = -1
                    return false if not hover_field(blob, record_start, record_end, field_index, value_field) or not analysis_worker_ascii_uinteger(value_field, parsed)
                    values.push(parsed)
                return false if not analysis_worker_source_position_valid(values[0], values[1], src, src_len, starts, span_start, span_count, utf8)
                return false if not analysis_worker_source_position_valid(values[2], values[3], src, src_len, starts, span_start, span_count, utf8)
                return false if not analysis_worker_source_position_valid(values[4], values[5], src, src_len, starts, span_start, span_count, utf8)
                return false if not analysis_worker_source_position_valid(values[6], values[7], src, src_len, starts, span_start, span_count, utf8)
                return false if values[0] > values[2] or (values[0] == values[2] and values[1] >= values[3])
                return false if values[4] > values[6] or (values[4] == values[6] and values[5] >= values[7])
            else:
                return false
        else:
            # signature_record_field starts at record_start + 3, where its
            # record_start is the REC byte (as supplied by signature_record_next).
            signature_record_start: usize = record_start - 1
            if tag == 83: # signature: tag, symbol row, name, arity, parameter names, bounded exact header hex
                return false if field_count < 4
                row_field: mutable sview = sview("", 0, 0)
                name: mutable sview = sview("", 0, 0)
                arity_field: mutable sview = sview("", 0, 0)
                row: mutable i64 = -1
                arity: mutable i64 = -1
                return false if not signature_record_field(blob, signature_record_start, record_end, 0, row_field) or not analysis_worker_ascii_uinteger(row_field, row)
                return false if not signature_record_field(blob, signature_record_start, record_end, 1, name) or name.len == 0
                return false if not signature_record_field(blob, signature_record_start, record_end, 2, arity_field) or not analysis_worker_ascii_uinteger(arity_field, arity)
                return false if field_count != 5 + arity
                for field_index in 0..<arity.usize():
                    parameter: mutable sview = sview("", 0, 0)
                    return false if not signature_record_field(blob, signature_record_start, record_end, field_index + 3, parameter) or parameter.len == 0
                header_hex: mutable sview = sview("", 0, 0)
                return false if not signature_record_field(blob, signature_record_start, record_end, arity.usize() + 3, header_hex)
                return false if header_hex.len > 4096 or header_hex.len.usize() % 2 != 0
                for byte in header_hex:
                    return false if not (byte >= 48 and byte <= 57) and not (byte >= 97 and byte <= 102)
            elif tag == 69: # comma event: tag, call ID, exclusive source byte offset
                return false if field_count != 3
                call_field: mutable sview = sview("", 0, 0)
                offset_field: mutable sview = sview("", 0, 0)
                call_id: mutable i64 = -1
                offset: mutable i64 = -1
                return false if not signature_record_field(blob, signature_record_start, record_end, 0, call_field) or not analysis_worker_ascii_uinteger(call_field, call_id)
                return false if not signature_record_field(blob, signature_record_start, record_end, 1, offset_field) or not analysis_worker_ascii_uinteger(offset_field, offset)
                return false if offset.usize() > src_len
                largest_event_call <- call_id if call_id > largest_event_call
            elif tag == 67: # call: tag, sequential ID, open/close byte offsets, signature, two flags
                return false if field_count != 7
                values: mutable darray[i64] = []
                for field_index in 0..=5:
                    value_field: mutable sview = sview("", 0, 0)
                    parsed: mutable i64 = -1
                    return false if not signature_record_field(blob, signature_record_start, record_end, field_index, value_field) or not analysis_worker_ascii_uinteger(value_field, parsed)
                    values.push(parsed)
                return false if values[0] != call_count or values[1].usize() > src_len or values[2].usize() > src_len or values[1] > values[2]
                return false if values[4] > 1 or values[5] > 1
                call_count <- call_count + 1
            else:
                return false
        cursor <- record_end
    if not hover_stream and largest_event_call >= call_count:
        return false
    return true


# Debug-only response validation. Provider payloads are already generated from
# trusted internal structures, but this boundary is deliberately treated as a
# second contract check: every emitted range must be ordered, belong to the
# current open snapshot, and use a negotiated encoding boundary. The walk is
# recursive so locations nested in document symbols and selection-range parent
# chains receive exactly the same checks as top-level references/highlights.
def provider_source_position_valid(line: i64, character: i64, src: u8&, src_len: usize, starts: darray[usize]&, utf8: bool) -> bool can[Abort.Panic]:
    return false if line < 0 or line.usize() >= starts.count or character < 0
    units: i64 = Positions::line_unit_length_span_indexed(src, src_len, starts, 0, starts.count, line, utf8)
    return false if character > units
    # Round-trip through the negotiated inverse to reject positions inside a
    # UTF-8 scalar or the middle code unit of a UTF-16 surrogate pair.
    byte_col: i64 = Positions::char_to_byte_col_span_indexed(src, src_len, starts, 0, starts.count, line, character, utf8)
    return Positions::byte_col_to_units_span_indexed(src, src_len, starts, 0, starts.count, line, byte_col, utf8) == character


def provider_json_position(value: Json::Value, src: u8&, src_len: usize, starts: darray[usize]&, utf8: bool, line_out: mutable i64&, character_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(value) or Json::count_key(value, "line") != 1 or Json::count_key(value, "character") != 1
        if Json::get(value, "line") is line_value and Json::get(value, "character") is character_value:
            line: i64 = Json::as_lsp_uinteger_or_invalid(line_value)
            character: i64 = Json::as_lsp_uinteger_or_invalid(character_value)
            return false if not provider_source_position_valid(line, character, src, src_len, starts, utf8)
            line_out <- line
            character_out <- character
            return true
        return false


def provider_json_range(value: Json::Value, src: u8&, src_len: usize, starts: darray[usize]&, utf8: bool, start_line_out: mutable i64&, start_char_out: mutable i64&, end_line_out: mutable i64&, end_char_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return false if not root_is_object(value) or Json::count_key(value, "start") != 1 or Json::count_key(value, "end") != 1
        if Json::get(value, "start") is start_value and Json::get(value, "end") is end_value:
            start_line: mutable i64 = 0
            start_char: mutable i64 = 0
            end_line: mutable i64 = 0
            end_char: mutable i64 = 0
            return false if not provider_json_position(start_value, src, src_len, starts, utf8, start_line, start_char)
            return false if not provider_json_position(end_value, src, src_len, starts, utf8, end_line, end_char)
            return false if start_line > end_line or (start_line == end_line and start_char > end_char)
            start_line_out <- start_line
            start_char_out <- start_char
            end_line_out <- end_line
            end_char_out <- end_char
            return true
        return false


def provider_json_ranges_walk(value: Json::Value, src: u8&, src_len: usize, starts: darray[usize]&, uri: sview, utf8: bool, source_ordered_arrays: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        match value:
            Json::Value.Obj(fields):
                range_count: usize = Json::count_key(value, "range")
                if range_count > 0:
                    return false if range_count != 1
                    if Json::get(value, "range") is range:
                        start_line: mutable i64 = 0
                        start_char: mutable i64 = 0
                        end_line: mutable i64 = 0
                        end_char: mutable i64 = 0
                        return false if not provider_json_range(range, src, src_len, starts, utf8, start_line, start_char, end_line, end_char)
                    else:
                        return false
                # Current location providers are same-document providers. If a
                # payload carries a URI beside a range, require that identity
                # to resolve to this request's canonical snapshot.
                if range_count == 1 and Json::count_key(value, "uri") > 0:
                    return false if Json::count_key(value, "uri") != 1
                    if Json::get(value, "uri") is location_uri:
                        return false if not analysis_worker_json_string_is(location_uri, uri)
                    else:
                        return false

                # FoldingRange uses line-based coordinates and optional
                # character endpoints. Missing characters mean line start for
                # the start and line end for the end, as specified by LSP.
                start_line_count: usize = Json::count_key(value, "startLine")
                end_line_count: usize = Json::count_key(value, "endLine")
                if start_line_count > 0 or end_line_count > 0:
                    return false if start_line_count != 1 or end_line_count != 1
                    start_line: mutable i64 = -1
                    end_line: mutable i64 = -1
                    if Json::get(value, "startLine") is start_value:
                        start_line <- Json::as_lsp_uinteger_or_invalid(start_value)
                    if Json::get(value, "endLine") is end_value:
                        end_line <- Json::as_lsp_uinteger_or_invalid(end_value)
                    return false if not provider_source_position_valid(start_line, 0, src, src_len, starts, utf8)
                    return false if not provider_source_position_valid(end_line, 0, src, src_len, starts, utf8)
                    return false if start_line > end_line
                    start_char: mutable i64 = 0
                    end_char: mutable i64 = Positions::line_unit_length_span_indexed(src, src_len, starts, 0, starts.count, end_line, utf8)
                    if Json::count_key(value, "startCharacter") > 0:
                        return false if Json::count_key(value, "startCharacter") != 1
                        if Json::get(value, "startCharacter") is start_character_value:
                            start_char <- Json::as_lsp_uinteger_or_invalid(start_character_value)
                        else:
                            return false
                    if Json::count_key(value, "endCharacter") > 0:
                        return false if Json::count_key(value, "endCharacter") != 1
                        if Json::get(value, "endCharacter") is end_character_value:
                            end_char <- Json::as_lsp_uinteger_or_invalid(end_character_value)
                        else:
                            return false
                    return false if not provider_source_position_valid(start_line, start_char, src, src_len, starts, utf8)
                    return false if not provider_source_position_valid(end_line, end_char, src, src_len, starts, utf8)
                    return false if start_line == end_line and start_char > end_char

                for field in fields:
                    return false if not provider_json_ranges_walk(field.value, src, src_len, starts, uri, utf8, source_ordered_arrays)
                return true
            Json::Value.Arr(items):
                # Direct arrays of locations/symbols must remain in source order.
                # Nested arrays (for example relatedInformation) are checked by
                # the recursive walk below, while objects without a top-level
                # `range` do not impose an ordering policy of their own.
                previous_line: mutable i64 = -1
                previous_character: mutable i64 = -1
                for item in items:
                    if source_ordered_arrays and root_is_object(item) and Json::count_key(item, "range") == 1:
                        if Json::get(item, "range") is item_range:
                            item_start_line: mutable i64 = 0
                            item_start_character: mutable i64 = 0
                            item_end_line: mutable i64 = 0
                            item_end_character: mutable i64 = 0
                            return false if not provider_json_range(item_range, src, src_len, starts, utf8, item_start_line, item_start_character, item_end_line, item_end_character)
                            return false if previous_line > item_start_line or (previous_line == item_start_line and previous_character > item_start_character)
                            previous_line <- item_start_line
                            previous_character <- item_start_character
                    return false if not provider_json_ranges_walk(item, src, src_len, starts, uri, utf8, source_ordered_arrays)
                return true
            _:
                return true


def provider_result_ranges_valid(root: Json::Value, payload: sview, documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&, utf8: bool, kind: ProviderRangeKind) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        spell_bytes: mutable darray[u8] = []
        canon_bytes: mutable darray[u8] = []
        uri: sview = request_identity(root, spell_bytes, canon_bytes)
        return false if uri.len == 0
        found: i64 = document_index(documents, storage, heads, uri)
        return false if found < 0 or not documents[found.usize()].lifecycle.open
        document: LspDocument = documents[found.usize()]
        return false if document.source.text_len == 0 or document.source.text_start > storage.count
        return false if document.source.text_len > storage.count - document.source.text_start
        src_len: usize = document.source.text_len - 1
        src: u8& = &storage[document.source.text_start]
        # A temporary index deliberately mirrors the accepted snapshot even
        # when the document could not retain a sidecar span under its budget.
        # The flag is opt-in, so the extra scan is paid only by debug runs.
        starts: darray[usize] = Positions::build_line_starts(src, src_len)
        if kind == ProviderRangeKind.SemanticTokens:
            packet: mutable darray[u8] = []
            for i in 0..<payload.len.usize():
                packet.push(sview_at(payload, i))
            return analysis_worker_semantic_payload_valid(packet, 0, packet.count, src, src_len, starts, 0, starts.count, utf8, true)
        match Json::parse(payload):
            Json::ParseOutcome.Parsed(value):
                return provider_json_ranges_walk(value, src, src_len, starts, uri, utf8, kind != ProviderRangeKind.SelectionRanges)
            Json::ParseOutcome.Rejected(_):
                return false


def log_provider_range_validation_failure() -> void can[Console, Memory.Allocate, Abort.Panic]:
    if lsp_provider_range_failure_logs < 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: provider output range assertion failed\n")
        write_stderr(line)
        lsp_provider_range_failure_logs <- lsp_provider_range_failure_logs + 1
    elif lsp_provider_range_failure_logs == 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: further provider output range assertions suppressed\n")
        write_stderr(line)
        lsp_provider_range_failure_logs <- lsp_provider_range_failure_logs + 1


def log_analysis_worker_failure(reason: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    if lsp_analysis_worker_failure_logs < 8:
        line: mutable darray[u8] = []
        if reason == 1:
            push_str(line, "elisa-lsp: could not start the analysis worker\n")
        elif reason == 2:
            push_str(line, "elisa-lsp: analysis worker exited, timed out, or lost its pipe\n")
        elif reason == 3:
            push_str(line, "elisa-lsp: rejected malformed analysis worker header\n")
        elif reason == 6:
            push_str(line, "elisa-lsp: rejected inconsistent analysis worker metadata, lengths, or payload contents\n")
        elif reason == 5:
            push_str(line, "elisa-lsp: analysis snapshot exceeds the 64 MiB worker limit\n")
        else:
            push_str(line, "elisa-lsp: analysis worker failed\n")
        write_stderr(line)
        lsp_analysis_worker_failure_logs <- lsp_analysis_worker_failure_logs + 1
    elif lsp_analysis_worker_failure_logs == 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: further analysis worker failures suppressed\n")
        write_stderr(line)
        lsp_analysis_worker_failure_logs <- lsp_analysis_worker_failure_logs + 1


def mark_analysis_worker_failed(document: mutable LspDocument&, uri: sview, version: i64, reason: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    document_mark_analysis_failed(document)
    lsp_last_analysis_status <- 2
    lsp_last_cache_outcome <- LSP_CACHE_FAILED
    log_frontend_validation_failure() if reason == 4
    log_analysis_worker_failure(reason) if reason != 4
    return if elisa_lsp_pending_termination_signal() != 0
    publish_empty_diagnostics(uri, version)


# D04 retained-cache accounting. Capacity, rather than only the currently
# visible length, is the budgeted cost: a successful replacement can reuse a
# reservation that is larger than its current payload, and that reservation is
# still memory owned by the session. The worker packet cap remains a separate
# per-snapshot input/output limit.
def document_derived_cache_retained_bytes(document: LspDocument) -> usize:
    return document.caches.semantic_capacity + document.caches.symbols_capacity + document.caches.hover_capacity + document.caches.signature_capacity


def document_derived_cache_live_bytes(document: LspDocument) -> usize:
    return document.caches.semantic_len + document.caches.symbols_len + document.caches.hover_len + document.caches.signature_len


def least_recent_derived_cache_slot(documents: darray[LspDocument]&) -> i64:
    selected: mutable i64 = -1
    i: mutable usize = 0
    while i < documents.count:
        document: LspDocument = documents[i]
        if document.lifecycle.open and not document.lifecycle.free and document_derived_cache_retained_bytes(document) > 0:
            if selected < 0 or document.caches.last_access < documents[selected.usize()].caches.last_access:
                selected <- i.i64()
        i <- i + 1
    return selected


def derived_cache_retained_bytes(documents: darray[LspDocument]&) -> usize:
    total: mutable usize = 0
    i: mutable usize = 0
    while i < documents.count:
        if documents[i].lifecycle.open and not documents[i].lifecycle.free:
            total <- total + document_derived_cache_retained_bytes(documents[i])
        i <- i + 1
    return total


# Enforce the process/session aggregate derived-cache budget after an analysis
# completes. One whole snapshot is the eviction unit, which keeps the semantic,
# symbol, hover, and signature indexes from becoming a mixed-version bundle.
# Requests are synchronous, so no provider can hold a retained span while this
# boundary runs; a future scheduler must add explicit pin/reference tracking
# before reusing this routine for in-flight request snapshots.
def enforce_derived_cache_budget(documents: mutable darray[LspDocument]&) -> void:
    return if lsp_max_derived_cache_bytes <= 0
    limit: usize = lsp_max_derived_cache_bytes.usize()
    retained: mutable usize = derived_cache_retained_bytes(documents)
    while retained > limit:
        victim: i64 = least_recent_derived_cache_slot(documents)
        return if victim < 0
        victim_document: mutable LspDocument& = &documents[victim.usize()]
        released: usize = document_clear_derived_cache(victim_document)
        retained <- retained - released if released <= retained else 0
        lsp_cache_eviction_count <- lsp_cache_eviction_count + 1


# Admit only snapshots that fit both the per-document worker bound and the
# aggregate retained-source budget across currently open documents.
def document_source_admission_fits(documents: darray[LspDocument]&, excluded_slot: i64, incoming_source_bytes: usize) -> bool can[Abort.Panic]:
    return false if lsp_max_open_source_bytes <= 0
    return false if incoming_source_bytes > MAX_ANALYSIS_PACKET_BYTES
    limit: usize = lsp_max_open_source_bytes.usize()
    retained: mutable usize = 0
    i: mutable usize = 0
    while i < documents.count:
        if i.i64() != excluded_slot and documents[i].lifecycle.open and not documents[i].lifecycle.free:
            source_bytes: mutable usize = 0
            source_bytes <- documents[i].source.text_len - 1 if documents[i].source.text_len > 0
            return false if source_bytes > limit - retained
            retained <- retained + source_bytes
        i <- i + 1
    return incoming_source_bytes <= limit - retained


# Apply document-count and retained URI-metadata budgets before a new open
# can reserve a document slot or insert into the URI index. Duplicate opens
# exclude their existing slot, then add the replacement URI back into the
# admission calculation so the document does not consume a second slot.
def document_open_metadata_admission_fits(documents: darray[LspDocument]&, excluded_slot: i64, incoming_uri_bytes: usize) -> bool can[Abort.Panic]:
    return false if lsp_max_open_documents <= 0 or lsp_max_open_uri_bytes <= 0
    max_documents: usize = lsp_max_open_documents.usize()
    max_uri_bytes: usize = lsp_max_open_uri_bytes.usize()
    retained_documents: mutable usize = 0
    retained_uri_bytes: mutable usize = 0
    i: mutable usize = 0
    while i < documents.count:
        document: LspDocument = documents[i]
        if i.i64() != excluded_slot and document.lifecycle.open and not document.lifecycle.free:
            return false if retained_documents >= max_documents
            retained_documents <- retained_documents + 1
            return false if document.uri_index.uri_len > max_uri_bytes - retained_uri_bytes
            retained_uri_bytes <- retained_uri_bytes + document.uri_index.uri_len
            return false if document.uri_index.spelling_len > max_uri_bytes - retained_uri_bytes
            retained_uri_bytes <- retained_uri_bytes + document.uri_index.spelling_len
        i <- i + 1
    return false if retained_documents >= max_documents
    return incoming_uri_bytes <= max_uri_bytes - retained_uri_bytes


# Keep admission rejections visible during development without retaining or
# printing any client URI or source content. A notification cannot receive a
# JSON-RPC error response, so rejection leaves the previously accepted
# snapshot untouched and reports one bounded stderr message.
def log_document_admission_rejection() -> void can[Console, Memory.Allocate, Abort.Panic]:
    if lsp_document_admission_rejection_logs < 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: rejected document update over configured resource limits\n")
        write_stderr(line)
        lsp_document_admission_rejection_logs <- lsp_document_admission_rejection_logs + 1
    elif lsp_document_admission_rejection_logs == 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: further document resource rejections suppressed\n")
        write_stderr(line)
        lsp_document_admission_rejection_logs <- lsp_document_admission_rejection_logs + 1


# Keep the element borrow used to replace source text inside a short helper.
# The current frontend invalidates views derived from `documents` and
# `storage` after this mutation, so callers must reacquire them at the next
# function boundary before constructing analysis views.
def store_document_text_at_slot(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, slot: usize, source: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    document: mutable LspDocument& = &documents[slot]
    store_document_text(document, storage, source)


def store_document_spelling_at_slot(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, slot: usize, spelling: sview) -> void can[Memory.Allocate, Abort.Panic]:
    document: mutable LspDocument& = &documents[slot]
    document_store_uri_spelling(document, storage, spelling)


def store_analysis_cache_blob_at_slot(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, slot: usize, target: DocumentCacheTarget, packet: darray[u8]&, source_start: usize, needed: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    document: mutable LspDocument& = &documents[slot]
    return document_store_cache_blob(document, target, storage, packet, source_start, needed)


# Encode a canonical, typed request-ID key. Numeric spellings normalize to the
# parsed integer and escaped string spellings normalize to the decoded value.
# This keeps integer 1 distinct from string "1" while cancellation is pending.
def pending_request_id_token(value: Json::Value, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    out.truncate(0)
    match value:
        Json::Value.Num(text):
            match Json::as_lsp_integer_result(value):
                Json::I64ParseOutcome.Valid(number):
                    out.push(78)
                    push_int(out, number)
                    return true
                Json::I64ParseOutcome.Invalid:
                    return false
        Json::Value.Str(_):
            decoded: mutable darray[u8] = []
            Json::decode_into(value, decoded)
            out.push(83)
            out.push(34)
            json_escape_utf8(out, bytes_view_range_ref(decoded, 0, decoded.count))
            out.push(34)
            return true
        _:
            return false


def pending_analysis_request_index(queue: LspPendingAnalysisQueue&, id_token: darray[u8]&) -> i64:
    i: mutable usize = 0
    while i < queue.requests.count:
        if string_views_eq(bytes_view_range_ref(queue.storage, queue.requests[i].key_start, queue.requests[i].key_len), bytes_view_range_ref(id_token, 0, id_token.count)) != 0:
            return i.i64()
        i <- i + 1
    return -1


def pending_analysis_request_remove(queue: mutable LspPendingAnalysisQueue&, index: usize) -> void can[Abort.Panic]:
    return if index >= queue.requests.count
    removed: LspPendingAnalysisRequest = queue.requests[index]
    removed_len: usize = removed.body_len + removed.key_len + removed.response_id_len
    removed_start: usize = removed.body_start
    tail_start: usize = removed_start + removed_len
    tail_len: usize = queue.storage.count - tail_start if tail_start <= queue.storage.count else 0
    i: mutable usize = 0
    while i < tail_len:
        queue.storage[removed_start + i] <- queue.storage[tail_start + i]
        i <- i + 1
    queue.storage.truncate(queue.storage.count - removed_len) if removed_len <= queue.storage.count
    i <- index + 1
    while i < queue.requests.count:
        queue.requests[i].body_start <- queue.requests[i].body_start - removed_len
        queue.requests[i].key_start <- queue.requests[i].key_start - removed_len
        queue.requests[i].response_id_start <- queue.requests[i].response_id_start - removed_len
        i <- i + 1
    queue.body_bytes <- queue.body_bytes - removed.body_len if removed.body_len <= queue.body_bytes
    _ = queue.requests.remove_at(index)


def pending_analysis_request_enqueue(root: Json::Value, method: sview, body: darray[u8]&, documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&, runtime: LspAnalysisWorkerRuntime&, queue: mutable LspPendingAnalysisQueue&) -> bool can[Memory.Allocate, Abort.Panic, Console]:
    return false if not method_waits_for_analysis_snapshot(method)
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return false if uri.len == 0
    found: i64 = document_index(documents, storage, heads, uri)
    return false if found < 0
    slot: usize = found.usize()
    document: LspDocument = documents[slot]
    return false if not document.lifecycle.open or document.lifecycle.analysis_state != DocumentAnalysisState.Pending
    is_scheduled: bool = document.lifecycle.analysis_queued or (runtime.active and runtime.slot == slot)
    return false if not is_scheduled

    id_token: mutable darray[u8] = extract_id(root)
    request_key: mutable darray[u8] = []
    valid_key: mutable bool = false
    if Json::get(root, "id") is request_id:
        valid_key <- pending_request_id_token(request_id, request_key)
    return false if not valid_key
    duplicate: i64 = pending_analysis_request_index(queue, request_key)
    if duplicate >= 0:
        duplicate_request: LspPendingAnalysisRequest = queue.requests[duplicate.usize()]
        duplicate_id: mutable darray[u8] = []
        duplicate_id.extend([b for b in bytes_view_range_ref(queue.storage, duplicate_request.response_id_start, duplicate_request.response_id_len)])
        pending_analysis_request_remove(queue, duplicate.usize())
        send_error(duplicate_id, -32600, "InvalidRequest: duplicate pending request ID")
        return true

    request_storage_bytes: usize = body.count + request_key.count + id_token.count
    if queue.requests.count >= MAX_PENDING_ANALYSIS_REQUESTS or body.count > MAX_PENDING_ANALYSIS_REQUEST_BYTES or body.count > MAX_PENDING_ANALYSIS_REQUEST_BYTES - queue.body_bytes or request_storage_bytes > MAX_PENDING_ANALYSIS_STORAGE_BYTES or queue.storage.count > MAX_PENDING_ANALYSIS_STORAGE_BYTES - request_storage_bytes:
        send_error(id_token, LSP_ERROR_SERVER_BUSY, "ServerBusy")
        return true

    body_start: usize = queue.storage.count
    queue.storage.extend([b for b in body])
    key_start: usize = queue.storage.count
    queue.storage.extend([b for b in request_key])
    response_id_start: usize = queue.storage.count
    queue.storage.extend([b for b in id_token])
    queued_at_ms: i64 = lsp_timing_start() can Console
    pending: LspPendingAnalysisRequest = LspPendingAnalysisRequest{body_start: body_start, body_len: body.count, key_start: key_start, key_len: request_key.count, response_id_start: response_id_start, response_id_len: id_token.count, slot: slot, job_id: document.lifecycle.analysis_job_id, generation: document.lifecycle.generation.i64(), version: document.lifecycle.version, priority: analysis_request_priority(method), queued_at_ms: queued_at_ms, ready: false}
    queue.body_bytes <- queue.body_bytes + body.count
    queue.requests.push(pending)
    return true


def pending_analysis_requests_rebind(queue: mutable LspPendingAnalysisQueue&, slot: usize, job_id: i64, generation: i64, version: i64) -> void:
    i: mutable usize = 0
    while i < queue.requests.count:
        if queue.requests[i].slot == slot:
            queue.requests[i].job_id <- job_id
            queue.requests[i].generation <- generation
            queue.requests[i].version <- version
            queue.requests[i].ready <- false
        i <- i + 1


def pending_analysis_requests_mark_ready(queue: mutable LspPendingAnalysisQueue&, slot: usize, job_id: i64, generation: i64, version: i64) -> void:
    i: mutable usize = 0
    while i < queue.requests.count:
        if queue.requests[i].slot == slot and queue.requests[i].job_id == job_id and queue.requests[i].generation == generation and queue.requests[i].version == version:
            queue.requests[i].ready <- true
        i <- i + 1


def pending_analysis_request_take_ready(queue: mutable LspPendingAnalysisQueue&, body: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Console]:
    i: mutable usize = 0
    while i < queue.requests.count:
        if queue.requests[i].ready:
            request: LspPendingAnalysisRequest = queue.requests[i]
            body.extend([b for b in bytes_view_range_ref(queue.storage, request.body_start, request.body_len)])
            lsp_timing_queue_wait_ms <- 0 if lsp_timing_enabled
            replayed_at_ms: i64 = lsp_timing_start() can Console
            lsp_timing_queue_wait_ms <- replayed_at_ms - request.queued_at_ms if replayed_at_ms >= request.queued_at_ms and request.queued_at_ms >= 0
            pending_analysis_request_remove(queue, i)
            return true
        i <- i + 1
    return false


def pending_analysis_request_cancel(root: Json::Value, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    id_token: mutable darray[u8] = []
    if Json::get(root, "params") is params:
        if Json::get(params, "id") is cancel_id:
            if pending_request_id_token(cancel_id, id_token):
                pass
            else:
                return
        else:
            return
    else:
        return
    found: i64 = pending_analysis_request_index(queue, id_token)
    cancel_log: mutable darray[u8] = []
    push_str(cancel_log, "event=pending_cancel matched=true") if found >= 0
    push_str(cancel_log, "event=pending_cancel matched=false") if found < 0
    push_str(cancel_log, " queued=")
    push_int(cancel_log, queue.requests.count.i64())
    log_line(LSP_LOG_DEBUG, cancel_log)
    return if found < 0
    request: LspPendingAnalysisRequest = queue.requests[found.usize()]
    response_id: mutable darray[u8] = []
    response_id.extend([b for b in bytes_view_range_ref(queue.storage, request.response_id_start, request.response_id_len)])
    pending_analysis_request_remove(queue, found.usize())
    send_error(response_id, LSP_ERROR_REQUEST_CANCELLED, "RequestCancelled")


def pending_analysis_requests_cancel_slot(queue: mutable LspPendingAnalysisQueue&, slot: usize, code: i64, message: cstr) -> void can[Console, Memory.Allocate, Abort.Panic]:
    i: mutable usize = 0
    while i < queue.requests.count:
        if queue.requests[i].slot == slot:
            request: LspPendingAnalysisRequest = queue.requests[i]
            response_id: mutable darray[u8] = []
            response_id.extend([b for b in bytes_view_range_ref(queue.storage, request.response_id_start, request.response_id_len)])
            pending_analysis_request_remove(queue, i)
            send_error(response_id, code, message)
        else:
            i <- i + 1


def pending_analysis_requests_cancel_all(queue: mutable LspPendingAnalysisQueue&, code: i64, message: cstr) -> void can[Console, Memory.Allocate, Abort.Panic]:
    while queue.requests.count > 0:
        index: usize = queue.requests.count - 1
        request: LspPendingAnalysisRequest = queue.requests[index]
        response_id: mutable darray[u8] = []
        response_id.extend([b for b in bytes_view_range_ref(queue.storage, request.response_id_start, request.response_id_len)])
        pending_analysis_request_remove(queue, index)
        send_error(response_id, code, message)


# Run the frontend over the document and publish its findings. The decoded
# text and its uri are stored in the session cache so later semantic-token and
# hover requests can retrieve the correct snapshot for their own URI.
# D01: versioned lifecycle — accept text into the store only for eligible
# versions; stale/equal versions never mutate; duplicate opens start a new
# generation; malformed notifications mutate nothing.
def analysis_worker_start_slot(slot: usize, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, line_starts: mutable darray[usize]&, utf8: bool, symbols_hier: bool, allowed_kinds: darray[i64]&, related: bool, runtime: mutable LspAnalysisWorkerRuntime&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if slot >= documents.count
    return if documents[slot].lifecycle.free or not documents[slot].lifecycle.open or not documents[slot].lifecycle.analysis_queued
    source_len: usize = documents[slot].source.text_len - 1 if documents[slot].source.text_len > 0 else 0
    spell: sview = bytes_view_range_ref(storage, documents[slot].uri_index.spelling_start, documents[slot].uri_index.spelling_len)
    incoming_version: i64 = documents[slot].lifecycle.version
    job_id: i64 = documents[slot].lifecycle.analysis_job_id
    snapshot_generation: i64 = documents[slot].lifecycle.generation.i64()
    if documents[slot].source.text_len == 0:
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 1)
        pending_analysis_requests_mark_ready(queue, slot, job_id, snapshot_generation, incoming_version)
        return
    source: u8& = &storage[documents[slot].source.text_start]
    uri_hash: i64 = documents[slot].uri_index.hash.i64()
    source_hash: i64 = analysis_source_fingerprint(source, source_len).i64()
    worker_role: int = elisa_lsp_analysis_worker_begin(lsp_analysis_timeout_ms) can Console
    if worker_role < 0:
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 1)
        pending_analysis_requests_mark_ready(queue, slot, job_id, snapshot_generation, incoming_version)
        return
    if worker_role == 1:
        base_tokenize: i64 = lsp_frontend_tokenize_calls
        base_parse: i64 = lsp_frontend_parse_calls
        base_check: i64 = lsp_frontend_check_calls
        base_queries: i64 = lsp_adapter_query_calls
        base_symbol_index: i64 = lsp_adapter_symbol_index_build_calls
        base_occurrence_index: i64 = lsp_adapter_occurrence_index_build_calls
        base_line_index_fallback: i64 = lsp_line_index_fallback_build_calls
        signature_index: mutable darray[u8] = []
        analysis_valid: mutable bool = false
        token_batch: LspFrontendTokenBatch = tokenize_frontend_source(source, source_len)
        # Keep the source, token batch, parsed AST, and semantic table in one
        # analysis scope. The table retains views into parser/source storage,
        # so returning it from a helper with a local `Ast::File` would outlive
        # the owners that keep those views valid.
        parse_started_ms: i64 = lsp_timing_start() can Console
        lsp_frontend_parse_calls <- lsp_frontend_parse_calls + 1
        file: Ast::File = frontend_parser_parse_file(source, token_batch.tokens)
        lsp_timing_record(lsp_timing_parse_ms, parse_started_ms) can Console
        check_started_ms: i64 = lsp_timing_start() can Console
        lsp_frontend_check_calls <- lsp_frontend_check_calls + 1
        table: Semantic::SymbolTable = Semantic::check(file)
        lsp_timing_record(lsp_timing_check_ms, check_started_ms) can Console
        occurrence_positions: mutable darray[Ast::Pos] = []
        analysis_valid <- frontend_table_valid(table, source, source_len, file.errors)
        analysis_valid <- frontend_occurrence_positions(table, token_batch.tokens, source, source_len, occurrence_positions) if analysis_valid
        completeness: mutable LspFrontendCompleteness = LspFrontendCompleteness.Rejected
        completeness <- LspFrontendCompleteness.Recovered if analysis_valid and file.errors.count > 0
        completeness <- LspFrontendCompleteness.Complete if analysis_valid and file.errors.count == 0
        frontend_snapshot: LspFrontendAnalysisSnapshot = LspFrontendAnalysisSnapshot{
            contract_version: frontend_contract_version(), source_len: source_len,
            token_batch: token_batch, syntax: file, semantic: table,
            symbols: table.symbols, diagnostics: table.diagnostics,
            occurrences: occurrence_positions, completeness: completeness
        }
        analysis_valid <- frontend_analysis_snapshot_valid(frontend_snapshot, source_len)
        signature_index <- build_signature_help_index(frontend_snapshot.syntax, frontend_snapshot.semantic, frontend_snapshot.token_batch.tokens, source, source_len) if analysis_valid
        semantic: mutable darray[u8] = []
        symbols: mutable darray[u8] = []
        hover: mutable darray[u8] = []
        diagnostics: mutable darray[u8] = []
        status_code: mutable i64 = 1
        index_started_ms: i64 = lsp_timing_start() can Console
        if analysis_valid:
            if documents[slot].caches.line_index_count > 0:
                semantic <- semtok_data_body_with_table(source, source_len, frontend_snapshot.token_batch.tokens, frontend_snapshot.token_batch.comments, frontend_snapshot.semantic, frontend_snapshot.occurrences, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8)
                symbols <- build_symbols_body(spell, frontend_snapshot.semantic, frontend_snapshot.token_batch.tokens, source, source_len, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8, symbols_hier, allowed_kinds)
                hover <- build_hover_index(frontend_snapshot.semantic, frontend_snapshot.occurrences, frontend_snapshot.token_batch.tokens, source, source_len, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8)
                diagnostics <- build_publish_body(spell, frontend_snapshot.semantic, source, source_len, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, incoming_version, utf8, related)
            else:
                # Over-budget snapshots build one worker-local index and share
                # it across every analysis-time provider for this job.
                worker_fallback_starts: darray[usize] = Positions::build_line_starts(source, source_len)
                lsp_line_index_fallback_build_calls <- lsp_line_index_fallback_build_calls + 1
                semantic <- semtok_data_body_with_table(source, source_len, frontend_snapshot.token_batch.tokens, frontend_snapshot.token_batch.comments, frontend_snapshot.semantic, frontend_snapshot.occurrences, worker_fallback_starts, 0, worker_fallback_starts.count, utf8)
                symbols <- build_symbols_body(spell, frontend_snapshot.semantic, frontend_snapshot.token_batch.tokens, source, source_len, worker_fallback_starts, 0, worker_fallback_starts.count, utf8, symbols_hier, allowed_kinds)
                hover <- build_hover_index(frontend_snapshot.semantic, frontend_snapshot.occurrences, frontend_snapshot.token_batch.tokens, source, source_len, worker_fallback_starts, 0, worker_fallback_starts.count, utf8)
                diagnostics <- build_publish_body(spell, frontend_snapshot.semantic, source, source_len, worker_fallback_starts, 0, worker_fallback_starts.count, incoming_version, utf8, related)
            status_code <- 0
        lsp_timing_record(lsp_timing_index_ms, index_started_ms) can Console
        packet_written: bool = analysis_worker_send_packet(job_id, snapshot_generation, incoming_version, source_len.i64(), uri_hash, source_hash, status_code, semantic, symbols, hover, signature_index, diagnostics, lsp_frontend_tokenize_calls - base_tokenize, lsp_frontend_parse_calls - base_parse, lsp_frontend_check_calls - base_check, lsp_adapter_query_calls - base_queries, lsp_adapter_symbol_index_build_calls - base_symbol_index, lsp_adapter_occurrence_index_build_calls - base_occurrence_index, lsp_line_index_fallback_build_calls - base_line_index_fallback, lsp_timing_lex_ms, lsp_timing_parse_ms, lsp_timing_check_ms, lsp_timing_index_ms) can Console, Memory.Allocate, Abort.Panic
        elisa_lsp_analysis_worker_child_exit(0 if packet_written else 74) can Console
        return

    runtime.active <- true
    runtime.packet.truncate(0)
    runtime.eof_seen <- false
    runtime.slot <- slot
    runtime.job_id <- job_id
    runtime.generation <- snapshot_generation
    runtime.version <- incoming_version
    runtime.source_len <- source_len
    runtime.uri_hash <- uri_hash
    runtime.source_hash <- source_hash
    runtime.utf8 <- utf8
    runtime.symbols_hier <- symbols_hier
    runtime.related <- related
    documents[slot].lifecycle.analysis_queued <- false


def analysis_worker_start_next_pending(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, line_starts: mutable darray[usize]&, utf8: bool, symbols_hier: bool, allowed_kinds: darray[i64]&, related: bool, runtime: mutable LspAnalysisWorkerRuntime&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    while not runtime.active:
        selected: mutable i64 = -1
        selected_priority: mutable i64 = 3
        selected_job: mutable i64 = 9223372036854775807
        i: mutable usize = 0
        while i < documents.count:
            document: LspDocument = documents[i]
            if document.lifecycle.open and not document.lifecycle.free and document.lifecycle.analysis_queued:
                priority: mutable i64 = 2
                request_i: mutable usize = 0
                while request_i < queue.requests.count:
                    request: LspPendingAnalysisRequest = queue.requests[request_i]
                    if not request.ready and request.slot == i and request.job_id == document.lifecycle.analysis_job_id and request.generation == document.lifecycle.generation.i64() and request.version == document.lifecycle.version:
                        priority <- request.priority if request.priority < priority
                    request_i <- request_i + 1
                if selected < 0 or priority < selected_priority or (priority == selected_priority and document.lifecycle.analysis_job_id < selected_job):
                    selected <- i.i64()
                    selected_priority <- priority
                    selected_job <- document.lifecycle.analysis_job_id
            i <- i + 1
        return if selected < 0
        analysis_worker_start_slot(selected.usize(), documents, storage, line_starts, utf8, symbols_hier, allowed_kinds, related, runtime, queue)


def analysis_worker_runtime_clear(runtime: mutable LspAnalysisWorkerRuntime&) -> void:
    runtime.active <- false
    runtime.packet.truncate(0)
    runtime.eof_seen <- false


def analysis_worker_abort_runtime(runtime: mutable LspAnalysisWorkerRuntime&) -> void can[Console]:
    elisa_lsp_analysis_worker_abort() can Console
    analysis_worker_runtime_clear(runtime)


def analysis_worker_fail_current(runtime: LspAnalysisWorkerRuntime&, documents: mutable darray[LspDocument]&, storage: darray[u8]&, reason: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if runtime.slot >= documents.count
    return if documents[runtime.slot].lifecycle.free
    current: bool = document_analysis_is_current(documents[runtime.slot], runtime.job_id, runtime.generation, runtime.version)
    return if not current
    spell: sview = bytes_view_range_ref(storage, documents[runtime.slot].uri_index.spelling_start, documents[runtime.slot].uri_index.spelling_len)
    mark_analysis_worker_failed(&documents[runtime.slot], spell, runtime.version, reason)


def analysis_worker_commit_packet(runtime: mutable LspAnalysisWorkerRuntime&, packet: mutable darray[u8]&, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, line_starts: mutable darray[usize]&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if runtime.slot >= documents.count
    slot: usize = runtime.slot
    return if documents[slot].lifecycle.free
    job_id: i64 = runtime.job_id
    snapshot_generation: i64 = runtime.generation
    incoming_version: i64 = runtime.version
    source_len: usize = runtime.source_len
    uri_hash: i64 = runtime.uri_hash
    source_hash: i64 = runtime.source_hash
    utf8: bool = runtime.utf8
    symbols_hier: bool = runtime.symbols_hier
    spelling_storage: mutable darray[u8] = []
    spelling_storage.extend([b for b in bytes_view_range_ref(storage, documents[slot].uri_index.spelling_start, documents[slot].uri_index.spelling_len)])
    spell: sview = bytes_view_range_ref(spelling_storage, 0, spelling_storage.count)
    fields: mutable darray[i64] = []
    payload_start: mutable usize = 0
    if not analysis_worker_parse_header(packet, fields, payload_start):
        elisa_lsp_analysis_worker_abort() can Console
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 3)
        return
    payload_bytes: mutable usize = 0
    packet_valid: mutable bool = true
    i: mutable usize = 7
    while i <= 11:
        length: i64 = fields[i]
        if length < 0:
            packet_valid <- false
            break
        length_bytes: usize = length.usize()
        if length_bytes > MAX_ANALYSIS_PACKET_BYTES:
            packet_valid <- false
            break
        if payload_bytes > MAX_ANALYSIS_PACKET_BYTES - length_bytes:
            packet_valid <- false
            break
        payload_bytes <- payload_bytes + length_bytes
        i <- i + 1
    if payload_start > packet.count or packet.count - payload_start != payload_bytes:
        packet_valid <- false
    if fields[0] != job_id or fields[1] != snapshot_generation or fields[2] != incoming_version or fields[3] != source_len.i64() or fields[4] != uri_hash or fields[5] != source_hash or (fields[6] != 0 and fields[6] != 1):
        packet_valid <- false
    i <- 12
    while i < fields.count:
        packet_valid <- false if fields[i] < 0
        i <- i + 1
    if fields[6] == 0 and fields[11] == 0:
        packet_valid <- false
    if fields[6] == 1 and (fields[7] != 0 or fields[8] != 0 or fields[9] != 0 or fields[10] != 0 or fields[11] != 0):
        packet_valid <- false
    if fields[12] != 1 or fields[13] != 1 or fields[14] != 1 or fields[15] < 1:
        packet_valid <- false
    if fields[6] == 0 and (fields[16] != 1 or fields[17] != 1):
        packet_valid <- false
    if fields[6] == 1 and (fields[16] != 0 or fields[17] != 0):
        packet_valid <- false
    if fields[6] == 1 and fields[18] != 0:
        packet_valid <- false
    if fields[6] == 0 and documents[slot].caches.line_index_count > 0 and fields[18] != 0:
        packet_valid <- false
    if fields[6] == 0 and documents[slot].caches.line_index_count == 0 and fields[18] != 1:
        packet_valid <- false
    if not packet_valid:
        elisa_lsp_analysis_worker_abort() can Console
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    # A valid old result is discarded if future scheduling allows a newer
    # update or close to race this completion.
    return if not document_analysis_is_current(documents[slot], job_id, snapshot_generation, incoming_version) or documents[slot].uri_index.hash.i64() != uri_hash or documents[slot].source.text_len != source_len + 1 or analysis_source_fingerprint(&storage[documents[slot].source.text_start], source_len).i64() != source_hash
    if fields[6] != 0:
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 4)
        return
    payload_pos: mutable usize = payload_start
    semantic_start: usize = payload_pos
    payload_pos <- payload_pos + fields[7].usize()
    symbols_start: usize = payload_pos
    payload_pos <- payload_pos + fields[8].usize()
    hover_start: usize = payload_pos
    payload_pos <- payload_pos + fields[9].usize()
    signature_start: usize = payload_pos
    payload_pos <- payload_pos + fields[10].usize()
    diagnostics_start: usize = payload_pos
    # The packet is untrusted even after its framing and snapshot identity pass.
    # Validate every derived representation before mutating cache storage or
    # exposing the diagnostics body to the client.
    src: u8& = &storage[documents[slot].source.text_start]
    src_len_valid: usize = documents[slot].source.text_len - 1
    doc_uri: sview = spell
    payloads_valid: mutable bool = false
    if documents[slot].caches.line_index_count > 0:
        payloads_valid <- analysis_worker_semantic_payload_valid(packet, semantic_start, fields[7].usize(), src, src_len_valid, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8, false)
        payloads_valid <- analysis_worker_symbols_payload_valid(packet, symbols_start, fields[8].usize(), symbols_hier, doc_uri, src, src_len_valid, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8) if payloads_valid
        hover_view: sview = bytes_view_range_ref(packet, hover_start, fields[9].usize()) if fields[9] > 0 else sview("", 0, 0)
        payloads_valid <- analysis_worker_private_record_stream(hover_view, true, src_len_valid, src, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8) if payloads_valid
        signature_view: sview = bytes_view_range_ref(packet, signature_start, fields[10].usize()) if fields[10] > 0 else sview("", 0, 0)
        payloads_valid <- analysis_worker_private_record_stream(signature_view, false, src_len_valid, src, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8) if payloads_valid
        payloads_valid <- analysis_worker_diagnostics_payload_valid(packet, diagnostics_start, fields[11].usize(), spell, incoming_version, src, src_len_valid, line_starts, documents[slot].caches.line_index_start, documents[slot].caches.line_index_count, utf8) if payloads_valid
    else:
        validation_starts: darray[usize] = Positions::build_line_starts(src, src_len_valid)
        payloads_valid <- analysis_worker_semantic_payload_valid(packet, semantic_start, fields[7].usize(), src, src_len_valid, validation_starts, 0, validation_starts.count, utf8, false)
        payloads_valid <- analysis_worker_symbols_payload_valid(packet, symbols_start, fields[8].usize(), symbols_hier, doc_uri, src, src_len_valid, validation_starts, 0, validation_starts.count, utf8) if payloads_valid
        hover_view: sview = bytes_view_range_ref(packet, hover_start, fields[9].usize()) if fields[9] > 0 else sview("", 0, 0)
        payloads_valid <- analysis_worker_private_record_stream(hover_view, true, src_len_valid, src, validation_starts, 0, validation_starts.count, utf8) if payloads_valid
        signature_view: sview = bytes_view_range_ref(packet, signature_start, fields[10].usize()) if fields[10] > 0 else sview("", 0, 0)
        payloads_valid <- analysis_worker_private_record_stream(signature_view, false, src_len_valid, src, validation_starts, 0, validation_starts.count, utf8) if payloads_valid
        payloads_valid <- analysis_worker_diagnostics_payload_valid(packet, diagnostics_start, fields[11].usize(), spell, incoming_version, src, src_len_valid, validation_starts, 0, validation_starts.count, utf8) if payloads_valid
    if not payloads_valid:
        elisa_lsp_analysis_worker_abort() can Console
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    lsp_frontend_tokenize_calls <- lsp_frontend_tokenize_calls + fields[12]
    lsp_frontend_parse_calls <- lsp_frontend_parse_calls + fields[13]
    lsp_frontend_check_calls <- lsp_frontend_check_calls + fields[14]
    lsp_adapter_query_calls <- lsp_adapter_query_calls + fields[15]
    lsp_adapter_symbol_index_build_calls <- lsp_adapter_symbol_index_build_calls + fields[16]
    lsp_adapter_occurrence_index_build_calls <- lsp_adapter_occurrence_index_build_calls + fields[17]
    lsp_line_index_fallback_build_calls <- lsp_line_index_fallback_build_calls + fields[18]
    lsp_timing_lex_ms <- fields[19]
    lsp_timing_parse_ms <- fields[20]
    lsp_timing_check_ms <- fields[21]
    lsp_timing_index_ms <- fields[22]
    # Commit derived state only while the analyzed snapshot is still current.
    if not store_analysis_cache_blob_at_slot(documents, storage, slot, DocumentCacheTarget.Semantic, packet, semantic_start, fields[7].usize()):
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    if not store_analysis_cache_blob_at_slot(documents, storage, slot, DocumentCacheTarget.Symbols, packet, symbols_start, fields[8].usize()):
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    if not store_analysis_cache_blob_at_slot(documents, storage, slot, DocumentCacheTarget.Hover, packet, hover_start, fields[9].usize()):
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    if not store_analysis_cache_blob_at_slot(documents, storage, slot, DocumentCacheTarget.Signature, packet, signature_start, fields[10].usize()):
        mark_analysis_worker_failed(&documents[slot], spell, incoming_version, 6)
        return
    document_mark_analysis_ready(&documents[slot])
    document_touch_cache(documents, slot, lsp_cache_access_clock)
    # Cache commit and provider dispatch still run on the parent thread, so no
    # response can retain a cache span across this boundary.
    enforce_derived_cache_budget(documents)
    lsp_last_analysis_status <- 1
    lsp_last_cache_outcome <- LSP_CACHE_UPDATED
    fp: u64 = body_fingerprint_span(packet, diagnostics_start, fields[11].usize())
    # Suppress identical repeats for the same version (e.g. duplicate didOpen);
    # the version is embedded in the body, so equal fingerprints imply equal
    # versions and findings — version correctness is preserved.
    if document_diagnostics_already_published(documents[slot], documents[slot].lifecycle.version, fp):
        lsp_last_cache_outcome <- LSP_CACHE_SUPPRESSED
        return
    document_record_published_diagnostics(&documents[slot], documents[slot].lifecycle.version, fp)
    send_message_span(packet, diagnostics_start, fields[11].usize())



def analysis_worker_complete(runtime: mutable LspAnalysisWorkerRuntime&, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, line_starts: mutable darray[usize]&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    analysis_worker_commit_packet(runtime, runtime.packet, documents, storage, line_starts)
    pending_analysis_requests_mark_ready(queue, runtime.slot, runtime.job_id, runtime.generation, runtime.version)
    analysis_worker_runtime_clear(runtime)


def analysis_worker_process_events(events: int, runtime: mutable LspAnalysisWorkerRuntime&, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, line_starts: mutable darray[usize]&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if not runtime.active
    if (events & 8) != 0:
        analysis_worker_fail_current(runtime, documents, storage, 2)
        pending_analysis_requests_mark_ready(queue, runtime.slot, runtime.job_id, runtime.generation, runtime.version)
        analysis_worker_abort_runtime(runtime)
        return
    if (events & 2) != 0 or (events & 16) != 0:
        chunk: mutable darray[u8] = []
        for i in 0..<ANALYSIS_WORKER_READ_CHUNK:
            chunk.push(0)
        while true:
            received: isize = elisa_lsp_analysis_worker_read_available((&chunk[0]).cast[void&], chunk.count) can Console
            if received == -2:
                break
            if received < 0:
                analysis_worker_fail_current(runtime, documents, storage, 2)
                pending_analysis_requests_mark_ready(queue, runtime.slot, runtime.job_id, runtime.generation, runtime.version)
                analysis_worker_abort_runtime(runtime)
                return
            if received == 0:
                runtime.eof_seen <- true
                break
            count: usize = received.usize()
            if count > MAX_ANALYSIS_PACKET_BYTES or runtime.packet.count > MAX_ANALYSIS_PACKET_BYTES - count:
                analysis_worker_fail_current(runtime, documents, storage, 5)
                pending_analysis_requests_mark_ready(queue, runtime.slot, runtime.job_id, runtime.generation, runtime.version)
                analysis_worker_abort_runtime(runtime)
                return
            for i in 0..<count:
                runtime.packet.push(chunk[i])
        if runtime.eof_seen:
            finished: int = elisa_lsp_analysis_worker_try_finish() can Console
            if finished < 0:
                analysis_worker_fail_current(runtime, documents, storage, 2)
                pending_analysis_requests_mark_ready(queue, runtime.slot, runtime.job_id, runtime.generation, runtime.version)
                analysis_worker_abort_runtime(runtime)
                return
            if finished > 0:
                analysis_worker_complete(runtime, documents, storage, line_starts, queue)


def check_and_publish(root: Json::Value, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, heads: mutable dict[u64, u32]&, line_starts: mutable darray[usize]&, utf8: bool, symbols_hier: bool, allowed_kinds: darray[i64]&, related: bool, runtime: mutable LspAnalysisWorkerRuntime&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return if uri.len == 0
    spell: sview = bytes_view_range_ref(spell_bytes, 0, spell_bytes.count)
    spelling_bytes: usize = spell.len.usize()
    if uri.len.usize() > 18446744073709551615 - spelling_bytes:
        log_document_admission_rejection()
        return
    uri_metadata_bytes: usize = uri.len.usize() + spelling_bytes
    is_open: bool = method_is(root, "textDocument/didOpen")
    decoded: mutable darray[u8] = []
    if is_open:
        # Full text first: a malformed open must not allocate a slot.
        edit_started_ms: i64 = lsp_timing_start() can Console
        accepted_full_text: bool = collect_full_text(root, true, decoded)
        lsp_timing_record(lsp_timing_edit_ms, edit_started_ms) can Console
        return if not accepted_full_text
    incoming_version: mutable i64 = 0
    match request_version_state(root):
        DocumentVersionState.Present(version):
            incoming_version <- version
        DocumentVersionState.Invalid:
            # Missing or malformed versions are rejected before any slot or
            # document state can be changed.
            return
    # Preflight decoded source before creating a slot, bumping a generation,
    # replacing text, or clearing accepted caches. Rejecting a notification at
    # this boundary therefore preserves the last valid snapshot atomically.
    slot: mutable usize = 0
    if is_open:
        existing: i64 = document_index(documents, storage, heads, uri)
        excluded_slot: mutable i64 = -1
        excluded_slot <- existing if existing >= 0 and documents[existing.usize()].lifecycle.open
        if not document_open_metadata_admission_fits(documents, excluded_slot, uri_metadata_bytes):
            log_document_admission_rejection()
            return
        if not document_source_admission_fits(documents, excluded_slot, decoded.count):
            log_document_admission_rejection()
            return
        slot <- document_slot(documents, storage, heads, uri)
    else:
        found: i64 = document_index(documents, storage, heads, uri)
        return if found < 0
        slot <- found.usize()
        # didChange for a never-opened document: ignore (no lifetime to update).
        return if not documents[slot].lifecycle.open
        # Stale/equal-version didChange: ignore without mutating.
        return if incoming_version <= documents[slot].lifecycle.version
        changes: mutable darray[Json::Value] = []
        if Json::get(root, "params") is params:
            if Json::get(params, "contentChanges") is cv:
                match cv:
                    Json::Value.Arr(items):
                        changes <- items
                    _:
                        return
        return if changes.count == 0
        current: sview = bytes_view_range_ref(storage, documents[slot].source.text_start, documents[slot].source.text_len - 1) if documents[slot].source.text_len > 0 else sview("", 0, 0)
        edit_started_ms: i64 = lsp_timing_start() can Console
        applied_changes: bool = apply_content_changes(current, changes, utf8, decoded)
        lsp_timing_record(lsp_timing_edit_ms, edit_started_ms) can Console
        return if not applied_changes
        if not document_source_admission_fits(documents, slot.i64(), decoded.count):
            log_document_admission_rejection()
            return
        if not document_open_metadata_admission_fits(documents, slot.i64(), uri_metadata_bytes):
            log_document_admission_rejection()
            return
    if runtime.active and runtime.slot == slot:
        analysis_worker_abort_runtime(runtime)
    if is_open and documents[slot].lifecycle.open:
        # Duplicate open: new lifetime even if URI/version repeat. Bump only
        # after source admission so an oversized replacement is a true no-op.
        _ = document_advance_generation(&documents[slot])
    store_document_spelling_at_slot(documents, storage, slot, spell)
    # Accept source as the authoritative snapshot before deriving its caches.
    # Pending state prevents cached providers from exposing the prior version
    # if analysis later becomes asynchronous or recoverable.
    source: mutable darray[u8] = []
    source.extend([b for b in decoded])
    source.push(0)
    store_document_text_at_slot(documents, storage, slot, source)
    line_index_started_ms: i64 = lsp_timing_start() can Console
    update_document_line_index(slot, documents, storage, line_starts)
    lsp_timing_record(lsp_timing_line_index_ms, line_index_started_ms) can Console
    document_begin_snapshot(&documents[slot], incoming_version)
    lsp_last_document_generation <- documents[slot].lifecycle.generation.i64()
    lsp_last_analysis_status <- 3
    lsp_last_cache_outcome <- LSP_CACHE_UPDATED
    log_document_snapshot(is_open, lsp_last_document_generation, incoming_version)
    lsp_analysis_job_sequence <- 1 if lsp_analysis_job_sequence >= 9223372036854775806 else lsp_analysis_job_sequence + 1
    job_id: i64 = lsp_analysis_job_sequence
    document_assign_analysis_job(&documents[slot], job_id)
    pending_analysis_requests_rebind(queue, slot, job_id, documents[slot].lifecycle.generation.i64(), incoming_version)


# FNV-1a over a complete notification body, mirroring `document_hash`.
# Used for identical-publication suppression (G02): equal bodies imply equal
# versions and findings because the version is embedded in the body.
def body_fingerprint_span(body: darray[u8]&, start: usize, count: usize) -> u64:
    14695981039346656037 return if count == 0
    return 0 if start > body.count or count > body.count - start
    hash: mutable u64 = 14695981039346656037
    i: mutable usize = 0
    while i < count:
        hash <- (hash ^ body[start + i].u64()) * 1099511628211
        i <- i + 1
    return hash


# Publish an empty diagnostic array to clear client state for a URI.
# Carries the last known version so the client can order it against pushes.
def publish_empty_diagnostics(uri: sview, version: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    body.push_str("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
    json_escape_utf8(body, uri)
    body.push_str("\",\"version\":")
    json_push_i64(body, version)
    body.push_str(",\"diagnostics\":[]}}")
    send_message(body)


# W01 workspace discovery. Roots come from the client's `workspaceFolders`
# (preferred) or the legacy single `rootUri`; each is stored canonically (same
# identity rules as documents), newline-separated. Nothing is read from disk or
# executed. A document with no matching root is a standalone file (single-file
# fallback), which keeps untitled buffers fully usable without a project.
def append_canonical_uri(v: Json::Value, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    tmp: mutable darray[u8] = []
    Json::decode_into(v, tmp)
    return false if tmp.count == 0
    canon: mutable darray[u8] = []
    uri_canonical(&tmp[0], tmp.count, canon)
    return false if canon.count == 0
    out.extend([b for b in canon])
    return true


def collect_roots(root: Json::Value, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.truncate(0)
    count: mutable i64 = 0
    if Json::get(root, "params") is params:
        if Json::get(params, "workspaceFolders") is wf:
            match wf:
                Json::Value.Arr(items):
                    i: mutable usize = 0
                    while i < items.count and count < MAX_WORKSPACE_ROOTS:
                        if Json::get(items[i], "uri") is u:
                            match u:
                                Json::Value.Str(_):
                                    if append_canonical_uri(u, out):
                                        out.push(10)
                                        count <- count + 1
                                _:
                                    pass
                        i <- i + 1
                _:
                    pass
        if count == 0:
            if Json::get(params, "rootUri") is ru:
                match ru:
                    Json::Value.Str(_):
                        out.push(10) if append_canonical_uri(ru, out)
                    _:
                        pass


# Longest root whose canonical form is a prefix of `uri` (path-boundary
# aware), or -1 for a standalone document. Roots are newline-separated.
def root_index_of(uri: sview, roots: darray[u8]&) -> i64:
    best: mutable i64 = -1
    best_len: mutable i64 = -1
    index: mutable i64 = 0
    start: mutable usize = 0
    i: mutable usize = 0
    n: usize = roots.count
    while i <= n:
        if i == n or roots[i] == 10:
            if i > start:
                root: sview = bytes_view_range_ref(roots, start, i - start)
                if uri.len >= root.len:
                    head_ok: mutable bool = false
                    if uri.len == root.len:
                        head_ok <- string_views_eq(uri, root) != 0
                    else:
                        root_has_separator_suffix: bool = sview_at(root, (root.len - 1).usize()) == 47
                        root_prefix_matches: bool = string_views_eq(string_view_slice(uri, 0, root.len), root) != 0
                        boundary_matches: mutable bool = root_has_separator_suffix
                        if not root_has_separator_suffix:
                            boundary_matches <- sview_at(uri, root.len.usize()) == 47
                        head_ok <- root_prefix_matches and boundary_matches
                    if head_ok and root.len > best_len:
                        best <- index
                        best_len <- root.len
            index <- index + 1
            start <- i + 1
        i <- i + 1
    return best


def send_workspace(id_raw: darray[u8], roots: darray[u8]&, document_uri: sview) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"folders\":[")
    count: mutable i64 = 0
    start: mutable usize = 0
    i: mutable usize = 0
    n: usize = roots.count
    while i <= n:
        if i == n or roots[i] == 10:
            if i > start:
                body.push_str(",") if count > 0
                body.push(34)
                json_escape_utf8(body, bytes_view_range_ref(roots, start, i - start))
                body.push(34)
                count <- count + 1
            start <- i + 1
        i <- i + 1
    push_str(body, "]")
    push_str(body, ",\"count\":")
    json_push_i64(body, count)
    if document_uri.len > 0:
        push_str(body, ",\"documentRoot\":")
        json_push_i64(body, root_index_of(document_uri, roots))
    push_str(body, "}")
    send_result_body(id_raw, body)


# R05: safe self-description. This private request reports protocol/build
# compatibility and effective limits without reading workspace files,
# launching project code, or returning source text. Detailed live storage
# counters remain in `$/elisa/stats`.
def send_status(id_raw: darray[u8], max_header_bytes: i64, max_header_lines: i64, max_body_bytes: i64, utf8: bool) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"server\":{\"name\":\"elisa-lsp\",\"version\":\"0.1.0\",\"status\":\"running\"}")
    push_str(body, ",\"compatibility\":{\"jsonrpc\":\"2.0\",\"lsp\":\"3.18\",\"manifest_schema\":3,\"worker_packet_version\":3,\"diagnostic_code_schema\":1}")
    push_str(body, ",\"compiler\":{\"status\":\"embedded\",\"source\":\"Elisa compiler frontend\",\"contract_version\":")
    push_int(body, frontend_contract_version())
    push_str(body, ",\"provenance\":\"build/manifest.json\",\"upgrade_policy\":\"manifest-pinned\"}")
    # Search providers are deliberately conservative. Expose their actual
    # scope so an empty same-document result is not mistaken for a complete
    # project-wide search.
    push_str(body, ",\"searchCoverage\":{\"references\":{\"scope\":\"sameDocument\",\"completeness\":\"partial\",\"crossDocument\":false,\"supportedIdentities\":[\"uniqueTopLevelFunctions\",\"parameters\",\"locals\"],\"emptyResultProvesProjectAbsence\":false}")
    push_str(body, ",\"documentHighlight\":{\"scope\":\"sameDocument\",\"completeness\":\"partial\",\"crossDocument\":false},\"workspaceIndex\":\"unavailable\"}")
    push_str(body, ",\"configuration\":{\"position_encoding\":\"utf-8\"}") if utf8
    push_str(body, ",\"configuration\":{\"position_encoding\":\"utf-16\"}") if not utf8
    # Keep all values numeric and machine-readable so support reports can
    # compare two sessions without scraping log prose.
    push_str(body, ",\"limits\":{\"max_header_bytes\":")
    push_int(body, max_header_bytes)
    push_str(body, ",\"max_header_lines\":")
    push_int(body, max_header_lines)
    push_str(body, ",\"max_body_bytes\":")
    push_int(body, max_body_bytes)
    push_str(body, ",\"max_open_documents\":")
    push_int(body, lsp_max_open_documents)
    push_str(body, ",\"max_open_uri_bytes\":")
    push_int(body, lsp_max_open_uri_bytes)
    push_str(body, ",\"max_open_source_bytes\":")
    push_int(body, lsp_max_open_source_bytes)
    push_str(body, ",\"max_derived_cache_bytes\":")
    push_int(body, lsp_max_derived_cache_bytes)
    push_str(body, ",\"write_timeout_ms\":")
    push_int(body, lsp_transport_write_timeout_ms)
    push_str(body, ",\"analysis_timeout_ms\":")
    push_int(body, lsp_analysis_timeout_ms)
    push_str(body, "}")
    push_str(body, ",\"logging\":{\"level\":\"")
    log_level_name(body, lsp_log_level)
    push_str(body, "\",\"max_bytes\":")
    push_int(body, lsp_log_max_bytes)
    push_str(body, ",\"bytes_written\":")
    push_int(body, lsp_log_bytes_written)
    push_str(body, ",\"source_text\":\"excluded\",\"wire_trace\":\"disabled\"}}")
    send_result_body(id_raw, body)


# D04/R05 self-description: report logical storage plus the current darray
# backing capacities for the flat byte store and document slots. A private `$/`
# extension (never advertised as a capability); capacities are partial
# allocation estimates, not total arena or process-memory measurements.
def send_stats(id_raw: darray[u8], documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&, line_starts: darray[usize]&, worker_runtime: LspAnalysisWorkerRuntime&, pending_requests: LspPendingAnalysisQueue&, max_header_bytes: i64, max_header_lines: i64, max_body_bytes: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    open_count: mutable i64 = 0
    open_uri_bytes: mutable usize = 0
    open_source_bytes: mutable usize = 0
    derived_cache_bytes: mutable usize = 0
    max_document_cache_bytes: mutable usize = 0
    pending_snapshots: mutable i64 = 0
    ready_snapshots: mutable i64 = 0
    failed_snapshots: mutable i64 = 0
    queued_snapshots: mutable i64 = 0
    i: mutable usize = 0
    while i < documents.count:
        if documents[i].lifecycle.open and not documents[i].lifecycle.free:
            open_count <- open_count + 1
            open_uri_bytes <- open_uri_bytes + documents[i].uri_index.uri_len + documents[i].uri_index.spelling_len
            open_source_bytes <- open_source_bytes + (documents[i].source.text_len - 1) if documents[i].source.text_len > 0
            document_cache_bytes: usize = documents[i].caches.semantic_len + documents[i].caches.symbols_len + documents[i].caches.hover_len + documents[i].caches.signature_len
            derived_cache_bytes <- derived_cache_bytes + document_cache_bytes
            max_document_cache_bytes <- document_cache_bytes if document_cache_bytes > max_document_cache_bytes
            if documents[i].lifecycle.analysis_state == DocumentAnalysisState.Pending:
                pending_snapshots <- pending_snapshots + 1
            elif documents[i].lifecycle.analysis_state == DocumentAnalysisState.Ready:
                ready_snapshots <- ready_snapshots + 1
            else:
                failed_snapshots <- failed_snapshots + 1
            queued_snapshots <- queued_snapshots + 1 if documents[i].lifecycle.analysis_queued
        i <- i + 1
    retained_cache_bytes: usize = derived_cache_retained_bytes(documents)
    live_storage_bytes: usize = storage_live_bytes(documents)
    dead_storage_bytes: mutable usize = 0
    dead_storage_bytes <- storage.count - live_storage_bytes if storage.count >= live_storage_bytes
    body: mutable darray[u8] = []
    push_str(body, "{\"storage_bytes\":")
    push_int(body, storage.count.i64())
    push_str(body, ",\"storage_capacity\":")
    push_int(body, storage.capacity.i64())
    push_str(body, ",\"live_bytes\":")
    push_int(body, live_storage_bytes.i64())
    push_str(body, ",\"dead_storage_bytes\":")
    push_int(body, dead_storage_bytes.i64())
    push_str(body, ",\"documents\":")
    push_int(body, documents.count.i64())
    push_str(body, ",\"documents_capacity\":")
    push_int(body, documents.capacity.i64())
    push_str(body, ",\"open\":")
    push_int(body, open_count)
    push_str(body, ",\"open_uri_bytes\":")
    push_int(body, open_uri_bytes.i64())
    push_str(body, ",\"open_source_bytes\":")
    push_int(body, open_source_bytes.i64())
    push_str(body, ",\"derived_cache_bytes\":")
    push_int(body, derived_cache_bytes.i64())
    push_str(body, ",\"max_document_cache_bytes\":")
    push_int(body, max_document_cache_bytes.i64())
    push_str(body, ",\"snapshots\":{\"open\":")
    push_int(body, open_count)
    push_str(body, ",\"pending\":")
    push_int(body, pending_snapshots)
    push_str(body, ",\"ready\":")
    push_int(body, ready_snapshots)
    push_str(body, ",\"failed\":")
    push_int(body, failed_snapshots)
    push_str(body, "}")
    push_str(body, ",\"analysis_worker\":{\"active\":true") if worker_runtime.active
    push_str(body, ",\"analysis_worker\":{\"active\":false") if not worker_runtime.active
    push_str(body, ",\"packet_bytes\":")
    push_int(body, worker_runtime.packet.count.i64())
    push_str(body, ",\"packet_capacity\":")
    push_int(body, worker_runtime.packet.capacity.i64())
    push_str(body, ",\"queued_snapshots\":")
    push_int(body, queued_snapshots)
    push_str(body, ",\"pending_requests\":")
    push_int(body, pending_requests.requests.count.i64())
    push_str(body, ",\"pending_request_bytes\":")
    push_int(body, pending_requests.body_bytes.i64())
    push_str(body, ",\"pending_request_storage_bytes\":")
    push_int(body, pending_requests.storage.count.i64())
    push_str(body, ",\"pending_request_storage_capacity\":")
    push_int(body, pending_requests.storage.capacity.i64())
    push_str(body, ",\"pending_request_limit\":")
    push_int(body, MAX_PENDING_ANALYSIS_REQUESTS.i64())
    push_str(body, ",\"pending_request_storage_limit\":")
    push_int(body, MAX_PENDING_ANALYSIS_STORAGE_BYTES.i64())
    push_str(body, "}")
    push_str(body, ",\"open_document_limit\":")
    push_int(body, lsp_max_open_documents)
    push_str(body, ",\"open_uri_bytes_limit\":")
    push_int(body, lsp_max_open_uri_bytes)
    # Expose the effective per-session analysis deadline through the private
    # diagnostics/stats probe. This keeps configuration changes observable in
    # protocol tests without advertising a new standard capability or leaking
    # source text.
    push_str(body, ",\"configuration\":{\"analysis_timeout_ms\":")
    push_int(body, lsp_analysis_timeout_ms)
    push_str(body, "}")
    push_str(body, ",\"index_keys\":")
    push_int(body, heads.count.i64())
    push_str(body, ",\"index_used\":")
    push_int(body, heads.used.i64())
    push_str(body, ",\"index_capacity\":")
    push_int(body, heads.capacity.i64())
    push_str(body, ",\"line_index\":{\"entries\":")
    push_int(body, line_index_live_entries(documents).i64())
    push_str(body, ",\"cached_documents\":")
    push_int(body, line_index_cached_documents(documents).i64())
    push_str(body, ",\"stored_entries\":")
    push_int(body, line_starts.count.i64())
    push_str(body, ",\"capacity_entries\":")
    push_int(body, line_starts.capacity.i64())
    push_str(body, ",\"build_calls\":")
    push_int(body, lsp_line_index_build_calls)
    push_str(body, ",\"fallback_build_calls\":")
    push_int(body, lsp_line_index_fallback_build_calls)
    push_str(body, "}")
    push_str(body, ",\"analysis\":{\"tokenize_calls\":")
    push_int(body, lsp_frontend_tokenize_calls)
    push_str(body, ",\"parse_calls\":")
    push_int(body, lsp_frontend_parse_calls)
    push_str(body, ",\"check_calls\":")
    push_int(body, lsp_frontend_check_calls)
    push_str(body, ",\"adapter_query_calls\":")
    push_int(body, lsp_adapter_query_calls)
    push_str(body, ",\"symbol_index_build_calls\":")
    push_int(body, lsp_adapter_symbol_index_build_calls)
    push_str(body, ",\"occurrence_index_build_calls\":")
    push_int(body, lsp_adapter_occurrence_index_build_calls)
    push_str(body, "}")
    # Q03/D04 observability: expose the configured hard bounds and the current
    # scheduler/cache policy through the private probe. The synchronous server
    # has no retained queue or in-flight work at a stats request boundary;
    # explicit zeroes make that invariant visible until Q01 introduces a
    # scheduler. Cache cost includes retained reservations, not just the
    # currently visible payload lengths, so the reported limit describes the
    # memory owned by completed snapshots.
    push_str(body, ",\"budgets\":{\"transport\":{\"max_header_bytes\":")
    push_int(body, max_header_bytes)
    push_str(body, ",\"max_header_lines\":")
    push_int(body, max_header_lines)
    push_str(body, ",\"max_body_bytes\":")
    push_int(body, max_body_bytes)
    push_str(body, ",\"write_timeout_ms\":")
    push_int(body, lsp_transport_write_timeout_ms)
    push_str(body, "},\"documents\":{\"open\":")
    push_int(body, open_count)
    push_str(body, ",\"open_limit\":")
    push_int(body, lsp_max_open_documents)
    push_str(body, ",\"open_uri_bytes\":")
    push_int(body, open_uri_bytes.i64())
    push_str(body, ",\"open_uri_bytes_limit\":")
    push_int(body, lsp_max_open_uri_bytes)
    push_str(body, ",\"open_source_bytes\":")
    push_int(body, open_source_bytes.i64())
    push_str(body, ",\"open_source_bytes_limit\":")
    push_int(body, lsp_max_open_source_bytes)
    push_str(body, "},\"analysis\":{\"mode\":\"one_shot_worker\",\"queued\":")
    push_int(body, queued_snapshots)
    push_str(body, ",\"queue_capacity\":")
    push_int(body, lsp_max_open_documents)
    push_str(body, ",\"in_flight\":")
    push_int(body, 1 if worker_runtime.active else 0)
    push_str(body, ",\"timeout_ms\":")
    push_int(body, lsp_analysis_timeout_ms)
    push_str(body, ",\"worker_packet_limit_bytes\":")
    push_int(body, MAX_ANALYSIS_PACKET_BYTES.i64())
    push_str(body, "},\"cache\":{\"derived_bytes\":")
    push_int(body, derived_cache_bytes.i64())
    push_str(body, ",\"retained_bytes\":")
    push_int(body, retained_cache_bytes.i64())
    push_str(body, ",\"aggregate_limit_bytes\":")
    push_int(body, lsp_max_derived_cache_bytes)
    push_str(body, ",\"eviction\":\"lru_snapshot\",\"evictions\":")
    push_int(body, lsp_cache_eviction_count)
    push_str(body, "}}")
    push_str(body, ",\"timings\":{\"enabled\":")
    push_str(body, "true") if lsp_timing_enabled
    push_str(body, "false") if not lsp_timing_enabled
    push_str(body, ",\"decode_ms\":")
    push_int(body, lsp_timing_last_decode_ms)
    push_str(body, ",\"edit_ms\":")
    push_int(body, lsp_timing_last_edit_ms)
    push_str(body, ",\"line_index_ms\":")
    push_int(body, lsp_timing_last_line_index_ms)
    push_str(body, ",\"lex_ms\":")
    push_int(body, lsp_timing_last_lex_ms)
    push_str(body, ",\"parse_ms\":")
    push_int(body, lsp_timing_last_parse_ms)
    push_str(body, ",\"check_ms\":")
    push_int(body, lsp_timing_last_check_ms)
    push_str(body, ",\"index_ms\":")
    push_int(body, lsp_timing_last_index_ms)
    push_str(body, ",\"provider_ms\":")
    push_int(body, lsp_timing_last_provider_ms)
    push_str(body, ",\"serialization_ms\":")
    push_int(body, lsp_timing_last_serialization_ms)
    push_str(body, ",\"queue_wait_ms\":")
    push_int(body, lsp_timing_last_queue_wait_ms)
    push_str(body, ",\"transport_ms\":")
    push_int(body, lsp_timing_last_transport_ms)
    push_str(body, "}")
    push_str(body, "}")
    send_result_body(id_raw, body)


# Close: mark closed, unlink from the hash chain, free the slot for reuse, bump
# generation, and clear client diagnostics. Freeing (rather than retaining)
# keeps the slot table and storage bounded under URI churn (D04); the generation
# bump ensures in-flight old work can never publish into a reused lifetime (D01).
def handle_did_close(root: Json::Value, documents: mutable darray[LspDocument]&, storage: darray[u8]&, heads: mutable dict[u64, u32]&, runtime: mutable LspAnalysisWorkerRuntime&, queue: mutable LspPendingAnalysisQueue&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return if uri.len == 0
    found: i64 = document_index(documents, storage, heads, uri)
    return if found < 0
    if runtime.active and runtime.slot == found.usize():
        analysis_worker_abort_runtime(runtime)
    pending_analysis_requests_cancel_slot(queue, found.usize(), LSP_ERROR_CONTENT_MODIFIED, "ContentModified")
    lsp_last_document_generation <- documents[found.usize()].lifecycle.generation.i64()
    lsp_last_analysis_status <- 0
    lsp_last_cache_outcome <- LSP_CACHE_UPDATED
    closed_version: i64 = documents[found.usize()].lifecycle.version
    chain_remove(documents, heads, found.usize())
    document_close(&documents[found.usize()])
    document_heads_compact_if_needed(documents, heads)
    spell: sview = bytes_view_range_ref(spell_bytes, 0, spell_bytes.count)
    publish_empty_diagnostics(spell, closed_version)


# ---- responses --------------------------------------------------------------------

def write_stdout_bytes(buffer: darray[u8]) -> void can[Console, Abort.Panic]:
    return if lsp_transport_output_failed or buffer.count == 0
    written: isize = elisa_lsp_write_all(1, (&buffer[0]).cast[void&], buffer.count, lsp_transport_write_timeout_ms) can Console
    lsp_transport_output_failed <- true if written != buffer.count.isize()


# Frame and write a body to stdout: `Content-Length: N\r\n\r\n<body>`.
# T02: measure serialized bytes, then write a small header and the existing
# response body separately. One output transaction applies a single deadline
# to the whole frame. This avoids a second allocation/copy proportional to
# response size; synchronous dispatch keeps only one response in flight.
def send_message(body: darray[u8]) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if lsp_transport_output_failed
    serialization_started_ms: i64 = lsp_timing_start() can Console
    header: mutable darray[u8] = []
    push_str(header, "Content-Length: ")
    push_int(header, body.count.i64())
    push_str(header, "\r\n\r\n")
    lsp_timing_record(lsp_timing_serialization_ms, serialization_started_ms) can Console
    transport_started_ms: i64 = lsp_timing_start() can Console
    began: int = elisa_lsp_output_begin(1, lsp_transport_write_timeout_ms) can Console
    if began != 0:
        lsp_transport_output_failed <- true
        lsp_timing_add(lsp_timing_transport_ms, transport_started_ms) can Console
        return
    write_stdout_bytes(header)
    write_stdout_bytes(body) if not lsp_transport_output_failed
    ended: int = elisa_lsp_output_end(1) can Console
    lsp_transport_output_failed <- true if ended != 0
    lsp_timing_add(lsp_timing_transport_ms, transport_started_ms) can Console


# Write a validated subspan without allocating a second body-sized buffer.
# Worker diagnostics remain inside the packet until this output transaction.
def send_message_span(body: darray[u8]&, start: usize, count: usize) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if lsp_transport_output_failed
    if start > body.count or count > body.count - start:
        lsp_transport_output_failed <- true
        return
    serialization_started_ms: i64 = lsp_timing_start() can Console
    header: mutable darray[u8] = []
    push_str(header, "Content-Length: ")
    push_int(header, count.i64())
    push_str(header, "\r\n\r\n")
    lsp_timing_record(lsp_timing_serialization_ms, serialization_started_ms) can Console
    transport_started_ms: i64 = lsp_timing_start() can Console
    began: int = elisa_lsp_output_begin(1, lsp_transport_write_timeout_ms) can Console
    if began != 0:
        lsp_transport_output_failed <- true
        lsp_timing_add(lsp_timing_transport_ms, transport_started_ms) can Console
        return
    write_stdout_bytes(header)
    if not lsp_transport_output_failed and count > 0:
        written: isize = elisa_lsp_write_all(1, (&body[start]).cast[void&], count, lsp_transport_write_timeout_ms) can Console
        lsp_transport_output_failed <- true if written != count.isize()
    ended: int = elisa_lsp_output_end(1) can Console
    lsp_transport_output_failed <- true if ended != 0
    lsp_timing_add(lsp_timing_transport_ms, transport_started_ms) can Console


def write_stderr(message: darray[u8]) -> void can[Console]:
    # R05: all server stderr shares one hard byte budget. Existing fixed error
    # messages and opt-in observability lines therefore cannot fill a client's
    # pipe or leave an unbounded log behind. Truncation is silent by design: a
    # second "log truncated" line would itself consume the same finite budget.
    return if lsp_log_max_bytes <= 0 or lsp_log_bytes_written >= lsp_log_max_bytes
    remaining: usize = (lsp_log_max_bytes - lsp_log_bytes_written).usize()
    allowed: usize = message.count if message.count <= remaining else remaining
    written: mutable usize = 0
    while written < allowed:
        n: isize = elisa_lsp_write_retry(2, (&message[written]).cast[void&], allowed - written) can Console
        return if n <= 0
        written <- written + n.usize()
    lsp_log_bytes_written <- lsp_log_bytes_written + written.i64()


# Append a method name using a conservative printable alphabet. Unknown client
# method names are still useful in debug logs, but control bytes and separators
# cannot forge additional log records. No URI, source text, or request ID is
# ever included by this path.
def log_safe_method(line: mutable darray[u8]&, method: sview) -> void:
    i: mutable usize = 0
    while i < method.len.usize():
        c: u8 = sview_at(method, i)
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 36 or c == 47 or c == 45 or c == 46 or c == 95:
            line.push(c)
        else:
            line.push(63)
        i <- i + 1


def log_level_name(line: mutable darray[u8]&, level: i64) -> void:
    push_str(line, "off") if level == LSP_LOG_OFF
    push_str(line, "error") if level == LSP_LOG_ERROR
    push_str(line, "warn") if level == LSP_LOG_WARN
    push_str(line, "info") if level == LSP_LOG_INFO
    push_str(line, "debug") if level == LSP_LOG_DEBUG
    push_str(line, "unknown") if level < LSP_LOG_OFF or level > LSP_LOG_DEBUG


def log_cache_name(line: mutable darray[u8]&, outcome: i64) -> void:
    push_str(line, "none") if outcome == LSP_CACHE_NONE
    push_str(line, "miss") if outcome == LSP_CACHE_MISS
    push_str(line, "hit") if outcome == LSP_CACHE_HIT
    push_str(line, "invalid") if outcome == LSP_CACHE_INVALID
    push_str(line, "failed") if outcome == LSP_CACHE_FAILED
    push_str(line, "updated") if outcome == LSP_CACHE_UPDATED
    push_str(line, "suppressed") if outcome == LSP_CACHE_SUPPRESSED
    push_str(line, "unknown") if outcome < LSP_CACHE_NONE or outcome > LSP_CACHE_SUPPRESSED


def log_analysis_name(line: mutable darray[u8]&, status: i64) -> void:
    push_str(line, "unknown") if status == 0
    push_str(line, "ready") if status == 1
    push_str(line, "failed") if status == 2
    push_str(line, "pending") if status == 3


# Emit one structured line only when its configured level is enabled. The
# prefix is deliberately stable enough for simple tooling while the body stays
# human-readable. `write_stderr` applies the process-wide size limit.
def log_line(level: i64, line: darray[u8]) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if lsp_log_level < level
    out: mutable darray[u8] = []
    push_str(out, "elisa-lsp[")
    log_level_name(out, level)
    push_str(out, "] ")
    out.extend([b for b in line])
    out.push(10)
    write_stderr(out)


def log_compiler_status() -> void can[Console, Memory.Allocate, Abort.Panic]:
    line: mutable darray[u8] = []
    push_str(line, "event=compiler status=embedded frontend=compiler-backed contract_version=")
    push_int(line, frontend_contract_version())
    push_str(line, " worker=isolated packet_version=3 diagnostic_codes=generated")
    log_line(LSP_LOG_INFO, line)


def log_document_snapshot(is_open: bool, generation: i64, version: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    line: mutable darray[u8] = []
    push_str(line, "event=document method=textDocument/")
    push_str(line, "didOpen") if is_open
    push_str(line, "didChange") if not is_open
    push_str(line, " generation=")
    push_int(line, generation)
    push_str(line, " version=")
    push_int(line, version)
    push_str(line, " cache=")
    log_cache_name(line, lsp_last_cache_outcome)
    log_line(LSP_LOG_DEBUG, line)


def log_method_timing(method: sview, started_ms: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    line: mutable darray[u8] = []
    elapsed: mutable i64 = -1
    finished_ms: i64 = elisa_lsp_monotonic_millis() can Console
    if started_ms >= 0 and finished_ms >= started_ms:
        elapsed <- finished_ms - started_ms
    push_str(line, "event=method method=")
    log_safe_method(line, method)
    push_str(line, " elapsed_ms=")
    push_int(line, elapsed)
    push_str(line, " generation=")
    push_int(line, lsp_last_document_generation)
    push_str(line, " cache=")
    log_cache_name(line, lsp_last_cache_outcome)
    push_str(line, " analysis=")
    log_analysis_name(line, lsp_last_analysis_status)
    log_line(LSP_LOG_INFO, line)


def log_stage_timing(method: sview) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if not lsp_timing_enabled
    line: mutable darray[u8] = []
    push_str(line, "event=stages method=")
    log_safe_method(line, method)
    push_str(line, " decode_ms=")
    push_int(line, lsp_timing_decode_ms)
    push_str(line, " edit_ms=")
    push_int(line, lsp_timing_edit_ms)
    push_str(line, " line_index_ms=")
    push_int(line, lsp_timing_line_index_ms)
    push_str(line, " lex_ms=")
    push_int(line, lsp_timing_lex_ms)
    push_str(line, " parse_ms=")
    push_int(line, lsp_timing_parse_ms)
    push_str(line, " check_ms=")
    push_int(line, lsp_timing_check_ms)
    push_str(line, " index_ms=")
    push_int(line, lsp_timing_index_ms)
    push_str(line, " provider_ms=")
    push_int(line, lsp_timing_provider_ms)
    push_str(line, " serialization_ms=")
    push_int(line, lsp_timing_serialization_ms)
    push_str(line, " queue_wait_ms=")
    push_int(line, lsp_timing_queue_wait_ms)
    push_str(line, " transport_ms=")
    push_int(line, lsp_timing_transport_ms)
    log_line(LSP_LOG_INFO, line)


def finish_method_next(method: sview, started_ms: i64) -> LspMessageStep can[Console, Memory.Allocate, Abort.Panic]:
    lsp_timing_commit()
    log_method_timing(method, started_ms)
    log_stage_timing(method)
    return LspMessageStep.Next


def finish_method_stop(method: sview, started_ms: i64, status: i64) -> LspMessageStep can[Console, Memory.Allocate, Abort.Panic]:
    lsp_timing_commit()
    log_method_timing(method, started_ms)
    log_stage_timing(method)
    return LspMessageStep.Stop(status)


# A failed normal-return frontend snapshot is not an Elisa source diagnostic.
# Rate-limit a fixed message so repeated edits cannot fill stderr.
def log_frontend_validation_failure() -> void can[Console, Memory.Allocate, Abort.Panic]:
    if lsp_frontend_validation_failure_logs < 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: rejected invalid frontend analysis snapshot\n")
        write_stderr(line)
        lsp_frontend_validation_failure_logs <- lsp_frontend_validation_failure_logs + 1
    elif lsp_frontend_validation_failure_logs == 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: further frontend snapshot failures suppressed\n")
        write_stderr(line)
        lsp_frontend_validation_failure_logs <- lsp_frontend_validation_failure_logs + 1


# Keep malformed-notification diagnostics useful without allowing a broken
# client to fill stderr indefinitely. No source text or client-provided value
# is included in these messages.
def log_malformed_notification(log_count: mutable i64&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    if log_count < 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: ignored malformed notification\n")
        write_stderr(line)
        log_count <- log_count + 1
    elif log_count == 8:
        line: mutable darray[u8] = []
        push_str(line, "elisa-lsp: further malformed notifications suppressed\n")
        write_stderr(line)
        log_count <- log_count + 1


# `{"jsonrpc":"2.0","id":<id>,"result":<result>}`
def send_result(id_raw: darray[u8], result: cstr) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"result\":")
    push_str(body, result)
    push_str(body, "}")
    send_message(body)


# P01: provider handlers return a typed outcome; the dispatcher owns the one
# JSON-RPC completion path and preserves each method's ordinary empty shape.
# U02: with ELISA_LSP_VALIDATE_RANGES enabled, validate the final provider
# payload against the exact open snapshot immediately before framing it. This
# keeps retained-cache and request-local bodies on one response contract.
def record_provider_snapshot(root: Json::Value, documents: mutable darray[LspDocument]&, retained_storage: darray[u8]&, document_heads: dict[u64, u32]&) -> void can[Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return if uri.len == 0
    found: i64 = document_index(documents, retained_storage, document_heads, uri)
    return if found < 0 or not documents[found.usize()].lifecycle.open
    lsp_last_document_generation <- documents[found.usize()].lifecycle.generation.i64()
    if documents[found.usize()].lifecycle.analysis_state == DocumentAnalysisState.Ready:
        document_touch_cache(documents, found.usize(), lsp_cache_access_clock)
        lsp_last_analysis_status <- 1
    elif documents[found.usize()].lifecycle.analysis_state == DocumentAnalysisState.Pending:
        lsp_last_analysis_status <- 3
    else:
        lsp_last_analysis_status <- 2
    # Snapshot metadata is useful at info level, but recency accounting must
    # remain active at every level so eviction cannot depend on logging.


def emit_provider_outcome(root: Json::Value, id_raw: darray[u8], outcome: ProviderOutcome, result_body: darray[u8], retained_storage: darray[u8]&, retained_start: usize, retained_len: usize, documents: mutable darray[LspDocument]&, document_heads: dict[u64, u32]&, utf8: bool, range_kind: ProviderRangeKind) -> void can[Console, Memory.Allocate, Abort.Panic]:
    record_provider_snapshot(root, documents, retained_storage, document_heads)
    # Provider handlers read immutable snapshot caches. Record the outcome for
    # the enclosing method log without adding metadata to the LSP response.
    match outcome:
        ProviderOutcome.Result:
            lsp_last_cache_outcome <- LSP_CACHE_HIT
        ProviderOutcome.NoMatchNull | ProviderOutcome.NoMatchEmptyArray | ProviderOutcome.NoMatchSemanticTokens:
            lsp_last_cache_outcome <- LSP_CACHE_MISS
        ProviderOutcome.InvalidRetainedCache:
            lsp_last_cache_outcome <- LSP_CACHE_INVALID
        ProviderOutcome.OperationalFailure:
            lsp_last_cache_outcome <- LSP_CACHE_FAILED
    match outcome:
        ProviderOutcome.Result:
            result_view: mutable sview = sview("", 0, 0)
            if retained_len > 0:
                if retained_start <= retained_storage.count and retained_len <= retained_storage.count - retained_start:
                    result_view <- bytes_view_range_ref(retained_storage, retained_start, retained_len)
                else:
                    send_error(id_raw, -32603, "InternalError")
                    return
            else:
                result_view <- bytes_view_range_ref(result_body, 0, result_body.count) if result_body.count > 0
            if lsp_validate_provider_ranges and not provider_result_ranges_valid(root, result_view, documents, retained_storage, document_heads, utf8, range_kind):
                log_provider_range_validation_failure()
                send_error(id_raw, -32603, "InternalError")
                return
            if retained_len > 0:
                send_result_storage(id_raw, retained_storage, retained_start, retained_len)
            else:
                send_result_body(id_raw, result_body)
        ProviderOutcome.NoMatchNull:
            send_result(id_raw, "null")
        ProviderOutcome.NoMatchEmptyArray:
            send_result(id_raw, "[]")
        ProviderOutcome.NoMatchSemanticTokens:
            send_result(id_raw, "{\"data\":[]}")
        ProviderOutcome.InvalidRetainedCache:
            send_error(id_raw, -32603, "InternalError")
        ProviderOutcome.OperationalFailure:
            send_error(id_raw, -32603, "InternalError")


# `{"jsonrpc":"2.0","id":<id>,"error":{"code":<code>,"message":"<msg>"}}`# P01: every valid request completes exactly once; unknown methods get
# MethodNotFound (-32601), never silence. Notifications (no id) never produce
# response objects — callers must check `request_has_id` first.
def send_error(id_raw: darray[u8], code: i64, message: cstr) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"error\":{\"code\":")
    json_push_i64(body, code)
    push_str(body, ",\"message\":\"")
    json_escape_utf8(body, sview(message, 0, -1))
    push_str(body, "\"}}")
    send_message(body)


# JSON-RPC ParseError (J01): the frame's body is not one valid JSON value, so
# no request id can be recovered. Per JSON-RPC the id is null.
def send_parse_error(detail: Json::ValidationError) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"ParseError\",\"data\":{\"offset\":")
    push_int(body, detail.offset.i64())
    push_str(body, ",\"category\":\"")
    match detail.category:
        Json::ValidationCategory.Encoding:
            push_str(body, "encoding")
        Json::ValidationCategory.Syntax:
            push_str(body, "syntax")
        Json::ValidationCategory.ResourceLimit:
            push_str(body, "resourceLimit")
    push_str(body, "\"}}}")
    send_message(body)


# P03 capability negotiation: derive the session profile from the client's
# `initialize` params. Position encodings are honored in client preference
# order (first supported wins; default UTF-16). Hover falls back to plaintext
# only when the client lists formats without markdown. Unknown or absent
# capabilities keep safe defaults; nothing unsupported is ever advertised.
def negotiate_utf8(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "general") is general:
                    if Json::get(general, "positionEncodings") is encs:
                        match encs:
                            Json::Value.Arr(items):
                                i: mutable usize = 0
                                while i < items.count:
                                    item: Json::Value = items[i]
                                    match item:
                                        Json::Value.Str(_):
                                            true return if json_string_is(item, "utf-8")
                                            false return if json_string_is(item, "utf-16")
                                        _:
                                            pass
                                    i <- i + 1
                            _:
                                pass
        return false


def negotiate_hover_markdown(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "hover") is hover:
                        if Json::get(hover, "contentFormat") is formats:
                            match formats:
                                Json::Value.Arr(items):
                                    i: mutable usize = 0
                                    while i < items.count:
                                        item: Json::Value = items[i]
                                        match item:
                                            Json::Value.Str(_):
                                                true return if json_string_is(item, "markdown")
                                            _:
                                                pass
                                        i <- i + 1
                                    return false
                                _:
                                    pass
        return true


# Whether the client accepts hierarchical `DocumentSymbol` (with children).
# Absent capability -> false: flat `SymbolInformation` is the universal shape.
def negotiate_symbols_hier(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "documentSymbol") is ds:
                        if Json::get(ds, "hierarchicalDocumentSymbolSupport") is h:
                            match h:
                                Json::Value.Bool(enabled):
                                    return enabled
                                _:
                                    return false
        return false


# The client's `symbolKind.valueSet`, when offered: the only SymbolKinds it
# accepts. An empty result means unrestricted (the common case); otherwise the
# renderer clamps every kind through per-category fallbacks (never invents a
# kind the client rejected).
def negotiate_symbol_kinds(root: Json::Value) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "documentSymbol") is ds:
                        if Json::get(ds, "symbolKind") is sk:
                            if Json::get(sk, "valueSet") is vs:
                                match vs:
                                    Json::Value.Arr(items):
                                        i: mutable usize = 0
                                        while i < items.count:
                                            item: Json::Value = items[i]
                                            match item:
                                                Json::Value.Num(_):
                                                    if Json::is_int_num(item):
                                                        kind: i64 = Json::as_lsp_uinteger_or_invalid(item)
                                                        out.push(kind) if kind > 0 and kind <= 26
                                                _:
                                                    pass
                                            i <- i + 1
                                    _:
                                        pass
        return out


# Whether the client accepts `relatedInformation` on published diagnostics
# (G03). False (and no related info emitted) unless explicitly advertised.
def negotiate_related_info(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "publishDiagnostics") is pd:
                        if Json::get(pd, "relatedInformation") is ri:
                            match ri:
                                Json::Value.Bool(enabled):
                                    return enabled
                                _:
                                    return false
        return false


# Rename returns versioned TextDocumentEdits. Do not advertise or answer it
# unless the client explicitly supports WorkspaceEdit.documentChanges.
def negotiate_rename_document_changes(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "workspace") is workspace:
                    if Json::get(workspace, "workspaceEdit") is workspace_edit:
                        if Json::get(workspace_edit, "documentChanges") is document_changes:
                            match document_changes:
                                Json::Value.Bool(enabled):
                                    return enabled
                                _:
                                    pass
        return false


# Keep only CompletionItemKind values explicitly accepted by the client. An
# absent valueSet means the LSP default (all standard kinds); an empty valueSet
# means omit `kind` from every CompletionItem.
def negotiate_completion_kinds(root: Json::Value, limited_out: mutable bool&) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        limited_out <- false
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "completion") is completion:
                        if Json::get(completion, "completionItemKind") is item_kind:
                            if Json::get(item_kind, "valueSet") is value_set:
                                limited_out <- true
                                match value_set:
                                    Json::Value.Arr(items):
                                        for i in 0..<items.count:
                                            out.push(Json::as_lsp_uinteger_or_invalid(items[i]))
                                    _:
                                        pass
        return out


# Snippet syntax is emitted only when the client explicitly opts in. The
# initialize validator rejects malformed and duplicate values before this
# profile is read.
def negotiate_completion_snippet_support(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "completion") is completion:
                        if Json::get(completion, "completionItem") is item:
                            if Json::get(item, "snippetSupport") is support:
                                match support:
                                    Json::Value.Bool(enabled):
                                        return enabled
                                    _:
                                        pass
        return false


def negotiate_completion_insert_replace_support(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
