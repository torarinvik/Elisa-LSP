# Elisa Language Server — transport + initialize handshake + live diagnostics.
#
# Speaks LSP over stdio (JSON-RPC with Content-Length framing). Requests are parsed with
# the `Json` module (module Json, src/json.elisa). `textDocument/didOpen` and `didChange`
# run the real stage1 frontend (`Semantic::check`, src/diagnostics.elisa) and publish
# findings back as `textDocument/publishDiagnostics`.
# Runtime is pulled in transitively via diagnostics.elisa -> Elisa-compiler's parser,
# which carries its own copy of elisacore_std (a second copy would duplicate-declare).
include "diagnostics.elisa"
include "frontend_adapter.elisa"
include "json.elisa"
include "semtokens.elisa"
include "features/document_symbols.elisa"
include "features/folding.elisa"

# Byte-buffer builders (push_str/push_int/push_sview) come from the frontend's `module Bytes`
# (inlined in Elisa-compiler semantic.elisa), pulled in transitively via diagnostics.elisa.
# `using` makes them callable unqualified and as UFCS methods.
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]


# Metadata for one document snapshot. URI, source bytes, and the encoded semantic
# token result live in the single flat `document_storage` buffer below; keeping
# nested darrays out of this hot cache avoids region/lifetime bugs and makes
# lookup cache-friendly.
# D01: explicit versioned lifecycle — client version, open state, and a
# monotonic internal generation independent of client versions. Close/reopen
# bumps generation so old analysis can never publish into a new lifetime.
struct LspDocument:
    uri_start: mutable usize
    uri_len: mutable usize
    text_start: mutable usize
    text_len: mutable usize
    text_capacity: mutable usize
    semantic_start: mutable usize
    semantic_len: mutable usize
    semantic_capacity: mutable usize
    symbols_start: mutable usize
    symbols_len: mutable usize
    symbols_capacity: mutable usize
    hash: mutable u64
    next: mutable u32
    version: mutable i64
    open: mutable bool
    generation: mutable u64
    last_diag_version: mutable i64
    last_diag_fp: mutable u64
    free: mutable bool


# ---- stdio byte transport ---------------------------------------------------------
#
# T01: buffered, bounded input framing. One reusable read buffer holds bytes
# read ahead of the current cursor, so a single `read` may deliver several
# messages, part of a message, or a multibyte UTF-8 sequence that the cursor
# must not split. Frames are read only from this buffer; consumed prefixes are
# reclaimed on refill. Limits are conservative and documented; a violation is
# a controlled session failure (main returns nonzero) rather than an unbounded
# allocation or a silent mis-frame.
const TRANSPORT_CHUNK: usize = 8192
const MAX_HEADER_BYTES: i64 = 16384
const MAX_HEADER_LINES: i64 = 64
const MAX_BODY_BYTES: i64 = 16777216


# Ensure at least one unconsumed byte is available. False only at clean EOF
# with nothing buffered.
def transport_fill(buf: mutable darray[u8]&, pos: mutable usize&) -> bool can[Console, Memory.Allocate, Abort.Panic]:
    true return if pos[0] < buf.count
    # Cursor reached the end: the whole buffer is consumed; reclaim it.
    buf.truncate(0)
    pos[0] <- 0
    start: usize = buf.count
    i: mutable usize = 0
    while i < TRANSPORT_CHUNK:
        buf.push(0)
        i <- i + 1
    got: isize = read(0, (&buf[start]).cast[void&], TRANSPORT_CHUNK) can Console
    if got <= 0:
        buf.truncate(start)
        return false
    buf.truncate(start + got.usize())
    return true


# Read one header line (through LF), stripping a trailing CR. `eof` is set only
# when the stream ended before LF was seen; a genuinely empty line is a real
# line (header terminator) with `eof` false.
def transport_read_line(buf: mutable darray[u8]&, pos: mutable usize&, eof: mutable bool&) -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    while true:
        if not transport_fill(buf, pos):
            eof[0] <- true
            return out
        b: u8 = buf[pos[0]]
        pos[0] <- pos[0] + 1
        out return if b == 10
        out.push(b) if b != 13
    return out


# Parse a `Content-Length:` header line strictly.
#   >= 0  the length
#   -1    not a Content-Length header (ignored)
#   -2    malformed Content-Length (non-digit, empty, or i64 overflow) — fatal
# Header names are case-insensitive; the value admits surrounding spaces but no
# other characters, so `Content-Length: 5x` and `Content-Length:` are rejected
# instead of silently parsing as 5 and 0.
def content_length_of(line: darray[u8]) -> i64 can[Memory.Allocate, Abort.Panic]:
    name: sview = sview("content-length:", 0, -1)
    -1 return if line.count.i64() < name.len
    i: mutable usize = 0
    while i < name.len.usize():
        if ascii_lower(line[i]) != sview_at(name, i):
            return -1
        i <- i + 1
    while i < line.count and line[i] == 32:
        i <- i + 1
    -2 return if i >= line.count
    n: mutable i64 = 0
    limit: i64 = 922337203685477580
    while i < line.count:
        ch: u8 = line[i]
        -2 return if ch < 48 or ch > 57
        d: i64 = ch.i64() - 48
        -2 return if n > limit or (n == limit and d > 7)
        n <- n * 10 + d
        i <- i + 1
    return n


# Read one full LSP message body from the shared buffer.
#   0   clean EOF between messages (nothing buffered)
#   1   a complete frame was read into `body`
#   -1  framing error: truncated header/body, malformed or conflicting
#       Content-Length, missing length, oversized header/body, or a zero-byte
#       body (never treated as a successful exit)
def read_message(body: mutable darray[u8]&, buf: mutable darray[u8]&, pos: mutable usize&) -> i64 can[Console, Memory.Allocate, Abort.Panic]:
    content_length: mutable i64 = -1
    header_bytes: mutable i64 = 0
    header_lines: mutable i64 = 0
    first: mutable bool = true
    while true:
        eof: mutable bool = false
        line: darray[u8] = transport_read_line(buf, pos, eof)
        if eof:
            # Nothing consumed yet at message start: clean EOF. Otherwise the
            # header was cut off mid-message.
            return 0 if first and line.count == 0 else -1
        first <- false
        header_bytes <- header_bytes + line.count.i64() + 2
        header_lines <- header_lines + 1
        if header_bytes > MAX_HEADER_BYTES or header_lines > MAX_HEADER_LINES:
            return -1
        if line.count == 0:
            break
        cl: i64 = content_length_of(line)
        if cl == -2:
            return -1
        if cl >= 0:
            # Conflicting duplicate lengths are ambiguous; identical repeats are
            # tolerated. A duplicate may not contradict the first.
            return -1 if content_length >= 0 and content_length != cl
            content_length <- cl
    if content_length <= 0:
        return -1
    if content_length > MAX_BODY_BYTES:
        return -1
    body.truncate(0)
    remaining: mutable i64 = content_length
    while remaining > 0:
        if not transport_fill(buf, pos):
            return -1
        available: i64 = (buf.count - pos[0]).i64()
        take: i64 = available if available < remaining else remaining
        i: mutable usize = 0
        while i < take.usize():
            body.push(buf[pos[0] + i])
            i <- i + 1
        pos[0] <- pos[0] + take.usize()
        remaining <- remaining - take
    return 1


# ---- request inspection (Json module) ----------------------------------------------

# The message's `"method"` field as a view, or empty if absent/non-string.
def request_method(root: Json::Value) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "method") is m:
            return Json::as_str(m)
        return sview("", 0, 0)


# Whether the message's method equals `name`.
def method_is(root: Json::Value, name: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        return string_view_eq(request_method(root), name) == 1


# The raw JSON token for `"id"`, re-encoded for verbatim echo into the response.
# Defaults to `null` when absent (notifications have no id).
def extract_id(root: Json::Value) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    if Json::get(root, "id") is idv:
        match idv:
            Json::Value.Num(text):
                push_sview(out, text)
            Json::Value.Str(text):
                out.push(34)
                push_sview(out, text)
                out.push(34)
            _:
                push_str(out, "null")
    else:
        push_str(out, "null")
    return out


# Whether the message carries a request ID (Num or Str). Notifications have no
# `id`; a null/wrong-typed id is not a valid request ID (P01).
def request_has_id(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "id") is idv:
            match idv:
                Json::Value.Num(text):
                    return true
                Json::Value.Str(text):
                    return true
                _:
                    return false
        return false


# ---- diagnostics: textDocument/didOpen + didChange ---------------------------------

# Decode `params.textDocument.uri` into `out`, returning a view of the decoded
# bytes. URI equality and diagnostics must use the same value the client sent;
# retaining the raw JSON string would make escaped quotes/backslashes part of the
# URI and could also emit malformed diagnostic JSON.
def request_uri(root: Json::Value, out: mutable darray[u8]&) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out.truncate(0)
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "uri") is u:
                    Json::decode_into(u, out)
                    return sview(&out[0], 0, out.count.i64()) if out.count > 0
        return sview("", 0, 0)


# The document's full text as a Json Str value: `params.textDocument.text`
# (didOpen) or `params.contentChanges[0].text` (didChange, full-document sync).
# Null if malformed. Returned as the VALUE (not a span) so the caller can decode
# the JSON string escapes — real clients escape every newline of the document.
def request_text_value(root: Json::Value) -> Json::Value? can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "text") is t:
                    return t
            if Json::get(params, "contentChanges") is changes:
                match changes:
                    Json::Value.Arr(items):
                        t return if items.count > 0 and Json::get(items[0], "text") is t
                    _:
                        pass
        return null


# Client version for didOpen/didChange (`params.textDocument.version`).
# Tristate (J02): -1 absent (legacy path: accept, auto-bump), -2 present but
# malformed (fractional, overflowing, or wrong-typed — the notification is
# rejected outright, never applied), otherwise the value. Versions need not
# increase by exactly one but must move forward; a malformed notification must
# not mutate text (D01).
def request_version_state(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "textDocument") is td:
                if Json::get(td, "version") is v:
                    return Json::as_i64_checked(v) if Json::is_int_num(v) else -2
        return -1


# Client version for didOpen/didChange (`params.textDocument.version`).
# Returns -1 when absent/non-numeric; versions need not increase by exactly one
# but must move forward. A malformed notification must not mutate text (D01).
def request_version(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    v: i64 = request_version_state(root)
    return -1 if v == -2 else v


# Strict hover line (J02): an integer `params.position.line`, else -1 meaning
# "no usable position" (absent, fractional, overflowing, or wrong-typed all
# yield null hover rather than a coerced line).
def request_hover_line(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "position") is pos:
                if Json::get(pos, "line") is ln:
                    return Json::as_i64_checked(ln)
        return -1


# D02 full-sync collection: decode the notification's full replacement text
# into `out` (byte-exact, CRLF/trailing-newline preserving). didOpen reads
# `params.textDocument.text`; didChange validates EVERY `contentChanges` entry
# in order and uses the last. Any ranged entry (`range`/`rangeLength`), missing
# text, non-string text, or empty change list rejects the whole notification
# (returns false, `out` untouched) — the server advertises full sync only, so a
# fragment must never be mistaken for the whole document. Byte copies (not
# container stores) keep the region checker satisfied.
def collect_full_text(root: Json::Value, is_open: bool, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if is_open:
            if Json::get(root, "params") is params:
                if Json::get(params, "textDocument") is td:
                    if Json::get(td, "text") is t:
                        match t:
                            Json::Value.Str(st):
                                tmp: mutable darray[u8] = []
                                Json::decode_into(t, tmp)
                                out.truncate(0)
                                for b in tmp:
                                    out.push(b)
                                return true
                            _:
                                return false
            return false
        if Json::get(root, "params") is params:
            if Json::get(params, "contentChanges") is changes:
                match changes:
                    Json::Value.Arr(items):
                        return false if items.count == 0
                        i: mutable usize = 0
                        while i < items.count:
                            entry: Json::Value = items[i]
                            if Json::get(entry, "range") is rg:
                                return false
                            if Json::get(entry, "rangeLength") is rl:
                                return false
                            if Json::get(entry, "text") is tt:
                                match tt:
                                    Json::Value.Str(st):
                                        pass
                                    _:
                                        return false
                            else:
                                return false
                            i <- i + 1
                        last: Json::Value = items[items.count - 1]
                        if Json::get(last, "text") is lt:
                            tmp: mutable darray[u8] = []
                            Json::decode_into(lt, tmp)
                            out.truncate(0)
                            for b in tmp:
                                out.push(b)
                            return true
                        return false
                    _:
                        return false
        return false


# D03 canonical document identity. JSON unescaping, URI percent-decoding, and
# filesystem normalization are different operations and must not be conflated:
# `request_uri` (above) only unescapes JSON; the functions below derive the
# lookup identity from those bytes. Rules, applied uniformly and documented in
# docs/development.md:
# - The scheme (text before the first `:`, only when no `/`, `?`, or `#`
#   precedes it) is ASCII-lowercased; schemes are case-insensitive. No scheme
#   means an opaque identity (percent-decoded copy).
# - `file` with a `//authority`: the authority is percent-decoded, lowercased,
#   and `localhost` is dropped (equivalent to empty). Any other authority is
#   preserved as-is — distinct, never resolved, never fetched.
# - The remainder is percent-decoded (`%XX` hex → byte); malformed `%`
#   sequences copy literally so the URI stays usable and distinct, never a
#   crash. A `#fragment` suffix is stripped (never document identity).
# - Case is otherwise preserved: paths are NOT lowercased and symlinks are NOT
#   resolved here (filesystem-aware aliasing belongs to W02). Remote and
#   unknown schemes are accepted as opaque in-memory overlays — the server
#   never fetches network resources for them.
# Responses always echo the client's incoming spelling, never the canonical
# form; only lookup/storage use the canonical bytes.
def hex_val_byte(c: u8) -> i64:
    0 return if c < 48
    (c.i64() - 48) return if c <= 57
    (c.i64() - 87) return if c >= 97 and c <= 102
    (c.i64() - 55) return if c >= 65 and c <= 70
    return -1


def ascii_lower(c: u8) -> u8:
    return ((c.i64() + 32).u8()) if c >= 65 and c <= 90 else c


def uri_percent_copy(decoded: u8&, decoded_len: usize, start: usize, out: mutable darray[u8]&, strip_fragment: bool) -> void can[Memory.Allocate, Abort.Panic]:
    i: mutable usize = start
    while i < decoded_len:
        c: u8 = decoded[i]
        if c == 37 and i + 2 < decoded_len:
            hi: i64 = hex_val_byte(decoded[i + 1])
            lo: i64 = hex_val_byte(decoded[i + 2])
            if hi >= 0 and lo >= 0:
                out.push((hi * 16 + lo).u8())
                i <- i + 3
            else:
                out.push(c)
                i <- i + 1
        else:
            break if strip_fragment and c == 35
            out.push(c)
            i <- i + 1


def uri_canonical(decoded: u8&, decoded_len: usize, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    scheme_end: mutable i64 = -1
    i: mutable usize = 0
    while i < decoded_len:
        c: u8 = decoded[i]
        if c == 58:
            scheme_end <- i.i64()
            break
        if c == 47 or c == 63 or c == 35:
            break
        i <- i + 1
    if scheme_end < 0:
        uri_percent_copy(decoded, decoded_len, 0, out, true)
        return
    s: mutable usize = 0
    while s < scheme_end.usize():
        out.push(ascii_lower(decoded[s]))
        s <- s + 1
    out.push(58)
    rest: usize = scheme_end.usize() + 1
    is_file: bool = scheme_end == 4 and ascii_lower(decoded[0]) == 102 and ascii_lower(decoded[1]) == 105 and ascii_lower(decoded[2]) == 108 and ascii_lower(decoded[3]) == 101
    pos: mutable usize = rest
    if is_file and pos + 1 < decoded_len:
        if decoded[pos] == 47 and decoded[pos + 1] == 47:
            astart: usize = pos + 2
            aend: mutable usize = astart
            while aend < decoded_len:
                ac: u8 = decoded[aend]
                break if ac == 47 or ac == 63 or ac == 35
                aend <- aend + 1
            tmp: mutable darray[u8] = []
            uri_percent_copy(decoded, aend, astart, tmp, false)
            li: mutable usize = 0
            while li < tmp.count:
                tmp[li] <- ascii_lower(tmp[li])
                li <- li + 1
            is_localhost: mutable bool = tmp.count == 9
            if is_localhost:
                host: sview = sview("localhost", 0, -1)
                k: mutable usize = 0
                while k < 9:
                    if tmp[k] != sview_at(host, k):
                        is_localhost <- false
                        break
                    k <- k + 1
            # Emit the `//` in both cases so `localhost` (the empty authority)
            # canonicalizes exactly to the `file:///path` form.
            out.push(47)
            out.push(47)
            if not is_localhost:
                for b in tmp:
                    out.push(b)
            pos <- aend
    uri_percent_copy(decoded, decoded_len, pos, out, true)


# Canonical lookup identity for a request: JSON-decode into `spell_buf` (kept
# for responses), derive bytes into `canon_buf`, and return a view of the
# canonical form — empty when the request carries no usable URI.
def request_identity(root: Json::Value, spell_buf: mutable darray[u8]&, canon_buf: mutable darray[u8]&) -> sview can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        request_uri(root, spell_buf)
        return sview("", 0, 0) if spell_buf.count == 0
        canon_buf.truncate(0)
        uri_canonical(&spell_buf[0], spell_buf.count, canon_buf)
        return sview(&canon_buf[0], 0, canon_buf.count.i64()) if canon_buf.count > 0
        return sview("", 0, 0)


# FNV-1a keeps the URI index compact and matches the compiler's existing hash
# discipline. Equality is still checked after hashing, so collisions are safe.
def document_hash(uri: sview) -> u64:
    hash: mutable u64 = 14695981039346656037
    i: mutable usize = 0
    while i < uri.len.usize():
        hash <- (hash ^ sview_at(uri, i).u64()) * 1099511628211
        i <- i + 1
    return hash


# Return the cached document index for `uri`, or -1 when it is not open. The
# hash table narrows lookup to one collision chain instead of scanning every
# open document.
def document_index(documents: darray[LspDocument]&, storage: darray[u8]&, heads: dict[u64, u32]&, uri: sview) -> i64 can[Abort.Panic]:
    if heads.get(document_hash(uri)) is head:
        current: mutable u32 = head
        while current != 4294967295:
            document: LspDocument = documents[current.usize()]
            if document.uri_len == uri.len.usize():
                cached: sview = sview(&storage[document.uri_start], 0, document.uri_len.i64())
                return current.i64() if string_views_eq(uri, cached) != 0
            current <- document.next
    return -1


# Find an existing cache entry, reuse a freed slot (D04), or append a new one.
# Reusing a freed slot keeps the slot table bounded under URI churn; the reused
# slot's generation is bumped so no old lifetime can publish into the new one.
def document_slot(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, heads: mutable dict[u64, u32]&, uri: sview) -> usize can[Memory.Allocate, Abort.Panic]:
    found: i64 = document_index(documents, storage, heads, uri)
    return found.usize() if found >= 0
    hash: u64 = document_hash(uri)
    previous: mutable u32 = 4294967295
    previous <- head if heads.get(hash) is head
    reuse: mutable i64 = -1
    i: mutable usize = 0
    while i < documents.count:
        if documents[i].free:
            reuse <- i.i64()
            break
        i <- i + 1
    if reuse >= 0:
        slot: usize = reuse.usize()
        d: mutable LspDocument& = &documents[slot]
        d.generation <- d.generation + 1
        d.uri_start <- storage.count
        d.uri_len <- uri.len.usize()
        d.text_start <- storage.count
        d.text_len <- 0
        d.text_capacity <- 0
        d.semantic_start <- 0
        d.semantic_len <- 0
        d.semantic_capacity <- 0
        d.symbols_start <- 0
        d.symbols_len <- 0
        d.symbols_capacity <- 0
        d.hash <- hash
        d.next <- previous
        d.version <- -1
        d.open <- false
        d.free <- false
        d.last_diag_version <- -1
        d.last_diag_fp <- 0
        j: mutable usize = 0
        while j < uri.len.usize():
            storage.push(sview_at(uri, j))
            j <- j + 1
        heads <- heads.put(hash, slot.u32())
        return slot
    uri_start: usize = storage.count
    documents.push(LspDocument{uri_start: uri_start, uri_len: uri.len.usize(), text_start: 0, text_len: 0, text_capacity: 0, semantic_start: 0, semantic_len: 0, semantic_capacity: 0, symbols_start: 0, symbols_len: 0, symbols_capacity: 0, hash: hash, next: previous, version: -1, open: false, generation: 0, last_diag_version: -1, last_diag_fp: 0, free: false})
    slot: usize = documents.count - 1
    for i in 0..<uri.len.usize():
        storage.push(sview_at(uri, i))
    heads <- heads.put(hash, slot.u32())
    return slot


# Remove `slot` from its hash chain so a freed slot can be reused without a
# stale chain reaching it. A missing key is a no-op.
def chain_remove(documents: mutable darray[LspDocument]&, heads: mutable dict[u64, u32]&, slot: usize) -> void can[Abort.Panic]:
    h: u64 = documents[slot].hash
    chain_head: mutable u32 = 4294967295
    found_chain: mutable bool = false
    if heads.get(h) is existing:
        chain_head <- existing
        found_chain <- true
    return if not found_chain
    previous: mutable u32 = 4294967295
    current: mutable u32 = chain_head
    while current != 4294967295:
        if current == slot.u32():
            if previous == 4294967295:
                heads <- heads.put(h, documents[slot].next)
            else:
                documents[previous.usize()].next <- documents[slot].next
            return
        previous <- current
        current <- documents[current.usize()].next


# Commit a decoded source snapshot into reusable flat storage. Same-sized edits
# overwrite the existing reservation; only growth appends a new reservation.
def store_document_text(document: mutable LspDocument&, storage: mutable darray[u8]&, source: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    needed: usize = source.count
    if document.text_capacity >= needed and document.text_capacity > 0:
        for i in 0..<needed:
            storage[document.text_start + i] <- source[i]
        document.text_len <- needed
        return
    document.text_start <- storage.count
    storage.extend(source)
    extra: mutable usize = needed
    extra <- 1 if extra == 0
    for i in 0..<extra:
        storage.push(0)
    document.text_len <- needed
    document.text_capacity <- needed + extra


# Commit an encoded semantic-token result into the same flat storage. Token
# requests are frequent and must not rerun the frontend when the source has not
# changed; same-sized results reuse their reservation.
def store_document_semantic(document: mutable LspDocument&, storage: mutable darray[u8]&, result: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    needed: usize = result.count
    if document.semantic_capacity >= needed and document.semantic_capacity > 0:
        for i in 0..<needed:
            storage[document.semantic_start + i] <- result[i]
        document.semantic_len <- needed
        return
    document.semantic_start <- storage.count
    storage.extend(result)
    extra: mutable usize = needed
    extra <- 1 if extra == 0
    for i in 0..<extra:
        storage.push(0)
    document.semantic_len <- needed
    document.semantic_capacity <- needed + extra


# Commit an encoded document-symbol result into the same flat storage.
# Outline requests must not rerun the frontend (F02); same-sized results reuse
# their reservation. The encoded shape depends on the session's negotiated
# symbol support, so the render is rebuilt only when the source changes.
def store_document_symbols(document: mutable LspDocument&, storage: mutable darray[u8]&, result: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    needed: usize = result.count
    if document.symbols_capacity >= needed and document.symbols_capacity > 0:
        for i in 0..<needed:
            storage[document.symbols_start + i] <- result[i]
        document.symbols_len <- needed
        return
    document.symbols_start <- storage.count
    storage.extend(result)
    extra: mutable usize = needed
    extra <- 1 if extra == 0
    for i in 0..<extra:
        storage.push(0)
    document.symbols_len <- needed
    document.symbols_capacity <- needed + extra


# Run the frontend over the document and publish its findings. The decoded
# text and its uri are stored in the session cache so later semantic-token and
# hover requests can retrieve the correct snapshot for their own URI.
# D01: versioned lifecycle — accept text into the store only for eligible
# versions; stale/equal versions never mutate; duplicate opens start a new
# generation; malformed notifications mutate nothing.
def check_and_publish(root: Json::Value, documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&, heads: mutable dict[u64, u32]&, utf8: bool, symbols_hier: bool, allowed_kinds: darray[i64]&, related: bool) -> void can[Console, Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return if uri.len == 0
    spell: sview = sview(&spell_bytes[0], 0, spell_bytes.count.i64())
    is_open: bool = method_is(root, "textDocument/didOpen")
    decoded: mutable darray[u8] = []
    return if not collect_full_text(root, is_open, decoded)
    slot: usize = document_slot(documents, storage, heads, uri)
    document: mutable LspDocument& = &documents[slot]
    incoming_version: i64 = request_version_state(root)
    # Malformed version (fractional, overflowing, wrong-typed): reject the
    # whole notification without mutating (J02/D01).
    return if incoming_version == -2
    # Duplicate open: new lifetime even if URI/version repeat.
    if is_open and document.open:
        document.generation <- document.generation + 1
    # Snapshot generation for the publish guard, captured AFTER this update's
    # lifetime bump so it reflects the revision actually being analyzed.
    gen: u64 = document.generation
    # Stale/equal-version didChange: ignore without mutating.
    if not is_open and document.open and incoming_version >= 0 and incoming_version <= document.version:
        return
    # didChange for a never-opened document: ignore (no lifetime to update).
    if not is_open and not document.open:
        return
    # Validate and diagnose against a temporary owned snapshot first. It is
    # never stored unless the complete frontend pass returns normally.
    source: mutable darray[u8] = []
    for b in decoded:
        source.push(b)
    source.push(0)
    table: Semantic::SymbolTable = check_source_buf(&source[0], source.count - 1)
    semantic: darray[u8] = semtok_data_body_with_table(&source[0], source.count - 1, table, utf8)
    symbols: darray[u8] = build_symbols_body(spell, table, &source[0], source.count - 1, utf8, symbols_hier, allowed_kinds)
    store_document_text(document, storage, source)
    store_document_semantic(document, storage, semantic)
    store_document_symbols(document, storage, symbols)
    document.open <- true
    document.version <- incoming_version if incoming_version >= 0 else document.version + 1
    # G02: publish only if this generation is still current. The analysis above
    # is synchronous so the guard is vacuous today; it becomes load-bearing the
    # moment analysis moves off the event loop (slow old results must never
    # overwrite newer findings).
    return if documents[slot].generation != gen
    body: darray[u8] = build_publish_body(spell, table, &source[0], source.count - 1, document.version, utf8, related)
    fp: u64 = body_fingerprint(body)
    # Suppress identical repeats for the same version (e.g. duplicate didOpen);
    # the version is embedded in the body, so equal fingerprints imply equal
    # versions and findings — version correctness is preserved.
    if document.last_diag_version == document.version and document.last_diag_fp == fp:
        return
    document.last_diag_fp <- fp
    document.last_diag_version <- document.version
    send_message(body)


# FNV-1a over a complete notification body, mirroring `document_hash`.
# Used for identical-publication suppression (G02): equal bodies imply equal
# versions and findings because the version is embedded in the body.
def body_fingerprint(body: darray[u8]&) -> u64:
    14695981039346656037 return if body.count == 0
    hash: mutable u64 = 14695981039346656037
    view: sview = sview(&body[0], 0, body.count.i64())
    i: mutable usize = 0
    while i < view.len.usize():
        hash <- (hash ^ sview_at(view, i).u64()) * 1099511628211
        i <- i + 1
    return hash


# Publish an empty diagnostic array to clear client state for a URI.
# Carries the last known version so the client can order it against pushes.
def publish_empty_diagnostics(uri: sview, version: i64) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    body.push_str("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
    for b in uri:
        json_escape_byte(body, b)
    if version >= 0:
        body.push_str("\",\"version\":")
        body.push_int(version)
        body.push_str(",\"diagnostics\":[]}}")
    else:
        body.push_str("\",\"diagnostics\":[]}}")
    send_message(body)


# D04/R05 self-description: report retained storage and document counts. A
# private `$/` extension (never advertised as a capability); used by the soak
# test to prove the flat buffer plateaus instead of growing without bound.
def send_stats(id_raw: darray[u8], documents: darray[LspDocument]&, storage: darray[u8]&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    open_count: mutable i64 = 0
    i: mutable usize = 0
    while i < documents.count:
        open_count <- open_count + 1 if documents[i].open
        i <- i + 1
    body: mutable darray[u8] = []
    push_str(body, "{\"storage_bytes\":")
    push_int(body, storage.count.i64())
    push_str(body, ",\"live_bytes\":")
    push_int(body, storage_live_bytes(documents).i64())
    push_str(body, ",\"documents\":")
    push_int(body, documents.count.i64())
    push_str(body, ",\"open\":")
    push_int(body, open_count)
    push_str(body, "}")
    send_result_body(id_raw, body)


# Close: mark closed, unlink from the hash chain, free the slot for reuse, bump
# generation, and clear client diagnostics. Freeing (rather than retaining)
# keeps the slot table and storage bounded under URI churn (D04); the generation
# bump ensures in-flight old work can never publish into a reused lifetime (D01).
def handle_did_close(root: Json::Value, documents: mutable darray[LspDocument]&, storage: darray[u8]&, heads: mutable dict[u64, u32]&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    return if uri.len == 0
    found: i64 = document_index(documents, storage, heads, uri)
    return if found < 0
    closed_version: i64 = documents[found.usize()].version
    chain_remove(documents, heads, found.usize())
    documents[found.usize()].open <- false
    documents[found.usize()].free <- true
    documents[found.usize()].text_len <- 0
    documents[found.usize()].text_capacity <- 0
    documents[found.usize()].semantic_len <- 0
    documents[found.usize()].semantic_capacity <- 0
    documents[found.usize()].symbols_len <- 0
    documents[found.usize()].symbols_capacity <- 0
    documents[found.usize()].generation <- documents[found.usize()].generation + 1
    documents[found.usize()].last_diag_version <- -1
    documents[found.usize()].last_diag_fp <- 0
    spell: sview = sview(&spell_bytes[0], 0, spell_bytes.count.i64())
    publish_empty_diagnostics(spell, closed_version)


# D04 storage reclamation. The flat buffer is append-only: growth appends a new
# reservation and leaves the old as dead space, and closed documents keep their
# analysis/token bytes. `storage_reclaim` compacts the buffer in place when it
# is at least twice the live size — copying every live document's URI, and (for
# open documents) text/token/symbol bytes, updating their offsets. Closed
# documents keep only their URI so hash chains stay valid. Safe to call between
# messages: no request holds a view into the buffer once it has returned.
const COMPACT_MIN_BYTES: usize = 65536


def storage_live_bytes(documents: darray[LspDocument]&) -> usize:
    live: mutable usize = 0
    i: mutable usize = 0
    while i < documents.count:
        d: LspDocument = documents[i]
        if not d.free:
            live <- live + d.uri_len
            if d.open:
                live <- live + d.text_len + d.semantic_len + d.symbols_len
        i <- i + 1
    return live


def storage_reclaim(documents: mutable darray[LspDocument]&, storage: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    if storage.count < COMPACT_MIN_BYTES:
        return
    live: usize = storage_live_bytes(documents)
    if storage.count < live * 2:
        return
    temp: mutable darray[u8] = []
    i: mutable usize = 0
    while i < documents.count:
        d: mutable LspDocument& = &documents[i]
        if d.free:
            # Freed slots retain nothing; reclaim their URI bytes too.
            d.uri_start <- temp.count
            d.uri_len <- 0
            d.text_start <- temp.count
            d.text_len <- 0
            d.text_capacity <- 0
            d.semantic_start <- temp.count
            d.semantic_len <- 0
            d.semantic_capacity <- 0
            d.symbols_start <- temp.count
            d.symbols_len <- 0
            d.symbols_capacity <- 0
            i <- i + 1
            continue
        old_uri: usize = d.uri_start
        d.uri_start <- temp.count
        j: mutable usize = 0
        while j < d.uri_len:
            temp.push(storage[old_uri + j])
            j <- j + 1
        if d.open:
            old_text: usize = d.text_start
            d.text_start <- temp.count
            j <- 0
            while j < d.text_len:
                temp.push(storage[old_text + j])
                j <- j + 1
            d.text_capacity <- d.text_len
            old_sem: usize = d.semantic_start
            d.semantic_start <- temp.count
            j <- 0
            while j < d.semantic_len:
                temp.push(storage[old_sem + j])
                j <- j + 1
            d.semantic_capacity <- d.semantic_len
            old_sym: usize = d.symbols_start
            d.symbols_start <- temp.count
            j <- 0
            while j < d.symbols_len:
                temp.push(storage[old_sym + j])
                j <- j + 1
            d.symbols_capacity <- d.symbols_len
        else:
            d.text_start <- temp.count
            d.text_len <- 0
            d.text_capacity <- 0
            d.semantic_start <- temp.count
            d.semantic_len <- 0
            d.semantic_capacity <- 0
            d.symbols_start <- temp.count
            d.symbols_len <- 0
            d.symbols_capacity <- 0
        i <- i + 1
    storage.truncate(0)
    for b in temp:
        storage.push(b)


# ---- responses --------------------------------------------------------------------

# Frame and write a body to stdout: `Content-Length: N\r\n\r\n<body>`.
# T02: loop until all bytes are written. A short write is retried; a
# zero/negative result (broken pipe, closed stdout) drops the message rather
# than busy-looping. Length is computed after serialization so non-ASCII
# payloads frame exact bytes. Logs must never go to stdout (see docs).
def send_message(body: darray[u8]) -> void can[Console, Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    push_str(out, "Content-Length: ")
    push_int(out, body.count.i64())
    push_str(out, "\r\n\r\n")
    out.extend(body)
    return if out.count == 0
    written: mutable usize = 0
    while written < out.count:
        n: isize = write(1, (&out[written]).cast[void&], out.count - written) can Console
        return if n <= 0
        written <- written + n.usize()


# `{"jsonrpc":"2.0","id":<id>,"result":<result>}`
def send_result(id_raw: darray[u8], result: u8&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"result\":")
    push_str(body, result)
    push_str(body, "}")
    send_message(body)


# `{"jsonrpc":"2.0","id":<id>,"error":{"code":<code>,"message":"<msg>"}}`# P01: every valid request completes exactly once; unknown methods get
# MethodNotFound (-32601), never silence. Notifications (no id) never produce
# response objects — callers must check `request_has_id` first.
# NOTE: `push_int` only emits >=0, so negative JSON-RPC codes need an explicit '-'.
def send_error(id_raw: darray[u8], code: i64, message: u8&) -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":")
    body.extend(id_raw)
    push_str(body, ",\"error\":{\"code\":")
    if code < 0:
        body.push(45)
        push_int(body, 0 - code)
    else:
        push_int(body, code)
    push_str(body, ",\"message\":\"")
    push_str(body, message)
    push_str(body, "\"}}")
    send_message(body)


# JSON-RPC ParseError (J01): the frame's body is not one valid JSON value, so
# no request id can be recovered. Per JSON-RPC the id is null.
def send_parse_error() -> void can[Console, Memory.Allocate, Abort.Panic]:
    body: mutable darray[u8] = []
    push_str(body, "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"ParseError\"}}")
    send_message(body)


# `params.id` as a raw JSON token, for `$/cancelRequest`.
def extract_params_id(root: Json::Value) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    if Json::get(root, "params") is params:
        if Json::get(params, "id") is idv:
            match idv:
                Json::Value.Num(text):
                    push_sview(out, text)
                Json::Value.Str(text):
                    out.push(34)
                    push_sview(out, text)
                    out.push(34)
                _:
                    pass
    return out


# Q02 cancellation set. `$/cancelRequest` can only cancel work that has not yet
# completed; analysis is synchronous today, so a cancellation is honored when it
# is pipelined ahead of its request. Ids are stored as their raw JSON token
# (e.g. `1` vs `"1"` stay distinct) newline-separated, bounded to CANCEL_CAP so
# a hostile client cannot grow it without limit.
const CANCEL_CAP: i64 = 128


def cancel_add(buf: mutable darray[u8]&, raw_id: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    lines: mutable i64 = 0
    i: mutable usize = 0
    while i < buf.count:
        lines <- lines + 1 if buf[i] == 10
        i <- i + 1
    return if lines >= CANCEL_CAP
    for b in raw_id:
        buf.push(b)
    buf.push(10)


def cancel_take(buf: mutable darray[u8]&, raw_id: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic]:
    start: mutable usize = 0
    i: mutable usize = 0
    while i <= buf.count:
        if i == buf.count or buf[i] == 10:
            same: mutable bool = (i - start) == raw_id.count
            if same:
                j: mutable usize = 0
                while j < raw_id.count:
                    if buf[start + j] != raw_id[j]:
                        same <- false
                        break
                    j <- j + 1
            if same:
                rest: mutable usize = i + 1
                k: mutable usize = start
                while rest < buf.count:
                    buf[k] <- buf[rest]
                    k <- k + 1
                    rest <- rest + 1
                buf.truncate(k)
                return true
            start <- i + 1
        i <- i + 1
    return false


# P03 capability negotiation: derive the session profile from the client's
# `initialize` params. Position encodings are honored in client preference
# order (first supported wins; default UTF-16). Hover falls back to plaintext
# only when the client lists formats without markdown. Unknown or absent
# capabilities keep safe defaults; nothing unsupported is ever advertised.
def negotiate_utf8(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "general") is general:
                    if Json::get(general, "positionEncodings") is encs:
                        match encs:
                            Json::Value.Arr(items):
                                i: mutable usize = 0
                                while i < items.count:
                                    item: Json::Value = items[i]
                                    match item:
                                        Json::Value.Str(st):
                                            true return if string_view_eq(st, "utf-8") == 1
                                            false return if string_view_eq(st, "utf-16") == 1
                                        _:
                                            pass
                                    i <- i + 1
                            _:
                                pass
        return false


def negotiate_hover_markdown(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "hover") is hover:
                        if Json::get(hover, "contentFormat") is formats:
                            match formats:
                                Json::Value.Arr(items):
                                    i: mutable usize = 0
                                    while i < items.count:
                                        item: Json::Value = items[i]
                                        match item:
                                            Json::Value.Str(st):
                                                true return if string_view_eq(st, "markdown") == 1
                                            _:
                                                pass
                                        i <- i + 1
                                    return false
                                _:
                                    pass
        return true


# Whether the client accepts hierarchical `DocumentSymbol` (with children).
# Absent capability -> false: flat `SymbolInformation` is the universal shape.
def negotiate_symbols_hier(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "documentSymbol") is ds:
                        if Json::get(ds, "hierarchicalDocumentSymbolSupport") is h:
                            match h:
                                Json::Value.Bool(enabled):
                                    return enabled
                                _:
                                    return false
        return false


# The client's `symbolKind.valueSet`, when offered: the only SymbolKinds it
# accepts. An empty result means unrestricted (the common case); otherwise the
# renderer clamps every kind through per-category fallbacks (never invents a
# kind the client rejected).
def negotiate_symbol_kinds(root: Json::Value) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "documentSymbol") is ds:
                        if Json::get(ds, "symbolKind") is sk:
                            if Json::get(sk, "valueSet") is vs:
                                match vs:
                                    Json::Value.Arr(items):
                                        i: mutable usize = 0
                                        while i < items.count:
                                            item: Json::Value = items[i]
                                            match item:
                                                Json::Value.Num(text):
                                                    out.push(Json::as_i64(item))
                                                _:
                                                    pass
                                            i <- i + 1
                                    _:
                                        pass
        return out


# Whether the client accepts `relatedInformation` on published diagnostics
# (G03). False (and no related info emitted) unless explicitly advertised.
def negotiate_related_info(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "publishDiagnostics") is pd:
                        if Json::get(pd, "relatedInformation") is ri:
                            match ri:
                                Json::Value.Bool(enabled):
                                    return enabled
                                _:
                                    return false
        return false


# The client's `foldingRange.rangeLimit`, or 0 for unlimited.
def negotiate_fold_limit(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "foldingRange") is fr:
                        if Json::get(fr, "rangeLimit") is lim:
                            v: i64 = Json::as_i64_checked(lim)
                            return v if v >= 0 else 0
        return 0


# ---- hover: textDocument/hover (docs/119 loop-header capture list) -----------------
# Byte range [start,end) of 0-based source line `line_no` in `doc`; false if OOB.
# U02: routed through the shared `Positions` coordinate module so hover slices
# the same lines diagnostics and tokens report. The end excludes LF and a
# trailing CR; the trailing empty line after a final newline is addressable.
def hover_line_range(doc: u8&, doc_len: usize, line_no: i64, start_out: mutable usize&, end_out: mutable usize&) -> bool can[Abort.Panic]:
    nlines: i64 = Positions::line_count(doc, doc_len)
    false return if line_no < 0 or line_no >= nlines
    start: usize = Positions::line_start_offset(doc, doc_len, line_no)
    start_out <- start
    end_out <- start + Positions::line_byte_length(doc, doc_len, line_no).usize()
    return true

# If the source line [start,end) carries a loop-expression header `|item, …|` whose
# closing `|` is followed by `:`/`->`, append a markdown summary (what it mutates vs
# its loop-private accumulators) to `out` and return true. A bitwise `|` never matches.
def hover_loop_header(doc: u8&, start: usize, end: usize, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    open: mutable usize = end
    p: mutable usize = start
    while p < end:
        if doc[p] == 124:
            open <- p
            break
        p <- p + 1
    false return if open >= end
    close: mutable usize = end
    q: mutable usize = open + 1
    while q < end:
        if doc[q] == 124:
            close <- q
            break
        q <- q + 1
    false return if close >= end or close <= open + 1
    # After the closing pipe, `:` or `->` (skipping spaces) marks a real header.
    r: mutable usize = close + 1
    while r < end and doc[r] == 32:
        r <- r + 1
    is_header: mutable bool = false
    is_header <- true if r < end and doc[r] == 58
    is_header <- true if r + 1 < end and doc[r] == 45 and doc[r + 1] == 62
    false return if not is_header
    caps: mutable darray[u8] = []
    accs: mutable darray[u8] = []
    ncaps: mutable i64 = 0
    naccs: mutable i64 = 0
    item_start: mutable usize = open + 1
    k: mutable usize = open + 1
    while k <= close:
        if k == close or doc[k] == 44:
            s: mutable usize = item_start
            e: mutable usize = k
            while s < e and doc[s] == 32:
                s <- s + 1
            while e > s and doc[e - 1] == 32:
                e <- e - 1
            eq: mutable usize = e
            t: mutable usize = s
            while t < e:
                if doc[t] == 61:
                    eq <- t
                    break
                t <- t + 1
            if eq < e:
                ne: mutable usize = eq
                while ne > s and doc[ne - 1] == 32:
                    ne <- ne - 1
                push_str(accs, ", ") if naccs > 0
                # J02: source bytes enter through the shared JSON escaper —
                # raw quotes/backslashes would corrupt the response frame.
                acc_span: sview = sview(&doc[s], 0, (ne - s).i64())
                ai: mutable usize = 0
                while ai < acc_span.len.usize():
                    json_escape_byte(accs, sview_at(acc_span, ai))
                    ai <- ai + 1
                naccs <- naccs + 1
            elif e > s:
                push_str(caps, ", ") if ncaps > 0
                cap_span: sview = sview(&doc[s], 0, (e - s).i64())
                ci: mutable usize = 0
                while ci < cap_span.len.usize():
                    json_escape_byte(caps, sview_at(cap_span, ci))
                    ci <- ci + 1
                ncaps <- ncaps + 1
            item_start <- k + 1
        k <- k + 1
    push_str(out, "**docs/119 loop header**\\n\\n")
    if ncaps > 0:
        push_str(out, "Mutates (captured, in place): ")
        # Copy bytes one by one: `out.extend(caps)` would store the local
        # `caps` container into caller-owned `out` (auto-region escape).
        for b in caps:
            out.push(b)
        push_str(out, "\\n\\n")
    else:
        push_str(out, "Pure over outer state (no captures).\\n\\n")
    if naccs > 0:
        push_str(out, "Loop-private accumulators: ")
        for b in accs:
            out.push(b)
    return true

def handle_hover(root: Json::Value, documents: darray[LspDocument]&, document_storage: darray[u8]&, document_heads: dict[u64, u32]&, markdown: bool) -> void can[Console, Memory.Allocate, Abort.Panic]:
    id_raw: darray[u8] = extract_id(root)
    spell_bytes: mutable darray[u8] = []
    canon_bytes: mutable darray[u8] = []
    uri: sview = request_identity(root, spell_bytes, canon_bytes)
    found: i64 = document_index(documents, document_storage, document_heads, uri)
    if found < 0 or not documents[found.usize()].open or documents[found.usize()].text_len <= 1:
        send_result(id_raw, "null")
        return
    document: LspDocument = documents[found.usize()]
    doc_text: u8& = &document_storage[document.text_start]
    line_no: i64 = request_hover_line(root)
    ls: mutable usize = 0
    le: mutable usize = 0
    msg: mutable darray[u8] = []
    ok: mutable bool = false
    ok <- hover_loop_header(doc_text, ls, le, msg) if line_no >= 0 and document.text_len > 1 and hover_line_range(doc_text, document.text_len - 1, line_no, ls, le)
    if not ok:
        send_result(id_raw, "null")
        return
    body: mutable darray[u8] = []
    push_str(body, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"") if markdown
    push_str(body, "{\"contents\":{\"kind\":\"plaintext\",\"value\":\"") if not markdown
    body.extend(msg)
    push_str(body, "\"}}")
    send_result_body(id_raw, body)


# ---- server loop ------------------------------------------------------------------

def main() -> int can[Console, Memory.Allocate, Console.Format, Abort.Panic]:
    # Session document cache, owned here so source spans outlive each request.
    documents: mutable darray[LspDocument] = []
    document_storage: mutable darray[u8] = []
    document_heads: mutable dict[u64, u32] = {}
    # P02 lifecycle: uninitialized -> running -> shutdown-requested -> exited.
    initialized: mutable bool = false
    shutdown_requested: mutable bool = false
    # P03 session profile, negotiated once at initialize and threaded to every
    # provider so handlers cannot disagree about encodings or formats.
    pos_utf8: mutable bool = false
    hover_markdown: mutable bool = true
    symbols_hier: mutable bool = false
    allowed_kinds: mutable darray[i64] = []
    diag_related: mutable bool = false
    fold_limit: mutable i64 = 0
    # T01 buffered input: bytes read ahead of the cursor survive across
    # messages, so pipelined frames and split UTF-8 sequences frame exactly.
    inbuf: mutable darray[u8] = []
    inpos: mutable usize = 0
    # Q02 pending cancellations, stored as raw id tokens (typed-distinct).
    cancelled: mutable darray[u8] = []
    while true:
        body: mutable darray[u8] = []
        status: i64 = read_message(body, inbuf, inpos)
        # Clean EOF between messages is an orderly stop. Any framing error is a
        # controlled nonzero exit — resynchronizing on arbitrary bytes is unsafe.
        0 return if status == 0
        1 return if status < 0
        bsv: sview = sview(&body[0], 0, body.count.i64())
        # J01: a body that is not exactly one JSON value gets ParseError and is
        # not dispatched. Valid JSON with wrong shape is handled below (P01).
        if not Json::is_valid(bsv):
            send_parse_error()
            continue
        root: Json::Value = Json::parse(bsv)
        method: sview = request_method(root)
        has_id: bool = request_has_id(root)
        # Q02: a request whose id was cancelled before dispatch completes once
        # with RequestCancelled instead of running.
        if has_id:
            id_raw_all: darray[u8] = extract_id(root)
            if cancel_take(cancelled, id_raw_all):
                send_error(id_raw_all, -32800, "RequestCancelled")
                continue
        match method:
            "initialize":
                id_raw: darray[u8] = extract_id(root)
                if shutdown_requested:
                    send_error(id_raw, -32600, "InvalidRequest: server is shutting down")
                elif initialized:
                    send_error(id_raw, -32600, "InvalidRequest: already initialized")
                else:
                    pos_utf8 <- negotiate_utf8(root)
                    hover_markdown <- negotiate_hover_markdown(root)
                    symbols_hier <- negotiate_symbols_hier(root)
                    allowed_kinds <- negotiate_symbol_kinds(root)
                    diag_related <- negotiate_related_info(root)
                    fold_limit <- negotiate_fold_limit(root)
                    caps: mutable darray[u8] = []
                    push_str(caps, "{\"capabilities\":{\"textDocumentSync\":1,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":")
                    push_str(caps, semtok_legend_json())
                    push_str(caps, ",\"tokenModifiers\":[]},\"full\":true},\"hoverProvider\":true,\"documentSymbolProvider\":true,\"foldingRangeProvider\":true")
                    push_str(caps, ",\"positionEncoding\":\"utf-8\"") if pos_utf8
                    push_str(caps, "},\"serverInfo\":{\"name\":\"elisa-lsp\",\"version\":\"0.1.0\"}}")
                    send_result_body(id_raw, caps)
                    initialized <- true
            "initialized":
                # Notification confirming client init; no response by definition.
                pass
            "shutdown":
                id_raw: darray[u8] = extract_id(root)
                # Shutdown is a request; a notification-form shutdown gets no response.
                send_result(id_raw, "null") if has_id
                shutdown_requested <- true
            "exit":
                return 0 if shutdown_requested else 1
            "textDocument/didOpen" | "textDocument/didChange":
                if shutdown_requested:
                    pass
                elif not initialized:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32002, "ServerNotInitialized") if has_id
                else:
                    check_and_publish(root, documents, document_storage, document_heads, pos_utf8, symbols_hier, allowed_kinds, diag_related)
                    storage_reclaim(documents, document_storage)
            "textDocument/didClose":
                if shutdown_requested:
                    pass
                elif not initialized:
                    pass
                else:
                    handle_did_close(root, documents, document_storage, document_heads)
                    storage_reclaim(documents, document_storage)
            "textDocument/semanticTokens/full":
                if shutdown_requested:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32600, "InvalidRequest: server is shutting down") if has_id
                elif not initialized:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32002, "ServerNotInitialized") if has_id
                else:
                    handle_semantic_tokens(root, documents, document_storage, document_heads)
            "textDocument/hover":
                if shutdown_requested:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32600, "InvalidRequest: server is shutting down") if has_id
                elif not initialized:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32002, "ServerNotInitialized") if has_id
                else:
                    handle_hover(root, documents, document_storage, document_heads, hover_markdown)
            "textDocument/documentSymbol":
                if shutdown_requested:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32600, "InvalidRequest: server is shutting down") if has_id
                elif not initialized:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32002, "ServerNotInitialized") if has_id
                else:
                    handle_document_symbols(root, documents, document_storage, document_heads)
            "textDocument/foldingRange":
                if shutdown_requested:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32600, "InvalidRequest: server is shutting down") if has_id
                elif not initialized:
                    id_raw: darray[u8] = extract_id(root)
                    send_error(id_raw, -32002, "ServerNotInitialized") if has_id
                else:
                    handle_folding_range(root, documents, document_storage, document_heads, fold_limit)
            "$/elisa/stats":
                id_raw: darray[u8] = extract_id(root)
                send_stats(id_raw, documents, document_storage) if has_id
            "$/cancelRequest":
                # Notification: record the id; no response is produced.
                cid: darray[u8] = extract_params_id(root)
                cancel_add(cancelled, cid) if cid.count > 0
            _:
                # P01: unknown requests get MethodNotFound; unknown notifications
                # are ignored without a response object.
                if has_id:
                    if shutdown_requested:
                        id_raw: darray[u8] = extract_id(root)
                        send_error(id_raw, -32600, "InvalidRequest: server is shutting down")
                    elif not initialized:
                        # Pre-initialize unknown requests: MethodNotFound would
                        # leak; ServerNotInitialized is the actionable error.
                        # Use MethodNotFound only once running to keep the
                        # envelope matrix predictable.
                        id_raw: darray[u8] = extract_id(root)
                        send_error(id_raw, -32002, "ServerNotInitialized")
                    else:
                        id_raw: darray[u8] = extract_id(root)
                        send_error(id_raw, -32601, "MethodNotFound")
                else:
                    pass
    return 0
