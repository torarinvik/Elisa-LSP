def negotiate_definition_link_support(root: Json::Value) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "definition") is definition:
                        if Json::get(definition, "linkSupport") is support:
