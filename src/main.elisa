# The client's `foldingRange.rangeLimit`, or 0 for unlimited.
def negotiate_fold_limit(root: Json::Value) -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        if Json::get(root, "params") is params:
            if Json::get(params, "capabilities") is caps:
                if Json::get(caps, "textDocument") is td:
                    if Json::get(td, "foldingRange") is fr:
                        if Json::get(fr, "rangeLimit") is lim:
                            v: i64 = Json::as_lsp_uinteger_or_invalid(lim)
                            return v if v >= 0 else 0
        return 0


# ---- hover: textDocument/hover (loop-header capture list) --------------------------
# Byte range [start,end) of 0-based source line `line_no` in `doc`; false if OOB.
# U02: routed through the shared `Positions` coordinate module so hover slices
# the same lines diagnostics and tokens report. The end excludes LF and a
# trailing CR; the trailing empty line after a final newline is addressable.
def hover_line_range(doc: u8&, doc_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, line_no: i64, start_out: mutable usize&, end_out: mutable usize&) -> bool can[Abort.Panic]:
    false return if line_no < 0 or line_no.usize() >= span_count
    start: usize = Positions::line_start_offset_span_indexed(line_starts, span_start, span_count, doc_len, line_no)
    start_out <- start
    end_out <- start + Positions::line_byte_length_span_indexed(doc, doc_len, line_starts, span_start, span_count, line_no).usize()
    return true

# If the source line [start,end) carries a loop-expression header `|item, …|` whose
# closing `|` is followed by `:`/`->`, append a markdown summary (what it mutates vs
# its loop-private accumulators) to `out` and return true. A bitwise `|` never matches.
def hover_loop_header(doc: u8&, start: usize, end: usize, cursor_byte_col: i64, doc_len: usize, line_starts: darray[usize]&, span_start: usize, span_count: usize, line_no: i64, utf8: bool, markdown: bool, out: mutable darray[u8]&, hover_start_char_out: mutable i64&, hover_end_char_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    open: mutable usize = end
    p: mutable usize = start
    while p < end:
        if doc[p] == 124:
            open <- p
            break
        p <- p + 1
    false return if open >= end
    close: mutable usize = end
    q: mutable usize = open + 1
    while q < end:
        if doc[q] == 124:
            close <- q
            break
        q <- q + 1
    false return if close >= end or close <= open + 1
    # After the closing pipe, `:` or `->` (skipping spaces) marks a real header.
    r: mutable usize = close + 1
    while r < end and doc[r] == 32:
        r <- r + 1
    is_header: mutable bool = false
    is_header <- true if r < end and doc[r] == 58
    is_header <- true if r + 1 < end and doc[r] == 45 and doc[r + 1] == 62
    false return if not is_header
    header_start_col: i64 = (open - start).i64()
    header_end_col: i64 = (close + 1.usize() - start).i64()
    false return if cursor_byte_col < header_start_col or cursor_byte_col > header_end_col
    hover_start_char_out <- Positions::byte_col_to_units_span_indexed(doc, doc_len, line_starts, span_start, span_count, line_no, header_start_col, utf8)
    hover_end_char_out <- Positions::byte_col_to_units_span_indexed(doc, doc_len, line_starts, span_start, span_count, line_no, header_end_col, utf8)
    caps: mutable darray[u8] = []
    accs: mutable darray[u8] = []
    ncaps: mutable i64 = 0
    naccs: mutable i64 = 0
    item_start: mutable usize = open + 1
    k: mutable usize = open + 1
    while k <= close:
        if k == close or doc[k] == 44:
            s: mutable usize = item_start
            e: mutable usize = k
            while s < e and doc[s] == 32:
                s <- s + 1
            while e > s and doc[e - 1] == 32:
                e <- e - 1
            eq: mutable usize = e
            t: mutable usize = s
            while t < e:
                if doc[t] == 61:
                    eq <- t
                    break
                t <- t + 1
            if eq < e:
                ne: mutable usize = eq
                while ne > s and doc[ne - 1] == 32:
                    ne <- ne - 1
                push_str(accs, ", ") if naccs > 0
                # J02: source bytes enter through the shared JSON escaper —
                # raw quotes/backslashes would corrupt the response frame.
                acc_span: sview = Positions::source_view_span(doc, end, s, ne - s)
                json_escape_utf8(accs, acc_span)
                naccs <- naccs + 1
            elif e > s:
                push_str(caps, ", ") if ncaps > 0
                cap_span: sview = Positions::source_view_span(doc, end, s, e - s)
                json_escape_utf8(caps, cap_span)
                ncaps <- ncaps + 1
            item_start <- k + 1
        k <- k + 1
    push_str(out, "**Loop header**\\n\\n") if markdown
    push_str(out, "Loop header\\n\\n") if not markdown
    if ncaps > 0:
        push_str(out, "Mutates (captured, in place): ")
        # Copy bytes one by one: `out.extend(caps)` would store the local
        # `caps` container into caller-owned `out` (auto-region escape).
        out.extend([b for b in caps])
        push_str(out, "\\n\\n")
    else:
        push_str(out, "Pure over outer state (no captures).\\n\\n")
    if naccs > 0:
        push_str(out, "Loop-private accumulators: ")
        out.extend([b for b in accs])
    return true

def handle_hover(root: Json::Value, snapshot: DocumentSnapshotView, document_storage: darray[u8]&, document_line_starts: darray[usize]&, result_body: mutable darray[u8]&, markdown: bool, utf8: bool) -> ProviderOutcome can[Memory.Allocate, Abort.Panic]:
    if not snapshot.valid:
        return ProviderOutcome.NoMatchNull
    document: DocumentSnapshotView = snapshot
    source_start: mutable usize = document.source.text_start
    if source_start > document_storage.count:
        return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len == 0 or document.source.text_len > document_storage.count - source_start:
        return ProviderOutcome.InvalidRetainedCache
    if document.caches.line_index_count > 0:
        if document.caches.line_index_start > document_line_starts.count:
            return ProviderOutcome.InvalidRetainedCache
        if document.caches.line_index_count > document_line_starts.count - document.caches.line_index_start:
            return ProviderOutcome.InvalidRetainedCache
    hover_start: mutable usize = document.caches.hover_start
    if document.caches.hover_len > 0:
        if hover_start > document_storage.count:
            return ProviderOutcome.InvalidRetainedCache
        if document.caches.hover_len > document_storage.count - hover_start:
            return ProviderOutcome.InvalidRetainedCache
    if document.caches.signature_len > 0:
        if document.caches.signature_start > document_storage.count:
            return ProviderOutcome.InvalidRetainedCache
        if document.caches.signature_len > document_storage.count - document.caches.signature_start:
            return ProviderOutcome.InvalidRetainedCache
    if document.source.text_len <= 1:
        return ProviderOutcome.NoMatchNull
    doc_text: u8& = &document_storage[source_start]
    line_no: i64 = request_hover_line(root)
    char_no: i64 = request_hover_char(root)
    ls: mutable usize = 0
    le: mutable usize = 0
    msg: mutable darray[u8] = []
    ok: mutable bool = false
    extra: mutable darray[u8] = []
    loop_start_char: mutable i64 = 0
    loop_end_char: mutable i64 = 0
    if line_no >= 0:
        if document.caches.line_index_count > 0:
            if hover_line_range(doc_text, document.source.text_len - 1, document_line_starts, document.caches.line_index_start, document.caches.line_index_count, line_no, ls, le):
                cursor_byte_col: i64 = Positions::char_to_byte_col_span_indexed(doc_text, document.source.text_len - 1, document_line_starts, document.caches.line_index_start, document.caches.line_index_count, line_no, char_no, utf8)
                ok <- hover_loop_header(doc_text, ls, le, cursor_byte_col, document.source.text_len - 1, document_line_starts, document.caches.line_index_start, document.caches.line_index_count, line_no, utf8, markdown, msg, loop_start_char, loop_end_char)
            if not ok and document.lifecycle.analysis_state == DocumentAnalysisState.Ready:
                extra <- general_hover_body(document, document_storage, source_start, document_line_starts, document.caches.line_index_start, document.caches.line_index_count, hover_start, document.caches.signature_start, line_no, char_no, markdown, utf8)
        else:
            # Loop-header and semantic hover share one fallback for this request.
            fallback_starts: darray[usize] = Positions::build_line_starts(doc_text, document.source.text_len - 1)
            lsp_line_index_fallback_build_calls <- lsp_line_index_fallback_build_calls + 1
            if hover_line_range(doc_text, document.source.text_len - 1, &fallback_starts, 0, fallback_starts.count, line_no, ls, le):
                cursor_byte_col: i64 = Positions::char_to_byte_col_span_indexed(doc_text, document.source.text_len - 1, &fallback_starts, 0, fallback_starts.count, line_no, char_no, utf8)
                ok <- hover_loop_header(doc_text, ls, le, cursor_byte_col, document.source.text_len - 1, &fallback_starts, 0, fallback_starts.count, line_no, utf8, markdown, msg, loop_start_char, loop_end_char)
            if not ok and document.lifecycle.analysis_state == DocumentAnalysisState.Ready:
                extra <- general_hover_body(document, document_storage, source_start, &fallback_starts, 0, fallback_starts.count, hover_start, document.caches.signature_start, line_no, char_no, markdown, utf8)
    if not ok:
        # F01: general hover from the retained summary; null when nothing resolves.
        if extra.count > 0:
            result_body.extend(extra)
            return ProviderOutcome.Result
        return ProviderOutcome.NoMatchNull
    body: mutable darray[u8] = []
    push_str(body, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"") if markdown
    push_str(body, "{\"contents\":{\"kind\":\"plaintext\",\"value\":\"") if not markdown
    body.extend(msg)
    push_str(body, "\"},\"range\":")
    hover_push_range(body, line_no, loop_start_char, loop_end_char)
    push_str(body, "}")
    result_body.extend(body)
    return ProviderOutcome.Result


# ---- server loop ------------------------------------------------------------------

# Process one complete frame in its own function allocation region. Returning
# releases parse nodes, body bytes, and serialization scratch before the server
# reads the next message; only state explicitly passed by reference survives.
def process_next_message[@docs, @storage, @line_starts, @heads, @profile, @roots, @input, @method, @frame, @worker, @requests](documents: mutable darray[LspDocument]& @docs, document_storage: mutable darray[u8]& @storage, document_line_starts: mutable darray[usize]& @line_starts, document_heads: mutable dict[u64, u32]& @heads, state: mutable LspSessionState&, semtok_profile: mutable SemTokProfile& @profile, allowed_kinds: mutable darray[i64]& @profile, allowed_completion_kinds: mutable darray[i64]& @profile, roots: mutable darray[u8]& @roots, inbuf: mutable darray[u8]& @input, inpos: mutable usize&, frame_decoder: mutable LspFrameDecoder& @frame, method_scratch: mutable darray[u8]& @method, worker_runtime: mutable LspAnalysisWorkerRuntime& @worker, pending_requests: mutable LspPendingAnalysisQueue& @requests, max_header_bytes: i64, max_header_lines: i64, max_body_bytes: i64, malformed_notification_logs: mutable i64&) -> LspMessageStep can[Console, Memory.Allocate, Abort.Panic]:
    lsp_timing_reset() if not frame_decoder.active
    transport_started_ms: i64 = lsp_timing_start() can Console
    body: mutable darray[u8] = []
    status: mutable i64 = frame_decoder_step(body, frame_decoder, inbuf, inpos, max_header_bytes, max_header_lines, max_body_bytes)
    if status == 2 and pending_analysis_request_take_ready(pending_requests, body):
        status <- 1
    lsp_timing_add(lsp_timing_transport_ms, transport_started_ms) can Console
    pending_signal: int = elisa_lsp_pending_termination_signal() can Console
    return LspMessageStep.Stop(128 + pending_signal.i64()) if pending_signal != 0
    return LspMessageStep.Stop(1) if lsp_transport_input_failed
    return LspMessageStep.WaitInput if status == 2
    # Clean EOF between messages is a transport-level orderly stop (the
    # same behavior as before P02). Any framing error is a controlled
    # nonzero exit — resynchronizing on arbitrary bytes is unsafe.
    if status == 0:
        state.lifecycle <- LspLifecycleState.Exited
        return LspMessageStep.Stop(0)
    if status < 0:
        state.lifecycle <- LspLifecycleState.Exited
        return LspMessageStep.Stop(1)
    profile_before: SemTokProfile = SemTokProfile{legend_json: semtok_profile.legend_json, type_map: semtok_profile.type_map, custom: semtok_profile.custom, modifier_json: semtok_profile.modifier_json, modifier_map: semtok_profile.modifier_map}
    bsv: sview = bytes_view_range_ref(body, 0, body.count) if body.count > 0 else sview("", 0, 0)
    # J01 checked parse returns either a complete borrowed value tree or a
    # structured failure; malformed bodies never reach request dispatch.
    decode_started_ms: i64 = lsp_timing_start() can Console
    parse_outcome: Json::ParseOutcome = Json::parse(bsv)
    lsp_timing_record(lsp_timing_decode_ms, decode_started_ms) can Console
    root: mutable Json::Value
    match parse_outcome:
        Json::ParseOutcome.Parsed(parsed_root):
            root <- parsed_root
        Json::ParseOutcome.Rejected(detail):
            send_parse_error(detail)
            return LspMessageStep.Next
    # Responses can only match requests initiated by the server. There are
    # no such requests today, so ignore response-shaped objects instead of
    # misreporting them as unknown method calls.
    if root_is_object(root) and is_unmatched_response(root):
        return LspMessageStep.Next
    if not root_is_object(root):
        invalid_id: mutable darray[u8] = []
        push_str(invalid_id, "null")
        send_error(invalid_id, -32600, "InvalidRequest")
        return LspMessageStep.Next
    method_scratch.truncate(0)
    method: sview = request_method(root, method_scratch)
    method_started_ms: i64 = elisa_lsp_monotonic_millis() can Console
    lsp_last_cache_outcome <- LSP_CACHE_NONE
    lsp_last_document_generation <- -1
    lsp_last_analysis_status <- 0
    method_valid: mutable bool = false
    if Json::get(root, "method") is method_value:
        match method_value:
            Json::Value.Str(_):
                method_valid <- method_scratch.count > 0
            _:
                pass
    rpc_valid: mutable bool = false
    if Json::get(root, "jsonrpc") is rpc_value:
        rpc_valid <- json_string_is(rpc_value, "2.0")
    id_present: bool = request_id_present(root)
    has_id: bool = request_has_id(root)
    if envelope_has_critical_duplicates(root) or not rpc_valid or not method_valid or (id_present and not request_id_valid(root)):
        invalid_id: darray[u8] = envelope_error_id(root)
        send_error(invalid_id, -32600, "InvalidRequest")
        return finish_method_next(method, method_started_ms)
    # A request method without an ID is a notification in JSON-RPC terms,
    # but LSP request handlers must not emit a response. Ignore it rather
    # than entering a handler that assumes a response ID is present.
    if not has_id and known_request_method(method):
        return finish_method_next(method, method_started_ms)
    # LSP notification methods are one-way. An ID on one is a malformed
    # envelope rather than a request whose completion can be answered.
    if has_id and known_notification_method(method):
        invalid_id: darray[u8] = extract_id(root)
        send_error(invalid_id, -32600, "InvalidRequest")
        return finish_method_next(method, method_started_ms)

    # LSP 3.17/3.18 lifecycle rules precede method-specific validation:
    # before initialize, requests get ServerNotInitialized and every
    # notification is dropped except exit; after shutdown, requests get
    # InvalidRequest and every notification is dropped except exit.
    # Consequently no provider, private request, or cancellation message
    # can perform work outside the live session.
    if state.lifecycle == LspLifecycleState.Uninitialized:
        if string_view_eq(method, "initialize") != 1 and string_view_eq(method, "exit") != 1:
            if has_id:
                id_raw: darray[u8] = extract_id(root)
                send_error(id_raw, -32002, "ServerNotInitialized")
            return finish_method_next(method, method_started_ms)
    elif state.lifecycle == LspLifecycleState.Initializing:
        if string_view_eq(method, "exit") != 1:
            if has_id:
                id_raw: darray[u8] = extract_id(root)
                send_error(id_raw, -32600, "InvalidRequest: server is initializing")
            return finish_method_next(method, method_started_ms)
    elif state.lifecycle == LspLifecycleState.ShutdownRequested:
        if string_view_eq(method, "exit") != 1:
            if has_id:
                id_raw: darray[u8] = extract_id(root)
                send_error(id_raw, -32600, "InvalidRequest: server is shutting down")
            return finish_method_next(method, method_started_ms)
    elif (state.lifecycle == LspLifecycleState.Running or state.lifecycle == LspLifecycleState.Initialized) and string_view_eq(method, "initialize") == 1:
        id_raw: darray[u8] = extract_id(root)
        send_error(id_raw, -32600, "InvalidRequest: initialize may only be sent once")
        return finish_method_next(method, method_started_ms)

    if not params_shape_valid(root):
        invalid_id: darray[u8] = extract_id(root)
        send_error(invalid_id, -32602, "InvalidParams") if has_id
        log_malformed_notification(malformed_notification_logs) if not has_id and known_notification_method(method)
        return finish_method_next(method, method_started_ms)
    if not method_params_valid(root, method):
        invalid_id: darray[u8] = extract_id(root)
        send_error(invalid_id, -32602, "InvalidParams") if has_id
        log_malformed_notification(malformed_notification_logs) if not has_id and known_notification_method(method)
        return finish_method_next(method, method_started_ms)
    if has_id and pending_analysis_request_enqueue(root, method, body, documents, document_storage, document_heads, worker_runtime, pending_requests):
        return finish_method_next(method, method_started_ms)
    # A frontend contract failure is a recoverable server-side analysis
    # failure. Do not disguise it as an empty semantic answer; each
    # analysis-backed request gets exactly one JSON-RPC InternalError.
    if has_id and request_has_failed_analysis_snapshot(root, method, documents, document_storage, document_heads):
        failed_id: darray[u8] = extract_id(root)
        send_error(failed_id, -32603, "InternalError")
        lsp_last_cache_outcome <- LSP_CACHE_FAILED
        return finish_method_next(method, method_started_ms)
    match method:
        "initialize":
            id_raw: darray[u8] = extract_id(root)
            if state.lifecycle == LspLifecycleState.Uninitialized:
                state.lifecycle <- LspLifecycleState.Initializing
                negotiated_utf8: bool = negotiate_utf8(root)
                state.pos_utf8 <- negotiated_utf8
                state.analysis_timeout_ms <- initialize_analysis_timeout(root, state.analysis_timeout_ms)
                lsp_analysis_timeout_ms <- state.analysis_timeout_ms
                # Keep negotiated containers in the caller-owned session region;
                # parse-tree borrows and intermediate arrays stay message-local.
                computed_profile: SemTokProfile = semtok_negotiate_profile(root)
                computed_kinds: darray[i64] = negotiate_symbol_kinds(root)
                computed_completion_kinds: darray[i64] = negotiate_completion_kinds(root, state.completion_kind_limited)
                state.completion_snippet_support <- negotiate_completion_snippet_support(root)
                state.completion_insert_replace_support <- negotiate_completion_insert_replace_support(root)
                state.completion_commit_characters_support <- negotiate_completion_commit_characters_support(root)
                state.completion_label_details_support <- negotiate_completion_label_details_support(root)
                state.definition_link_support <- negotiate_definition_link_support(root)
                in profile:
                    semtok_profile.legend_json.truncate(0)
                    semtok_profile.legend_json.extend(computed_profile.legend_json)
                    semtok_profile.type_map.truncate(0)
                    semtok_profile.type_map.extend(computed_profile.type_map)
                    semtok_profile.custom <- computed_profile.custom
                    semtok_profile.modifier_json.truncate(0)
                    semtok_profile.modifier_json.extend(computed_profile.modifier_json)
                    semtok_profile.modifier_map.truncate(0)
                    semtok_profile.modifier_map.extend(computed_profile.modifier_map)
                    allowed_kinds.truncate(0)
                    allowed_kinds.extend(computed_kinds)
                    allowed_completion_kinds.truncate(0)
                    allowed_completion_kinds.extend(computed_completion_kinds)
                state.hover_markdown <- negotiate_hover_markdown(root)
                state.rename_document_changes <- negotiate_rename_document_changes(root)
                state.symbols_hier <- negotiate_symbols_hier(root)
                state.diag_related <- negotiate_related_info(root)
                state.fold_limit <- negotiate_fold_limit(root)
                collect_roots(root, roots)
                caps: mutable darray[u8] = []
                push_str(caps, "{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":2},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":")
                caps.extend(semtok_profile.legend_json)
                push_str(caps, ",\"tokenModifiers\":")
                caps.extend(semtok_profile.modifier_json)
                push_str(caps, "},\"full\":true,\"range\":true},\"hoverProvider\":true,\"completionProvider\":{\"resolveProvider\":true},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"definitionProvider\":true,\"referencesProvider\":true")
                push_str(caps, ",\"renameProvider\":{\"prepareProvider\":true}") if state.rename_document_changes
                push_str(caps, ",\"documentSymbolProvider\":true,\"foldingRangeProvider\":true,\"selectionRangeProvider\":true")
                push_str(caps, ",\"positionEncoding\":\"utf-8\"") if negotiated_utf8
                push_str(caps, ",\"documentHighlightProvider\":true")
                push_str(caps, "},\"serverInfo\":{\"name\":\"elisa-lsp\",\"version\":\"0.1.0\"}}")
                send_result_body(id_raw, caps)
                state.lifecycle <- LspLifecycleState.Running
            else:
                send_error(id_raw, -32600, "InvalidRequest: initialize may only be sent once")
        "initialized":
            # The one valid notification records completion of the client
            # handshake. Repeats and out-of-order notifications are dropped.
            state.lifecycle <- LspLifecycleState.Initialized if state.lifecycle == LspLifecycleState.Running
        "shutdown":
            id_raw: darray[u8] = extract_id(root)
            pending_analysis_requests_cancel_all(pending_requests, LSP_ERROR_REQUEST_CANCELLED, "RequestCancelled")
            # The response must be delivered before the client sends exit.
            # Requests after this transition are rejected by the central
            # lifecycle gate, including a second shutdown request.
            send_result(id_raw, "null")
            # No analysis result is useful once shutdown has been accepted.
            analysis_worker_abort_runtime(worker_runtime)
            state.lifecycle <- LspLifecycleState.ShutdownRequested
        "exit":
            exit_status: mutable i64 = 1
            pending_analysis_requests_cancel_all(pending_requests, LSP_ERROR_REQUEST_CANCELLED, "RequestCancelled")
            exit_status <- 0 if state.lifecycle == LspLifecycleState.ShutdownRequested
            state.lifecycle <- LspLifecycleState.Exited
            return finish_method_stop(method, method_started_ms, exit_status)
        "textDocument/didOpen" | "textDocument/didChange":
            check_and_publish(root, documents, document_storage, document_heads, document_line_starts, state.pos_utf8, state.symbols_hier, allowed_kinds, state.diag_related, worker_runtime, pending_requests)
            enforce_derived_cache_budget(documents)
            storage_reclaim(documents, document_storage)
            line_index_reclaim_if_needed(documents, document_line_starts)
        "textDocument/didClose":
            handle_did_close(root, documents, document_storage, document_heads, worker_runtime, pending_requests)
            storage_reclaim(documents, document_storage)
            line_index_reclaim_if_needed(documents, document_line_starts)
        "workspace/didChangeConfiguration":
            # P03 inbound settings are validated before this arm. Applying a
            # timeout at a message boundary is atomic and cannot race the
            # synchronous worker; unknown extension settings are ignored.
            apply_configuration_notification(root, state)
        "textDocument/semanticTokens/full":
            semtok_id: darray[u8] = extract_id(root)
            semtok_body: mutable darray[u8] = []
            semtok_storage_start: mutable usize = 0
            semtok_storage_len: mutable usize = 0
            provider_started_ms: i64 = lsp_timing_start() can Console
            semtok_outcome: ProviderOutcome = handle_semantic_tokens(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, profile_before, semtok_body, semtok_storage_start, semtok_storage_len)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, semtok_id, semtok_outcome, semtok_body, document_storage, semtok_storage_start, semtok_storage_len, documents, document_heads, state.pos_utf8, ProviderRangeKind.SemanticTokens)
        "textDocument/semanticTokens/range":
            semtok_range_id: darray[u8] = extract_id(root)
            semtok_range_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            semtok_range_outcome: ProviderOutcome = handle_semantic_tokens_range(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, profile_before, semtok_range_body)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, semtok_range_id, semtok_range_outcome, semtok_range_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.SemanticTokens)
        "textDocument/hover":
            hover_id: darray[u8] = extract_id(root)
            hover_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            hover_outcome: ProviderOutcome = handle_hover(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, hover_body, state.hover_markdown, state.pos_utf8)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, hover_id, hover_outcome, hover_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/signatureHelp":
            signature_id: darray[u8] = extract_id(root)
            signature_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            signature_outcome: ProviderOutcome = handle_signature_help(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, signature_body, state.pos_utf8)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, signature_id, signature_outcome, signature_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/completion":
            completion_id: darray[u8] = extract_id(root)
            completion_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            completion_outcome: ProviderOutcome = handle_completion(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, completion_body, state.pos_utf8, state.completion_kind_limited, allowed_completion_kinds, state.completion_snippet_support, state.completion_insert_replace_support, state.completion_commit_characters_support, state.completion_label_details_support)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, completion_id, completion_outcome, completion_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "completionItem/resolve":
            completion_resolve_id: darray[u8] = extract_id(root)
            completion_resolve_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            handle_completion_resolve(root, documents, document_storage, document_heads, completion_resolve_body)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            send_result_body(completion_resolve_id, completion_resolve_body)
        "textDocument/definition":
            definition_id: darray[u8] = extract_id(root)
            definition_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            definition_outcome: ProviderOutcome = handle_definition(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, definition_body, state.pos_utf8, state.definition_link_support)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, definition_id, definition_outcome, definition_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/references":
            references_id: darray[u8] = extract_id(root)
            references_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            references_outcome: ProviderOutcome = handle_references(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, references_body)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, references_id, references_outcome, references_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/prepareRename":
            prepare_rename_id: darray[u8] = extract_id(root)
            prepare_rename_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            prepare_rename_outcome: mutable ProviderOutcome = ProviderOutcome.NoMatchNull
            if state.rename_document_changes:
                prepare_rename_outcome <- handle_prepare_rename(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, prepare_rename_body)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, prepare_rename_id, prepare_rename_outcome, prepare_rename_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/rename":
            rename_id: darray[u8] = extract_id(root)
            rename_body: mutable darray[u8] = []
            rename_snapshot: DocumentSnapshotView = request_document_snapshot(root, documents, document_storage, document_heads)
            provider_started_ms: i64 = lsp_timing_start() can Console
            rename_outcome: mutable ProviderOutcome = ProviderOutcome.NoMatchNull
            if state.rename_document_changes:
                rename_outcome <- handle_rename(root, rename_snapshot, document_storage, rename_body)
            # The message loop is synchronous. Still compare the captured source
            # generation/version immediately before returning a WorkspaceEdit,
            # so a future dispatch change cannot accidentally emit stale edits.
            current_rename_snapshot: DocumentSnapshotView = request_document_snapshot(root, documents, document_storage, document_heads)
            if rename_outcome == ProviderOutcome.Result and (not current_rename_snapshot.valid or current_rename_snapshot.lifecycle.generation != rename_snapshot.lifecycle.generation or current_rename_snapshot.lifecycle.version != rename_snapshot.lifecycle.version):
                rename_body.truncate(0)
                rename_outcome <- ProviderOutcome.NoMatchNull
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, rename_id, rename_outcome, rename_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/documentHighlight":
            highlight_id: darray[u8] = extract_id(root)
            highlight_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            highlight_outcome: ProviderOutcome = handle_document_highlight(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, highlight_body, state.pos_utf8)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, highlight_id, highlight_outcome, highlight_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/documentSymbol":
            symbols_id: darray[u8] = extract_id(root)
            symbols_body: mutable darray[u8] = []
            symbols_storage_start: mutable usize = 0
            symbols_storage_len: mutable usize = 0
            provider_started_ms: i64 = lsp_timing_start() can Console
            symbols_outcome: ProviderOutcome = handle_document_symbols(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, symbols_storage_start, symbols_storage_len)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, symbols_id, symbols_outcome, symbols_body, document_storage, symbols_storage_start, symbols_storage_len, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/foldingRange":
            folding_id: darray[u8] = extract_id(root)
            folding_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            folding_outcome: ProviderOutcome = handle_folding_range(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, folding_body, state.fold_limit)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, folding_id, folding_outcome, folding_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.Standard)
        "textDocument/selectionRange":
            selection_id: darray[u8] = extract_id(root)
            selection_body: mutable darray[u8] = []
            provider_started_ms: i64 = lsp_timing_start() can Console
            selection_outcome: ProviderOutcome = handle_selection_range(root, request_document_snapshot(root, documents, document_storage, document_heads), document_storage, document_line_starts, selection_body, state.pos_utf8)
            lsp_timing_record(lsp_timing_provider_ms, provider_started_ms) can Console
            emit_provider_outcome(root, selection_id, selection_outcome, selection_body, document_storage, 0, 0, documents, document_heads, state.pos_utf8, ProviderRangeKind.SelectionRanges)
        "$/elisa/stats":
            id_raw: darray[u8] = extract_id(root)
            send_stats(id_raw, documents, document_storage, document_heads, document_line_starts, worker_runtime, pending_requests, max_header_bytes, max_header_lines, max_body_bytes) if has_id
        "$/elisa/status":
            id_raw: darray[u8] = extract_id(root)
            send_status(id_raw, max_header_bytes, max_header_lines, max_body_bytes, state.pos_utf8) if has_id
        "$/elisa/workspace":
            id_raw: darray[u8] = extract_id(root)
            if has_id:
                doc_bytes: mutable darray[u8] = []
                doc_canon: mutable darray[u8] = []
                doc_uri: mutable sview = sview("", 0, 0)
                if Json::get(root, "params") is params:
                    if Json::get(params, "textDocument") is td:
                        if Json::get(td, "uri") is u:
                            match u:
                                Json::Value.Str(_):
                                    if append_canonical_uri(u, doc_canon):
                                        doc_uri <- bytes_view_range_ref(doc_canon, 0, doc_canon.count)
                                _:
                                    pass
                send_workspace(id_raw, roots, doc_uri)
        "$/cancelRequest":
            pending_analysis_request_cancel(root, pending_requests)
        _:
            # P01: unknown requests get MethodNotFound; unknown notifications
            # are ignored without a response object.
            if has_id:
                id_raw: darray[u8] = extract_id(root)
                send_error(id_raw, -32601, "MethodNotFound")
            else:
                pass
    return finish_method_next(method, method_started_ms)


def main() -> int can[Console, Memory.Allocate, Console.Format, Abort.Panic]:
    # Session document cache, owned here so source spans outlive each request.
    documents: mutable darray[LspDocument] = []
    document_storage: mutable darray[u8] = []
    document_line_starts: mutable darray[usize] = []
    document_heads: mutable dict[u64, u32] = {}
    # P02 lifecycle: Uninitialized -> Initializing -> Running -> Initialized
    # -> ShutdownRequested -> Exited. `Running` is usable immediately after the
    # initialize response; `Initialized` records the optional one-time client
    # notification without imposing an extra gate on established clients.
    # P03 negotiated settings remain together for one-message processing.
    state: mutable LspSessionState = LspSessionState{lifecycle: LspLifecycleState.Uninitialized, pos_utf8: false, hover_markdown: true, rename_document_changes: false, completion_kind_limited: false, completion_snippet_support: false, completion_insert_replace_support: false, completion_commit_characters_support: false, completion_label_details_support: false, definition_link_support: false, symbols_hier: false, diag_related: false, fold_limit: 0, analysis_timeout_ms: 0}
    # W01: newline-separated canonical workspace roots (empty = standalone).
    roots: mutable darray[u8] = []
    # T01 buffered input: bytes read ahead of the cursor survive across
    # messages, so pipelined frames and split UTF-8 sequences frame exactly.
    inbuf: mutable darray[u8] = []
    inpos: mutable usize = 0
    frame_decoder: mutable LspFrameDecoder = LspFrameDecoder{phase: LspFramePhase.Header, active: false, header_line: [], body: [], header_bytes: 0, header_lines: 0, content_length: -1, body_remaining: 0, content_type_seen: false, content_encoding_seen: false}
    method_scratch: mutable darray[u8] = []
    worker_runtime: mutable LspAnalysisWorkerRuntime = LspAnalysisWorkerRuntime{packet: [], slot: 0, source_len: 0, job_id: 0, generation: 0, version: 0, uri_hash: 0, source_hash: 0, active: false, eof_seen: false, utf8: false, symbols_hier: false, related: false}
    pending_requests: mutable LspPendingAnalysisQueue = LspPendingAnalysisQueue{requests: [], storage: [], body_bytes: 0}
    max_header_bytes: i64 = elisa_lsp_max_header_bytes() can Console
    max_header_lines: i64 = elisa_lsp_max_header_lines() can Console
    max_body_bytes: i64 = elisa_lsp_max_body_bytes() can Console
    lsp_max_open_source_bytes <- elisa_lsp_max_open_source_bytes() can Console
    lsp_max_open_documents <- elisa_lsp_max_open_documents() can Console
    lsp_max_open_uri_bytes <- elisa_lsp_max_open_uri_bytes() can Console
    lsp_max_derived_cache_bytes <- elisa_lsp_max_derived_cache_bytes() can Console
    lsp_transport_write_timeout_ms <- elisa_lsp_write_timeout_millis() can Console
    lsp_analysis_timeout_ms <- elisa_lsp_analysis_timeout_millis() can Console
    lsp_validate_provider_ranges <- elisa_lsp_validate_provider_ranges() != 0 can Console
    lsp_log_level <- elisa_lsp_log_level() can Console
    lsp_log_max_bytes <- elisa_lsp_log_max_bytes() can Console
    lsp_timing_enabled <- elisa_lsp_timing_enabled() != 0 can Console
    state.analysis_timeout_ms <- lsp_analysis_timeout_ms
    malformed_notification_logs: mutable i64 = 0
    install_result: int = elisa_lsp_install_termination_handlers() can Console
    if install_result != 0:
        message: mutable darray[u8] = []
        push_str(message, "error: could not install POSIX termination handlers\n")
        write_stderr(message)
        return 2
    if max_header_bytes <= 0 or max_header_lines <= 0 or max_body_bytes <= 0 or lsp_max_open_source_bytes <= 0 or lsp_max_open_documents <= 0 or lsp_max_open_uri_bytes <= 0 or lsp_max_derived_cache_bytes <= 0 or lsp_transport_write_timeout_ms <= 0 or lsp_analysis_timeout_ms <= 0 or lsp_log_level < LSP_LOG_OFF or lsp_log_level > LSP_LOG_DEBUG or lsp_log_max_bytes <= 0:
        config_error: mutable darray[u8] = []
        push_str(config_error, "error: invalid ELISA_LSP limit or log setting; check the documented bounds in docs/development.md\n")
        write_stderr(config_error)
        return transport_finish(2)
    log_compiler_status()
    # Keep the negotiated variable-sized profile containers for the session.
    region session_profile:
        semtok_profile: mutable SemTokProfile = semtok_default_profile()
        allowed_kinds: mutable darray[i64] = []
        allowed_completion_kinds: mutable darray[i64] = []
        while true:
            pending_signal: mutable int = elisa_lsp_pending_termination_signal() can Console
            return transport_finish(128 + pending_signal.i64()) if pending_signal != 0
            return transport_finish(1) if lsp_transport_output_failed
            if state.lifecycle != LspLifecycleState.ShutdownRequested and state.lifecycle != LspLifecycleState.Exited:
                analysis_worker_start_next_pending(documents, document_storage, document_line_starts, state.pos_utf8, state.symbols_hier, allowed_kinds, state.diag_related, worker_runtime, pending_requests)
            step: LspMessageStep = process_next_message(documents, document_storage, document_line_starts, document_heads, state, semtok_profile, allowed_kinds, allowed_completion_kinds, roots, inbuf, inpos, frame_decoder, method_scratch, worker_runtime, pending_requests, max_header_bytes, max_header_lines, max_body_bytes, malformed_notification_logs)
            match step:
                LspMessageStep.Next:
                    pass
                LspMessageStep.WaitInput:
                    wait_started_ms: i64 = lsp_timing_start() can Console
                    events: int = elisa_lsp_analysis_worker_wait_event(-1) can Console
                    pending_signal: int = elisa_lsp_pending_termination_signal() can Console
                    lsp_timing_add(lsp_timing_transport_ms, wait_started_ms) can Console
                    return transport_finish(128 + pending_signal.i64()) if pending_signal != 0
                    return transport_finish(1) if events < 0
                    if (events & 1) != 0:
                        fill_started_ms: i64 = lsp_timing_start() can Console
                        _ = transport_fill(inbuf, inpos)
                        lsp_timing_add(lsp_timing_transport_ms, fill_started_ms) can Console
                        return transport_finish(1) if lsp_transport_input_failed
                    elif (events & 2) != 0 or (events & 8) != 0 or (events & 16) != 0:
                        # When input and worker readiness coincide, dispatch the
                        # client frame first so a newer edit can invalidate a
                        # completed but obsolete snapshot before it is published.
                        analysis_worker_process_events(events, worker_runtime, documents, document_storage, document_line_starts, pending_requests)
                LspMessageStep.Stop(exit_code):
                    return transport_finish(exit_code)
    return transport_finish(0)
