# Minimal JSON value model + recursive-descent parser for the Elisa LSP.
#
# Enough of JSON to read LSP/JSON-RPC requests: objects, arrays, strings, numbers,
# bools, null. String and number payloads are kept as raw source spans (`sview`) into
# the message buffer — cheap, and unescaping is applied only where a value is actually
# consumed (e.g. document text). Children are `darray` side-tables (docs/76); navigate
# with `match` and the `get` accessor.
module Json:
    # Nesting bound for the strict validator (J01): hostile depth is rejected
    # rather than overflowing the stack.
    const MAX_JSON_DEPTH: i64 = 256
    # Bound object/array node allocation even when a body packs millions of
    # tiny values. Object member names also consume this budget because they
    # allocate a Field and retain a source span in the parsed value tree.
    const MAX_JSON_VALUES: i64 = 200000

    public:
        # Hierarchy root so `Value` is a handle-based, store-backed packed enum whose
        # Arr/Obj payloads can carry `darray` side-tables (docs/76).
        enum Node layout(handle: u32):
            pass


        enum Value is Node:
            Null
            Bool(value: bool)
            # Raw numeric source text (e.g. "7", "-3.5e2"); decoded on demand by as_i64.
            Num(text: sview)
            # Raw string content between the quotes (escapes NOT yet expanded).
            Str(text: sview)
            Arr(items: darray[Value])
            Obj(fields: darray[Field])


        struct Field:
            key: sview
            value: Value


        # Strict validation reports a zero-based byte offset into the original
        # UTF-8 body and a stable failure category.
        enum ValidationCategory:
            Encoding
            Syntax
            ResourceLimit


        struct ValidationError:
            offset: mutable usize
            category: mutable ValidationCategory


        enum ParseOutcome:
            Parsed(value: Value)
            Rejected(detail: ValidationError)


        # Integer conversion keeps failure distinct from every valid i64,
        # including -2, which was previously used as a sentinel.
        enum I64ParseOutcome:
            Valid(value: i64)
            Invalid


        enum StringParseOutcome:
            Valid(text: sview)
            Null
            WrongType

    private:
        # Byte at `pos`, or 0 past the end.
        def at(src: sview, pos: usize) -> u8:
            0 return if pos >= sview_len(src)
            return sview_at(src, pos)


        def skip_ws(src: sview, pos: mutable usize&) -> void:
            while pos[0] < sview_len(src):
                c: u8 = sview_at(src, pos[0])
                match c:
                    32 | 9 | 10 | 13:
                        pos[0] <- pos[0] + 1
                    _:
                        return


        # Parse a JSON string, returning the raw content span (between the quotes). The
        # cursor is left just past the closing quote. Backslash escapes are skipped so an
        # escaped quote does not end the string early.
        def parse_string_span(src: sview, pos: mutable usize&) -> sview:
            sview("", 0, 0) return if at(src, pos[0]) != 34
            pos[0] <- pos[0] + 1
            start: usize = pos[0]
            while pos[0] < sview_len(src):
                c: u8 = sview_at(src, pos[0])
                match c:
                    92:
                        pos[0] <- pos[0] + 2
                    34:
                        end: usize = pos[0]
                        pos[0] <- pos[0] + 1
                        return string_view_slice(src, start.i64(), end.i64())
                    _:
                        pos[0] <- pos[0] + 1
            return string_view_slice(src, start.i64(), sview_len(src).i64())


        def parse_number_span(src: sview, pos: mutable usize&) -> sview:
            start: usize = pos[0]
            while pos[0] < sview_len(src):
                c: u8 = sview_at(src, pos[0])
                match c:
                    48..=57 | 45 | 43 | 46 | 101 | 69:
                        pos[0] <- pos[0] + 1
                    _:
                        break
            return string_view_slice(src, start.i64(), pos[0].i64())


        def parse_object(src: sview, pos: mutable usize&) -> Value:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[Field] = []
                pos[0] <- pos[0] + 1                 # consume `{`
                skip_ws(src, pos)
                if at(src, pos[0]) == 125:           # empty `}`
                    pos[0] <- pos[0] + 1
                    return (Value.Obj(fields))
                while true:
                    skip_ws(src, pos)
                    k: sview = parse_string_span(src, pos)
                    skip_ws(src, pos)
                    pos[0] <- pos[0] + 1 if at(src, pos[0]) == 58        # `:`
                    v: Value = parse_value(src, pos)
                    fields.push(Field{key: k, value: v})
                    skip_ws(src, pos)
                    if at(src, pos[0]) == 44:        # `,`
                        pos[0] <- pos[0] + 1
                    else:
                        pos[0] <- pos[0] + 1         # consume `}`
                        break
                return (Value.Obj(fields))


        def parse_array(src: sview, pos: mutable usize&) -> Value:
            can Memory.Allocate, Abort.Panic:
                items: mutable darray[Value] = []
                pos[0] <- pos[0] + 1                 # consume `[`
                skip_ws(src, pos)
                if at(src, pos[0]) == 93:            # empty `]`
                    pos[0] <- pos[0] + 1
                    return (Value.Arr(items))
                while true:
                    v: Value = parse_value(src, pos)
                    items.push(v)
                    skip_ws(src, pos)
                    if at(src, pos[0]) == 44:        # `,`
                        pos[0] <- pos[0] + 1
                    else:
                        pos[0] <- pos[0] + 1         # consume `]`
                        break
                return (Value.Arr(items))


        def parse_value(src: sview, pos: mutable usize&) -> Value:
            can Memory.Allocate, Abort.Panic:
                skip_ws(src, pos)
                c: u8 = at(src, pos[0])
                match c:
                    123:                              # `{`
                        return parse_object(src, pos)
                    91:                               # `[`
                        return parse_array(src, pos)
                    34:                               # `"`
                        return (Value.Str(parse_string_span(src, pos)))
                    116:                              # `true`
                        pos[0] <- pos[0] + 4
                        return (Value.Bool(true))
                    102:                              # `false`
                        pos[0] <- pos[0] + 5
                        return (Value.Bool(false))
                    110:                              # `null`
                        pos[0] <- pos[0] + 4
                        return (Value.Null)
                    _:
                        return (Value.Num(parse_number_span(src, pos)))

    public:
        # J01 strict validation: true iff `src` is exactly one well-formed JSON
        # value followed only by whitespace. On failure, `error` identifies a
        # zero-based byte offset and whether the body failed UTF-8 validation,
        # JSON grammar, or a configured resource bound. The value parser above
        # remains deliberately permissive; callers must validate before parse.
        def validate(src: sview, detail: mutable ValidationError&) -> bool:
            can Memory.Allocate, Abort.Panic:
                detail.offset <- 0
                detail.category <- ValidationCategory.Syntax
                bad_utf8: mutable usize = 0
                if not utf8_ok(src, bad_utf8):
                    detail.offset <- bad_utf8
                    detail.category <- ValidationCategory.Encoding
                    return false
                # The LSP content part is UTF-8. The structural JSON scanner
                # below treats non-ASCII bytes as ordinary string bytes, so
                # validate the complete message encoding before parsing any
                # spans that may later be copied back to the client.
                pos: mutable usize = 0
                values: mutable i64 = 0
                resource_failed: mutable bool = false
                if not value_ok(src, pos, 0, values, resource_failed):
                    detail.offset <- pos
                    if resource_failed:
                        detail.category <- ValidationCategory.ResourceLimit
                    return false
                ws_ok(src, pos)
                if pos != sview_len(src):
                    detail.offset <- pos
                    return false
                return true


        # Compatibility convenience for callers that only need a yes/no gate.
        def is_valid(src: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                detail: mutable ValidationError = ValidationError{offset: 0, category: ValidationCategory.Syntax}
                return validate(src, detail)


        # Checked parse entry point. The raw-value builder stays private and
        # zero-copy, while callers receive either the complete root or a
        # structured failure and can never observe a partial parsed tree.
        def parse(src: sview) -> ParseOutcome:
            can Memory.Allocate, Abort.Panic:
                detail: mutable ValidationError = ValidationError{offset: 0, category: ValidationCategory.Syntax}
                if not validate(src, detail):
                    return ParseOutcome.Rejected(detail)
                pos: mutable usize = 0
                root: Value = parse_value(src, pos)
                return ParseOutcome.Parsed(root)


    private:
        # Strict UTF-8 validation for the JSON body. Reject overlong encodings,
        # surrogate code points, isolated continuations, truncated sequences,
        # and scalars above U+10FFFF. This is deliberately applied to the full
        # body, not only decoded string values: JSON syntax itself is ASCII, and
        # every raw non-ASCII byte must belong to a valid Unicode scalar.
        def invalid_utf8(bad_offset: mutable usize&, offset: usize) -> bool:
            bad_offset[0] <- offset
            return false


        def utf8_ok(src: sview, bad_offset: mutable usize&) -> bool:
            n: usize = sview_len(src)
            i: mutable usize = 0
            while i < n:
                b0: u8 = sview_at(src, i)
                if b0 <= 0x7F:
                    i <- i + 1
                    continue
                if b0 >= 0xC2 and b0 <= 0xDF:
                    return invalid_utf8(bad_offset, i) if i + 1 >= n
                    b1: u8 = sview_at(src, i + 1)
                    return invalid_utf8(bad_offset, i) if b1 < 0x80 or b1 > 0xBF
                    i <- i + 2
                    continue
                if b0 == 0xE0:
                    return invalid_utf8(bad_offset, i) if i + 2 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    return invalid_utf8(bad_offset, i) if b1 < 0xA0 or b1 > 0xBF or b2 < 0x80 or b2 > 0xBF
                    i <- i + 3
                    continue
                if (b0 >= 0xE1 and b0 <= 0xEC) or (b0 >= 0xEE and b0 <= 0xEF):
                    return invalid_utf8(bad_offset, i) if i + 2 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    return invalid_utf8(bad_offset, i) if b1 < 0x80 or b1 > 0xBF or b2 < 0x80 or b2 > 0xBF
                    i <- i + 3
                    continue
                if b0 == 0xED:
                    return invalid_utf8(bad_offset, i) if i + 2 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    return invalid_utf8(bad_offset, i) if b1 < 0x80 or b1 > 0x9F or b2 < 0x80 or b2 > 0xBF
                    i <- i + 3
                    continue
                if b0 == 0xF0:
                    return invalid_utf8(bad_offset, i) if i + 3 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    b3: u8 = sview_at(src, i + 3)
                    return invalid_utf8(bad_offset, i) if b1 < 0x90 or b1 > 0xBF or b2 < 0x80 or b2 > 0xBF or b3 < 0x80 or b3 > 0xBF
                    i <- i + 4
                    continue
                if b0 >= 0xF1 and b0 <= 0xF3:
                    return invalid_utf8(bad_offset, i) if i + 3 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    b3: u8 = sview_at(src, i + 3)
                    return invalid_utf8(bad_offset, i) if b1 < 0x80 or b1 > 0xBF or b2 < 0x80 or b2 > 0xBF or b3 < 0x80 or b3 > 0xBF
                    i <- i + 4
                    continue
                if b0 == 0xF4:
                    return invalid_utf8(bad_offset, i) if i + 3 >= n
                    b1: u8 = sview_at(src, i + 1)
                    b2: u8 = sview_at(src, i + 2)
                    b3: u8 = sview_at(src, i + 3)
                    return invalid_utf8(bad_offset, i) if b1 < 0x80 or b1 > 0x8F or b2 < 0x80 or b2 > 0xBF or b3 < 0x80 or b3 > 0xBF
                    i <- i + 4
                    continue
                return invalid_utf8(bad_offset, i)
            return true


        def ws_ok(src: sview, pos: mutable usize&) -> void:
            while pos[0] < sview_len(src):
                c: u8 = sview_at(src, pos[0])
                match c:
                    32 | 9 | 10 | 13:
                        pos[0] <- pos[0] + 1
                    _:
                        return


        def lit_ok(src: sview, pos: mutable usize&, text: cstr?) -> bool:
            n: usize = sview_len(sview(text, 0, -1))
            false return if pos[0] + n > sview_len(src)
            i: mutable usize = 0
            while i < n:
                false return if sview_at(src, pos[0] + i) != sview_at(sview(text, 0, -1), i)
                i <- i + 1
            pos[0] <- pos[0] + n
            return true


        def hex4_ok(src: sview, start: usize) -> bool:
            false return if start + 4 > sview_len(src)
            i: mutable usize = 0
            while i < 4:
                c: u8 = sview_at(src, start + i)
                false return if c < 48 or (c > 57 and c < 65) or (c > 70 and c < 97) or c > 102
                i <- i + 1
            return true


        def hex4_value(src: sview, start: usize) -> u32:
            value: mutable u32 = 0
            i: mutable usize = 0
            while i < 4:
                c: u8 = sview_at(src, start + i)
                digit: u32 = (c - 48).u32() if c >= 48 and c <= 57 else ((c - 87).u32() if c >= 97 and c <= 102 else (c - 55).u32())
                value <- (value << 4) | digit
                i <- i + 1
            return value


        def string_ok(src: sview, pos: mutable usize&) -> bool:
            false return if sview_at(src, pos[0]) != 34
            pos[0] <- pos[0] + 1
            while pos[0] < sview_len(src):
                c: u8 = sview_at(src, pos[0])
                if c == 34:
                    pos[0] <- pos[0] + 1
                    return true
                if c == 92:
                    e: u8 = sview_at(src, pos[0] + 1) if pos[0] + 1 < sview_len(src) else 0
                    if e == 117:
                        false return if not hex4_ok(src, pos[0] + 2)
                        cp: u32 = hex4_value(src, pos[0] + 2)
                        if cp >= 0xD800 and cp <= 0xDBFF:
                            # A high surrogate is valid only as the first half
                            # of an immediately adjacent escaped low surrogate.
                            false return if pos[0] + 11 >= sview_len(src)
                            false return if sview_at(src, pos[0] + 6) != 92 or sview_at(src, pos[0] + 7) != 117
                            false return if not hex4_ok(src, pos[0] + 8)
                            lo: u32 = hex4_value(src, pos[0] + 8)
                            false return if lo < 0xDC00 or lo > 0xDFFF
                            pos[0] <- pos[0] + 12
                        else:
                            # Unpaired low surrogates cannot be encoded as
                            # valid UTF-8 by decode_into, so reject them here.
                            false return if cp >= 0xDC00 and cp <= 0xDFFF
                            pos[0] <- pos[0] + 6
                    elif e == 34 or e == 92 or e == 47 or e == 98 or e == 102 or e == 110 or e == 114 or e == 116:
                        pos[0] <- pos[0] + 2
                    else:
                        return false
                elif c < 32:
                    return false
                else:
                    pos[0] <- pos[0] + 1
            return false


        def number_ok(src: sview, pos: mutable usize&) -> bool:
            if sview_at(src, pos[0]) == 45:
                pos[0] <- pos[0] + 1
            false return if pos[0] >= sview_len(src)
            c: u8 = sview_at(src, pos[0])
            if c == 48:
                pos[0] <- pos[0] + 1
            elif c >= 49 and c <= 57:
                pos[0] <- pos[0] + 1
                while pos[0] < sview_len(src) and sview_at(src, pos[0]) >= 48 and sview_at(src, pos[0]) <= 57:
                    pos[0] <- pos[0] + 1
            else:
                return false
            if pos[0] < sview_len(src) and sview_at(src, pos[0]) == 46:
                pos[0] <- pos[0] + 1
                false return if pos[0] >= sview_len(src) or sview_at(src, pos[0]) < 48 or sview_at(src, pos[0]) > 57
                while pos[0] < sview_len(src) and sview_at(src, pos[0]) >= 48 and sview_at(src, pos[0]) <= 57:
                    pos[0] <- pos[0] + 1
            if pos[0] < sview_len(src) and (sview_at(src, pos[0]) == 101 or sview_at(src, pos[0]) == 69):
                pos[0] <- pos[0] + 1
                if pos[0] < sview_len(src) and (sview_at(src, pos[0]) == 43 or sview_at(src, pos[0]) == 45):
                    pos[0] <- pos[0] + 1
                false return if pos[0] >= sview_len(src) or sview_at(src, pos[0]) < 48 or sview_at(src, pos[0]) > 57
                while pos[0] < sview_len(src) and sview_at(src, pos[0]) >= 48 and sview_at(src, pos[0]) <= 57:
                    pos[0] <- pos[0] + 1
            return true


        def value_ok(src: sview, pos: mutable usize&, depth: i64, values: mutable i64&, resource_failed: mutable bool&) -> bool:
            ws_ok(src, pos)
            if depth > MAX_JSON_DEPTH:
                resource_failed[0] <- true
                return false
            if values[0] >= MAX_JSON_VALUES:
                resource_failed[0] <- true
                return false
            values[0] <- values[0] + 1
            false return if pos[0] >= sview_len(src)
            c: u8 = sview_at(src, pos[0])
            if c == 123:
                return object_ok(src, pos, depth + 1, values, resource_failed)
            if c == 91:
                return array_ok(src, pos, depth + 1, values, resource_failed)
            if c == 34:
                return string_ok(src, pos)
            if c == 116:
                return lit_ok(src, pos, "true")
            if c == 102:
                return lit_ok(src, pos, "false")
            if c == 110:
                return lit_ok(src, pos, "null")
            if c == 45 or (c >= 48 and c <= 57):
                return number_ok(src, pos)
            return false


        def object_ok(src: sview, pos: mutable usize&, depth: i64, values: mutable i64&, resource_failed: mutable bool&) -> bool:
            pos[0] <- pos[0] + 1
            ws_ok(src, pos)
            if pos[0] < sview_len(src) and sview_at(src, pos[0]) == 125:
                pos[0] <- pos[0] + 1
                return true
            while true:
                ws_ok(src, pos)
                false return if pos[0] >= sview_len(src) or sview_at(src, pos[0]) != 34
                if values[0] >= MAX_JSON_VALUES:
                    resource_failed[0] <- true
                    return false
                values[0] <- values[0] + 1
                false return if not string_ok(src, pos)
                ws_ok(src, pos)
                false return if pos[0] >= sview_len(src) or sview_at(src, pos[0]) != 58
                pos[0] <- pos[0] + 1
                false return if not value_ok(src, pos, depth, values, resource_failed)
                ws_ok(src, pos)
                false return if pos[0] >= sview_len(src)
                d: u8 = sview_at(src, pos[0])
                if d == 44:
                    pos[0] <- pos[0] + 1
                elif d == 125:
                    pos[0] <- pos[0] + 1
                    return true
                else:
                    return false
            return false


        def array_ok(src: sview, pos: mutable usize&, depth: i64, values: mutable i64&, resource_failed: mutable bool&) -> bool:
            pos[0] <- pos[0] + 1
            ws_ok(src, pos)
            if pos[0] < sview_len(src) and sview_at(src, pos[0]) == 93:
                pos[0] <- pos[0] + 1
                return true
            while true:
                false return if not value_ok(src, pos, depth, values, resource_failed)
                ws_ok(src, pos)
                false return if pos[0] >= sview_len(src)
                d: u8 = sview_at(src, pos[0])
                if d == 44:
                    pos[0] <- pos[0] + 1
                elif d == 93:
                    pos[0] <- pos[0] + 1
                    return true
                else:
                    return false
            return false


    public:
        # Look up a field by key in an object value; null if absent or not an object.
        def get(v: Value, key: cstr?) -> Value?:
            can Memory.Allocate, Abort.Panic:
                match v:
                    Value.Obj(fields):
                        for f in fields:
                            # Object member names are JSON strings too: compare
                            # their decoded value so e.g. "metho\\u0064" is
                            # the same protocol field as "method".
                            decoded_key: mutable darray[u8] = []
                            decode_into(Value.Str(f.key), decoded_key)
                            key_view: sview = bytes_view_range_ref(decoded_key, 0, decoded_key.count) if decoded_key.count > 0 else sview("", 0, 0)
                            f.value return if string_view_eq(key_view, key) == 1
                    _:
                        pass
                return null


        # Count members whose decoded key exactly matches `key`. Protocol
        # envelopes reject duplicate critical keys instead of letting callers
        # disagree about which occurrence wins.
        def count_key(v: Value, key: cstr?) -> i64:
            can Memory.Allocate, Abort.Panic:
                count: mutable i64 = 0
                match v:
                    Value.Obj(fields):
                        for f in fields:
                            decoded_key: mutable darray[u8] = []
                            decode_into(Value.Str(f.key), decoded_key)
                            key_view: sview = bytes_view_range_ref(decoded_key, 0, decoded_key.count) if decoded_key.count > 0 else sview("", 0, 0)
                            count <- count + 1 if string_view_eq(key_view, key) == 1
                    _:
                        pass
                return count


        # J02 strict protocol integers: canonical optional-`-` plus 1+ ASCII
        # digits and nothing else. Fractional (`1.5`), signed-plus (`+1`),
        # empty, or lone-`-` spellings are NOT integers — accepting them would
        # coerce (e.g. version `1.5` parsed as 15), corrupting staleness logic.
        def is_int_text(text: sview) -> bool:
            return false if text.len == 0
            i: mutable usize = 0
            if sview_at(text, 0) == 45:
                return false if text.len == 1
                i <- 1
            digits: mutable bool = false
            while i < text.len.usize():
                d: u8 = sview_at(text, i)
                return false if d < 48 or d > 57
                digits <- true
                i <- i + 1
            return digits


        def is_int_num(v: Value) -> bool:
            match v:
                Value.Num(text):
                    return is_int_text(text)
                _:
                    return false


        # Convert a canonical integer token without overflow. Accumulating a
        # negative value permits the asymmetric i64 minimum to be represented.
        def as_i64_result(v: Value) -> I64ParseOutcome:
            match v:
                Value.Num(text):
                    return I64ParseOutcome.Invalid if not is_int_text(text)
                    neg: mutable bool = false
                    i: mutable usize = 0
                    if sview_at(text, 0) == 45:
                        neg <- true
                        i <- 1
                    n: mutable i64 = 0
                    limit: mutable i64 = -9223372036854775807
                    limit <- -9223372036854775808 if neg
                    while i < text.len.usize():
                        d: i64 = sview_at(text, i).i64() - 48
                        return I64ParseOutcome.Invalid if n < limit / 10
                        n <- n * 10
                        return I64ParseOutcome.Invalid if n < limit + d
                        n <- n - d
                        i <- i + 1
                    value: i64 = n if neg else 0 - n
                    return I64ParseOutcome.Valid(value)
                _:
                    return I64ParseOutcome.Invalid


        # LSP `integer` is a signed 32-bit JSON integer; coordinates and
        # limits generally use the non-negative `uinteger` range.
        def as_lsp_integer_result(v: Value) -> I64ParseOutcome:
            match as_i64_result(v):
                I64ParseOutcome.Valid(value):
                    return I64ParseOutcome.Valid(value) if value >= -2147483648 and value <= 2147483647
                    return I64ParseOutcome.Invalid
                I64ParseOutcome.Invalid:
                    return I64ParseOutcome.Invalid


        def as_lsp_uinteger_result(v: Value) -> I64ParseOutcome:
            match as_i64_result(v):
                I64ParseOutcome.Valid(value):
                    return I64ParseOutcome.Valid(value) if value >= 0 and value <= 2147483647
                    return I64ParseOutcome.Invalid
                I64ParseOutcome.Invalid:
                    return I64ParseOutcome.Invalid


        # Convenience for coordinates that default to an invalid negative
        # value. `-1` cannot collide with a valid LSP uinteger.
        def as_lsp_uinteger_or_invalid(v: Value) -> i64:
            match as_lsp_uinteger_result(v):
                I64ParseOutcome.Valid(value):
                    return value
                I64ParseOutcome.Invalid:
                    return -1


        # Raw string content is distinct from an empty valid string; absent
        # fields remain distinct through `get`'s optional result.
        def as_str_result(v: Value) -> StringParseOutcome:
            match v:
                Value.Str(text):
                    return StringParseOutcome.Valid(text)
                Value.Null:
                    return StringParseOutcome.Null
                _:
                    return StringParseOutcome.WrongType


        # Hex digit value, or 0 for non-hex.
        def hex_val(c: u8) -> u32:
            return when c:
                48..=57 -> (c - 48).u32()
                97..=102 -> (c - 87).u32()
                65..=70 -> (c - 55).u32()
                _ -> 0


        # Append `cp` to `out` as UTF-8.
        def push_utf8(out: mutable darray[u8]&, cp: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                match cp:
                    0..<0x80:
                        out.push(cp.u8())
                    0x80..<0x800:
                        out.push((0xC0 | (cp >> 6)).u8())
                        out.push((0x80 | (cp & 0x3F)).u8())
                    0x800..<0x10000:
                        out.push((0xE0 | (cp >> 12)).u8())
                        out.push((0x80 | ((cp >> 6) & 0x3F)).u8())
                        out.push((0x80 | (cp & 0x3F)).u8())
                    _:
                        out.push((0xF0 | (cp >> 18)).u8())
                        out.push((0x80 | ((cp >> 12) & 0x3F)).u8())
                        out.push((0x80 | ((cp >> 6) & 0x3F)).u8())
                        out.push((0x80 | (cp & 0x3F)).u8())


        # Append a Str value's DECODED content to `out`, expanding JSON escapes
        # (\n \t \r \b \f \" \\ \/ and \uXXXX incl. surrogate pairs). This is
        # the consumption point the parser defers to — `Str` spans stay raw, and
        # anything that feeds string content onward (document text!) decodes here.
        # Real clients escape every newline/quote of the document, so skipping
        # this hands the frontend `\n`-riddled source (parse-error storms on
        # small docs) — the exact bug found wiring up the JetBrains client.
        def decode_into(v: Value, out: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                text: mutable sview = sview("", 0, 0)
                match as_str_result(v):
                    StringParseOutcome.Valid(value):
                        text <- value
                    StringParseOutcome.Null | StringParseOutcome.WrongType:
                        return
                n: usize = sview_len(text)
                i: mutable usize = 0
                while i < n:
                    c: u8 = sview_at(text, i)
                    if c != 92:
                        out.push(c)
                        i <- i + 1
                    else:
                        e: u8 = sview_at(text, i + 1) if i + 1 < n else 0
                        if e == 110:                      # \n
                            out.push(10)
                            i <- i + 2
                        elif e == 116:                    # \t
                            out.push(9)
                            i <- i + 2
                        elif e == 114:                    # \r
                            out.push(13)
                            i <- i + 2
                        elif e == 98:                     # \b
                            out.push(8)
                            i <- i + 2
                        elif e == 102:                    # \f
                            out.push(12)
                            i <- i + 2
                        elif e == 117 and i + 5 < n:      # \uXXXX
                            cp: mutable u32 = (hex_val(sview_at(text, i + 2)) << 12) | (hex_val(sview_at(text, i + 3)) << 8) | (hex_val(sview_at(text, i + 4)) << 4) | hex_val(sview_at(text, i + 5))
                            i <- i + 6
                            # High surrogate followed by \uDC00-\uDFFF combines.
                            if cp >= 0xD800 and cp <= 0xDBFF and i + 5 < n and sview_at(text, i) == 92 and sview_at(text, i + 1) == 117:
                                lo: u32 = (hex_val(sview_at(text, i + 2)) << 12) | (hex_val(sview_at(text, i + 3)) << 8) | (hex_val(sview_at(text, i + 4)) << 4) | hex_val(sview_at(text, i + 5))
                                if lo >= 0xDC00 and lo <= 0xDFFF:
                                    cp <- 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                                    i <- i + 6
                            push_utf8(out, cp)
                        else:
                            # \" \\ \/ and any unknown escape: literal next byte.
                            out.push(e)
                            i <- i + 2
